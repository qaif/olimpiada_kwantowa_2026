# webTEX configuration (see server/config.js). Copy to .env and adjust.
# Note: the server reads plain environment variables; it does not load .env itself.
# docker compose reads .env automatically; for `npm start` export them in your shell.

# HTTP
PORT=3000
HOST=0.0.0.0

# Where SQLite, project files, compile dirs and PDFs live
DATA_DIR=./data

# Accounts
ALLOW_REGISTRATION=true
# Set to true when served over HTTPS (adds the Secure flag to the session cookie)
SECURE_COOKIES=false

# Max size of a single uploaded file / imported zip, in MB
MAX_UPLOAD_MB=50

# Compilation
# auto   = local latexmk if found, otherwise the Docker sandbox image
# local  = latexmk on the server's PATH (not isolated per project)
# docker = every compile in a fresh, network-less container (recommended)
COMPILE_BACKEND=auto
COMPILE_IMAGE=webtex-texlive
# seconds
COMPILE_TIMEOUT=90
# docker backend only
COMPILE_MEMORY=1g
COMPILE_CPUS=2

# Quantum Olympiad platform integration (docs/tasks/TEX-01.md in the platform repository)
# true = accounts only via SSO from the platform, signed /api/integration/* API, sharing policy per stage
WEBTEX_INTEGRATION=false
# Shared secret with Django, at least 32 characters, different from every other secret.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBTEX_SHARED_KEY=
# Expected `iss` of SSO tokens (Django's WEBTEX_ISSUER)
WEBTEX_ISSUER=olimpiada
# Public platform address, shown on /login and SSO error pages
PLATFORM_URL=

# AI assistant (TEX-02). Off unless LLM_ENABLED=true. Provider keys stay on the server.
# In integration mode the assistant is additionally off per project until the platform enables it
# (SSO claim `ai: true` or the signed POST /api/integration/ai).
LLM_ENABLED=false
# Optional JSON file with providers (README, "Asystent AI"); its entries override the env shortcuts below
LLM_CONFIG=
# false = ignore the env shortcuts below and use only LLM_CONFIG
LLM_ENV_PROVIDERS=true
LLM_DEFAULT_PROVIDER=
# Limits: max answer tokens, requests per user per window (seconds, 0 = unlimited), parallel answers per user
LLM_MAX_TOKENS=4096
LLM_RATE_LIMIT=30
LLM_RATE_WINDOW=600
LLM_MAX_CONCURRENT=2
# seconds: whole request / silence in the stream
LLM_TIMEOUT=180
LLM_IDLE_TIMEOUT=90
# characters of the current file sent as context; size limit of the conversation sent to the model
LLM_CONTEXT_CHARS=24000
LLM_MAX_INPUT_CHARS=40000
# Leave empty: current Claude and OpenAI reasoning models reject a temperature
LLM_TEMPERATURE=
# true logs prompts (debugging only); by default only metadata is logged
LLM_LOG_PROMPTS=false

# Provider shortcuts: a key (or URL) registers the provider.
# <PREFIX>_MODELS="id=Label,id2" overrides the default model list.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-5=GPT-5,gpt-5-mini=GPT-5 mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-5-5=Claude Opus 5.5,claude-sonnet-5-5=Claude Sonnet 5.5,claude-haiku-5-5=Claude Haiku 5.5
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-pro=Gemini 2.5 Pro,gemini-2.5-flash=Gemini 2.5 Flash
MISTRAL_API_KEY=
COHERE_API_KEY=
# Azure OpenAI: deployment names are the models; AZURE_OPENAI_API_VERSION=v1 uses the newer v1 API
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENTS=
AZURE_OPENAI_API_VERSION=2024-10-21
# Amazon Bedrock (ConverseStream): BEDROCK_REGION + IAM keys (SigV4) or a Bedrock API key.
# AWS_* keys alone do not register Bedrock.
BEDROCK_REGION=
BEDROCK_MODELS=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=
# Local / self-hosted servers: models are discovered when *_MODELS is empty
OLLAMA_BASE_URL=
VLLM_BASE_URL=
LITELLM_BASE_URL=
LITELLM_API_KEY=
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Hosted OpenAI-compatible APIs (set *_MODELS too)
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
