{
  "name": "webtex",
  "version": "0.1.0",
  "description": "webTEX — an open-source, self-hosted collaborative LaTeX editor (an Overleaf alternative)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test \"server/test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "lib0": "^0.2.119",
    "multer": "^2.4.0",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "pdfjs-dist": "^6.4.299",
    "vite": "^8.3.4",
    "y-codemirror.next": "^0.3.6"
  }
