{
    # API administracyjne wyłącznie z wnętrza kontenera (healthcheck woła 127.0.0.1:2019).
    admin localhost:2019
}

{$SITE_DOMAIN} {
    encode gzip zstd
    request_body {
        max_size {$MAX_UPLOAD_MB}MB
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto {scheme}
            # Adres klienta dla audytu; backend ufa temu nagłówkowi tylko, gdy REMOTE_ADDR jest adresem proxy.
            header_up X-Real-IP {remote_host}
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }
}

# Publiczny endpoint S3 dla presigned URL (podpis SigV4 obejmuje host, więc osobna nazwa, nie podścieżka).
# Bucket `submissions` jest prywatny: bez ważnego podpisu MinIO odpowiada 403.
s3.{$SITE_DOMAIN} {
    request_body {
        max_size {$MAX_UPLOAD_MB}MB
    }
    reverse_proxy minio:9000
}
