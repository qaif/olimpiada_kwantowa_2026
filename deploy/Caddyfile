{
    # API administracyjne wyłącznie z wnętrza kontenera (healthcheck woła 127.0.0.1:2019).
    admin localhost:2019
    email {$ACME_EMAIL}
    # Limity czasu odczytu żądania (audyt bezpieczeństwa 10.10.2026, S16 – „slow-POST”). Bez nich
    # Go nie ogranicza czasu odczytu wcale: klient wysyłający nagłówki albo treść po bajcie co kilka
    # sekund trzymał połączenie bez końca. Razem z `request_buffers` przy każdym `reverse_proxy`
    # do aplikacji (niżej i w scripts/render_caddyfile.sh) – to tamto zdejmuje problem z gunicorna
    # (16 wątków), ten limit ogranicza już tylko to, co trzyma sam Caddy.
    # - `read_header 15s` – nagłówki przychodzą w jednym pakiecie; 15 s to zapas na fatalne łącze.
    # - `read_body 600s` – CAŁE żądanie (nagłówki + treść), liczone od jego początku. Upload na
    #   granicy MAX_UPLOAD_MB=25 (25 000 000 B treści) w 600 s wymaga ok. 0,33 Mbit/s wysyłania;
    #   300 s z audytu – 0,67 Mbit/s, a tyle potrafi nie mieć telefon na słabym LTE w ostatniej
    #   godzinie przed terminem. Podnosząc MAX_UPLOAD_MB, sprawdź ten rachunek. Część pliku wideo z warsztatów (16 MB na
    #   blok S3) mieści się z zapasem. Przekroczenie kończy żądanie bez dotarcia do aplikacji
    #   (Caddy 2.10 odpowiada wtedy pustym 200 i zamyka połączenie – sprawdzone 10.10.2026).
    # Limity nie dotyczą WebSocketów po zestawieniu (XMPP Jitsi pod meet., socket.io monitora):
    # Caddy zdejmuje terminy z przejętego połączenia HTTP/1.1, a WebSocketów po HTTP/2 nie ogłasza
    # (brak SETTINGS_ENABLE_CONNECT_PROTOCOL) – sprawdzone 10.10.2026 na caddy:2.10: połączenie
    # trwało dłużej niż `read_body` bez zerwania. Odpowiedzi (pobieranie plików) nie dotyczą wcale.
    servers {
        timeouts {
            read_header 15s
            read_body 600s
        }
    }
}

# Strona „Prace techniczne” (docs/OPERACJE.md § 20) – fragment wstawiany (`import maintenance`) do
# każdego bloku **aplikacji**: domena główna, domeny z EXTRA_DOMAINS i blok `*.` subdomen platformy
# (scripts/render_caddyfile.sh). Celowo NIE do `meet.` (Jitsi), `monitor.` (monitoring ma działać
# właśnie wtedy) ani do bloku S3 (`{$S3_PUBLIC_ADDRESS}`) – wgrywanie przerwane przez awarię ma się
# skończyć zwykłym błędem, a nie stroną HTML, której klient S3 nie zrozumie.
#
# Stronę podaje Caddy, nie Django: działa, gdy `web` albo baza leżą. Katalog /srv/maintenance to
# <REMOTE_DIR>/maintenance/ na hoście (docker-compose.yml) – poza plikami z repozytorium, bo krok 2/8
# scripts/deploy.sh kasuje i rozpakowuje kod od nowa, a kontener widziałby wtedy pusty, skasowany
# katalog aż do restartu proxy. Treść strony kopiuje tam `scripts/maintenance.sh sync` (woła go też
# deploy.sh, krok 4/8) z deploy/maintenance/.
#
# Dwa tryby, ta sama strona (503, Retry-After, no-store; JSON dla /status.json, /healthz/, /api/*):
# 1. planowy – istnieje plik /srv/maintenance/on (`scripts/maintenance.sh on|off`). Matcher `file`
#    sprawdza plik przy każdym żądaniu, więc przełączenie nie wymaga przeładowania Caddy'ego.
#    Wyjątki: wyzwanie ACME i operator z tokenem MAINTENANCE_BYPASS_TOKEN (z .env) w nagłówku
#    `X-Maintenance-Bypass` albo w ciasteczku `olimpiada_maintenance_bypass` – ustawia je wejście na
#    /__maintenance/bypass?token=<token>. Token krótszy niż 32 znaki (albo pusty) nie przepuszcza
#    nikogo, więc brak wpisu w .env nie otwiera furtki. Kolejność `handle` (sprawdzona
#    `caddy adapt`): logowanie tokenem, potem przerwa, dopiero potem /static/* i aplikacja – przerwa
#    zasłania więc też pliki statyczne, a strona i tak nie wczytuje niczego z zewnątrz.
# 2. nieplanowy – `web` nie odpowiada (restart przy wdrożeniu, awaria): reverse_proxy zwraca błąd
#    502/504 (albo 503), a `handle_errors` podaje tę samą stronę zamiast pustego 502. Odpowiedzi,
#    które aplikacja wysłała sama (także jej 500/503), przechodzą bez zmian – `handle_errors` widzi
#    wyłącznie błędy Caddy'ego.
(maintenance) {
    @maintenance_bypass_login {
        path /__maintenance/bypass
        expression `"{$MAINTENANCE_BYPASS_TOKEN}".size() >= 32 && {http.request.uri.query.token} == "{$MAINTENANCE_BYPASS_TOKEN}"`
    }
    handle @maintenance_bypass_login {
        header Set-Cookie "olimpiada_maintenance_bypass={$MAINTENANCE_BYPASS_TOKEN}; Path=/; Max-Age=43200; Secure; HttpOnly; SameSite=Lax"
        header Cache-Control "no-store"
        redir * / 303
    }
    @maintenance {
        file {
            root /srv/maintenance
            try_files /on
        }
        not path /.well-known/acme-challenge/*
        not expression `"{$MAINTENANCE_BYPASS_TOKEN}".size() >= 32 && ({http.request.header.X-Maintenance-Bypass} == "{$MAINTENANCE_BYPASS_TOKEN}" || {http.request.cookie.olimpiada_maintenance_bypass} == "{$MAINTENANCE_BYPASS_TOKEN}")`
    }
    handle @maintenance {
        error 503
    }
    # `handle_errors` bez listy kodów i własny matcher kodu: w Caddym 2.8 (`handle_errors 502 503
    # 504`) lista kodów NADPISUJE matchery zagnieżdżonych `handle` (sprawdzone `caddy adapt` na
    # 2.8.4 – wariant JSON łapał wtedy każde żądanie). Błędy o innych kodach (np. 404 z /static/)
    # nie pasują do niczego tutaj i kończą się tak, jak przed tą zmianą: sam kod, pusta treść.
    handle_errors {
        @maintenance_error expression `{http.error.status_code} in [502, 503, 504]`
        handle @maintenance_error {
            # Nagłówki bezpieczeństwa powtórzone: odpowiedź błędu nie przechodzi przez `header`
            # bloku. CSP tylko dla tej strony – bez skryptów i zasobów z zewnątrz (meta refresh).
            header {
                Cache-Control "no-store"
                Retry-After "60"
                Strict-Transport-Security "max-age=31536000"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "same-origin"
                X-Frame-Options "DENY"
                Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
            }
            @maintenance_json path /status.json /healthz /healthz/* /api/*
            handle @maintenance_json {
                header Content-Type "application/json"
                respond `{"status":"maintenance","retry_after":60}` 503
            }
            # Katalog strony jeszcze nie skopiowany (serwer przed pierwszym `maintenance.sh sync`):
            # zwykły tekst zamiast 404 z pustą treścią.
            @maintenance_no_page not file {
                root /srv/maintenance/page
                try_files /index.html
            }
            handle @maintenance_no_page {
                header Content-Type "text/plain; charset=utf-8"
                respond "Prace techniczne – serwis wróci za kilka minut. Maintenance – back in a few minutes. contact@qaif.org" 503
            }
            handle {
                root * /srv/maintenance/page
                rewrite * /index.html
                # Wstawka komunikatu operatora (plik info.html, który pisze scripts/maintenance.sh,
                # z treścią zamienioną na encje – także klamry, więc nie da się nią wywołać szablonu).
                templates {
                    root /srv/maintenance
                }
                file_server {
                    status 503
                }
            }
        }
    }
}

# Przekierowanie www -> domena główna (jeden kanoniczny adres, jeden certyfikat w linkach).
www.{$SITE_DOMAIN} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
    import maintenance
    encode gzip zstd
    request_body {
        max_size {$MAX_UPLOAD_MB}MB
    }
    handle_path /static/* {
        # Rok + `immutable`: WhiteNoise (`CompressedManifestStaticFilesStorage`, DEBUG=0 –
        # config/settings/base.py) daje każdemu plikowi w szablonach (`{% static %}`) nazwę
        # z odciskiem treści w nazwie (`app.<hash>.css`) – zmiana treści to zawsze **nowy** adres,
        # więc stary URL bezpiecznie leży w pamięci przeglądarki, dopóki istnieje. Szablony nie
        # odwołują się do `/static/...` z pominięciem `{% static %}` (sprawdzone grepem po
        # `backend/apps` – jedyne trafienia to testy, nie kod serwowany produkcyjnie), więc cała
        # ścieżka może dostać ten sam, długi nagłówek bez ryzyka przytrzymania nieaktualnej wersji
        # pliku pod niezmienną nazwą.
        header Cache-Control "public, max-age=31536000, immutable"
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            # Cała treść żądania w pamięci Caddy'ego, ZANIM pójdzie do gunicorna (audyt 10.10.2026,
            # S16): 16 wątków web nie czeka już na wolnego klienta, tylko dostaje gotowe żądanie.
            # `MiB` przy `MB` w `max_size` wyżej celowo – ta sama zmienna, a bufor zawsze WIĘKSZY
            # od największej dopuszczalnej treści (25 MiB = 26 214 400 B > 25 MB = 25 000 000 B).
            # Bufor równy limitowi zapełnia się przy treści na granicy i Caddy przechodzi wtedy na
            # strumień do gunicorna – klient wstrzymany na ostatnim bajcie znowu trzymałby wątek.
            # Koszt: pamięć proxy rośnie o treść każdego trwającego uploadu (patrz docs/OPERACJE.md).
            request_buffers {$MAX_UPLOAD_MB}MiB
            header_up X-Forwarded-Proto {scheme}
            # Adres klienta dla audytu; backend ufa temu nagłówkowi tylko, gdy REMOTE_ADDR jest adresem proxy.
            header_up X-Real-IP {remote_host}
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }
}

# Publiczny endpoint S3 dla presigned URL (podpis SigV4 obejmuje host, więc osobny adres, nie podścieżka).
# S3_PUBLIC_ADDRESS: `s3.<domena>` (rekord DNS A) albo `<domena>:9000` (ten sam certyfikat, osobny port),
# spójne z S3_PUBLIC_ENDPOINT_URL w .env. Bucket `submissions` jest prywatny: bez podpisu MinIO odpowiada 403.
#
# Materiały z warsztatów (apps/workshop_materials): przeglądarka koordynatora wysyła tu film **częściami**
# po 16 MB (`PART_SIZE` w apps/workshop_materials/storage.py) na adresy podpisane przez serwer, więc limit
# niżej dotyczy jednej części, nie całego filmu – MAX_UPLOAD_MB musi zostać **powyżej** 16 (domyślnie 25).
# Oglądanie idzie tym samym adresem (GET z podpisem, przewijanie żądaniami `Range`), bez `encode`:
# film jest już skompresowany, a kompresja w locie psułaby odpowiedzi częściowe (206).
# Access logu Caddy nie włączamy (brak dyrektywy `log`) – adresy z podpisem nie lądują w żadnym pliku.
#
# Utwardzenie (1.10.2026, audyt bezpieczeństwa):
# 1. `/minio/*` – 404 z proxy, poza dwiema sondami życia. Pod tym prefiksem MinIO ma WYŁĄCZNIE własne
#    API: administracyjne (`/minio/admin/` – konta, polityki, konfiguracja; chronione kluczem roota,
#    ale nie ma powodu wystawiać go na świat), metryki (`/minio/v2|v3/metrics/`, `/minio/prometheus/`),
#    KMS, RPC węzłów. Żaden klient S3 tam nie chodzi: nazwa bucketu `minio` jest w MinIO zarezerwowana,
#    więc ścieżka `/minio/…` nigdy nie jest obiektem, a presigned GET/PUT, wgrywanie wieloczęściowe
#    (`?uploads`, `?partNumber=&uploadId=` – apps/workshop_materials/storage.py) i żądania `Range`
#    idą na `/<bucket>/<klucz>` i tej reguły nie dotykają. Zostają `/minio/health/live` i `/ready`:
#    monitor nr 4 z deploy/monitoring/README.md sprawdza właśnie tę publiczną drogę (adresy presigned
#    omijają aplikację, więc awaria tylko tej trasy nie zapaliłaby niczego innego), a odpowiedź
#    to sam kod 200/503 bez treści. `/minio/health/cluster*` (kworum) – zamknięte razem z resztą.
# 2. Nagłówki bezpieczeństwa: `nosniff`, HSTS jak w bloku domeny głównej i CSP `sandbox` – obiekt
#    `public-media` (wgrany przez redaktora SVG albo HTML) otwarty wprost w karcie nie wykona skryptu.
#    To jest ten sam origin co reszta serwisu dla ciasteczek (ciasteczka nie rozróżniają portów –
#    produkcja ma S3 pod `<domena>:9000`), więc skrypt stąd czytałby np. `csrftoken`. Wyjątek: PDF
#    (`path_regexp (?i)\.pdf$`, to samo podejście co dla plików redaktorów serwisu na django CMS
#    w scripts/render_caddyfile.sh) – wbudowane przeglądarki PDF nie działają pod `sandbox`. CSP
#    odpowiedzi nie dotyczy żądań `fetch`/XHR (dotyczy dokumentu, który się z niej buduje), więc
#    wgrywanie z przeglądarki koordynatora i odtwarzacz `<video>` działają bez zmian.
#    `defer`: nagłówki ustawiane PO odpowiedzi MinIO, które wysyła własne `X-Content-Type-Options`,
#    HSTS (z `includeSubDomains`) i CSP `block-all-mixed-content` – bez `defer` dostałby je klient
#    obok naszych albo zamiast nich (PDF zostaje z CSP MinIO – samo `block-all-mixed-content`,
#    nieszkodliwe). CORS, `ETag`, `Content-Range`, `Accept-Ranges` i pozostałe nagłówki MinIO
#    przechodzą nietknięte (żadnego `-` ani podmiany). Działanie na żywym Caddym z atrapą MinIO
#    (ścieżki, nagłówki każdy dokładnie raz, `Range` → 206): scripts/tests/s3_proxy_test.sh.
{$S3_PUBLIC_ADDRESS} {
    request_body {
        max_size {$MAX_UPLOAD_MB}MB
    }
    @s3_minio_api {
        path /minio /minio/*
        not path /minio/health/live /minio/health/ready
    }
    handle @s3_minio_api {
        respond 404
    }
    header {
        defer
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000"
    }
    @s3_active_content not path_regexp (?i)\.pdf$
    header @s3_active_content {
        defer
        Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'; sandbox"
    }
    handle {
        reverse_proxy minio:9000
    }
}

# Własne Jitsi Meet (rozmowy kwalifikacyjne): osobny projekt compose (deploy/jitsi, scripts/deploy_jitsi.sh);
# kontener `jitsi-web` dołącza pod tą nazwą do sieci `meet` (od 10.10.2026; wcześniej `edge`), w której
# stoi tylko proxy. WebSocket (XMPP) przechodzi przez reverse_proxy bez dodatkowej konfiguracji. Dopóki
# nie ma rekordu DNS `meet.<domena>`, ten blok tylko czeka na certyfikat.
#
# Ramki (audyt 10.10.2026): platforma NIE osadza pokoi w `<iframe>` (link otwiera pokój w karcie –
# apps/competitions/video.py, CSP `frame-src` aplikacji Jitsi nie zna), więc strona z kamerą
# i mikrofonem nie ma po co dawać się wstawić w cudzą stronę (clickjacking zgody na urządzenia).
# `'self'`/SAMEORIGIN, a nie `'none'`: obcy origin jest zablokowany tak samo, a Jitsi zostaje przy
# swoich ewentualnych ramkach z własnego hosta. Bez `defer`, jak w bloku monitor. – drugi nagłówek
# CSP od Jitsi (gdyby kiedyś go wysłało) przeglądarka egzekwuje razem z tym, nie zamiast.
#
# Przepustki platformy (v0.39.0, docs/OPERACJE.md § 25): portal przekierowuje do pokoju z tokenem JWT we
# fragmencie adresu (`#jwt="…"`), który nie jedzie do serwera. `Referrer-Policy: no-referrer` zamyka drugą
# drogę wycieku na wypadek adresu z `?jwt=` (stare zakładki, ręcznie sklejone linki): strona pokoju nie
# wyśle swojego adresu w `Referer` do nikogo (czcionki, zasoby zewnętrzne). Access logu nie ma (brak
# dyrektywy `log`, jak w całym pliku) – adres z tokenem nie ląduje w żadnym pliku Caddy'ego.
meet.{$SITE_DOMAIN} {
    encode gzip zstd
    reverse_proxy jitsi-web:80 {
        header_up X-Forwarded-Proto {scheme}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "SAMEORIGIN"
        Content-Security-Policy "frame-ancestors 'self'"
    }
}

# Monitoring (Uptime Kuma, profil `monitoring` w docker-compose.yml, patrz deploy/monitoring/README.md).
# Ten sam wzorzec, co przy Jitsi: kontener `monitor` dołącza do sieci `edge` pod tą nazwą, a dopóki
# nie ma rekordu DNS `monitor.<domena>`, blok tylko czeka na certyfikat i nikomu nie przeszkadza.
# WebSocket (pulpit Kumy odświeża się przez socket.io) przechodzi przez reverse_proxy bez dodatków.
#
# Uwierzytelnienie jest po stronie Kumy (własne konto zakładane przy pierwszym wejściu) i musi tam
# zostać włączone – pulpit monitoringu wystawiony anonimowo jest mapą tego, co i gdzie w tym
# serwisie stoi, razem z historią, kiedy co nie działało.
monitor.{$SITE_DOMAIN} {
    encode gzip zstd
    reverse_proxy monitor:3001 {
        header_up X-Forwarded-Proto {scheme}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        # Pulpit monitoringu nie ma po co wisieć w cudzej ramce ani wyciekać ścieżek w Refererze.
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
    }
}
