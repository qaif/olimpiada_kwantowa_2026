{
    # API administracyjne wyłącznie z wnętrza kontenera (healthcheck woła 127.0.0.1:2019).
    admin localhost:2019
    email {$ACME_EMAIL}
}

# Przekierowanie www -> domena główna (jeden kanoniczny adres, jeden certyfikat w linkach).
www.{$SITE_DOMAIN} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
    encode gzip zstd
    request_body {
        max_size {$MAX_UPLOAD_MB}MB
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto {scheme}
            # Adres klienta dla audytu; backend ufa temu nagłówkowi tylko, gdy REMOTE_ADDR jest adresem proxy.
            header_up X-Real-IP {remote_host}
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }
}

# Publiczny endpoint S3 dla presigned URL (podpis SigV4 obejmuje host, więc osobny adres, nie podścieżka).
# S3_PUBLIC_ADDRESS: `s3.<domena>` (rekord DNS A) albo `<domena>:9000` (ten sam certyfikat, osobny port),
# spójne z S3_PUBLIC_ENDPOINT_URL w .env. Bucket `submissions` jest prywatny: bez podpisu MinIO odpowiada 403.
{$S3_PUBLIC_ADDRESS} {
    request_body {
        max_size {$MAX_UPLOAD_MB}MB
    }
    reverse_proxy minio:9000
}

# Własne Jitsi Meet (rozmowy kwalifikacyjne): osobny projekt compose (deploy/jitsi, scripts/deploy_jitsi.sh);
# kontener `jitsi-web` dołącza do sieci `edge` pod tą nazwą. WebSocket (XMPP) przechodzi przez reverse_proxy
# bez dodatkowej konfiguracji. Dopóki nie ma rekordu DNS `meet.<domena>`, ten blok tylko czeka na certyfikat.
meet.{$SITE_DOMAIN} {
    encode gzip zstd
    reverse_proxy jitsi-web:80 {
        header_up X-Forwarded-Proto {scheme}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
    }
}

# Monitoring (Uptime Kuma, profil `monitoring` w docker-compose.yml, patrz deploy/monitoring/README.md).
# Ten sam wzorzec, co przy Jitsi: kontener `monitor` dołącza do sieci `edge` pod tą nazwą, a dopóki
# nie ma rekordu DNS `monitor.<domena>`, blok tylko czeka na certyfikat i nikomu nie przeszkadza.
# WebSocket (pulpit Kumy odświeża się przez socket.io) przechodzi przez reverse_proxy bez dodatków.
#
# Uwierzytelnienie jest po stronie Kumy (własne konto zakładane przy pierwszym wejściu) i musi tam
# zostać włączone – pulpit monitoringu wystawiony anonimowo jest mapą tego, co i gdzie w tym
# serwisie stoi, razem z historią, kiedy co nie działało.
monitor.{$SITE_DOMAIN} {
    encode gzip zstd
    reverse_proxy monitor:3001 {
        header_up X-Forwarded-Proto {scheme}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        # Pulpit monitoringu nie ma po co wisieć w cudzej ramce ani wyciekać ścieżek w Refererze.
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
    }
}
