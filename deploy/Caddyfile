{
    # API administracyjne wyłącznie z wnętrza kontenera (healthcheck woła 127.0.0.1:2019).
    admin localhost:2019
    email {$ACME_EMAIL}
}

# Strona „Prace techniczne” (docs/OPERACJE.md § 20) – fragment wstawiany (`import maintenance`) do
# każdego bloku **aplikacji**: domena główna, domeny z EXTRA_DOMAINS i blok `*.` subdomen platformy
# (scripts/render_caddyfile.sh). Celowo NIE do `meet.` (Jitsi), `monitor.` (monitoring ma działać
# właśnie wtedy) ani do bloku S3 (`{$S3_PUBLIC_ADDRESS}`) – wgrywanie przerwane przez awarię ma się
# skończyć zwykłym błędem, a nie stroną HTML, której klient S3 nie zrozumie.
#
# Stronę podaje Caddy, nie Django: działa, gdy `web` albo baza leżą. Katalog /srv/maintenance to
# <REMOTE_DIR>/maintenance/ na hoście (docker-compose.yml) – poza plikami z repozytorium, bo krok 2/8
# scripts/deploy.sh kasuje i rozpakowuje kod od nowa, a kontener widziałby wtedy pusty, skasowany
# katalog aż do restartu proxy. Treść strony kopiuje tam `scripts/maintenance.sh sync` (woła go też
# deploy.sh, krok 4/8) z deploy/maintenance/.
#
# Dwa tryby, ta sama strona (503, Retry-After, no-store; JSON dla /status.json, /healthz/, /api/*):
# 1. planowy – istnieje plik /srv/maintenance/on (`scripts/maintenance.sh on|off`). Matcher `file`
#    sprawdza plik przy każdym żądaniu, więc przełączenie nie wymaga przeładowania Caddy'ego.
#    Wyjątki: wyzwanie ACME i operator z tokenem MAINTENANCE_BYPASS_TOKEN (z .env) w nagłówku
#    `X-Maintenance-Bypass` albo w ciasteczku `olimpiada_maintenance_bypass` – ustawia je wejście na
#    /__maintenance/bypass?token=<token>. Token krótszy niż 32 znaki (albo pusty) nie przepuszcza
#    nikogo, więc brak wpisu w .env nie otwiera furtki. Kolejność `handle` (sprawdzona
#    `caddy adapt`): logowanie tokenem, potem przerwa, dopiero potem /static/* i aplikacja – przerwa
#    zasłania więc też pliki statyczne, a strona i tak nie wczytuje niczego z zewnątrz.
# 2. nieplanowy – `web` nie odpowiada (restart przy wdrożeniu, awaria): reverse_proxy zwraca błąd
#    502/504 (albo 503), a `handle_errors` podaje tę samą stronę zamiast pustego 502. Odpowiedzi,
#    które aplikacja wysłała sama (także jej 500/503), przechodzą bez zmian – `handle_errors` widzi
#    wyłącznie błędy Caddy'ego.
(maintenance) {
    @maintenance_bypass_login {
        path /__maintenance/bypass
        expression `"{$MAINTENANCE_BYPASS_TOKEN}".size() >= 32 && {http.request.uri.query.token} == "{$MAINTENANCE_BYPASS_TOKEN}"`
    }
    handle @maintenance_bypass_login {
        header Set-Cookie "olimpiada_maintenance_bypass={$MAINTENANCE_BYPASS_TOKEN}; Path=/; Max-Age=43200; Secure; HttpOnly; SameSite=Lax"
        header Cache-Control "no-store"
        redir * / 303
    }
    @maintenance {
        file {
            root /srv/maintenance
            try_files /on
        }
        not path /.well-known/acme-challenge/*
        not expression `"{$MAINTENANCE_BYPASS_TOKEN}".size() >= 32 && ({http.request.header.X-Maintenance-Bypass} == "{$MAINTENANCE_BYPASS_TOKEN}" || {http.request.cookie.olimpiada_maintenance_bypass} == "{$MAINTENANCE_BYPASS_TOKEN}")`
    }
    handle @maintenance {
        error 503
    }
    # `handle_errors` bez listy kodów i własny matcher kodu: w Caddym 2.8 (`handle_errors 502 503
    # 504`) lista kodów NADPISUJE matchery zagnieżdżonych `handle` (sprawdzone `caddy adapt` na
    # 2.8.4 – wariant JSON łapał wtedy każde żądanie). Błędy o innych kodach (np. 404 z /static/)
    # nie pasują do niczego tutaj i kończą się tak, jak przed tą zmianą: sam kod, pusta treść.
    handle_errors {
        @maintenance_error expression `{http.error.status_code} in [502, 503, 504]`
        handle @maintenance_error {
            # Nagłówki bezpieczeństwa powtórzone: odpowiedź błędu nie przechodzi przez `header`
            # bloku. CSP tylko dla tej strony – bez skryptów i zasobów z zewnątrz (meta refresh).
            header {
                Cache-Control "no-store"
                Retry-After "60"
                Strict-Transport-Security "max-age=31536000"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "same-origin"
                X-Frame-Options "DENY"
                Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
            }
            @maintenance_json path /status.json /healthz /healthz/* /api/*
            handle @maintenance_json {
                header Content-Type "application/json"
                respond `{"status":"maintenance","retry_after":60}` 503
            }
            # Katalog strony jeszcze nie skopiowany (serwer przed pierwszym `maintenance.sh sync`):
            # zwykły tekst zamiast 404 z pustą treścią.
            @maintenance_no_page not file {
                root /srv/maintenance/page
                try_files /index.html
            }
            handle @maintenance_no_page {
                header Content-Type "text/plain; charset=utf-8"
                respond "Prace techniczne – serwis wróci za kilka minut. Maintenance – back in a few minutes. contact@qaif.org" 503
            }
            handle {
                root * /srv/maintenance/page
                rewrite * /index.html
                # Wstawka komunikatu operatora (plik info.html, który pisze scripts/maintenance.sh,
                # z treścią zamienioną na encje – także klamry, więc nie da się nią wywołać szablonu).
                templates {
                    root /srv/maintenance
                }
                file_server {
                    status 503
                }
            }
        }
    }
}

# Przekierowanie www -> domena główna (jeden kanoniczny adres, jeden certyfikat w linkach).
www.{$SITE_DOMAIN} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
    import maintenance
    encode gzip zstd
    request_body {
        max_size {$MAX_UPLOAD_MB}MB
    }
    handle_path /static/* {
        # Rok + `immutable`: WhiteNoise (`CompressedManifestStaticFilesStorage`, DEBUG=0 –
        # config/settings/base.py) daje każdemu plikowi w szablonach (`{% static %}`) nazwę
        # z odciskiem treści w nazwie (`app.<hash>.css`) – zmiana treści to zawsze **nowy** adres,
        # więc stary URL bezpiecznie leży w pamięci przeglądarki, dopóki istnieje. Szablony nie
        # odwołują się do `/static/...` z pominięciem `{% static %}` (sprawdzone grepem po
        # `backend/apps` – jedyne trafienia to testy, nie kod serwowany produkcyjnie), więc cała
        # ścieżka może dostać ten sam, długi nagłówek bez ryzyka przytrzymania nieaktualnej wersji
        # pliku pod niezmienną nazwą.
        header Cache-Control "public, max-age=31536000, immutable"
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto {scheme}
            # Adres klienta dla audytu; backend ufa temu nagłówkowi tylko, gdy REMOTE_ADDR jest adresem proxy.
            header_up X-Real-IP {remote_host}
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }
}

# Publiczny endpoint S3 dla presigned URL (podpis SigV4 obejmuje host, więc osobny adres, nie podścieżka).
# S3_PUBLIC_ADDRESS: `s3.<domena>` (rekord DNS A) albo `<domena>:9000` (ten sam certyfikat, osobny port),
# spójne z S3_PUBLIC_ENDPOINT_URL w .env. Bucket `submissions` jest prywatny: bez podpisu MinIO odpowiada 403.
#
# Materiały z warsztatów (apps/workshop_materials): przeglądarka koordynatora wysyła tu film **częściami**
# po 16 MB (`PART_SIZE` w apps/workshop_materials/storage.py) na adresy podpisane przez serwer, więc limit
# niżej dotyczy jednej części, nie całego filmu – MAX_UPLOAD_MB musi zostać **powyżej** 16 (domyślnie 25).
# Oglądanie idzie tym samym adresem (GET z podpisem, przewijanie żądaniami `Range`), bez `encode`:
# film jest już skompresowany, a kompresja w locie psułaby odpowiedzi częściowe (206).
# Access logu Caddy nie włączamy (brak dyrektywy `log`) – adresy z podpisem nie lądują w żadnym pliku.
{$S3_PUBLIC_ADDRESS} {
    request_body {
        max_size {$MAX_UPLOAD_MB}MB
    }
    reverse_proxy minio:9000
}

# Własne Jitsi Meet (rozmowy kwalifikacyjne): osobny projekt compose (deploy/jitsi, scripts/deploy_jitsi.sh);
# kontener `jitsi-web` dołącza do sieci `edge` pod tą nazwą. WebSocket (XMPP) przechodzi przez reverse_proxy
# bez dodatkowej konfiguracji. Dopóki nie ma rekordu DNS `meet.<domena>`, ten blok tylko czeka na certyfikat.
meet.{$SITE_DOMAIN} {
    encode gzip zstd
    reverse_proxy jitsi-web:80 {
        header_up X-Forwarded-Proto {scheme}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
    }
}

# Monitoring (Uptime Kuma, profil `monitoring` w docker-compose.yml, patrz deploy/monitoring/README.md).
# Ten sam wzorzec, co przy Jitsi: kontener `monitor` dołącza do sieci `edge` pod tą nazwą, a dopóki
# nie ma rekordu DNS `monitor.<domena>`, blok tylko czeka na certyfikat i nikomu nie przeszkadza.
# WebSocket (pulpit Kumy odświeża się przez socket.io) przechodzi przez reverse_proxy bez dodatków.
#
# Uwierzytelnienie jest po stronie Kumy (własne konto zakładane przy pierwszym wejściu) i musi tam
# zostać włączone – pulpit monitoringu wystawiony anonimowo jest mapą tego, co i gdzie w tym
# serwisie stoi, razem z historią, kiedy co nie działało.
monitor.{$SITE_DOMAIN} {
    encode gzip zstd
    reverse_proxy monitor:3001 {
        header_up X-Forwarded-Proto {scheme}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        # Pulpit monitoringu nie ma po co wisieć w cudzej ramce ani wyciekać ścieżek w Refererze.
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
    }
}
