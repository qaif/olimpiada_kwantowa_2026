# Skopiuj do .env i uzupełnij. Nigdy nie commituj .env.
# Każde `change-me…` niżej MUSI zostać podmienione: config/settings/production.py odmawia startu
# z którymkolwiek z nich w haśle bazy, MINIO_ROOT_PASSWORD albo sekretach kont S3 (tak jak z krótkim
# DJANGO_SECRET_KEY). Na serwerze wartości generuje scripts/deploy.sh.
APP_VERSION=dev
# Gotowy obraz aplikacji z rejestru zamiast budowanego na miejscu (README § 3, „Świeża instalacja
# z gotowego obrazu”). Pusto/brak = obraz `olimpiada/web:$APP_VERSION` budowany lokalnie albo na
# serwerze przez scripts/deploy.sh – i to jest droga domyślna. Obrazy publikuje CI z gałęzi `main`
# i ze znaczników `v*` (.github/workflows/ci.yml, zadanie `image`):
#   WEB_IMAGE=ghcr.io/qaif/olimpiada-web:v0.24.0
# Jedna wartość obsługuje `web`, `worker` i `beat`: to ten sam obraz z trzema poleceniami.
# Po zmianie: docker compose pull web && docker compose up -d web worker beat
# WEB_IMAGE=
SITE_DOMAIN=localhost
# E-mail do Let's Encrypt (Caddy) i publiczny adres S3 dla Caddy: s3.<domena> (rekord DNS A) albo <domena>:9000
ACME_EMAIL=
S3_PUBLIC_ADDRESS=s3.localhost
MAX_UPLOAD_MB=25

DJANGO_SECRET_KEY=change-me-to-50-random-chars
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
# Domeny kolejnych konkursów platformy, rozdzielone SPACJAMI (nie przecinkami – to lista dla
# Caddy'ego, a tam rozdzielaczem jest spacja). Pusto = instalacja jednokonkursowa i konfiguracja
# proxy bajt w bajt taka, jak deploy/Caddyfile.
#
# Jedna zmienna zamiast trzech wpisów, bo dołożenie domeny musi zadziałać w trzech miejscach naraz
# i każde milczy inaczej: brak w Caddym = „no such site” i brak certyfikatu, brak
# w DJANGO_ALLOWED_HOSTS = 400 na każde żądanie, brak w DJANGO_CSRF_TRUSTED_ORIGINS = odmowa na
# każdym formularzu. Django dokłada te hosty do obu list samo (config/settings/base.py), Caddy
# dostaje je przez scripts/render_caddyfile.sh, a rozjazd z bazą wykrywa `manage.py check_domains`.
#
# Po każdej zmianie tej linijki: bash scripts/proxy_config.sh update && docker compose up -d web
# (scripts/deploy.sh robi jedno i drugie sam; proxy przeładowuje konfigurację bez restartu). Wpisanie obok siebie „x.pl www.x.pl” daje jeden
# adres kanoniczny: www dostaje przekierowanie 301, tak jak www.<SITE_DOMAIN>.
EXTRA_DOMAINS=
# Konkursy w subdomenach platformy: koordynator zakłada kolejny konkurs z panelu, a ten dostaje
# adres <slug>.<SITE_DOMAIN> — bez wdrożenia i bez wpisu w tym pliku (docs/OPERACJE.md § 6.5).
# Wymaga rekordu DNS *.<SITE_DOMAIN> wskazującego ten serwer; certyfikat powstaje przy pierwszym
# wejściu na adres, a zgody na wystawienie udziela aplikacja (/internal/tls-allowed), więc limit
# Let's Encrypt (50 certyfikatów na domenę tygodniowo) zużywają wyłącznie istniejące konkursy.
# Razem z tym przełącznikiem musi działać CADDY_CONFIG_DIR niżej (scripts/deploy.sh ustawia je sam):
# bez niego proxy montuje plik źródłowy i bloku subdomen po prostu nie widzi.
# PLATFORM_SUBDOMAINS=1
# Katalog z plikiem `Caddyfile` montowany do proxy jako /etc/caddy. Domyślnie deploy/ (plik
# źródłowy); serwer ma tu katalog stanu ./caddy z plikiem składanym przez scripts/proxy_config.sh
# (deploy/Caddyfile + EXTRA_DOMAINS i przełączniki niżej). Katalog, a nie plik: nową konfigurację
# proxy ładuje `caddy reload`, bez restartu kontenera (docs/OPERACJE.md § 23).
# CADDY_CONFIG_DIR=./caddy
# Strona „Prace techniczne” (docs/OPERACJE.md § 20, scripts/maintenance.sh on|off|status).
# Przepustka operatora przez stronę w czasie przerwy: nagłówek `X-Maintenance-Bypass: <token>`
# albo ciasteczko ustawiane wejściem na https://<domena>/__maintenance/bypass?token=<token>.
# Min. 32 znaki [A-Za-z0-9]; pusty = nikt nie przechodzi. scripts/deploy.sh generuje go sam
# (krok 4/8); po ręcznej zmianie: docker compose up -d proxy.
MAINTENANCE_BYPASS_TOKEN=
# Katalog stanu strony (flaga `on`, komunikat, kopia strony) – domyślnie ./maintenance.
# MAINTENANCE_DIR=./maintenance
# Domyślnie = not DJANGO_DEBUG (prod: 1). Odkomentuj tylko w devie bez TLS.
# SESSION_COOKIE_SECURE=0
# CSRF_COOKIE_SECURE=0
# `web` to WSGI + worker `gthread`: concurrency procesu = WEB_WORKERS × WEB_THREADS (docker-compose.yml,
# backend/Dockerfile). Budżet połączeń Postgresa (`max_connections=100`): przy domyślnych 4×4 to
# WEB_WORKERS × DB_POOL_MAX_SIZE = 16 połączeń z `web` + CELERY_CONCURRENCY (worker) + 1 (beat) ≈ 20
# ze 100 (docs/OPERACJE.md § 11.2). Podnoszenie ponad ok. 6×8 (48) zbliża się do granicy bez
# podniesienia max_connections.
WEB_WORKERS=4
WEB_THREADS=4
CELERY_CONCURRENCY=2
# Pula połączeń psycopg w `web` (config/dbpool.py). Jedna pula na worker gunicorna; domyślnie
# włączona w `web`, a wyłączona w `worker` i `beat` (compose ustawia im DB_POOL=0 – Celery prefork
# zamyka pulę przy każdym zadaniu). Przy włączonej puli DB_CONN_MAX_AGE jest ignorowane (Django
# wymaga wtedy CONN_MAX_AGE=0); działa tylko w procesach bez puli.
# DB_POOL=1
# Domyślnie = WEB_THREADS (wątek trzyma najwyżej jedno połączenie). Mniej = wątki czekają na połączenie.
# DB_POOL_MAX_SIZE=4
# Połączenia trzymane bez ruchu, na proces; nadwyżkę pula zamyka sama, jedno na 10 min bezczynności.
# DB_POOL_MIN_SIZE=1
# Sekundy czekania na wolne połączenie z puli, potem błąd 500 (liczony przez watchdog 5xx).
# DB_POOL_TIMEOUT=10
# Trwałość połączenia w procesach bez puli (worker, beat), w sekundach.
# DB_CONN_MAX_AGE=60
# Progi alarmu zajętości połączeń (procent max_connections): /healthz/ i /status.json pokazują
# `db_connections: ok|warn|critical`, watchdog pisze na ALERT_EMAILS, szczegóły:
# `docker compose exec web python manage.py db_connections`.
# DB_CONNECTIONS_WARN_PERCENT=80
# DB_CONNECTIONS_CRITICAL_PERCENT=95

POSTGRES_DB=olimpiada
POSTGRES_USER=olimpiada
POSTGRES_PASSWORD=change-me
# Wersja bazy: bez tych dwóch linijek – PostgreSQL 18 na wolumenie `pg18_data`. Przypięcie do 16
# (instalacja sprzed przejścia albo po wycofaniu) wpisuje i zdejmuje scripts/upgrade_postgres18.sh
# – ręcznie tylko przy wycofaniu bez skryptu (docs/OPERACJE.md § 19).
# POSTGRES_IMAGE=postgres:16-alpine
# POSTGRES_VOLUME=pg_data:/var/lib/postgresql/data

# Hasło Redisa (cache Django i broker Celery; docker-compose.yml – `requirepass` i adresy
# REDIS_URL/CELERY_BROKER_URL z `:hasło@`). WYŁĄCZNIE [A-Za-z0-9], co najmniej 16 znaków: wklejane do
# URL-a bez kodowania. Pusto = Redis bez hasła (zgodność z instalacjami sprzed 1.10.2026) – na serwerze
# scripts/deploy.sh generuje je sam, także do istniejącego .env. Ręcznie:
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
# Po zmianie: docker compose up -d redis web worker beat (wszystkie cztery naraz).
REDIS_PASSWORD=

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
S3_PRESIGNED_TTL_SECONDS=600
# Publiczny host MinIO widziany z przeglądarki (prod: https://s3.<SITE_DOMAIN> przez Caddy; dev: http://localhost:9000)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Materiały z warsztatów (flaga `workshop_materials`, docs/OPERACJE.md § 16): limit filmu i pliku w MB.
# Film idzie z przeglądarki prosto do MinIO częściami po 16 MB – MAX_UPLOAD_MB musi zostać > 16.
# WORKSHOP_VIDEO_MAX_MB=4096
# WORKSHOP_FILE_MAX_MB=100

# Poczta wychodząca. Bez niej nie działa reset hasła (jedyna droga odzyskania konta dla wszystkich ról).
# Trzy sensowne wartości (README § 4.1):
#   smtp://mailpit:1025   – dev: podgląd na http://localhost:8025/ (usługa z profilu `dev`),
#   smtp://mail:587       – produkcja, wariant A: własny Postfix z usługi `mail` (send-only relay
#                           + DKIM, port nieopublikowany, więc brak TLS/auth jest tu bez znaczenia;
#                           to wartość wpisywana przez scripts/deploy.sh),
#   smtp+tls://uzytkownik:haslo@smtp.dostawca.example:587 – wariant B: zewnętrzny dostawca
#                           (albo smtps:// dla portu 465); znaki @ i : w haśle kodować %40, %3A.
# Domyślnie (brak zmiennej) listy idą do logu.
EMAIL_URL=smtp://mailpit:1025
# Nadawca listów; ten sam adres trafia do SERVER_EMAIL. W produkcji adres w domenie z rekordami
# SPF, DKIM i DMARC (README § 4.2) – inaczej wiadomości lądują w spamie albo są odrzucane.
# Wariant A wymaga, żeby domena tego adresu = SITE_DOMAIN (ALLOWED_SENDER_DOMAINS usługi `mail`).
DEFAULT_FROM_EMAIL=olimpiada@localhost
# Limit sekund na połączenie SMTP. Wysyłka jest synchroniczna w żądaniu POST /password-reset/.
EMAIL_TIMEOUT=10
# Do jakiego rozmiaru (MB) rozwiązanie przekazywane na skrzynkę organizatora idzie w załączniku
# (ekran /coordinator/submission-forwarding/). Powyżej list wychodzi bez pliku, z odnośnikiem do
# panelu. Podnosząc tę wartość, podnieś też POSTFIX_message_size_limit w docker-compose.yml:
# base64 rozdyma załącznik o ~37 %, więc koperta jest o tyle większa niż plik.
SUBMISSION_FORWARD_MAX_ATTACHMENT_MB=20

# Adresy/podsieci, z których backend ufa nagłówkowi X-Real-IP (domyślnie sieci compose `edge`
# i `internal`). NIE dopisuj tu sieci `cache` (172.30.3.0/24, Redis) ani `clamav_egress`
# (172.30.4.0/24): proxy w nich nie stoi. Ta sama lista jest `mynetworks` Postfiksa.
TRUSTED_PROXY_IPS=172.30.1.0/24,172.30.2.0/24

# Konta serwisowe MinIO z dostępem tylko do własnego bucketu (tworzone przez minio-init):
# public-media (Wagtail) i submissions (prace uczestników + treści zadań). Backend używa ich zamiast MINIO_ROOT_*.
S3_PUBLIC_ACCESS_KEY=wagtail-media
S3_PUBLIC_SECRET_KEY=change-me-min-8-chars
S3_PRIVATE_ACCESS_KEY=app-private
S3_PRIVATE_SECRET_KEY=change-me-min-8-chars

# Logowanie przez Google i Facebooka (README § 4.4). Pusta wartość = dostawca wyłączony:
# nie ma go w konfiguracji allauth i nie pokazuje się przycisk na /login/ ani /register/.
# Oba klucze danego dostawcy muszą być ustawione – sam identyfikator bez sekretu nic nie włącza.
# Adresy powrotne do wpisania u dostawcy:
#   https://<SITE_DOMAIN>/accounts/google/login/callback/
#   https://<SITE_DOMAIN>/accounts/facebook/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Pieczęć elektroniczna dyplomów i zaświadczeń (README § „Dyplomy i zaświadczenia”). Pusta
# ścieżka = podpisywanie wyłączone i dokumenty wychodzą niepodpisane; to jest stan domyślny
# i poprawny — dokument potwierdza kod weryfikacyjny, a pieczęć dotyczy samego pliku PDF.
# Plik PKCS#12 (.p12/.pfx) z kluczem pieczęci montuje się do kontenera wolumenem i NIGDY nie
# trzyma w repozytorium. Ścieżka jest ścieżką **w kontenerze**.
CERT_SIGN_P12_PATH=
CERT_SIGN_P12_PASSWORD=
# Znacznik czasu (RFC 3161) od dostawcy zaufania. Bez niego podpis niesie czas z zegara serwera.
CERT_SIGN_TSA_URL=
# Powód i miejsce złożenia pieczęci – widoczne we właściwościach podpisu w czytniku PDF-ów.
CERT_SIGN_REASON=Dokument wystawiony przez Olimpiadę Kwantową
CERT_SIGN_LOCATION=

# --- Kopie zapasowe (docs/OPERACJE.md § 1) ----------------------------------------------------
# Hasło do symetrycznego szyfrowania paczek (gpg AES-256). Na produkcji generuje je
# scripts/deploy.sh przy pierwszym wdrożeniu i NIE wypisuje w logu.
# JEGO UTRATA = UTRATA WSZYSTKICH KOPII. Zapisz je w menedżerze haseł organizatora.
BACKUP_PASSPHRASE=
# Kubełek poza tym serwerem (dowolny zgodny z S3: Backblaze B2, Hetzner, inny region Contabo).
# Bez tych czterech wartości scripts/backup.sh robi WYŁĄCZNIE kopię lokalną w /opt/olimpiada-backups,
# czyli taką, która ginie razem z maszyną – i mówi o tym na stdout.
BACKUP_REMOTE_URL=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_BUCKET=
# Część dostawców wymaga regionu; PROVIDER trafia do rclone (np. B2, Other).
BACKUP_REMOTE_REGION=
BACKUP_REMOTE_PROVIDER=Other
# Zamiast kubełka S3: Dysk Google konta Fundacji (docs/OPERACJE.md § 1.6). Token NIE jest tutaj –
# wkleja go `scripts/backup.sh --drive-token` do secrets/rclone/rclone.conf (600), bo rclone musi
# móc zapisywać odświeżony token. Poniższe są opcjonalne.
# Wybór miejsca: s3 | drive | none. Pusto = automatycznie (s3, gdy jest BACKUP_REMOTE_URL;
# drive, gdy jest token Dysku). Ustaw jawnie, gdy skonfigurowane są oba warianty.
BACKUP_REMOTE_TYPE=
# Folder w „Mój dysk” (zakłada go rclone – przy zakresie drive.file folderu ręcznie zakładać nie wolno).
BACKUP_DRIVE_FOLDER=Olimpiada-kopie-zapasowe
# Własny klient OAuth z Google Cloud (typ „Wewnętrzny” w Workspace); pusto = klient rclone.
BACKUP_DRIVE_CLIENT_ID=
BACKUP_DRIVE_CLIENT_SECRET=
# Identyfikator dysku współdzielonego zamiast „Mój dysk”.
BACKUP_DRIVE_TEAM_DRIVE=
# false = retencja kasuje na stałe (kosz Dysku zajmowałby miejsce jeszcze 30 dni).
BACKUP_DRIVE_USE_TRASH=false
# Alternatywa dla --drive-token: token z `rclone authorize` wpisany tutaj, KONIECZNIE w apostrofach:
# BACKUP_DRIVE_TOKEN='{"access_token":"…","refresh_token":"…",…}'
# Retencja poza serwerem w dniach (S3 i Dysk): kopie dzienne / miesięczne.
REMOTE_DAILY_KEEP_DAYS=30
REMOTE_MONTHLY_KEEP_DAYS=365

# --- Alarmy (docs/OPERACJE.md § 3.2) ----------------------------------------------------------
# Adresy dyżurnych, na które watchdog wysyła alarmy (przecinkami). Pusta wartość = wysyłka
# wyłączona; instalacja deweloperska nikogo nie budzi. Każdy rodzaj alarmu ma godzinne wyciszenie.
ALERT_EMAILS=

# --- Logowanie dwuskładnikowe (docs/OPERACJE.md § 5) ------------------------------------------
# Wyłącznik główny całej funkcji. DOMYŚLNIE WYŁĄCZONY – decyzja organizatora („autoryzacja
# 2-etapowa wyłączona”). Wyłączony znaczy: ekrany /account/2fa/ i /login/2fa/ odpowiadają 404,
# w interfejsie nie ma ani jednego odnośnika, a konta z zapisanym urządzeniem logują się samym
# hasłem. Zapisanych urządzeń wyłącznik NIE kasuje – ponowne włączenie przywraca stan.
TWO_FACTOR_ENABLED=0
# Role, od których drugi składnik jest WYMAGANY (przecinkami, np. coordinator,reviewer,appeals).
# Znaczenie ma WYŁĄCZNIE przy TWO_FACTOR_ENABLED=1. Pusto = nikt nie musi, każdy może włączyć
# sobie sam na /account/2fa/. Włączenie tego, zanim komitet ma aplikacje uwierzytelniające,
# zamyka koordynatorowi drogę do własnego panelu.
TWO_FACTOR_REQUIRED_ROLES=

# --- Strona błędu serwera (templates/500.html) ------------------------------------------------
# Adres kontaktowy pokazywany na stronie 500. Ta strona renderuje się BEZ bazy (i to jest jej
# sens), więc adresu nie da się wziąć z konkursu – jest ustawieniem instalacji. Bez wpisu
# obowiązuje adres organizatora Olimpiady Kwantowej (contact@qaif.org), czyli stan sprzed
# etapu 2. Operator stawiający platformę dla własnego konkursu wpisuje tu swój adres.
# ERROR_PAGE_CONTACT_EMAIL=

# --- Przepustki do własnego Jitsi (JWT, v0.39.0; docs/OPERACJE.md § 25) ------------------------
# Sekret, którym portal podpisuje przepustki do pokoi na meet.<SITE_DOMAIN>. TEN SAM, co
# JWT_APP_SECRET w jitsi/.env – na serwerze generuje go i przepisuje scripts/deploy_jitsi.sh
# (64 znaki [A-Za-z0-9]; nie wpisuj ręcznie, chyba że przy rotacji). Pusty albo krótszy niż
# 32 znaki = funkcja wyłączona: linki do pokoi działają jak przed v0.39.0, a ekrany „Pokoje wideo”
# nie istnieją. Krótki-niepusty albo równy innemu sekretowi zgłasza `manage.py check`
# (competitions.W001).
JITSI_JWT_APP_SECRET=
# Identyfikator aplikacji (claim `iss`; w jitsi/.env: JWT_APP_ID i JWT_ACCEPTED_ISSUERS).
# JITSI_JWT_APP_ID=olimpiada
# Host własnego Jitsi – przepustki dostają wyłącznie pokoje pod tym adresem (domyślnie meet.<SITE_DOMAIN>).
# JITSI_JWT_HOST=meet.example.org
# Claim `aud` (JWT_ACCEPTED_AUDIENCES w jitsi/.env) i `sub` (XMPP_DOMAIN w jitsi/.env).
# JITSI_JWT_AUDIENCE=jitsi
# JITSI_JWT_SUBJECT=meet.jitsi
# Okna czasowe (minuty): wejście na rozmowę od LEAD przed początkiem do GRACE po końcu terminu;
# próba sprzętu; wejście z panelu do pokoju bez terminu; wejście linkiem-zaproszeniem.
# JITSI_JWT_LEAD_MINUTES=15
# JITSI_JWT_GRACE_MINUTES=60
# JITSI_JWT_PRECHECK_MINUTES=30
# JITSI_JWT_SESSION_MINUTES=180
# JITSI_JWT_GATEWAY_MINUTES=10
# Najdłuższa ważność pokoju bez terminu (dni; lista 1/7/30/60 przycinana tym limitem):
# koordynator i członek komisji z uprawnieniem (nigdy więcej niż limit koordynatora).
# JITSI_JWT_ROOM_MAX_DAYS=60
# JITSI_JWT_COMMITTEE_ROOM_MAX_DAYS=30

# --- Operatorzy płatności (PAY-01; docs/OPERACJE.md § 29) ---------------------------------------
# Puste = operator wyłączony (przycisk płatności się nie pokazuje, webhook odpowiada 404). Najpierw
# klucze TESTOWE (sk_test_…) – przełączenie na sk_live_… dopiero po próbnej płatności i zwrocie.
# Stripe: Developers → API keys (secret key) i Developers → Webhooks → endpoint
# https://<domena>/payments/webhooks/stripe/ (Signing secret whsec_…; kilka po przecinku przy rotacji).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Przelewy24 (tylko PLN): panel → Moje dane / Dane API (merchant, POS, klucz do raportów, CRC).
# P24_SANDBOX=true kieruje na sandbox.przelewy24.pl.
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=
P24_SANDBOX=false

# --- Serwis publiczny na django CMS (djcms; docs/tasks/DJ-01.md, docs/tasks/DJ-02.md) ---
# Wyłączony, dopóki nie uruchomisz profilu compose `djcms`. Token krótszy niż 32 znaki (albo pusty)
# wyłącza wewnętrzne API /internal/djcms/v2/ w głównej aplikacji.
#
# DJCMS_ENABLED – przełącznik produkcyjny (docs/OPERACJE.md § 22): 1 = scripts/render_caddyfile.sh
# dokłada blok dj.<SITE_DOMAIN> i odmowę /internal/* na nazwach publicznych, a scripts/deploy.sh
# generuje brakujące sekrety niżej, zakłada bazę (scripts/djcms_db.sh), buduje i startuje `djcms`.
# 0 albo pusto = nic z tego (konfiguracja proxy i wdrożenie jak przed DJ-01). Inna wartość = błąd.
# Lokalnie (docker-compose.dev.yml, http://localhost:8100) przełącznik nie jest potrzebny.
DJCMS_ENABLED=0
# DJCMS_PRIMARY – kto podaje strony publiczne wszystkich konkursów (docs/OPERACJE.md § 22.8):
# 0 = Wagtail (web; podgląd djcms ciasteczkiem djcms_view=dj z /djcms/preview/), 1 = django CMS.
# Adresy aplikacji (logowanie, panele, /cms/, /api/…) zawsze obsługuje web. Przełącza wyłącznie
# `bash scripts/djcms_switch.sh on|off` (render Caddyfile'a + caddy reload, bez restartu usług);
# 1 bez DJCMS_ENABLED=1 = błąd generatora konfiguracji proxy.
DJCMS_PRIMARY=0
# Stały adres kontenera proxy w sieci `internal` (nakładka docker-compose.djcms.yml) – jedyne proxy,
# któremu djcms ufa (X-Real-IP, X-Djcms-Mode). Zmiana tylko, gdy koliduje z czymś w 172.30.2.0/24.
# DJCMS_PROXY_IP=172.30.2.250
# Gunicorn djcms (serwis publiczny wszystkich konkursów): workery × wątki; połączenia z bazą ≤ iloczyn.
DJCMS_WORKERS=3
DJCMS_THREADS=4
# Sekrety – na serwerze generuje je deploy.sh przy DJCMS_ENABLED=1 (istniejących nie rusza).
# Ręcznie: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48   (token: co najmniej 32 znaki; klucz: 64;
# hasło bazy: co najmniej 16, wyłącznie [A-Za-z0-9_-] – trafia do DATABASE_URL).
DJCMS_INTERNAL_TOKEN=
DJCMS_SECRET_KEY=
DJCMS_DB_PASSWORD=
# Klucz tokenu SSO redaktorów z /cms/ do djcms (DJ-02 D6): ≥ 32 znaki, inny niż pozostałe sekrety.
# Ten sam wpis czytają web (.env) i djcms (compose przekazuje go jawnie). Pusty = przejście
# „Edytuj w django CMS” wyłączone.
DJCMS_SSO_KEY=
# Opcjonalnie: najdłuższa sesja redaktora w djcms po SSO, w sekundach od logowania (domyślnie
# 7200 = 2 h). Po niej redaktor wraca przez /cms/, a uprawnienia liczą się od nowa. Wylogowanie
# z aplikacji głównej kończy ją od razu.
# DJCMS_SSO_SESSION_SECONDS=7200
# Publiczny adres aplikacji głównej dla konkursu domeny głównej – czyta go web (adresy w API dla
# djcms i w paczce eksportu); pozostałe konkursy dostają adres ze swojej domeny albo prefiksu.
DJCMS_MAIN_PUBLIC_URL=http://localhost:8000
# Tylko lokalnie: dodatkowy certyfikat CA dla budowania obrazu djcms (np. antywirus przechwytujący
# TLS). Przekazywany jako sekret BuildKit – nie trafia do obrazu.
EXTRA_CA_FILE=
