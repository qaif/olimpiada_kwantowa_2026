# Wygenerowane przez `manage.py djcms_routes --write` – nie edytuj ręcznie.
# Źródło: urlconf aplikacji `web` (apps/core/app_routes.py, docs/tasks/DJ-02.md § 6).
# Format: poprawny fragment POSIX sh – `. ./app_routes.env` – jedna zmienna w linii,
# wartość w apostrofach, bez apostrofów, odstępów i klamer w środku (bezpieczne
# wklejenie do matchera `path_regexp` Caddyfile'a). Wyrażenia dopasowują całą ścieżkę;
# składnia RE2/PCRE (`(?:…)`), nie POSIX ERE – w testach powłoki `grep -P`, nie `grep -E`.
APP_RE='^/(?:_theme|_util|account|accounts|activate|admin|api|appeals|captcha|cms|coordinator|delegation|documents|dyplomy|forum|healthz|i18n|integrations|internal|konto|login|logout|me|opiekun|password-reset|payments|plakaty|proctoring|register|rejestracja|reset|results|review|setup|status|statystyki|supervisor|support|translations|warsztaty/materialy|webinars|zaproszenie|zgoda)(?:/.*)?$|^/[^/]+\.html$|^/status\.json$'
APP_RE_PREFIXED='^/[^/]+/(?:_theme|_util|account|accounts|activate|admin|api|appeals|captcha|cms|coordinator|delegation|documents|dyplomy|forum|healthz|i18n|integrations|internal|konto|login|logout|me|opiekun|password-reset|payments|plakaty|proctoring|register|rejestracja|reset|results|review|setup|status|statystyki|supervisor|support|translations|warsztaty/materialy|webinars|zaproszenie|zgoda)(?:/.*)?$|^/[^/]+/[^/]+\.html$|^/[^/]+/status\.json$'
