msgid "Faktura"
msgstr "发票"

msgid "Faktura pro forma"
msgstr "形式发票"

msgid "Data sprzedaży"
msgstr "销售日期"

msgid "Zapłacono"
msgstr "已付款"

msgid "Kod referencyjny"
msgstr "参考代码"

msgid "NIP / VAT ID"
msgstr "税号 / 增值税号"

msgid "Sprzedawca"
msgstr "卖方"

msgid "Nabywca"
msgstr "买方"

msgid "Pozycja"
msgstr "项目"

