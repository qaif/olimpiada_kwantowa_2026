msgstr "البنك"

msgid "Tytuł przelewu"
msgstr "مرجع التحويل"

msgid "Dane do przelewu"
msgstr "بيانات التحويل المصرفي"

msgid "Faktura pro forma nie jest dokumentem księgowym. Fakturę wystawimy po zaksięgowaniu wpłaty."
msgstr "الفاتورة المبدئية ليست مستندًا محاسبيًا. سنصدر الفاتورة بعد استلام الدفعة."

msgid "Nazwa instytucji albo imię i nazwisko"
msgstr "اسم المؤسسة أو الاسم الكامل"

msgid "Adres"
msgstr "العنوان"

msgid "Opcjonalnie – jeśli instytucja ma numer podatkowy, który ma znaleźć się na fakturze."
msgstr "اختياري – إذا كان للمؤسسة رقم ضريبي يجب أن يظهر في الفاتورة."

msgid "E-mail do rozliczeń"
msgstr "البريد الإلكتروني للفوترة"

msgid "Liczba obserwatorów"
msgstr "عدد المراقبين"

msgid "Osoby towarzyszące drużynie bez roli opiekuna – płatne według cennika."
msgstr "الأشخاص المرافقون للفريق دون أن يكونوا قادة له – تُحتسب رسومهم وفق قائمة الأسعار."

msgid "Opłata za delegację"
msgstr "رسوم الوفد"

msgid "Uczeń"
msgstr "طالب"

msgid "Opiekun drużyny"
msgstr "قائد الفريق"

msgid "Obserwator"
msgstr "مراقب"

