msgid "Faktura"
msgstr "चालान"

msgid "Faktura pro forma"
msgstr "प्रोफ़ॉर्मा चालान"

msgid "Data sprzedaży"
msgstr "बिक्री की तारीख"

msgid "Zapłacono"
msgstr "भुगतान किया गया"

msgid "Kod referencyjny"
msgstr "संदर्भ कोड"

msgid "NIP / VAT ID"
msgstr "कर / VAT आईडी"

