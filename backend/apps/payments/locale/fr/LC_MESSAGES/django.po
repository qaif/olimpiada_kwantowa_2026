msgid "Faktura pro forma nie jest dokumentem księgowym. Fakturę wystawimy po zaksięgowaniu wpłaty."
msgstr "La facture pro forma n'est pas un document comptable. Nous émettrons la facture dès réception du paiement."

msgid "Nazwa instytucji albo imię i nazwisko"
msgstr "Nom de l'institution ou nom complet"

msgid "Adres"
msgstr "Adresse"

msgid "Opcjonalnie – jeśli instytucja ma numer podatkowy, który ma znaleźć się na fakturze."
msgstr "Facultatif – si l'institution dispose d'un numéro fiscal à faire figurer sur la facture."

msgid "E-mail do rozliczeń"
msgstr "E-mail de facturation"

msgid "Liczba obserwatorów"
msgstr "Nombre d'observateurs"

msgid "Osoby towarzyszące drużynie bez roli opiekuna – płatne według cennika."
msgstr "Personnes accompagnant l'équipe sans être chefs d'équipe – facturées selon la grille tarifaire."

msgid "Opłata za delegację"
msgstr "Frais de délégation"

msgid "Uczeń"
msgstr "Élève"

msgid "Opiekun drużyny"
msgstr "Chef d'équipe"

msgid "Obserwator"
msgstr "Observateur"

msgid "Opłata za udział"
msgstr "Frais de participation"

msgid "Zniżka"
msgstr "Remise"

msgid "cena wczesna"
msgstr "tarif anticipé"

msgid "cena podstawowa"
msgstr "tarif normal"

msgid "cena późna"
msgstr "tarif tardif"

