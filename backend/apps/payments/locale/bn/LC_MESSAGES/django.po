msgid "Najpierw uzupełnij dane do faktury."
msgstr "অনুগ্রহ করে প্রথমে বিলিংয়ের তথ্য পূরণ করুন।"

msgid "Organizator nie opublikował jeszcze cennika."
msgstr "আয়োজক এখনও মূল্য তালিকা প্রকাশ করেননি।"

msgid "Delegacja jest zwolniona z opłat."
msgstr "প্রতিনিধিদল ফি থেকে অব্যাহতিপ্রাপ্ত।"

msgid "Nie ma nic nowego do zapłaty."
msgstr "নতুন করে পরিশোধের কিছু নেই।"

msgid "Ta opłata jest już rozliczona."
msgstr "এই ফি ইতিমধ্যে নিষ্পত্তি হয়েছে।"

msgid "Nie ma nic do zapłaty."
msgstr "পরিশোধের কিছু নেই।"

msgid "Płatność tego zamówienia jest właśnie przetwarzana. Spróbuj ponownie za kilka minut."
msgstr "এই অর্ডারের অর্থপ্রদান এখন প্রক্রিয়াধীন। কয়েক মিনিট পরে আবার চেষ্টা করুন।"

#, python-format
msgid "Płatność Przelewy24 tego zamówienia jest w toku. Spróbuj ponownie za %(minutes)s minut."
msgstr "এই অর্ডারের Przelewy24 অর্থপ্রদান চলছে। %(minutes)s মিনিট পরে আবার চেষ্টা করুন।"

msgid "Anulować można wyłącznie zamówienie czekające na wpłatę."
msgstr "শুধু অর্থপ্রদানের অপেক্ষায় থাকা অর্ডার বাতিল করা যায়।"

msgid "To zamówienie nie czeka na wpłatę."
msgstr "এই অর্ডারটি অর্থপ্রদানের অপেক্ষায় নেই।"

msgid "Ta metoda płatności nie jest dostępna."
msgstr "এই অর্থপ্রদান পদ্ধতি উপলব্ধ নয়।"

msgid "Dostawca płatności jest chwilowo niedostępny. Spróbuj ponownie za chwilę."
msgstr "পেমেন্ট প্রদানকারী সাময়িকভাবে অনুপলব্ধ। একটু পরে আবার চেষ্টা করুন।"

msgid "Opłaty"
msgstr "ফি"

