msgstr "Factura proforma"

msgid "Data sprzedaży"
msgstr "Fecha de venta"

msgid "Zapłacono"
msgstr "Pagado"

msgid "Kod referencyjny"
msgstr "Código de referencia"

msgid "NIP / VAT ID"
msgstr "NIF / número de IVA"

msgid "Sprzedawca"
msgstr "Vendedor"

msgid "Nabywca"
msgstr "Comprador"

