msgid "Faktura"
msgstr "Fatura"

msgid "Faktura pro forma"
msgstr "Fatura pró-forma"

msgid "Data sprzedaży"
msgstr "Data da venda"

msgid "Zapłacono"
msgstr "Pago"

msgid "Kod referencyjny"
msgstr "Código de referência"

msgid "NIP / VAT ID"
msgstr "NIF / número de IVA"

msgid "Sprzedawca"
msgstr "Vendedor"

msgid "Nabywca"
msgstr "Comprador"

msgid "Pozycja"
msgstr "Item"

msgid "Ilość"
msgstr "Quantidade"

