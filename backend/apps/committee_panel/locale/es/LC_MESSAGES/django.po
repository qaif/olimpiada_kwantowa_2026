msgid "Ocenianie"
msgstr "Evaluación"

msgid "Komisja odwoławcza"
msgstr "Comisión de apelaciones"

msgid "Spotkania"
msgstr "Reuniones"

msgid "Wiadomości i materiały"
msgstr "Mensajes y materiales"

msgid "Do oceny"
msgstr "Por evaluar"

msgid "Ocenione"
msgstr "Evaluadas"

msgid "Druga ocena (runda rozjemcza)"
msgstr "Segunda evaluación (ronda de desempate)"

msgid "Materiały dla komisji"
msgstr "Materiales para la comisión"

msgid "Reklamacje do rozpatrzenia"
msgstr "Reclamaciones por resolver"

msgid "Rozmowy i pokoje komisji"
msgstr "Entrevistas y salas de la comisión"

msgid "Moje pokoje wideo"
msgstr "Mis salas de vídeo"

msgid "Nawigacja panelu komisji"
msgstr "Navegación del panel de la comisión"

msgid "Menu komisji"
msgstr "Menú de la comisión"

msgid "czeka"
msgstr "pendientes"

msgid "Panel komisji"
msgstr "Panel de la comisión"

msgid "Prace do oceny, terminy i materiały komisji w jednym miejscu. Ocenianie jest anonimowe: prace są oznaczone wyłącznie kodem publicznym."
msgstr "Trabajos por evaluar, plazos y materiales de la comisión en un solo lugar. La evaluación es anónima: los trabajos se identifican solo por su código público."

msgid "Reklamacje do rozpatrzenia, terminy i spotkania komisji w jednym miejscu."
msgstr "Reclamaciones por resolver, plazos y reuniones de la comisión en un solo lugar."

msgid "do oceny (nowe i w toku)"
msgstr "por evaluar (nuevas y en curso)"

msgid "Przejdź do oceniania"
msgstr "Ir a evaluar"

msgid "Postęp oceniania"
msgstr "Progreso de la evaluación"

msgid "Druga ocena"
msgstr "Segunda evaluación"

msgid "do oceny w rundzie rozjemczej"
msgstr "por evaluar en la ronda de desempate"

msgid "Oceny rundy 1 się rozjechały – rozstrzygasz spór o pracę, nie między osobami."
msgstr "Las notas de la ronda 1 discrepan: resuelves una disputa sobre el trabajo, no entre personas."

msgid "Pokaż prace rundy 2"
msgstr "Mostrar trabajos de la ronda 2"

msgid "w kolejce komisji odwoławczej"
msgstr "en la cola de la comisión de apelaciones"

msgid "Kolejka pomija sprawy, w których jesteś w konflikcie interesów."
msgstr "La cola omite los casos en los que tienes un conflicto de intereses."

msgid "Otwórz kolejkę"
msgstr "Abrir la cola"

msgid "Najbliższe terminy"
msgstr "Próximos plazos"

msgid "Nic nie czeka na termin."
msgstr "No hay nada pendiente con plazo."

msgid "Twoja rola"
msgstr "Tu función"

msgid "Recenzent (komitet oceniający)"
msgstr "Evaluador (comité de evaluación)"

msgid "Członek komisji odwoławczej"
msgstr "Miembro de la comisión de apelaciones"

msgid "Nie dostajesz prac uczestników ze swojego województwa ani regionu (konflikt interesów)."
msgstr "No recibes trabajos de participantes de tu provincia ni de tu región (conflicto de intereses)."

msgid "Prace do oceny według etapów"
msgstr "Trabajos por evaluar por etapa"

msgid "Koniec oceniania etapu"
msgstr "Fin de la evaluación de la etapa"

msgid "Czynność"
msgstr "Acción"

msgid "Oceniaj"
msgstr "Evaluar"

msgid "Spotkania komisji"
msgstr "Reuniones de la comisión"

msgid "Rozmowy kwalifikacyjne"
msgstr "Entrevistas de clasificación"

msgid "Zapisanych"
msgstr "Inscritos"

msgid "Wejście"
msgstr "Acceso"

msgid "Dołącz jako gospodarz"
msgstr "Unirse como anfitrión"

msgid "Adres pokoju podaje koordynator."
msgstr "La dirección de la sala la facilita el coordinador."

#, python-format
msgid "%(done)s z %(total)s ocenionych"
msgstr "%(done)s de %(total)s evaluadas"

#, python-format
msgid "Termin Twoich ocen · %(stage)s"
msgstr "Tu plazo de evaluación · %(stage)s"

#, python-format
msgid "Koniec oceniania etapu · %(stage)s"
msgstr "Fin de la evaluación de la etapa · %(stage)s"

#, python-format
msgid "Rozmowa kwalifikacyjna · %(stage)s"
msgstr "Entrevista de clasificación · %(stage)s"

#, python-format
msgid "Webinar · %(title)s"
msgstr "Seminario web · %(title)s"

#, python-format
msgid "runda 2: %(count)s"
msgstr "ronda 2: %(count)s"

#, python-format
msgid "Postęp oceniania – %(stage)s"
msgstr "Progreso de la evaluación – %(stage)s"

#, python-format
msgid "%(done)s z %(total)s"
msgstr "%(done)s de %(total)s"

#, python-format
msgid "pokój otwiera się %(when)s"
msgstr "la sala se abre %(when)s"

msgid "Rubryki, uwagi dla recenzentów, rozwiązania wzorcowe i wspólne szablony komentarzy – dla zadań, które masz do oceny. Materiał wyłącznie dla komitetu."
msgstr "Rúbricas, notas para evaluadores, soluciones modelo y plantillas de comentarios compartidas, para las tareas que evalúas. Material solo para la comisión."

msgid "Uwagi dla recenzentów"
msgstr "Notas para evaluadores"

msgid "Rubryka"
msgstr "Rúbrica"

msgid "Kryterium"
msgstr "Criterio"

msgid "Maks. punktów"
msgstr "Puntos máx."

msgid "Koordynator nie dodał do tego zadania materiałów – oceniasz według skali etapu."
msgstr "El coordinador no ha añadido materiales a esta tarea: evalúas según la escala de la etapa."

msgid "Materiały pojawią się tu razem z pierwszym przydziałem prac do oceny."
msgstr "Los materiales aparecerán aquí con tu primera asignación de trabajos por evaluar."

#, python-format
msgid "Wspólne szablony komentarzy: %(count)s"
msgstr "Plantillas de comentarios compartidas: %(count)s"

msgid "Pojawią się tu nowe przydziały prac, prace w rundzie rozjemczej, przypomnienia o terminie oceniania i reklamacje do rozpatrzenia."
msgstr "Aquí aparecerán nuevas asignaciones, trabajos de la ronda de desempate, recordatorios de plazos de evaluación y reclamaciones por resolver."

#, python-format
msgid "Nowe prace do oceny, przypomnienia o terminach i reklamacje do rozpatrzenia – w jednym miejscu. Powiadomienia starsze niż %(days)s dni usuwamy automatycznie."
msgstr "Nuevos trabajos por evaluar, recordatorios de plazos y reclamaciones por resolver, en un solo lugar. Las notificaciones de más de %(days)s días se eliminan automáticamente."

msgid "Nowe prace do oceny"
msgstr "Nuevos trabajos por evaluar"

msgid "Praca w rundzie rozjemczej"
msgstr "Trabajo en la ronda de desempate"

msgid "Termin oceniania"
msgstr "Plazo de evaluación"

msgid "Reklamacja do rozpatrzenia"
msgstr "Reclamación por resolver"

#, python-format
msgid "Nowe prace do oceny: %(stage)s"
msgstr "Nuevos trabajos por evaluar: %(stage)s"

#, python-format
msgid "Praca czeka na Twoją ocenę w rundzie rozjemczej: %(stage)s"
msgstr "Un trabajo espera tu evaluación en la ronda de desempate: %(stage)s"

#, python-format
msgid "Mija termin oceniania – prace po terminie albo tuż przed nim: %(count)s"
msgstr "Vence el plazo de evaluación: trabajos vencidos o a punto de vencer: %(count)s"

#, python-format
msgid "Nowa reklamacja do rozpatrzenia: %(stage)s"
msgstr "Nueva reclamación por resolver: %(stage)s"

msgid "Filtr kolejki"
msgstr "Filtro de la cola"

msgid "wszystkie etapy"
msgstr "todas las etapas"

msgid "wszystkie zadania"
msgstr "todas las tareas"

msgid "wszystkie rundy"
msgstr "todas las rondas"

msgid "runda 2 (rozjemcza)"
msgstr "ronda 2 (desempate)"

msgid "Wyczyść filtr"
msgstr "Quitar filtro"

msgid "Zakładki pokazują tylko prace pasujące do filtra; podsumowanie i paczka ZIP obejmują całą kolejkę."
msgstr "Las pestañas muestran solo los trabajos que coinciden con el filtro; el resumen y el paquete ZIP abarcan toda la cola."

#, python-format
msgid "runda %(number)s"
msgstr "ronda %(number)s"

msgid "Kolejka pomija sprawy, w których jesteś w konflikcie interesów (recenzowałeś tę pracę)."
msgstr "La cola omite los casos en los que tienes un conflicto de intereses (evaluaste ese trabajo)."

msgid "Ocena wstępna"
msgstr "Nota provisional"

msgid "Złożona"
msgstr "Presentada"

msgid "Argument uczestnika"
msgstr "Argumento del participante"

msgid "Oceny rundy 1"
msgstr "Notas de la ronda 1"

msgid "Pobierz pracę"
msgstr "Descargar el trabajo"

msgid "Zapisać decyzję komisji? Rozstrzygnięcie jest ostateczne."
msgstr "¿Guardar la decisión de la comisión? La resolución es definitiva."

msgid "Zapisz decyzję"
msgstr "Guardar decisión"

msgid "Kolejka pusta"
msgstr "Cola vacía"

msgid "Brak reklamacji do rozpatrzenia."
msgstr "No hay reclamaciones por resolver."

msgid "Rozstrzygnięcie"
msgstr "Resolución"

msgid "Nowa punktacja"
msgstr "Nueva puntuación"

msgid "Uzasadnienie"
msgstr "Justificación"
