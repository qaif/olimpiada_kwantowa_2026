msgid "Ocenianie"
msgstr "Avaliação"

msgid "Komisja odwoławcza"
msgstr "Comissão de recursos"

msgid "Spotkania"
msgstr "Reuniões"

msgid "Wiadomości i materiały"
msgstr "Mensagens e materiais"

msgid "Do oceny"
msgstr "Para avaliar"

msgid "Ocenione"
msgstr "Avaliadas"

msgid "Druga ocena (runda rozjemcza)"
msgstr "Segunda avaliação (ronda de desempate)"

msgid "Materiały dla komisji"
msgstr "Materiais da comissão"

msgid "Reklamacje do rozpatrzenia"
msgstr "Reclamações a decidir"

msgid "Rozmowy i pokoje komisji"
msgstr "Entrevistas e salas da comissão"

msgid "Moje pokoje wideo"
msgstr "As minhas salas de vídeo"

msgid "Nawigacja panelu komisji"
msgstr "Navegação do painel da comissão"

msgid "Menu komisji"
msgstr "Menu da comissão"

msgid "czeka"
msgstr "pendentes"

msgid "Panel komisji"
msgstr "Painel da comissão"

msgid "Prace do oceny, terminy i materiały komisji w jednym miejscu. Ocenianie jest anonimowe: prace są oznaczone wyłącznie kodem publicznym."
msgstr "Trabalhos para avaliar, prazos e materiais da comissão num só lugar. A avaliação é anónima: os trabalhos são identificados apenas pelo código público."

msgid "Reklamacje do rozpatrzenia, terminy i spotkania komisji w jednym miejscu."
msgstr "Reclamações a decidir, prazos e reuniões da comissão num só lugar."

msgid "do oceny (nowe i w toku)"
msgstr "para avaliar (novas e em curso)"

msgid "Przejdź do oceniania"
msgstr "Ir para a avaliação"

msgid "Postęp oceniania"
msgstr "Progresso da avaliação"

msgid "Druga ocena"
msgstr "Segunda avaliação"

msgid "do oceny w rundzie rozjemczej"
msgstr "para avaliar na ronda de desempate"

msgid "Oceny rundy 1 się rozjechały – rozstrzygasz spór o pracę, nie między osobami."
msgstr "As notas da ronda 1 divergiram – decides uma disputa sobre o trabalho, não entre pessoas."

msgid "Pokaż prace rundy 2"
msgstr "Mostrar trabalhos da ronda 2"

msgid "w kolejce komisji odwoławczej"
msgstr "na fila da comissão de recursos"

msgid "Kolejka pomija sprawy, w których jesteś w konflikcie interesów."
msgstr "A fila omite os casos em que tens conflito de interesses."

msgid "Otwórz kolejkę"
msgstr "Abrir a fila"

msgid "Najbliższe terminy"
msgstr "Próximos prazos"

msgid "Nic nie czeka na termin."
msgstr "Nada está pendente de prazo."

msgid "Twoja rola"
msgstr "A tua função"

msgid "Recenzent (komitet oceniający)"
msgstr "Avaliador (comité de avaliação)"

msgid "Członek komisji odwoławczej"
msgstr "Membro da comissão de recursos"

msgid "Nie dostajesz prac uczestników ze swojego województwa ani regionu (konflikt interesów)."
msgstr "Não recebes trabalhos de participantes da tua província ou região (conflito de interesses)."

msgid "Prace do oceny według etapów"
msgstr "Trabalhos para avaliar por etapa"

msgid "Koniec oceniania etapu"
msgstr "Fim da avaliação da etapa"

msgid "Czynność"
msgstr "Ação"

msgid "Oceniaj"
msgstr "Avaliar"

msgid "Spotkania komisji"
msgstr "Reuniões da comissão"

msgid "Rozmowy kwalifikacyjne"
msgstr "Entrevistas de qualificação"

msgid "Zapisanych"
msgstr "Inscritos"

msgid "Wejście"
msgstr "Entrada"

msgid "Dołącz jako gospodarz"
msgstr "Entrar como anfitrião"

msgid "Adres pokoju podaje koordynator."
msgstr "O endereço da sala é fornecido pelo coordenador."

#, python-format
msgid "%(done)s z %(total)s ocenionych"
msgstr "%(done)s de %(total)s avaliadas"

#, python-format
msgid "Termin Twoich ocen · %(stage)s"
msgstr "O teu prazo de avaliação · %(stage)s"

#, python-format
msgid "Koniec oceniania etapu · %(stage)s"
msgstr "Fim da avaliação da etapa · %(stage)s"

#, python-format
msgid "Rozmowa kwalifikacyjna · %(stage)s"
msgstr "Entrevista de qualificação · %(stage)s"

#, python-format
msgid "Webinar · %(title)s"
msgstr "Webinar · %(title)s"

#, python-format
msgid "runda 2: %(count)s"
msgstr "ronda 2: %(count)s"

#, python-format
msgid "Postęp oceniania – %(stage)s"
msgstr "Progresso da avaliação – %(stage)s"

#, python-format
msgid "%(done)s z %(total)s"
msgstr "%(done)s de %(total)s"

#, python-format
msgid "pokój otwiera się %(when)s"
msgstr "a sala abre %(when)s"

msgid "Rubryki, uwagi dla recenzentów, rozwiązania wzorcowe i wspólne szablony komentarzy – dla zadań, które masz do oceny. Materiał wyłącznie dla komitetu."
msgstr "Rubricas, notas para avaliadores, soluções-modelo e modelos de comentários partilhados – para as tarefas que avalias. Material exclusivo da comissão."

msgid "Uwagi dla recenzentów"
msgstr "Notas para avaliadores"

msgid "Rubryka"
msgstr "Rubrica"

msgid "Kryterium"
msgstr "Critério"

msgid "Maks. punktów"
msgstr "Pontos máx."

msgid "Koordynator nie dodał do tego zadania materiałów – oceniasz według skali etapu."
msgstr "O coordenador não adicionou materiais a esta tarefa – avalias segundo a escala da etapa."

msgid "Materiały pojawią się tu razem z pierwszym przydziałem prac do oceny."
msgstr "Os materiais aparecerão aqui com a tua primeira atribuição de trabalhos para avaliar."

#, python-format
msgid "Wspólne szablony komentarzy: %(count)s"
msgstr "Modelos de comentários partilhados: %(count)s"

msgid "Pojawią się tu nowe przydziały prac, prace w rundzie rozjemczej, przypomnienia o terminie oceniania i reklamacje do rozpatrzenia."
msgstr "Aqui aparecerão novas atribuições, trabalhos da ronda de desempate, lembretes de prazos de avaliação e reclamações a decidir."

#, python-format
msgid "Nowe prace do oceny, przypomnienia o terminach i reklamacje do rozpatrzenia – w jednym miejscu. Powiadomienia starsze niż %(days)s dni usuwamy automatycznie."
msgstr "Novos trabalhos para avaliar, lembretes de prazos e reclamações a decidir – num só lugar. As notificações com mais de %(days)s dias são eliminadas automaticamente."

msgid "Nowe prace do oceny"
msgstr "Novos trabalhos para avaliar"

msgid "Praca w rundzie rozjemczej"
msgstr "Trabalho na ronda de desempate"

msgid "Termin oceniania"
msgstr "Prazo de avaliação"

msgid "Reklamacja do rozpatrzenia"
msgstr "Reclamação a decidir"

#, python-format
msgid "Nowe prace do oceny: %(stage)s"
msgstr "Novos trabalhos para avaliar: %(stage)s"

#, python-format
msgid "Praca czeka na Twoją ocenę w rundzie rozjemczej: %(stage)s"
msgstr "Um trabalho aguarda a tua avaliação na ronda de desempate: %(stage)s"

#, python-format
msgid "Mija termin oceniania – prace po terminie albo tuż przed nim: %(count)s"
msgstr "O prazo de avaliação está a terminar – trabalhos em atraso ou quase: %(count)s"

#, python-format
msgid "Nowa reklamacja do rozpatrzenia: %(stage)s"
msgstr "Nova reclamação a decidir: %(stage)s"

msgid "Filtr kolejki"
msgstr "Filtro da fila"

msgid "wszystkie etapy"
msgstr "todas as etapas"

msgid "wszystkie zadania"
msgstr "todas as tarefas"

msgid "wszystkie rundy"
msgstr "todas as rondas"

msgid "runda 2 (rozjemcza)"
msgstr "ronda 2 (desempate)"

msgid "Wyczyść filtr"
msgstr "Limpar filtro"

msgid "Zakładki pokazują tylko prace pasujące do filtra; podsumowanie i paczka ZIP obejmują całą kolejkę."
msgstr "Os separadores mostram apenas os trabalhos que correspondem ao filtro; o resumo e o pacote ZIP abrangem toda a fila."

#, python-format
msgid "runda %(number)s"
msgstr "ronda %(number)s"

msgid "Kolejka pomija sprawy, w których jesteś w konflikcie interesów (recenzowałeś tę pracę)."
msgstr "A fila omite os casos em que tens conflito de interesses (avaliaste esse trabalho)."

msgid "Ocena wstępna"
msgstr "Nota provisória"

msgid "Złożona"
msgstr "Apresentada"

msgid "Argument uczestnika"
msgstr "Argumento do participante"

msgid "Oceny rundy 1"
msgstr "Notas da ronda 1"

msgid "Pobierz pracę"
msgstr "Descarregar o trabalho"

msgid "Zapisać decyzję komisji? Rozstrzygnięcie jest ostateczne."
msgstr "Guardar a decisão da comissão? A decisão é definitiva."

msgid "Zapisz decyzję"
msgstr "Guardar decisão"

msgid "Kolejka pusta"
msgstr "Fila vazia"

msgid "Brak reklamacji do rozpatrzenia."
msgstr "Não há reclamações a decidir."

msgid "Rozstrzygnięcie"
msgstr "Decisão"

msgid "Nowa punktacja"
msgstr "Nova pontuação"

msgid "Uzasadnienie"
msgstr "Justificação"
