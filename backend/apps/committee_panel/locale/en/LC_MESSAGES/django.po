msgid "Ocenianie"
msgstr "Grading"

msgid "Komisja odwoławcza"
msgstr "Appeals committee"

msgid "Spotkania"
msgstr "Meetings"

msgid "Wiadomości i materiały"
msgstr "Messages and materials"

msgid "Do oceny"
msgstr "To grade"

msgid "Ocenione"
msgstr "Graded"

msgid "Druga ocena (runda rozjemcza)"
msgstr "Second marking (tie-break round)"

msgid "Materiały dla komisji"
msgstr "Committee materials"

msgid "Reklamacje do rozpatrzenia"
msgstr "Appeals to decide"

msgid "Rozmowy i pokoje komisji"
msgstr "Interviews and committee rooms"

msgid "Moje pokoje wideo"
msgstr "My video rooms"

msgid "Nawigacja panelu komisji"
msgstr "Committee panel navigation"

msgid "Menu komisji"
msgstr "Committee menu"

msgid "czeka"
msgstr "waiting"

msgid "Panel komisji"
msgstr "Committee panel"

msgid "Prace do oceny, terminy i materiały komisji w jednym miejscu. Ocenianie jest anonimowe: prace są oznaczone wyłącznie kodem publicznym."
msgstr "Work to grade, deadlines and committee materials in one place. Grading is anonymous: work is identified only by its public code."

msgid "Reklamacje do rozpatrzenia, terminy i spotkania komisji w jednym miejscu."
msgstr "Appeals to decide, deadlines and committee meetings in one place."

msgid "do oceny (nowe i w toku)"
msgstr "to grade (new and in progress)"

msgid "Przejdź do oceniania"
msgstr "Go to grading"

msgid "Postęp oceniania"
msgstr "Grading progress"

msgid "Druga ocena"
msgstr "Second marking"

msgid "do oceny w rundzie rozjemczej"
msgstr "to grade in the tie-break round"

msgid "Oceny rundy 1 się rozjechały – rozstrzygasz spór o pracę, nie między osobami."
msgstr "The round 1 marks diverged – you settle a dispute about the work, not between people."

msgid "Pokaż prace rundy 2"
msgstr "Show round 2 work"

msgid "w kolejce komisji odwoławczej"
msgstr "in the appeals committee queue"

msgid "Kolejka pomija sprawy, w których jesteś w konflikcie interesów."
msgstr "The queue skips cases in which you have a conflict of interest."

msgid "Otwórz kolejkę"
msgstr "Open the queue"

msgid "Najbliższe terminy"
msgstr "Upcoming deadlines"

msgid "Nic nie czeka na termin."
msgstr "Nothing is waiting for a deadline."

msgid "Twoja rola"
msgstr "Your role"

msgid "Recenzent (komitet oceniający)"
msgstr "Reviewer (grading committee)"

msgid "Członek komisji odwoławczej"
msgstr "Appeals committee member"

msgid "Nie dostajesz prac uczestników ze swojego województwa ani regionu (konflikt interesów)."
msgstr "You do not receive work by participants from your own province or region (conflict of interest)."

msgid "Prace do oceny według etapów"
msgstr "Work to grade by stage"

msgid "Koniec oceniania etapu"
msgstr "End of grading for the stage"

msgid "Czynność"
msgstr "Action"

msgid "Oceniaj"
msgstr "Grade"

msgid "Spotkania komisji"
msgstr "Committee meetings"

msgid "Rozmowy kwalifikacyjne"
msgstr "Qualifying interviews"

msgid "Zapisanych"
msgstr "Booked"

msgid "Wejście"
msgstr "Entry"

msgid "Dołącz jako gospodarz"
msgstr "Join as host"

msgid "Adres pokoju podaje koordynator."
msgstr "The coordinator provides the room address."

#, python-format
msgid "%(done)s z %(total)s ocenionych"
msgstr "%(done)s of %(total)s graded"

#, python-format
msgid "Termin Twoich ocen · %(stage)s"
msgstr "Your grading deadline · %(stage)s"

#, python-format
msgid "Koniec oceniania etapu · %(stage)s"
msgstr "End of grading for the stage · %(stage)s"

#, python-format
msgid "Rozmowa kwalifikacyjna · %(stage)s"
msgstr "Qualifying interview · %(stage)s"

#, python-format
msgid "Webinar · %(title)s"
msgstr "Webinar · %(title)s"

#, python-format
msgid "runda 2: %(count)s"
msgstr "round 2: %(count)s"

#, python-format
msgid "Postęp oceniania – %(stage)s"
msgstr "Grading progress – %(stage)s"

#, python-format
msgid "%(done)s z %(total)s"
msgstr "%(done)s of %(total)s"

#, python-format
msgid "pokój otwiera się %(when)s"
msgstr "the room opens %(when)s"

msgid "Rubryki, uwagi dla recenzentów, rozwiązania wzorcowe i wspólne szablony komentarzy – dla zadań, które masz do oceny. Materiał wyłącznie dla komitetu."
msgstr "Rubrics, notes for reviewers, model solutions and shared comment templates – for the tasks you grade. Committee-only material."

msgid "Uwagi dla recenzentów"
msgstr "Notes for reviewers"

msgid "Rubryka"
msgstr "Rubric"

msgid "Kryterium"
msgstr "Criterion"

msgid "Maks. punktów"
msgstr "Max. points"

msgid "Koordynator nie dodał do tego zadania materiałów – oceniasz według skali etapu."
msgstr "The coordinator has not added materials to this task – you grade by the stage scale."

msgid "Materiały pojawią się tu razem z pierwszym przydziałem prac do oceny."
msgstr "Materials will appear here with your first assignment of work to grade."

#, python-format
msgid "Wspólne szablony komentarzy: %(count)s"
msgstr "Shared comment templates: %(count)s"

msgid "Pojawią się tu nowe przydziały prac, prace w rundzie rozjemczej, przypomnienia o terminie oceniania i reklamacje do rozpatrzenia."
msgstr "New work assignments, tie-break round work, grading deadline reminders and appeals to decide will appear here."

#, python-format
msgid "Nowe prace do oceny, przypomnienia o terminach i reklamacje do rozpatrzenia – w jednym miejscu. Powiadomienia starsze niż %(days)s dni usuwamy automatycznie."
msgstr "New work to grade, deadline reminders and appeals to decide – in one place. Notifications older than %(days)s days are deleted automatically."

msgid "Nowe prace do oceny"
msgstr "New work to grade"

msgid "Praca w rundzie rozjemczej"
msgstr "Work in the tie-break round"

msgid "Termin oceniania"
msgstr "Grading deadline"

msgid "Reklamacja do rozpatrzenia"
msgstr "Appeal to decide"

#, python-format
msgid "Nowe prace do oceny: %(stage)s"
msgstr "New work to grade: %(stage)s"

#, python-format
msgid "Praca czeka na Twoją ocenę w rundzie rozjemczej: %(stage)s"
msgstr "Work awaits your mark in the tie-break round: %(stage)s"

#, python-format
msgid "Mija termin oceniania – prace po terminie albo tuż przed nim: %(count)s"
msgstr "Grading deadline is due – work overdue or nearly due: %(count)s"

#, python-format
msgid "Nowa reklamacja do rozpatrzenia: %(stage)s"
msgstr "New appeal to decide: %(stage)s"

msgid "Filtr kolejki"
msgstr "Queue filter"

msgid "wszystkie etapy"
msgstr "all stages"

msgid "wszystkie zadania"
msgstr "all tasks"

msgid "wszystkie rundy"
msgstr "all rounds"

msgid "runda 2 (rozjemcza)"
msgstr "round 2 (tie-break)"

msgid "Wyczyść filtr"
msgstr "Clear filter"

msgid "Zakładki pokazują tylko prace pasujące do filtra; podsumowanie i paczka ZIP obejmują całą kolejkę."
msgstr "The tabs show only work matching the filter; the summary and the ZIP package cover the whole queue."

#, python-format
msgid "runda %(number)s"
msgstr "round %(number)s"

msgid "Kolejka pomija sprawy, w których jesteś w konflikcie interesów (recenzowałeś tę pracę)."
msgstr "The queue skips cases in which you have a conflict of interest (you reviewed that work)."

msgid "Ocena wstępna"
msgstr "Provisional mark"

msgid "Złożona"
msgstr "Filed"

msgid "Argument uczestnika"
msgstr "Participant’s argument"

msgid "Oceny rundy 1"
msgstr "Round 1 marks"

msgid "Pobierz pracę"
msgstr "Download the work"

msgid "Zapisać decyzję komisji? Rozstrzygnięcie jest ostateczne."
msgstr "Save the committee’s decision? The ruling is final."

msgid "Zapisz decyzję"
msgstr "Save decision"

msgid "Kolejka pusta"
msgstr "Queue empty"

msgid "Brak reklamacji do rozpatrzenia."
msgstr "No appeals to decide."

msgid "Rozstrzygnięcie"
msgstr "Ruling"

msgid "Nowa punktacja"
msgstr "New score"

msgid "Uzasadnienie"
msgstr "Justification"
