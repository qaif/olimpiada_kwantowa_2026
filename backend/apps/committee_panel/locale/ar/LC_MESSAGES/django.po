msgid "Ocenianie"
msgstr "التقييم"

msgid "Komisja odwoławcza"
msgstr "لجنة الطعون"

msgid "Spotkania"
msgstr "الاجتماعات"

msgid "Wiadomości i materiały"
msgstr "الرسائل والمواد"

msgid "Do oceny"
msgstr "للتقييم"

msgid "Ocenione"
msgstr "تم تقييمها"

msgid "Druga ocena (runda rozjemcza)"
msgstr "التقييم الثاني (جولة الفصل)"

msgid "Materiały dla komisji"
msgstr "مواد اللجنة"

msgid "Reklamacje do rozpatrzenia"
msgstr "طعون بانتظار القرار"

msgid "Rozmowy i pokoje komisji"
msgstr "المقابلات وغرف اللجنة"

msgid "Moje pokoje wideo"
msgstr "غرف الفيديو الخاصة بي"

msgid "Nawigacja panelu komisji"
msgstr "التنقل في لوحة اللجنة"

msgid "Menu komisji"
msgstr "قائمة اللجنة"

msgid "czeka"
msgstr "بانتظار"

msgid "Panel komisji"
msgstr "لوحة اللجنة"

msgid "Prace do oceny, terminy i materiały komisji w jednym miejscu. Ocenianie jest anonimowe: prace są oznaczone wyłącznie kodem publicznym."
msgstr "الأعمال المطلوب تقييمها والمواعيد ومواد اللجنة في مكان واحد. التقييم مجهول الهوية: تُعرَّف الأعمال بالرمز العام فقط."

msgid "Reklamacje do rozpatrzenia, terminy i spotkania komisji w jednym miejscu."
msgstr "الطعون بانتظار القرار والمواعيد واجتماعات اللجنة في مكان واحد."

msgid "do oceny (nowe i w toku)"
msgstr "للتقييم (جديدة وقيد العمل)"

msgid "Przejdź do oceniania"
msgstr "الانتقال إلى التقييم"

msgid "Postęp oceniania"
msgstr "تقدّم التقييم"

msgid "Druga ocena"
msgstr "التقييم الثاني"

msgid "do oceny w rundzie rozjemczej"
msgstr "للتقييم في جولة الفصل"

msgid "Oceny rundy 1 się rozjechały – rozstrzygasz spór o pracę, nie między osobami."
msgstr "تباينت درجات الجولة الأولى – أنت تفصل في خلاف حول العمل، لا بين أشخاص."

msgid "Pokaż prace rundy 2"
msgstr "عرض أعمال الجولة الثانية"

msgid "w kolejce komisji odwoławczej"
msgstr "في قائمة انتظار لجنة الطعون"

msgid "Kolejka pomija sprawy, w których jesteś w konflikcie interesów."
msgstr "تتجاوز القائمة القضايا التي لديك فيها تضارب مصالح."

msgid "Otwórz kolejkę"
msgstr "فتح القائمة"

msgid "Najbliższe terminy"
msgstr "المواعيد القادمة"

msgid "Nic nie czeka na termin."
msgstr "لا شيء بانتظار موعد."

msgid "Twoja rola"
msgstr "دورك"

msgid "Recenzent (komitet oceniający)"
msgstr "مُراجع (لجنة التقييم)"

msgid "Członek komisji odwoławczej"
msgstr "عضو لجنة الطعون"

msgid "Nie dostajesz prac uczestników ze swojego województwa ani regionu (konflikt interesów)."
msgstr "لا تتلقى أعمال مشاركين من محافظتك أو منطقتك (تضارب مصالح)."

msgid "Prace do oceny według etapów"
msgstr "الأعمال المطلوب تقييمها حسب المرحلة"

msgid "Koniec oceniania etapu"
msgstr "نهاية تقييم المرحلة"

msgid "Czynność"
msgstr "إجراء"

msgid "Oceniaj"
msgstr "قيّم"

msgid "Spotkania komisji"
msgstr "اجتماعات اللجنة"

msgid "Rozmowy kwalifikacyjne"
msgstr "مقابلات التأهيل"

msgid "Zapisanych"
msgstr "المسجلون"

msgid "Wejście"
msgstr "الدخول"

msgid "Dołącz jako gospodarz"
msgstr "الانضمام كمضيف"

msgid "Adres pokoju podaje koordynator."
msgstr "يزوّدك المنسق بعنوان الغرفة."

#, python-format
msgid "%(done)s z %(total)s ocenionych"
msgstr "تم تقييم %(done)s من %(total)s"

#, python-format
msgid "Termin Twoich ocen · %(stage)s"
msgstr "موعد تقييماتك · %(stage)s"

#, python-format
msgid "Koniec oceniania etapu · %(stage)s"
msgstr "نهاية تقييم المرحلة · %(stage)s"

#, python-format
msgid "Rozmowa kwalifikacyjna · %(stage)s"
msgstr "مقابلة التأهيل · %(stage)s"

#, python-format
msgid "Webinar · %(title)s"
msgstr "ندوة عبر الإنترنت · %(title)s"

#, python-format
msgid "runda 2: %(count)s"
msgstr "الجولة 2: %(count)s"

#, python-format
msgid "Postęp oceniania – %(stage)s"
msgstr "تقدّم التقييم – %(stage)s"

#, python-format
msgid "%(done)s z %(total)s"
msgstr "%(done)s من %(total)s"

#, python-format
msgid "pokój otwiera się %(when)s"
msgstr "تُفتح الغرفة %(when)s"

msgid "Rubryki, uwagi dla recenzentów, rozwiązania wzorcowe i wspólne szablony komentarzy – dla zadań, które masz do oceny. Materiał wyłącznie dla komitetu."
msgstr "معايير التقييم وملاحظات المراجعين والحلول النموذجية وقوالب التعليقات المشتركة – للمسائل التي تقيّمها. مواد للجنة فقط."

msgid "Uwagi dla recenzentów"
msgstr "ملاحظات للمراجعين"

msgid "Rubryka"
msgstr "معايير التقييم"

msgid "Kryterium"
msgstr "المعيار"

msgid "Maks. punktów"
msgstr "الحد الأقصى للنقاط"

msgid "Koordynator nie dodał do tego zadania materiałów – oceniasz według skali etapu."
msgstr "لم يضف المنسق مواد لهذه المسألة – تقيّم وفق سلّم المرحلة."

msgid "Materiały pojawią się tu razem z pierwszym przydziałem prac do oceny."
msgstr "ستظهر المواد هنا مع أول إسناد لأعمال التقييم."

#, python-format
msgid "Wspólne szablony komentarzy: %(count)s"
msgstr "قوالب التعليقات المشتركة: %(count)s"

msgid "Pojawią się tu nowe przydziały prac, prace w rundzie rozjemczej, przypomnienia o terminie oceniania i reklamacje do rozpatrzenia."
msgstr "ستظهر هنا الإسنادات الجديدة وأعمال جولة الفصل وتذكيرات مواعيد التقييم والطعون بانتظار القرار."

#, python-format
msgid "Nowe prace do oceny, przypomnienia o terminach i reklamacje do rozpatrzenia – w jednym miejscu. Powiadomienia starsze niż %(days)s dni usuwamy automatycznie."
msgstr "أعمال جديدة للتقييم وتذكيرات بالمواعيد وطعون بانتظار القرار – في مكان واحد. تُحذف الإشعارات الأقدم من %(days)s يومًا تلقائيًا."

msgid "Nowe prace do oceny"
msgstr "أعمال جديدة للتقييم"

msgid "Praca w rundzie rozjemczej"
msgstr "عمل في جولة الفصل"

msgid "Termin oceniania"
msgstr "موعد التقييم"

msgid "Reklamacja do rozpatrzenia"
msgstr "طعن بانتظار القرار"

#, python-format
msgid "Nowe prace do oceny: %(stage)s"
msgstr "أعمال جديدة للتقييم: %(stage)s"

#, python-format
msgid "Praca czeka na Twoją ocenę w rundzie rozjemczej: %(stage)s"
msgstr "عمل بانتظار تقييمك في جولة الفصل: %(stage)s"

#, python-format
msgid "Mija termin oceniania – prace po terminie albo tuż przed nim: %(count)s"
msgstr "يحين موعد التقييم – أعمال متأخرة أو قريبة من الموعد: %(count)s"

#, python-format
msgid "Nowa reklamacja do rozpatrzenia: %(stage)s"
msgstr "طعن جديد بانتظار القرار: %(stage)s"

msgid "Filtr kolejki"
msgstr "تصفية القائمة"

msgid "wszystkie etapy"
msgstr "كل المراحل"

msgid "wszystkie zadania"
msgstr "كل المسائل"

msgid "wszystkie rundy"
msgstr "كل الجولات"

msgid "runda 2 (rozjemcza)"
msgstr "الجولة 2 (الفصل)"

msgid "Wyczyść filtr"
msgstr "مسح التصفية"

msgid "Zakładki pokazują tylko prace pasujące do filtra; podsumowanie i paczka ZIP obejmują całą kolejkę."
msgstr "تعرض الألسنة الأعمال المطابقة للتصفية فقط؛ ويشمل الملخص وحزمة ZIP القائمة كاملة."

#, python-format
msgid "runda %(number)s"
msgstr "الجولة %(number)s"

msgid "Kolejka pomija sprawy, w których jesteś w konflikcie interesów (recenzowałeś tę pracę)."
msgstr "تتجاوز القائمة القضايا التي لديك فيها تضارب مصالح (راجعت ذلك العمل)."

msgid "Ocena wstępna"
msgstr "الدرجة المبدئية"

msgid "Złożona"
msgstr "قُدِّم"

msgid "Argument uczestnika"
msgstr "حجة المشارك"

msgid "Oceny rundy 1"
msgstr "درجات الجولة الأولى"

msgid "Pobierz pracę"
msgstr "تنزيل العمل"

msgid "Zapisać decyzję komisji? Rozstrzygnięcie jest ostateczne."
msgstr "حفظ قرار اللجنة؟ القرار نهائي."

msgid "Zapisz decyzję"
msgstr "حفظ القرار"

msgid "Kolejka pusta"
msgstr "القائمة فارغة"

msgid "Brak reklamacji do rozpatrzenia."
msgstr "لا توجد طعون بانتظار القرار."

msgid "Rozstrzygnięcie"
msgstr "القرار"

msgid "Nowa punktacja"
msgstr "الدرجة الجديدة"

msgid "Uzasadnienie"
msgstr "التعليل"
