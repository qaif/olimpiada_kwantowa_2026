msgstr "কমিটি মেনু"

msgid "czeka"
msgstr "অপেক্ষমাণ"

msgid "Panel komisji"
msgstr "কমিটি প্যানেল"

msgid "Prace do oceny, terminy i materiały komisji w jednym miejscu. Ocenianie jest anonimowe: prace są oznaczone wyłącznie kodem publicznym."
msgstr "মূল্যায়নের কাজ, সময়সীমা ও কমিটির উপকরণ এক জায়গায়। মূল্যায়ন বেনামি: কাজ শুধু পাবলিক কোড দিয়ে চিহ্নিত।"

msgid "Reklamacje do rozpatrzenia, terminy i spotkania komisji w jednym miejscu."
msgstr "নিষ্পত্তির অপেক্ষায় আপিল, সময়সীমা ও কমিটির সভা এক জায়গায়।"

msgid "do oceny (nowe i w toku)"
msgstr "মূল্যায়নের জন্য (নতুন ও চলমান)"

msgid "Przejdź do oceniania"
msgstr "মূল্যায়নে যান"

msgid "Postęp oceniania"
msgstr "মূল্যায়নের অগ্রগতি"

msgid "Druga ocena"
msgstr "দ্বিতীয় মূল্যায়ন"

msgid "do oceny w rundzie rozjemczej"
msgstr "নিষ্পত্তি পর্বে মূল্যায়নের জন্য"

msgid "Oceny rundy 1 się rozjechały – rozstrzygasz spór o pracę, nie między osobami."
msgstr "প্রথম পর্বের নম্বরে পার্থক্য – আপনি কাজ নিয়ে বিরোধ মেটান, মানুষের মধ্যে নয়।"

msgid "Pokaż prace rundy 2"
msgstr "দ্বিতীয় পর্বের কাজ দেখান"

msgid "w kolejce komisji odwoławczej"
msgstr "আপিল কমিটির সারিতে"

msgid "Kolejka pomija sprawy, w których jesteś w konflikcie interesów."
msgstr "যেসব ক্ষেত্রে আপনার স্বার্থের সংঘাত আছে, সারি সেগুলো বাদ দেয়।"

msgid "Otwórz kolejkę"
msgstr "সারি খুলুন"

msgid "Najbliższe terminy"
msgstr "আসন্ন সময়সীমা"

msgid "Nic nie czeka na termin."
msgstr "কোনো সময়সীমা বাকি নেই।"

msgid "Twoja rola"
msgstr "আপনার ভূমিকা"

msgid "Recenzent (komitet oceniający)"
msgstr "পর্যালোচক (মূল্যায়ন কমিটি)"

msgid "Członek komisji odwoławczej"
msgstr "আপিল কমিটির সদস্য"

msgid "Nie dostajesz prac uczestników ze swojego województwa ani regionu (konflikt interesów)."
msgstr "নিজের প্রদেশ বা অঞ্চলের অংশগ্রহণকারীদের কাজ আপনি পান না (স্বার্থের সংঘাত)।"

msgid "Prace do oceny według etapów"
msgstr "পর্যায় অনুযায়ী মূল্যায়নের কাজ"

msgid "Koniec oceniania etapu"
msgstr "পর্যায়ের মূল্যায়নের শেষ"

msgid "Czynność"
msgstr "কাজ"

msgid "Oceniaj"
msgstr "মূল্যায়ন করুন"

msgid "Spotkania komisji"
msgstr "কমিটির সভা"

msgid "Rozmowy kwalifikacyjne"
msgstr "যোগ্যতা সাক্ষাৎকার"

msgid "Zapisanych"
msgstr "নিবন্ধিত"

msgid "Wejście"
msgstr "প্রবেশ"

msgid "Dołącz jako gospodarz"
msgstr "হোস্ট হিসেবে যোগ দিন"

msgid "Adres pokoju podaje koordynator."
msgstr "কক্ষের ঠিকানা সমন্বয়ক দেন।"

#, python-format
msgid "%(done)s z %(total)s ocenionych"
msgstr "%(total)s-এর মধ্যে %(done)s মূল্যায়িত"

#, python-format
msgid "Termin Twoich ocen · %(stage)s"
msgstr "আপনার মূল্যায়নের সময়সীমা · %(stage)s"

#, python-format
msgid "Koniec oceniania etapu · %(stage)s"
msgstr "পর্যায়ের মূল্যায়নের শেষ · %(stage)s"

#, python-format
msgid "Rozmowa kwalifikacyjna · %(stage)s"
msgstr "যোগ্যতা সাক্ষাৎকার · %(stage)s"

#, python-format
msgid "Webinar · %(title)s"
msgstr "ওয়েবিনার · %(title)s"

#, python-format
msgid "runda 2: %(count)s"
msgstr "পর্ব ২: %(count)s"

#, python-format
msgid "Postęp oceniania – %(stage)s"
msgstr "মূল্যায়নের অগ্রগতি – %(stage)s"

#, python-format
msgid "%(done)s z %(total)s"
msgstr "%(total)s-এর মধ্যে %(done)s"

