msgstr "কক্ষ খুলবে %(when)s"

msgid "Rubryki, uwagi dla recenzentów, rozwiązania wzorcowe i wspólne szablony komentarzy – dla zadań, które masz do oceny. Materiał wyłącznie dla komitetu."
msgstr "রুব্রিক, পর্যালোচকদের জন্য নোট, আদর্শ সমাধান ও শেয়ার করা মন্তব্যের টেমপ্লেট – আপনি যেসব সমস্যা মূল্যায়ন করেন সেগুলোর জন্য। শুধু কমিটির জন্য।"

msgid "Uwagi dla recenzentów"
msgstr "পর্যালোচকদের জন্য নোট"

msgid "Rubryka"
msgstr "রুব্রিক"

msgid "Kryterium"
msgstr "মানদণ্ড"

msgid "Maks. punktów"
msgstr "সর্বোচ্চ নম্বর"

msgid "Koordynator nie dodał do tego zadania materiałów – oceniasz według skali etapu."
msgstr "সমন্বয়ক এই সমস্যায় কোনো উপকরণ যোগ করেননি – আপনি পর্যায়ের স্কেল অনুযায়ী মূল্যায়ন করেন।"

msgid "Materiały pojawią się tu razem z pierwszym przydziałem prac do oceny."
msgstr "মূল্যায়নের কাজের প্রথম বরাদ্দের সঙ্গে উপকরণ এখানে দেখা যাবে।"

#, python-format
msgid "Wspólne szablony komentarzy: %(count)s"
msgstr "শেয়ার করা মন্তব্যের টেমপ্লেট: %(count)s"

msgid "Pojawią się tu nowe przydziały prac, prace w rundzie rozjemczej, przypomnienia o terminie oceniania i reklamacje do rozpatrzenia."
msgstr "নতুন কাজের বরাদ্দ, নিষ্পত্তি পর্বের কাজ, মূল্যায়নের সময়সীমার অনুস্মারক ও নিষ্পত্তির অপেক্ষায় আপিল এখানে দেখা যাবে।"

#, python-format
msgid "Nowe prace do oceny, przypomnienia o terminach i reklamacje do rozpatrzenia – w jednym miejscu. Powiadomienia starsze niż %(days)s dni usuwamy automatycznie."
msgstr "নতুন মূল্যায়নের কাজ, সময়সীমার অনুস্মারক ও নিষ্পত্তির অপেক্ষায় আপিল – এক জায়গায়। %(days)s দিনের পুরোনো বিজ্ঞপ্তি স্বয়ংক্রিয়ভাবে মুছে যায়।"

msgid "Nowe prace do oceny"
msgstr "মূল্যায়নের নতুন কাজ"

msgid "Praca w rundzie rozjemczej"
msgstr "নিষ্পত্তি পর্বের কাজ"

msgid "Termin oceniania"
msgstr "মূল্যায়নের সময়সীমা"

msgid "Reklamacja do rozpatrzenia"
msgstr "নিষ্পত্তির অপেক্ষায় আপিল"

#, python-format
msgid "Nowe prace do oceny: %(stage)s"
msgstr "মূল্যায়নের নতুন কাজ: %(stage)s"

#, python-format
msgid "Praca czeka na Twoją ocenę w rundzie rozjemczej: %(stage)s"
msgstr "নিষ্পত্তি পর্বে একটি কাজ আপনার মূল্যায়নের অপেক্ষায়: %(stage)s"

#, python-format
msgid "Mija termin oceniania – prace po terminie albo tuż przed nim: %(count)s"
msgstr "মূল্যায়নের সময়সীমা ঘনিয়ে এসেছে – সময়সীমা পেরোনো বা আসন্ন কাজ: %(count)s"

#, python-format
msgid "Nowa reklamacja do rozpatrzenia: %(stage)s"
msgstr "নিষ্পত্তির অপেক্ষায় নতুন আপিল: %(stage)s"

msgid "Filtr kolejki"
msgstr "সারির ফিল্টার"

msgid "wszystkie etapy"
msgstr "সব পর্যায়"

msgid "wszystkie zadania"
msgstr "সব সমস্যা"

msgid "wszystkie rundy"
msgstr "সব পর্ব"

msgid "runda 2 (rozjemcza)"
msgstr "পর্ব ২ (নিষ্পত্তি)"

msgid "Wyczyść filtr"
msgstr "ফিল্টার মুছুন"

msgid "Zakładki pokazują tylko prace pasujące do filtra; podsumowanie i paczka ZIP obejmują całą kolejkę."
msgstr "ট্যাবগুলো শুধু ফিল্টারের সঙ্গে মেলে এমন কাজ দেখায়; সারসংক্ষেপ ও ZIP প্যাকেজ পুরো সারি জুড়ে।"

#, python-format
msgid "runda %(number)s"
msgstr "পর্ব %(number)s"

msgid "Kolejka pomija sprawy, w których jesteś w konflikcie interesów (recenzowałeś tę pracę)."
msgstr "যেসব ক্ষেত্রে আপনার স্বার্থের সংঘাত আছে (আপনি সেই কাজ পর্যালোচনা করেছেন), সারি সেগুলো বাদ দেয়।"

msgid "Ocena wstępna"
msgstr "অস্থায়ী নম্বর"

msgid "Złożona"
msgstr "দাখিল"

msgid "Argument uczestnika"
msgstr "অংশগ্রহণকারীর যুক্তি"

msgid "Oceny rundy 1"
msgstr "পর্ব ১-এর নম্বর"

msgid "Pobierz pracę"
msgstr "কাজ ডাউনলোড করুন"

msgid "Zapisać decyzję komisji? Rozstrzygnięcie jest ostateczne."
msgstr "কমিটির সিদ্ধান্ত সংরক্ষণ করবেন? সিদ্ধান্ত চূড়ান্ত।"

msgid "Zapisz decyzję"
msgstr "সিদ্ধান্ত সংরক্ষণ করুন"

msgid "Kolejka pusta"
msgstr "সারি খালি"

msgid "Brak reklamacji do rozpatrzenia."
msgstr "নিষ্পত্তির অপেক্ষায় কোনো আপিল নেই।"

msgid "Rozstrzygnięcie"
msgstr "সিদ্ধান্ত"

msgid "Nowa punktacja"
msgstr "নতুন নম্বর"

msgid "Uzasadnienie"
msgstr "যৌক্তিকতা"
