#: apps/workshop_certificates/notifications.py
msgid "Zaświadczenie z warsztatów jest gotowe – Olimpiada Kwantowa"
msgstr "Votre attestation des ateliers est prête – Olympiade quantique"

#: apps/workshop_certificates/notifications.py
#, python-format
msgid "Zaświadczenie z warsztatów jest gotowe – %(competition)s"
msgstr "Votre attestation des ateliers est prête – %(competition)s"

#: apps/workshop_certificates/notifications.py
#, python-format
msgid "Wystawiliśmy Ci zaświadczenie o udziale w warsztatach (edycja %(edition)s). Dokument w PDF-ie pobierzesz po zalogowaniu, w zakładce „Dyplomy”:"
msgstr "Nous vous avons délivré l’attestation de participation aux ateliers (édition %(edition)s). Vous pouvez télécharger le PDF après vous être connecté(e), dans l’onglet « Diplômes » :"

#: apps/workshop_certificates/notifications.py
msgid "Na zaświadczeniu są wymienione tematy i terminy zajęć, na których byłeś(-aś)."
msgstr "L’attestation indique les thèmes et les dates des séances auxquelles vous avez assisté."
