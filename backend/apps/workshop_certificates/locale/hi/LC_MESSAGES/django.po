#: apps/workshop_certificates/notifications.py
msgid "Zaświadczenie z warsztatów jest gotowe – Olimpiada Kwantowa"
msgstr "आपका कार्यशाला प्रमाणपत्र तैयार है – क्वांटम ओलंपियाड"

#: apps/workshop_certificates/notifications.py
#, python-format
msgid "Zaświadczenie z warsztatów jest gotowe – %(competition)s"
msgstr "आपका कार्यशाला प्रमाणपत्र तैयार है – %(competition)s"

#: apps/workshop_certificates/notifications.py
#, python-format
msgid "Wystawiliśmy Ci zaświadczenie o udziale w warsztatach (edycja %(edition)s). Dokument w PDF-ie pobierzesz po zalogowaniu, w zakładce „Dyplomy”:"
msgstr "हमने आपको कार्यशालाओं में भागीदारी का प्रमाणपत्र (संस्करण %(edition)s) जारी किया है। लॉग इन करने के बाद आप इसे “प्रमाणपत्र” टैब में PDF के रूप में डाउनलोड कर सकते हैं:"

#: apps/workshop_certificates/notifications.py
msgid "Na zaświadczeniu są wymienione tematy i terminy zajęć, na których byłeś(-aś)."
msgstr "प्रमाणपत्र पर उन सत्रों के विषय और तिथियाँ दी गई हैं जिनमें आपने भाग लिया।"
