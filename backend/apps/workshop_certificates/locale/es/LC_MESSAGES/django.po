#: apps/workshop_certificates/notifications.py
msgid "Zaświadczenie z warsztatów jest gotowe – Olimpiada Kwantowa"
msgstr "Tu certificado de los talleres está listo – Olimpiada Cuántica"

#: apps/workshop_certificates/notifications.py
#, python-format
msgid "Zaświadczenie z warsztatów jest gotowe – %(competition)s"
msgstr "Tu certificado de los talleres está listo – %(competition)s"

#: apps/workshop_certificates/notifications.py
#, python-format
msgid "Wystawiliśmy Ci zaświadczenie o udziale w warsztatach (edycja %(edition)s). Dokument w PDF-ie pobierzesz po zalogowaniu, w zakładce „Dyplomy”:"
msgstr "Te hemos emitido el certificado de participación en los talleres (edición %(edition)s). Puedes descargar el PDF después de iniciar sesión, en la pestaña «Diplomas»:"

#: apps/workshop_certificates/notifications.py
msgid "Na zaświadczeniu są wymienione tematy i terminy zajęć, na których byłeś(-aś)."
msgstr "El certificado enumera los temas y las fechas de las sesiones a las que asististe."
