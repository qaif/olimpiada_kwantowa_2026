msgid "Powiadomienia"
msgstr "বিজ্ঞপ্তি"

msgid "nowe"
msgstr "নতুন"

msgid "Ogłoszenia"
msgstr "ঘোষণা"

msgid "Pulpit"
msgstr "ড্যাশবোর্ড"

msgid "Zadania i moje prace"
msgstr "প্রশ্ন ও আমার উত্তর"

msgid "Archiwum zadań"
msgstr "প্রশ্নের সংগ্রহ"

msgid "Nauka"
msgstr "শেখা"

msgid "Notatniki Qiskit"
msgstr "Qiskit নোটবুক"

msgid "Edytor LaTeX (webTEX)"
msgstr "LaTeX সম্পাদক (webTEX)"

msgid "Profil i dane"
msgstr "প্রোফাইল ও তথ্য"

msgid "Weryfikacja dwuetapowa"
msgstr "দুই ধাপের যাচাই"

msgid "Menu panelu"
msgstr "প্যানেল মেনু"

msgid "Menu panelu uczestnika"
msgstr "অংশগ্রহণকারী প্যানেলের মেনু"

msgid "Powiadomienia – brak nowych"
msgstr "বিজ্ঞপ্তি – নতুন কিছু নেই"

msgid "Na skróty"
msgstr "শর্টকাট"

msgid "Najbliższy termin"
msgstr "পরবর্তী সময়সীমা"

msgid "Przejdź do zadań"
msgstr "প্রশ্নে যাও"

msgid "Bieżący etap"
msgstr "বর্তমান পর্ব"

msgid "Najbliższy warsztat"
msgstr "পরবর্তী কর্মশালা"

msgid "Warsztaty online"
msgstr "অনলাইন কর্মশালা"

msgid "Link do spotkania organizator podaje w ogłoszeniu."
msgstr "সভার লিংক আয়োজক ঘোষণায় জানিয়ে দেন।"

msgid "Co nowego"
msgstr "নতুন কী"

msgid "brak nowych"
msgstr "নতুন কিছু নেই"

msgid "nieprzeczytane rozmowy"
msgstr "না-পড়া কথোপকথন"

msgid "Narzędzia"
msgstr "সরঞ্জাম"

msgid "Pracujesz w przeglądarce – nic nie trzeba instalować."
msgstr "তুমি ব্রাউজারেই কাজ করো – কিছুই ইনস্টল করতে হয় না।"

msgid "Edytor LaTeX"
msgstr "LaTeX সম্পাদক"

msgid "(otwiera się w nowej karcie)"
msgstr "(নতুন ট্যাবে খোলে)"

msgid "Na razie nie ma tu zadań"
msgstr "এখানে এখনো কোনো প্রশ্ন নেই"

msgid "Notatniki pojawiają się przy zadaniach z obliczeń kwantowych, gdy etap, do którego jesteś zapisany, się rozpocznie."
msgstr "তুমি যে পর্বে নিবন্ধিত, সেটি শুরু হলেই কোয়ান্টাম কম্পিউটিং প্রশ্নের সঙ্গে নোটবুক দেখা যায়।"

msgid "Edytor jest dostępny przy zadaniach etapu, do którego jesteś zapisany, od chwili jego rozpoczęcia."
msgstr "তুমি যে পর্বে নিবন্ধিত, সেটি শুরু হওয়ার মুহূর্ত থেকেই তার প্রশ্নের জন্য সম্পাদক পাওয়া যায়।"

msgid "Zadania z obliczeń kwantowych rozwiązujesz w notatniku Jupyter z biblioteką Qiskit, uruchamianym w przeglądarce – nic nie trzeba instalować. Notatnik otwiera się w osobnej karcie, z plikiem startowym zadania."
msgstr "কোয়ান্টাম কম্পিউটিং প্রশ্ন তুমি ব্রাউজারে চলা, Qiskit লাইব্রেরিসহ Jupyter নোটবুকে সমাধান করো – কিছুই ইনস্টল করতে হয় না। নোটবুক প্রশ্নের শুরুর ফাইলসহ আলাদা ট্যাবে খোলে।"

msgid "Rozwiązanie możesz napisać w edytorze LaTeX (webTEX) z podglądem PDF. Edytor otwiera się w nowej karcie z gotowym szablonem; skompilowany PDF złożysz przyciskiem na karcie zadania."
msgstr "তুমি PDF প্রিভিউসহ LaTeX সম্পাদকে (webTEX) সমাধান লিখতে পারো। সম্পাদক তৈরি টেমপ্লেটসহ নতুন ট্যাবে খোলে; সংকলিত PDF প্রশ্নের কার্ডের বোতাম দিয়ে জমা দাও।"

#, python-format
msgid "Powiadomienia, nieprzeczytane: %(number)s"
msgstr "বিজ্ঞপ্তি, না-পড়া: %(number)s"
