msgstr "Редактор LaTeX (webTEX)"

msgid "Profil i dane"
msgstr "Профиль и данные"

msgid "Weryfikacja dwuetapowa"
msgstr "Двухэтапная проверка"

msgid "Menu uczestnika"
msgstr "Меню участника"

msgid "Nawigacja panelu uczestnika"
msgstr "Навигация панели участника"

msgid "Powiadomienia – brak nowych"
msgstr "Уведомления — новых нет"

msgid "Na skróty"
msgstr "Быстрый доступ"

msgid "Najbliższy termin"
msgstr "Ближайший срок"

msgid "Przejdź do zadań"
msgstr "Перейти к задачам"

msgid "Bieżący etap"
msgstr "Текущий этап"

msgid "Najbliższy warsztat"
msgstr "Ближайший семинар"

msgid "Warsztaty online"
msgstr "Онлайн-семинары"

msgid "Link do spotkania organizator podaje w ogłoszeniu."
msgstr "Ссылку на встречу организатор публикует в объявлении."

msgid "Co nowego"
msgstr "Что нового"

msgid "brak nowych"
msgstr "новых нет"

msgid "nieprzeczytane rozmowy"
msgstr "непрочитанные беседы"

msgid "Narzędzia"
msgstr "Инструменты"

msgid "Pracujesz w przeglądarce – nic nie trzeba instalować."
msgstr "Работа идёт в браузере — ничего устанавливать не нужно."

msgid "Edytor LaTeX"
msgstr "Редактор LaTeX"

msgid "(otwiera się w nowej karcie)"
msgstr "(откроется в новой вкладке)"

msgid "Na razie nie ma tu zadań"
msgstr "Здесь пока нет задач"

msgid "Notatniki pojawiają się przy zadaniach z obliczeń kwantowych, gdy etap, do którego jesteś zapisany, się rozpocznie."
msgstr "Блокноты появляются у задач по квантовым вычислениям, когда начинается этап, на который вы записаны."

msgid "Edytor jest dostępny przy zadaniach etapu, do którego jesteś zapisany, od chwili jego rozpoczęcia."
msgstr "Редактор доступен для задач этапа, на который вы записаны, с момента его начала."

msgid "Zadania z obliczeń kwantowych rozwiązujesz w notatniku Jupyter z biblioteką Qiskit, uruchamianym w przeglądarce – nic nie trzeba instalować. Notatnik otwiera się w osobnej karcie, z plikiem startowym zadania."
msgstr "Задачи по квантовым вычислениям решаются в блокноте Jupyter с библиотекой Qiskit, который работает в браузере, — ничего устанавливать не нужно. Блокнот открывается в отдельной вкладке со стартовым файлом задачи."

msgid "Rozwiązanie możesz napisać w edytorze LaTeX (webTEX) z podglądem PDF. Edytor otwiera się w nowej karcie z gotowym szablonem; skompilowany PDF złożysz przyciskiem na karcie zadania."
msgstr "Решение можно написать в редакторе LaTeX (webTEX) с предпросмотром PDF. Редактор открывается в новой вкладке с готовым шаблоном; скомпилированный PDF отправляется кнопкой на карточке задачи."

#, python-format
msgid "Powiadomienia, nieprzeczytane: %(number)s"
msgstr "Уведомления, непрочитанные: %(number)s"
