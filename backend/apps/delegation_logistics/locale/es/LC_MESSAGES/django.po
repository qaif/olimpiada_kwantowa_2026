#: services.py templates/delegation_logistics/leader_dashboard.html
msgid "Finał się zakończył, a dane delegacji zostały usunięte."
msgstr "La final ha terminado y los datos de la delegación se han eliminado."

#: services.py templates/delegation_logistics/leader_dashboard.html
msgid "Organizator nie ustalił jeszcze dat finału – dane dokumentu podróży i o zdrowiu przyjmiemy po ich ustaleniu."
msgstr "El organizador aún no ha fijado las fechas de la final: los datos del documento de viaje y de salud se aceptarán cuando estén fijadas."

#: services.py
#, python-format
msgid "Termin na uzupełnienie sekcji „%(group)s” minął – zmiany wprowadza już tylko organizator."
msgstr "El plazo de la sección «%(group)s» ha vencido: ahora solo el organizador puede hacer cambios."

#: services.py
msgid "Obywatelstwo podaj dwuliterowym kodem kraju (np. DE, PL)."
msgstr "Indique la nacionalidad con un código de país de dos letras (p. ej. DE, PL)."

#: services.py
msgid "Niepoprawna data."
msgstr "Fecha no válida."

#: services.py
msgid "Paszport traci ważność przed końcem finału – podaj dokument ważny w czasie pobytu."
msgstr "El pasaporte caduca antes del final de la competición: indique un documento válido durante la estancia."

#: services.py
msgid "Wyjazd nie może być przed przyjazdem."
msgstr "La salida no puede ser anterior a la llegada."

#: services.py
msgid "Wybierz dietę z listy."
msgstr "Elija una dieta de la lista."

#: services.py
msgid "Dane o wyżywieniu i zdrowiu zapiszemy dopiero po zaznaczeniu zgody osoby (albo jej rodzica, jeśli jest niepełnoletnia) na ich przetwarzanie."
msgstr "Los datos de alimentación y salud solo se guardarán cuando marque el consentimiento de la persona (o de su madre o padre, si es menor) para su tratamiento."

#: services.py
msgid "Wybierz rolę z listy."
msgstr "Elija una función de la lista."

#: services.py
msgid "Podaj imię i nazwisko."
msgstr "Indique el nombre y los apellidos."

#: services.py
#, python-format
msgid "Delegacja może mieć najwyżej %(count)s gości."
msgstr "Una delegación puede tener como máximo %(count)s invitados."

#: services.py
msgid "Zdjęcie musi być plikiem JPG albo PNG."
msgstr "La foto debe ser un archivo JPG o PNG."

#: services.py
msgid "Nie udało się odczytać zdjęcia – wgraj inny plik JPG lub PNG."
msgstr "No se ha podido leer la foto: suba otro archivo JPG o PNG."

#: services.py
msgid "Zdjęcie ma zbyt dużą rozdzielczość."
msgstr "La resolución de la foto es demasiado alta."

#: services.py
msgid "Plik jest pusty."
msgstr "El archivo está vacío."

#: services.py
msgid "Zdjęcie może mieć najwyżej 5 MB."
msgstr "La foto puede tener como máximo 5 MB."

