#: services.py
#, python-format
msgid "Termin na uzupełnienie sekcji „%(group)s” minął – zmiany wprowadza już tylko organizator."
msgstr "Срок для раздела «%(group)s» истёк – теперь изменения вносит только организатор."

#: services.py
msgid "Obywatelstwo podaj dwuliterowym kodem kraju (np. DE, PL)."
msgstr "Укажите гражданство двухбуквенным кодом страны (напр. DE, PL)."

#: services.py
msgid "Niepoprawna data."
msgstr "Неверная дата."

#: services.py
msgid "Paszport traci ważność przed końcem finału – podaj dokument ważny w czasie pobytu."
msgstr "Паспорт истекает до окончания финала – укажите документ, действительный на время пребывания."

#: services.py
msgid "Wyjazd nie może być przed przyjazdem."
msgstr "Дата отъезда не может быть раньше даты приезда."

#: services.py
msgid "Dane o wyżywieniu i zdrowiu zapiszemy dopiero po zaznaczeniu zgody osoby (albo jej rodzica, jeśli jest niepełnoletnia) na ich przetwarzanie."
msgstr "Данные о питании и здоровье сохраняются только после отметки согласия человека (или его родителя, если он несовершеннолетний) на их обработку."

