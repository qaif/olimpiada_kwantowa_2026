#: services.py templates/delegation_logistics/leader_dashboard.html
msgid "Finał się zakończył, a dane delegacji zostały usunięte."
msgstr "फ़ाइनल समाप्त हो चुका है और प्रतिनिधिमंडल का डेटा हटा दिया गया है।"

#: services.py templates/delegation_logistics/leader_dashboard.html
msgid "Organizator nie ustalił jeszcze dat finału – dane dokumentu podróży i o zdrowiu przyjmiemy po ich ustaleniu."
msgstr "आयोजक ने अभी फ़ाइनल की तिथियाँ तय नहीं की हैं – तिथियाँ तय होने के बाद ही यात्रा दस्तावेज़ और स्वास्थ्य डेटा स्वीकार किया जाएगा।"

#: services.py
#, python-format
msgid "Termin na uzupełnienie sekcji „%(group)s” minął – zmiany wprowadza już tylko organizator."
msgstr "“%(group)s” खंड की समय-सीमा बीत चुकी है – अब केवल आयोजक बदलाव कर सकते हैं।"

#: services.py
msgid "Obywatelstwo podaj dwuliterowym kodem kraju (np. DE, PL)."
msgstr "राष्ट्रीयता दो अक्षरों के देश कोड में लिखें (जैसे DE, PL)।"

#: services.py
msgid "Niepoprawna data."
msgstr "अमान्य तिथि।"

#: services.py
msgid "Paszport traci ważność przed końcem finału – podaj dokument ważny w czasie pobytu."
msgstr "पासपोर्ट फ़ाइनल समाप्त होने से पहले समाप्त हो जाता है – कृपया प्रवास के दौरान मान्य दस्तावेज़ दें।"

#: services.py
msgid "Wyjazd nie może być przed przyjazdem."
msgstr "प्रस्थान, आगमन से पहले नहीं हो सकता।"

#: services.py
msgid "Wybierz dietę z listy."
msgstr "सूची से आहार चुनें।"

#: services.py
msgid "Dane o wyżywieniu i zdrowiu zapiszemy dopiero po zaznaczeniu zgody osoby (albo jej rodzica, jeśli jest niepełnoletnia) na ich przetwarzanie."
msgstr "भोजन और स्वास्थ्य जानकारी तभी सहेजी जाएगी जब आप व्यक्ति (या नाबालिग होने पर उसके माता-पिता) की प्रसंस्करण सहमति पर निशान लगाएँगे।"

#: services.py
msgid "Wybierz rolę z listy."
msgstr "सूची से भूमिका चुनें।"

#: services.py
msgid "Podaj imię i nazwisko."
msgstr "पहला और अंतिम नाम दर्ज करें।"

#: services.py
#, python-format
msgid "Delegacja może mieć najwyżej %(count)s gości."
msgstr "एक प्रतिनिधिमंडल में अधिकतम %(count)s अतिथि हो सकते हैं।"

#: services.py
msgid "Zdjęcie musi być plikiem JPG albo PNG."
msgstr "फ़ोटो JPG या PNG फ़ाइल होनी चाहिए।"

#: services.py
msgid "Nie udało się odczytać zdjęcia – wgraj inny plik JPG lub PNG."
msgstr "फ़ोटो पढ़ी नहीं जा सकी – कृपया कोई दूसरी JPG या PNG फ़ाइल अपलोड करें।"

#: services.py
msgid "Zdjęcie ma zbyt dużą rozdzielczość."
msgstr "फ़ोटो का रिज़ॉल्यूशन बहुत अधिक है।"

#: services.py
msgid "Plik jest pusty."
msgstr "फ़ाइल खाली है।"

#: services.py
msgid "Zdjęcie może mieć najwyżej 5 MB."
msgstr "फ़ोटो अधिकतम 5 MB की हो सकती है।"

