#: services.py templates/delegation_logistics/leader_dashboard.html
msgid "Finał się zakończył, a dane delegacji zostały usunięte."
msgstr "انتهى النهائي وحُذفت بيانات الوفد."

#: services.py templates/delegation_logistics/leader_dashboard.html
msgid "Organizator nie ustalił jeszcze dat finału – dane dokumentu podróży i o zdrowiu przyjmiemy po ich ustaleniu."
msgstr "لم يحدد المنظِّم مواعيد النهائي بعد – ستُقبل بيانات وثيقة السفر والصحة بعد تحديدها."

#: services.py
#, python-format
msgid "Termin na uzupełnienie sekcji „%(group)s” minął – zmiany wprowadza już tylko organizator."
msgstr "انتهى الموعد النهائي لقسم «%(group)s» – يمكن للمنظِّم وحده إجراء التغييرات الآن."

#: services.py
msgid "Obywatelstwo podaj dwuliterowym kodem kraju (np. DE, PL)."
msgstr "أدخل الجنسية برمز بلد من حرفين (مثل DE، PL)."

#: services.py
msgid "Niepoprawna data."
msgstr "تاريخ غير صالح."

#: services.py
msgid "Paszport traci ważność przed końcem finału – podaj dokument ważny w czasie pobytu."
msgstr "تنتهي صلاحية جواز السفر قبل نهاية النهائي – يرجى تقديم وثيقة صالحة طوال فترة الإقامة."

#: services.py
msgid "Wyjazd nie może być przed przyjazdem."
msgstr "لا يمكن أن يكون موعد المغادرة قبل موعد الوصول."

#: services.py
msgid "Wybierz dietę z listy."
msgstr "اختر نظامًا غذائيًا من القائمة."

#: services.py
msgid "Dane o wyżywieniu i zdrowiu zapiszemy dopiero po zaznaczeniu zgody osoby (albo jej rodzica, jeśli jest niepełnoletnia) na ich przetwarzanie."
msgstr "لا يمكن حفظ معلومات الوجبات والصحة إلا بعد تحديد موافقة الشخص (أو والده إذا كان قاصرًا) على معالجتها."

#: services.py
msgid "Wybierz rolę z listy."
msgstr "اختر دورًا من القائمة."

#: services.py
msgid "Podaj imię i nazwisko."
msgstr "أدخل الاسم الأول واسم العائلة."

#: services.py
#, python-format
msgid "Delegacja może mieć najwyżej %(count)s gości."
msgstr "يمكن أن يضم الوفد %(count)s ضيوف كحد أقصى."

#: services.py
msgid "Zdjęcie musi być plikiem JPG albo PNG."
msgstr "يجب أن تكون الصورة ملف JPG أو PNG."

#: services.py
msgid "Nie udało się odczytać zdjęcia – wgraj inny plik JPG lub PNG."
msgstr "تعذّرت قراءة الصورة – يرجى رفع ملف JPG أو PNG آخر."

#: services.py
msgid "Zdjęcie ma zbyt dużą rozdzielczość."
msgstr "دقة الصورة عالية جدًا."

#: services.py
msgid "Plik jest pusty."
msgstr "الملف فارغ."

#: services.py
msgid "Zdjęcie może mieć najwyżej 5 MB."
msgstr "يجب ألا يتجاوز حجم الصورة 5 ميغابايت."

