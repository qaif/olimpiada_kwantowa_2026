#: services.py templates/delegation_logistics/leader_dashboard.html
msgid "Finał się zakończył, a dane delegacji zostały usunięte."
msgstr "A final terminou e os dados da delegação foram apagados."

#: services.py templates/delegation_logistics/leader_dashboard.html
msgid "Organizator nie ustalił jeszcze dat finału – dane dokumentu podróży i o zdrowiu przyjmiemy po ich ustaleniu."
msgstr "O organizador ainda não definiu as datas da final – os dados do documento de viagem e de saúde serão aceites depois de definidas."

#: services.py
#, python-format
msgid "Termin na uzupełnienie sekcji „%(group)s” minął – zmiany wprowadza już tylko organizator."
msgstr "O prazo da secção «%(group)s» terminou – agora só o organizador pode fazer alterações."

#: services.py
msgid "Obywatelstwo podaj dwuliterowym kodem kraju (np. DE, PL)."
msgstr "Indique a nacionalidade com um código de país de duas letras (p. ex. DE, PL)."

#: services.py
msgid "Niepoprawna data."
msgstr "Data inválida."

#: services.py
msgid "Paszport traci ważność przed końcem finału – podaj dokument ważny w czasie pobytu."
msgstr "O passaporte expira antes do fim da final – indique um documento válido durante a estadia."

#: services.py
msgid "Wyjazd nie może być przed przyjazdem."
msgstr "A partida não pode ser anterior à chegada."

#: services.py
msgid "Wybierz dietę z listy."
msgstr "Escolha uma dieta da lista."

#: services.py
msgid "Dane o wyżywieniu i zdrowiu zapiszemy dopiero po zaznaczeniu zgody osoby (albo jej rodzica, jeśli jest niepełnoletnia) na ich przetwarzanie."
msgstr "Os dados de alimentação e saúde só serão guardados depois de assinalar o consentimento da pessoa (ou do pai ou mãe, se for menor) para o seu tratamento."

#: services.py
msgid "Wybierz rolę z listy."
msgstr "Escolha uma função da lista."

#: services.py
msgid "Podaj imię i nazwisko."
msgstr "Indique o nome e o apelido."

#: services.py
#, python-format
msgid "Delegacja może mieć najwyżej %(count)s gości."
msgstr "Uma delegação pode ter no máximo %(count)s convidados."

#: services.py
msgid "Zdjęcie musi być plikiem JPG albo PNG."
msgstr "A fotografia tem de ser um ficheiro JPG ou PNG."

#: services.py
msgid "Nie udało się odczytać zdjęcia – wgraj inny plik JPG lub PNG."
msgstr "Não foi possível ler a fotografia – carregue outro ficheiro JPG ou PNG."

#: services.py
msgid "Zdjęcie ma zbyt dużą rozdzielczość."
msgstr "A resolução da fotografia é demasiado alta."

#: services.py
msgid "Plik jest pusty."
msgstr "O arquivo está vazio."

#: services.py
msgid "Zdjęcie może mieć najwyżej 5 MB."
msgstr "A fotografia pode ter no máximo 5 MB."

