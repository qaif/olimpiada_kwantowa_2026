#: services.py templates/delegation_logistics/leader_dashboard.html
msgid "Finał się zakończył, a dane delegacji zostały usunięte."
msgstr "La finale est terminée et les données de la délégation ont été supprimées."

#: services.py templates/delegation_logistics/leader_dashboard.html
msgid "Organizator nie ustalił jeszcze dat finału – dane dokumentu podróży i o zdrowiu przyjmiemy po ich ustaleniu."
msgstr "L’organisateur n’a pas encore fixé les dates de la finale – les données du document de voyage et de santé seront acceptées une fois les dates fixées."

#: services.py
#, python-format
msgid "Termin na uzupełnienie sekcji „%(group)s” minął – zmiany wprowadza już tylko organizator."
msgstr "La date limite de la section « %(group)s » est passée – seul l’organisateur peut désormais modifier."

#: services.py
msgid "Obywatelstwo podaj dwuliterowym kodem kraju (np. DE, PL)."
msgstr "Indiquez la nationalité par un code pays à deux lettres (p. ex. DE, PL)."

#: services.py
msgid "Niepoprawna data."
msgstr "Date non valide."

#: services.py
msgid "Paszport traci ważność przed końcem finału – podaj dokument ważny w czasie pobytu."
msgstr "Le passeport expire avant la fin de la finale – indiquez un document valable pendant le séjour."

#: services.py
msgid "Wyjazd nie może być przed przyjazdem."
msgstr "Le départ ne peut pas précéder l’arrivée."

#: services.py
msgid "Wybierz dietę z listy."
msgstr "Choisissez un régime dans la liste."

#: services.py
msgid "Dane o wyżywieniu i zdrowiu zapiszemy dopiero po zaznaczeniu zgody osoby (albo jej rodzica, jeśli jest niepełnoletnia) na ich przetwarzanie."
msgstr "Les informations de repas et de santé ne seront enregistrées qu’après avoir coché le consentement de la personne (ou de son parent, si elle est mineure) à leur traitement."

#: services.py
msgid "Wybierz rolę z listy."
msgstr "Choisissez un rôle dans la liste."

#: services.py
msgid "Podaj imię i nazwisko."
msgstr "Indiquez le prénom et le nom."

#: services.py
#, python-format
msgid "Delegacja może mieć najwyżej %(count)s gości."
msgstr "Une délégation peut compter au plus %(count)s invités."

#: services.py
msgid "Zdjęcie musi być plikiem JPG albo PNG."
msgstr "La photo doit être un fichier JPG ou PNG."

#: services.py
msgid "Nie udało się odczytać zdjęcia – wgraj inny plik JPG lub PNG."
msgstr "Impossible de lire la photo – téléversez un autre fichier JPG ou PNG."

#: services.py
msgid "Zdjęcie ma zbyt dużą rozdzielczość."
msgstr "La résolution de la photo est trop élevée."

#: services.py
msgid "Plik jest pusty."
msgstr "Le fichier est vide."

#: services.py
msgid "Zdjęcie może mieć najwyżej 5 MB."
msgstr "La photo ne doit pas dépasser 5 Mo."

