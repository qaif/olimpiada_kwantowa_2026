# Logowanie dwuskładnikowe personelu (SEC-01) – katalog aplikacji apps.staff_mfa.
# Angielski przejrzany ręcznie; pozostałe języki maszynowe (do przeglądu native speakerów, I18N-01 § 8).
msgid ""
msgstr ""
"Project-Id-Version: olimpiada\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Włączono logowanie dwuskładnikowe"
msgstr "Double authentification activée"

msgid "Na Twoim koncie włączono logowanie dwuskładnikowe (kod z aplikacji w telefonie)."
msgstr "La double authentification a été activée sur votre compte (code d’une application sur votre téléphone)."

msgid "Wyłączono logowanie dwuskładnikowe"
msgstr "Double authentification désactivée"

msgid "Na Twoim koncie wyłączono logowanie dwuskładnikowe. Konto chroni teraz samo hasło."
msgstr "La double authentification a été désactivée sur votre compte. Votre compte n’est plus protégé que par votre mot de passe."

msgid "Nowe kody zapasowe"
msgstr "Nouveaux codes de secours"

msgid "Wygenerowano nowy komplet kodów zapasowych do logowania dwuskładnikowego. Poprzednie kody przestały działać."
msgstr "Un nouveau jeu de codes de secours pour la double authentification a été généré. Les codes précédents ne fonctionnent plus."

msgid "Użyto kodu zapasowego"
msgstr "Code de secours utilisé"

msgid "Do zalogowania na Twoje konto użyto jednego z kodów zapasowych."
msgstr "L’un de vos codes de secours a été utilisé pour vous connecter à votre compte."

msgid "Organizator zdjął logowanie dwuskładnikowe"
msgstr "L’organisateur a retiré la double authentification"

msgid "Organizator zdjął logowanie dwuskładnikowe z Twojego konta (np. po zgłoszeniu zgubionego telefonu). Po zalogowaniu hasłem skonfiguruj je od nowa na nowym urządzeniu."
msgstr "L’organisateur a retiré la double authentification de votre compte (par exemple après la déclaration d’un téléphone perdu). Après vous être connecté avec votre mot de passe, configurez-la à nouveau sur votre nouvel appareil."

msgid "Wstrzymano logowanie po błędnych kodach"
msgstr "Connexion suspendue après des codes erronés"

#, python-format
msgid "Na Twoje konto kilka razy z rzędu wpisano błędny kod logowania dwuskładnikowego. Logowanie kodem jest wstrzymane na %(minutes)s min."
msgstr "Un code de double authentification erroné a été saisi plusieurs fois de suite sur votre compte. La connexion par code est suspendue pendant %(minutes)s min."

#, python-format
msgid "Zostało kodów zapasowych: %(left)s."
msgstr "Codes de secours restants : %(left)s."

#, python-format
msgid "Konto: %(email)s"
msgstr "Compte : %(email)s"

#, python-format
msgid "Kiedy: %(when)s"
msgstr "Quand : %(when)s"

msgid "Jeśli ta wiadomość Cię zaskoczyła, natychmiast zmień hasło i skontaktuj się z organizatorem – ktoś może znać Twoje hasło."
msgstr "Si ce message vous surprend, changez immédiatement votre mot de passe et contactez l’organisateur : quelqu’un connaît peut-être votre mot de passe."

#, python-format
msgid "%(what)s – %(competition)s"
msgstr "%(what)s – %(competition)s"

msgid "Hasło się nie zgadza."
msgstr "Le mot de passe est incorrect."

#, python-format
msgid "Zbyt wiele błędnych kodów. Spróbuj ponownie za %(minutes)s min."
msgstr "Trop de codes erronés. Réessayez dans %(minutes)s min."

msgid "Kod nie pasuje."
msgstr "Le code ne correspond pas."

#, python-format
msgid "Zbyt wiele błędnych kodów z rzędu. Logowanie kodem jest wstrzymane na %(minutes)s min – wysłaliśmy też list na adres konta."
msgstr "Trop de codes erronés d’affilée. La connexion par code est suspendue pendant %(minutes)s min – nous avons aussi envoyé un e-mail à l’adresse du compte."

#, python-format
msgid "Twoja rola w tym serwisie wymaga logowania dwuskładnikowego. Włącz je do %(deadline)s – potem bez niego nie wejdziesz do panelu."
msgstr "Votre rôle sur ce site exige la double authentification. Activez-la avant le %(deadline)s – ensuite, vous ne pourrez plus accéder au panneau sans elle."

msgid "Twoja rola w tym serwisie wymaga logowania dwuskładnikowego. Włącz je teraz, żeby wrócić do panelu."
msgstr "Votre rôle sur ce site exige la double authentification. Activez-la maintenant pour revenir au panneau."

msgid "Nowy komplet unieważnia wszystkie dotychczasowe kody. Potrzebne będą hasło i bieżący kod."
msgstr "Un nouveau jeu annule tous vos codes actuels. Votre mot de passe et un code actuel seront nécessaires."

msgid "Wygeneruj nowe kody zapasowe"
msgstr "Générer de nouveaux codes de secours"

msgid "Twoja rola wymaga logowania dwuskładnikowego – po wyłączeniu trzeba będzie od razu skonfigurować je ponownie."
msgstr "Votre rôle exige la double authentification – après l’avoir désactivée, vous devrez la configurer à nouveau immédiatement."

msgid "Kod z aplikacji albo kod zapasowy"
msgstr "Code de l’application ou code de secours"

#, python-format
msgid "Nie pytaj o kod na tym urządzeniu do %(until)s"
msgstr "Ne plus demander de code sur cet appareil jusqu’au %(until)s"

msgid "Zaznacz wyłącznie na własnym komputerze – nie na wspólnym w szkole ani w biurze."
msgstr "Cochez uniquement sur votre propre ordinateur – pas sur un ordinateur partagé à l’école ou au bureau."

msgid "Włącz teraz"
msgstr "Activer maintenant"
