# Logowanie dwuskładnikowe personelu (SEC-01) – katalog aplikacji apps.staff_mfa.
# Angielski przejrzany ręcznie; pozostałe języki maszynowe (do przeglądu native speakerów, I18N-01 § 8).
msgid ""
msgstr ""
"Project-Id-Version: olimpiada\n"
"Language: id\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Włączono logowanie dwuskładnikowe"
msgstr "Verifikasi dua langkah diaktifkan"

msgid "Na Twoim koncie włączono logowanie dwuskładnikowe (kod z aplikacji w telefonie)."
msgstr "Verifikasi dua langkah telah diaktifkan di akun Anda (kode dari aplikasi di ponsel Anda)."

msgid "Wyłączono logowanie dwuskładnikowe"
msgstr "Verifikasi dua langkah dinonaktifkan"

msgid "Na Twoim koncie wyłączono logowanie dwuskładnikowe. Konto chroni teraz samo hasło."
msgstr "Verifikasi dua langkah telah dinonaktifkan di akun Anda. Kini akun Anda hanya dilindungi oleh kata sandi."

msgid "Nowe kody zapasowe"
msgstr "Kode cadangan baru"

msgid "Wygenerowano nowy komplet kodów zapasowych do logowania dwuskładnikowego. Poprzednie kody przestały działać."
msgstr "Satu set kode cadangan baru untuk verifikasi dua langkah telah dibuat. Kode sebelumnya tidak berlaku lagi."

msgid "Użyto kodu zapasowego"
msgstr "Kode cadangan telah digunakan"

msgid "Do zalogowania na Twoje konto użyto jednego z kodów zapasowych."
msgstr "Salah satu kode cadangan Anda digunakan untuk masuk ke akun Anda."

msgid "Organizator zdjął logowanie dwuskładnikowe"
msgstr "Penyelenggara menghapus verifikasi dua langkah"

msgid "Organizator zdjął logowanie dwuskładnikowe z Twojego konta (np. po zgłoszeniu zgubionego telefonu). Po zalogowaniu hasłem skonfiguruj je od nowa na nowym urządzeniu."
msgstr "Penyelenggara menghapus verifikasi dua langkah dari akun Anda (misalnya setelah laporan ponsel hilang). Setelah masuk dengan kata sandi, siapkan kembali di perangkat baru Anda."

msgid "Wstrzymano logowanie po błędnych kodach"
msgstr "Proses masuk dijeda setelah kode yang salah"

#, python-format
msgid "Na Twoje konto kilka razy z rzędu wpisano błędny kod logowania dwuskładnikowego. Logowanie kodem jest wstrzymane na %(minutes)s min."
msgstr "Kode verifikasi dua langkah yang salah dimasukkan beberapa kali berturut-turut pada akun Anda. Masuk dengan kode dijeda selama %(minutes)s menit."

#, python-format
msgid "Zostało kodów zapasowych: %(left)s."
msgstr "Sisa kode cadangan: %(left)s."

#, python-format
msgid "Konto: %(email)s"
msgstr "Akun: %(email)s"

#, python-format
msgid "Kiedy: %(when)s"
msgstr "Waktu: %(when)s"

msgid "Jeśli ta wiadomość Cię zaskoczyła, natychmiast zmień hasło i skontaktuj się z organizatorem – ktoś może znać Twoje hasło."
msgstr "Jika pesan ini mengejutkan Anda, segera ubah kata sandi dan hubungi penyelenggara – seseorang mungkin mengetahui kata sandi Anda."

#, python-format
msgid "%(what)s – %(competition)s"
msgstr "%(what)s – %(competition)s"

msgid "Hasło się nie zgadza."
msgstr "Kata sandi salah."

#, python-format
msgid "Zbyt wiele błędnych kodów. Spróbuj ponownie za %(minutes)s min."
msgstr "Terlalu banyak kode yang salah. Coba lagi dalam %(minutes)s menit."

msgid "Kod nie pasuje."
msgstr "Kode tidak cocok."

#, python-format
msgid "Zbyt wiele błędnych kodów z rzędu. Logowanie kodem jest wstrzymane na %(minutes)s min – wysłaliśmy też list na adres konta."
msgstr "Terlalu banyak kode yang salah berturut-turut. Masuk dengan kode dijeda selama %(minutes)s menit – kami juga telah mengirim email ke alamat akun."

#, python-format
msgid "Twoja rola w tym serwisie wymaga logowania dwuskładnikowego. Włącz je do %(deadline)s – potem bez niego nie wejdziesz do panelu."
msgstr "Peran Anda di situs ini mewajibkan verifikasi dua langkah. Aktifkan paling lambat %(deadline)s – setelah itu Anda tidak dapat masuk ke panel tanpanya."

msgid "Twoja rola w tym serwisie wymaga logowania dwuskładnikowego. Włącz je teraz, żeby wrócić do panelu."
msgstr "Peran Anda di situs ini mewajibkan verifikasi dua langkah. Aktifkan sekarang untuk kembali ke panel."

msgid "Nowy komplet unieważnia wszystkie dotychczasowe kody. Potrzebne będą hasło i bieżący kod."
msgstr "Set baru membatalkan semua kode Anda saat ini. Anda memerlukan kata sandi dan kode saat ini."

msgid "Wygeneruj nowe kody zapasowe"
msgstr "Buat kode cadangan baru"

msgid "Twoja rola wymaga logowania dwuskładnikowego – po wyłączeniu trzeba będzie od razu skonfigurować je ponownie."
msgstr "Peran Anda mewajibkan verifikasi dua langkah – setelah dinonaktifkan, Anda harus segera menyiapkannya kembali."

msgid "Kod z aplikacji albo kod zapasowy"
msgstr "Kode dari aplikasi atau kode cadangan"

#, python-format
msgid "Nie pytaj o kod na tym urządzeniu do %(until)s"
msgstr "Jangan minta kode di perangkat ini hingga %(until)s"

msgid "Zaznacz wyłącznie na własnym komputerze – nie na wspólnym w szkole ani w biurze."
msgstr "Centang hanya di komputer Anda sendiri – bukan di komputer bersama di sekolah atau kantor."

msgid "Włącz teraz"
msgstr "Aktifkan sekarang"

msgid "Zapamiętane urządzenia"
msgstr "Perangkat yang diingat"

msgid "Przeglądarki, w których zaznaczono „nie pytaj o kod”, przestaną być zapamiętane – także te, do których nie masz już dostępu."
msgstr "Browser yang dicentang “jangan minta kode” tidak akan diingat lagi – termasuk yang sudah tidak dapat Anda akses."

msgid "Zapomnij wszystkie urządzenia"
msgstr "Lupakan semua perangkat"

msgid "Zapomnieliśmy wszystkie zapamiętane urządzenia – przy następnym logowaniu podasz kod."
msgstr "Semua perangkat yang diingat telah dilupakan – Anda akan diminta kode saat masuk berikutnya."
