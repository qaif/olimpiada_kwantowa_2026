# Logowanie dwuskładnikowe personelu (SEC-01) – katalog aplikacji apps.staff_mfa.
# Angielski przejrzany ręcznie; pozostałe języki maszynowe (do przeglądu native speakerów, I18N-01 § 8).
msgid ""
msgstr ""
"Project-Id-Version: olimpiada\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Włączono logowanie dwuskładnikowe"
msgstr "Verificación en dos pasos activada"

msgid "Na Twoim koncie włączono logowanie dwuskładnikowe (kod z aplikacji w telefonie)."
msgstr "Se ha activado la verificación en dos pasos en tu cuenta (código de una aplicación en tu teléfono)."

msgid "Wyłączono logowanie dwuskładnikowe"
msgstr "Verificación en dos pasos desactivada"

msgid "Na Twoim koncie wyłączono logowanie dwuskładnikowe. Konto chroni teraz samo hasło."
msgstr "Se ha desactivado la verificación en dos pasos en tu cuenta. Ahora tu cuenta está protegida solo por la contraseña."

msgid "Nowe kody zapasowe"
msgstr "Nuevos códigos de respaldo"

msgid "Wygenerowano nowy komplet kodów zapasowych do logowania dwuskładnikowego. Poprzednie kody przestały działać."
msgstr "Se ha generado un nuevo conjunto de códigos de respaldo para la verificación en dos pasos. Los códigos anteriores ya no funcionan."

msgid "Użyto kodu zapasowego"
msgstr "Se ha usado un código de respaldo"

msgid "Do zalogowania na Twoje konto użyto jednego z kodów zapasowych."
msgstr "Se ha usado uno de tus códigos de respaldo para iniciar sesión en tu cuenta."

msgid "Organizator zdjął logowanie dwuskładnikowe"
msgstr "El organizador ha quitado la verificación en dos pasos"

msgid "Organizator zdjął logowanie dwuskładnikowe z Twojego konta (np. po zgłoszeniu zgubionego telefonu). Po zalogowaniu hasłem skonfiguruj je od nowa na nowym urządzeniu."
msgstr "El organizador ha quitado la verificación en dos pasos de tu cuenta (por ejemplo, tras comunicar la pérdida del teléfono). Después de iniciar sesión con tu contraseña, vuelve a configurarla en tu nuevo dispositivo."

msgid "Wstrzymano logowanie po błędnych kodach"
msgstr "Inicio de sesión suspendido tras códigos incorrectos"

#, python-format
msgid "Na Twoje konto kilka razy z rzędu wpisano błędny kod logowania dwuskładnikowego. Logowanie kodem jest wstrzymane na %(minutes)s min."
msgstr "Se ha introducido varias veces seguidas un código incorrecto de verificación en dos pasos en tu cuenta. El inicio de sesión con código queda suspendido durante %(minutes)s min."

#, python-format
msgid "Zostało kodów zapasowych: %(left)s."
msgstr "Códigos de respaldo restantes: %(left)s."

#, python-format
msgid "Konto: %(email)s"
msgstr "Cuenta: %(email)s"

#, python-format
msgid "Kiedy: %(when)s"
msgstr "Cuándo: %(when)s"

msgid "Jeśli ta wiadomość Cię zaskoczyła, natychmiast zmień hasło i skontaktuj się z organizatorem – ktoś może znać Twoje hasło."
msgstr "Si este mensaje te sorprende, cambia tu contraseña de inmediato y ponte en contacto con el organizador: alguien podría conocer tu contraseña."

#, python-format
msgid "%(what)s – %(competition)s"
msgstr "%(what)s – %(competition)s"

msgid "Hasło się nie zgadza."
msgstr "La contraseña no es correcta."

#, python-format
msgid "Zbyt wiele błędnych kodów. Spróbuj ponownie za %(minutes)s min."
msgstr "Demasiados códigos incorrectos. Inténtalo de nuevo dentro de %(minutes)s min."

msgid "Kod nie pasuje."
msgstr "El código no coincide."

#, python-format
msgid "Zbyt wiele błędnych kodów z rzędu. Logowanie kodem jest wstrzymane na %(minutes)s min – wysłaliśmy też list na adres konta."
msgstr "Demasiados códigos incorrectos seguidos. El inicio de sesión con código queda suspendido durante %(minutes)s min; también hemos enviado un correo a la dirección de la cuenta."

#, python-format
msgid "Twoja rola w tym serwisie wymaga logowania dwuskładnikowego. Włącz je do %(deadline)s – potem bez niego nie wejdziesz do panelu."
msgstr "Tu función en este sitio requiere la verificación en dos pasos. Actívala antes del %(deadline)s; después no podrás acceder al panel sin ella."

msgid "Twoja rola w tym serwisie wymaga logowania dwuskładnikowego. Włącz je teraz, żeby wrócić do panelu."
msgstr "Tu función en este sitio requiere la verificación en dos pasos. Actívala ahora para volver al panel."

msgid "Nowy komplet unieważnia wszystkie dotychczasowe kody. Potrzebne będą hasło i bieżący kod."
msgstr "Un nuevo conjunto invalida todos los códigos actuales. Necesitarás tu contraseña y un código actual."

msgid "Wygeneruj nowe kody zapasowe"
msgstr "Generar nuevos códigos de respaldo"

msgid "Twoja rola wymaga logowania dwuskładnikowego – po wyłączeniu trzeba będzie od razu skonfigurować je ponownie."
msgstr "Tu función requiere la verificación en dos pasos: después de desactivarla tendrás que configurarla de nuevo de inmediato."

msgid "Kod z aplikacji albo kod zapasowy"
msgstr "Código de la aplicación o código de respaldo"

#, python-format
msgid "Nie pytaj o kod na tym urządzeniu do %(until)s"
msgstr "No pedir código en este dispositivo hasta el %(until)s"

msgid "Zaznacz wyłącznie na własnym komputerze – nie na wspólnym w szkole ani w biurze."
msgstr "Márcalo solo en tu propio ordenador, no en uno compartido en la escuela o en la oficina."

msgid "Włącz teraz"
msgstr "Activar ahora"
