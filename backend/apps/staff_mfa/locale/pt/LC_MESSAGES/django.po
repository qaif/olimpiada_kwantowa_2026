# Logowanie dwuskładnikowe personelu (SEC-01) – katalog aplikacji apps.staff_mfa.
# Angielski przejrzany ręcznie; pozostałe języki maszynowe (do przeglądu native speakerów, I18N-01 § 8).
msgid ""
msgstr ""
"Project-Id-Version: olimpiada\n"
"Language: pt\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Włączono logowanie dwuskładnikowe"
msgstr "Autenticação de dois fatores ativada"

msgid "Na Twoim koncie włączono logowanie dwuskładnikowe (kod z aplikacji w telefonie)."
msgstr "A autenticação de dois fatores foi ativada na sua conta (código de um aplicativo no seu celular)."

msgid "Wyłączono logowanie dwuskładnikowe"
msgstr "Autenticação de dois fatores desativada"

msgid "Na Twoim koncie wyłączono logowanie dwuskładnikowe. Konto chroni teraz samo hasło."
msgstr "A autenticação de dois fatores foi desativada na sua conta. Agora sua conta está protegida apenas pela senha."

msgid "Nowe kody zapasowe"
msgstr "Novos códigos de backup"

msgid "Wygenerowano nowy komplet kodów zapasowych do logowania dwuskładnikowego. Poprzednie kody przestały działać."
msgstr "Foi gerado um novo conjunto de códigos de backup para a autenticação de dois fatores. Os códigos anteriores deixaram de funcionar."

msgid "Użyto kodu zapasowego"
msgstr "Código de backup utilizado"

msgid "Do zalogowania na Twoje konto użyto jednego z kodów zapasowych."
msgstr "Um dos seus códigos de backup foi usado para entrar na sua conta."

msgid "Organizator zdjął logowanie dwuskładnikowe"
msgstr "O organizador removeu a autenticação de dois fatores"

msgid "Organizator zdjął logowanie dwuskładnikowe z Twojego konta (np. po zgłoszeniu zgubionego telefonu). Po zalogowaniu hasłem skonfiguruj je od nowa na nowym urządzeniu."
msgstr "O organizador removeu a autenticação de dois fatores da sua conta (por exemplo, após a comunicação de um celular perdido). Depois de entrar com sua senha, configure-a novamente no novo dispositivo."

msgid "Wstrzymano logowanie po błędnych kodach"
msgstr "Login suspenso após códigos incorretos"

#, python-format
msgid "Na Twoje konto kilka razy z rzędu wpisano błędny kod logowania dwuskładnikowego. Logowanie kodem jest wstrzymane na %(minutes)s min."
msgstr "Um código incorreto de autenticação de dois fatores foi digitado várias vezes seguidas na sua conta. O login com código está suspenso por %(minutes)s min."

#, python-format
msgid "Zostało kodów zapasowych: %(left)s."
msgstr "Códigos de backup restantes: %(left)s."

#, python-format
msgid "Konto: %(email)s"
msgstr "Conta: %(email)s"

#, python-format
msgid "Kiedy: %(when)s"
msgstr "Quando: %(when)s"

msgid "Jeśli ta wiadomość Cię zaskoczyła, natychmiast zmień hasło i skontaktuj się z organizatorem – ktoś może znać Twoje hasło."
msgstr "Se esta mensagem o surpreendeu, altere sua senha imediatamente e entre em contato com o organizador – alguém pode conhecer sua senha."

#, python-format
msgid "%(what)s – %(competition)s"
msgstr "%(what)s – %(competition)s"

msgid "Hasło się nie zgadza."
msgstr "A senha está incorreta."

#, python-format
msgid "Zbyt wiele błędnych kodów. Spróbuj ponownie za %(minutes)s min."
msgstr "Muitos códigos incorretos. Tente novamente em %(minutes)s min."

msgid "Kod nie pasuje."
msgstr "O código não confere."

#, python-format
msgid "Zbyt wiele błędnych kodów z rzędu. Logowanie kodem jest wstrzymane na %(minutes)s min – wysłaliśmy też list na adres konta."
msgstr "Muitos códigos incorretos seguidos. O login com código está suspenso por %(minutes)s min – também enviamos um e-mail para o endereço da conta."

#, python-format
msgid "Twoja rola w tym serwisie wymaga logowania dwuskładnikowego. Włącz je do %(deadline)s – potem bez niego nie wejdziesz do panelu."
msgstr "Sua função neste site exige autenticação de dois fatores. Ative-a até %(deadline)s – depois disso, você não poderá acessar o painel sem ela."

msgid "Twoja rola w tym serwisie wymaga logowania dwuskładnikowego. Włącz je teraz, żeby wrócić do panelu."
msgstr "Sua função neste site exige autenticação de dois fatores. Ative-a agora para voltar ao painel."

msgid "Nowy komplet unieważnia wszystkie dotychczasowe kody. Potrzebne będą hasło i bieżący kod."
msgstr "Um novo conjunto invalida todos os seus códigos atuais. Você precisará da sua senha e de um código atual."

msgid "Wygeneruj nowe kody zapasowe"
msgstr "Gerar novos códigos de backup"

msgid "Twoja rola wymaga logowania dwuskładnikowego – po wyłączeniu trzeba będzie od razu skonfigurować je ponownie."
msgstr "Sua função exige autenticação de dois fatores – depois de desativá-la, será preciso configurá-la novamente de imediato."

msgid "Kod z aplikacji albo kod zapasowy"
msgstr "Código do aplicativo ou código de backup"

#, python-format
msgid "Nie pytaj o kod na tym urządzeniu do %(until)s"
msgstr "Não pedir código neste dispositivo até %(until)s"

msgid "Zaznacz wyłącznie na własnym komputerze – nie na wspólnym w szkole ani w biurze."
msgstr "Marque apenas no seu próprio computador – não em um computador compartilhado na escola ou no escritório."

msgid "Włącz teraz"
msgstr "Ativar agora"
