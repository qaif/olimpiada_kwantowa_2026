# Logowanie dwuskładnikowe personelu (SEC-01) – katalog aplikacji apps.staff_mfa.
# Angielski przejrzany ręcznie; pozostałe języki maszynowe (do przeglądu native speakerów, I18N-01 § 8).
msgid ""
msgstr ""
"Project-Id-Version: olimpiada\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Włączono logowanie dwuskładnikowe"
msgstr "Two-factor authentication enabled"

msgid "Na Twoim koncie włączono logowanie dwuskładnikowe (kod z aplikacji w telefonie)."
msgstr "Two-factor authentication has been enabled on your account (a code from an app on your phone)."

msgid "Wyłączono logowanie dwuskładnikowe"
msgstr "Two-factor authentication disabled"

msgid "Na Twoim koncie wyłączono logowanie dwuskładnikowe. Konto chroni teraz samo hasło."
msgstr "Two-factor authentication has been disabled on your account. Your account is now protected by your password alone."

msgid "Nowe kody zapasowe"
msgstr "New backup codes"

msgid "Wygenerowano nowy komplet kodów zapasowych do logowania dwuskładnikowego. Poprzednie kody przestały działać."
msgstr "A new set of backup codes for two-factor authentication has been generated. Your previous codes no longer work."

msgid "Użyto kodu zapasowego"
msgstr "Backup code used"

msgid "Do zalogowania na Twoje konto użyto jednego z kodów zapasowych."
msgstr "One of your backup codes was used to sign in to your account."

msgid "Organizator zdjął logowanie dwuskładnikowe"
msgstr "The organiser removed two-factor authentication"

msgid "Organizator zdjął logowanie dwuskładnikowe z Twojego konta (np. po zgłoszeniu zgubionego telefonu). Po zalogowaniu hasłem skonfiguruj je od nowa na nowym urządzeniu."
msgstr "The organiser removed two-factor authentication from your account (for example after a lost phone was reported). After signing in with your password, set it up again on your new device."

msgid "Wstrzymano logowanie po błędnych kodach"
msgstr "Sign-in paused after incorrect codes"

#, python-format
msgid "Na Twoje konto kilka razy z rzędu wpisano błędny kod logowania dwuskładnikowego. Logowanie kodem jest wstrzymane na %(minutes)s min."
msgstr "An incorrect two-factor authentication code was entered for your account several times in a row. Signing in with a code is paused for %(minutes)s min."

#, python-format
msgid "Zostało kodów zapasowych: %(left)s."
msgstr "Backup codes left: %(left)s."

#, python-format
msgid "Konto: %(email)s"
msgstr "Account: %(email)s"

#, python-format
msgid "Kiedy: %(when)s"
msgstr "When: %(when)s"

msgid "Jeśli ta wiadomość Cię zaskoczyła, natychmiast zmień hasło i skontaktuj się z organizatorem – ktoś może znać Twoje hasło."
msgstr "If this message surprises you, change your password immediately and contact the organiser – someone may know your password."

#, python-format
msgid "%(what)s – %(competition)s"
msgstr "%(what)s – %(competition)s"

msgid "Hasło się nie zgadza."
msgstr "The password is incorrect."

#, python-format
msgid "Zbyt wiele błędnych kodów. Spróbuj ponownie za %(minutes)s min."
msgstr "Too many incorrect codes. Try again in %(minutes)s min."

msgid "Kod nie pasuje."
msgstr "The code does not match."

#, python-format
msgid "Zbyt wiele błędnych kodów z rzędu. Logowanie kodem jest wstrzymane na %(minutes)s min – wysłaliśmy też list na adres konta."
msgstr "Too many incorrect codes in a row. Signing in with a code is paused for %(minutes)s min – we have also sent an email to the account address."

#, python-format
msgid "Twoja rola w tym serwisie wymaga logowania dwuskładnikowego. Włącz je do %(deadline)s – potem bez niego nie wejdziesz do panelu."
msgstr "Your role on this site requires two-factor authentication. Turn it on by %(deadline)s – after that you will not be able to access the panel without it."

msgid "Twoja rola w tym serwisie wymaga logowania dwuskładnikowego. Włącz je teraz, żeby wrócić do panelu."
msgstr "Your role on this site requires two-factor authentication. Turn it on now to get back to the panel."

msgid "Nowy komplet unieważnia wszystkie dotychczasowe kody. Potrzebne będą hasło i bieżący kod."
msgstr "A new set invalidates all of your current codes. You will need your password and a current code."

msgid "Wygeneruj nowe kody zapasowe"
msgstr "Generate new backup codes"

msgid "Twoja rola wymaga logowania dwuskładnikowego – po wyłączeniu trzeba będzie od razu skonfigurować je ponownie."
msgstr "Your role requires two-factor authentication – after turning it off you will have to set it up again straight away."

msgid "Kod z aplikacji albo kod zapasowy"
msgstr "Code from the app or a backup code"

#, python-format
msgid "Nie pytaj o kod na tym urządzeniu do %(until)s"
msgstr "Don't ask for a code on this device until %(until)s"

msgid "Zaznacz wyłącznie na własnym komputerze – nie na wspólnym w szkole ani w biurze."
msgstr "Tick this only on your own computer – not on a shared one at school or in an office."

msgid "Włącz teraz"
msgstr "Turn on now"

msgid "Zapamiętane urządzenia"
msgstr "Remembered devices"

msgid "Przeglądarki, w których zaznaczono „nie pytaj o kod”, przestaną być zapamiętane – także te, do których nie masz już dostępu."
msgstr "Browsers where “don't ask for a code” was ticked will no longer be remembered – including ones you no longer have access to."

msgid "Zapomnij wszystkie urządzenia"
msgstr "Forget all devices"

msgid "Zapomnieliśmy wszystkie zapamiętane urządzenia – przy następnym logowaniu podasz kod."
msgstr "All remembered devices have been forgotten – you will be asked for a code the next time you sign in."
