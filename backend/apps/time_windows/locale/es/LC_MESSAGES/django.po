#, python-format
msgid "Twoje okno czasowe: %(label)s"
msgstr "Tu franja horaria: %(label)s"

#, python-format
msgid "Twoje okno czasowe %(label)s: %(stage)s"
msgstr "Tu franja horaria %(label)s: %(stage)s"

msgid "Start"
msgstr "Inicio"

msgid "Koniec"
msgstr "Fin"

msgid "Strefa czasowa"
msgstr "Zona horaria"

msgid "Dodatkowy czas"
msgstr "Tiempo adicional"

#, python-format
msgid "%(minutes)s min"
msgstr "%(minutes)s min"

msgid "Zadania zobaczysz dopiero na starcie swojego okna. Do końca ostatniego okna wszystkich krajów nie rozmawiaj o zadaniach – forum i wiadomości są wtedy moderowane."
msgstr "Verás los problemas solo cuando empiece tu franja. Hasta que termine la última franja de todos los países, no comentes los problemas: el foro y los mensajes están moderados durante ese tiempo."

msgid "Okna czasowe drużyny"
msgstr "Franjas horarias del equipo"

msgid "Panel opiekuna drużyny"
msgstr "Panel del líder del equipo"

#, python-format
msgid "Okna czasowe: %(country)s"
msgstr "Franjas horarias: %(country)s"

#, python-format
msgid "Strefa czasowa kraju: %(zone)s. Każdy uczeń zaczyna etap na starcie okna przydzielonego przez organizatora i widzi godziny w swojej strefie."
msgstr "Zona horaria del país: %(zone)s. Cada estudiante empieza la fase al inicio de la franja asignada por el organizador y ve las horas en su propia zona horaria."

#, python-format
msgid "Czas pracy: %(duration)s."
msgstr "Tiempo de trabajo: %(duration)s."

msgid "Okna uczniów w etapie"
msgstr "Franjas de los estudiantes en la fase"

msgid "Uczeń"
msgstr "Estudiante"

msgid "Okno"
msgstr "Franja"

msgid "Start (strefa ucznia)"
msgstr "Inicio (zona del estudiante)"

msgid "Koniec (strefa ucznia)"
msgstr "Fin (zona del estudiante)"

msgid "Nie zgłoszono jeszcze żadnego ucznia."
msgstr "Todavía no se ha inscrito a ningún estudiante."

msgid "Żaden etap tej edycji nie ma jeszcze okien czasowych."
msgstr "Ninguna fase de esta edición tiene aún franjas horarias."

msgid "Strefy czasowe uczniów"
msgstr "Zonas horarias de los estudiantes"

msgid "Strefa zmienia tylko to, jak uczeń widzi godziny w swoim panelu. Nie zmienia jego okna."
msgstr "La zona horaria solo cambia cómo ve las horas el estudiante en su panel. No cambia su franja."

msgid "jak kraj drużyny"
msgstr "como el país del equipo"

msgid "Zapisz"
msgstr "Guardar"

msgid "Okna czasowe i strefy uczniów"
msgstr "Franjas horarias y zonas de los estudiantes"

msgid "Wybierz strefę czasową z listy."
msgstr "Elige una zona horaria de la lista."

msgid "Strefa czasowa ucznia została zapisana."
msgstr "Se ha guardado la zona horaria del estudiante."

#, python-format
msgid "Wysłano (%(zone)s)"
msgstr "Enviado (%(zone)s)"

#, python-format
msgid "Złożona (%(zone)s)"
msgstr "Presentada (%(zone)s)"

#, python-format
msgid "Data (%(zone)s)"
msgstr "Fecha (%(zone)s)"

#, python-format
msgid "Terminy edycji. Wszystkie godziny: %(zone)s."
msgstr "Fechas de la edición. Todas las horas: %(zone)s."

#, python-format
msgid "Wszystkie godziny: %(zone)s."
msgstr "Todas las horas: %(zone)s."

#, python-format
msgid "Pokój otwiera się %(opens)s (%(zone)s). Wchodzi się wyłącznie tym przyciskiem – adresu pokoju nie da się podać przez telefon ani przesłać dalej."
msgstr "La sala se abre a las %(opens)s (%(zone)s). Solo se entra con este botón: la dirección de la sala no se puede dar por teléfono ni reenviar."
