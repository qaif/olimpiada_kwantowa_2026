#, python-format
msgid "Twoje okno czasowe: %(label)s"
msgstr "Sua janela de horário: %(label)s"

#, python-format
msgid "Twoje okno czasowe %(label)s: %(stage)s"
msgstr "Sua janela de horário %(label)s: %(stage)s"

msgid "Start"
msgstr "Início"

msgid "Koniec"
msgstr "Fim"

msgid "Strefa czasowa"
msgstr "Fuso horário"

msgid "Dodatkowy czas"
msgstr "Tempo adicional"

#, python-format
msgid "%(minutes)s min"
msgstr "%(minutes)s min"

msgid "Zadania zobaczysz dopiero na starcie swojego okna. Do końca ostatniego okna wszystkich krajów nie rozmawiaj o zadaniach – forum i wiadomości są wtedy moderowane."
msgstr "Você verá os problemas apenas quando sua janela começar. Até o fim da última janela de todos os países, não discuta os problemas – o fórum e as mensagens são moderados nesse período."

msgid "Okna czasowe drużyny"
msgstr "Janelas de horário da equipe"

msgid "Panel opiekuna drużyny"
msgstr "Painel do líder da equipe"

#, python-format
msgid "Okna czasowe: %(country)s"
msgstr "Janelas de horário: %(country)s"

#, python-format
msgid "Strefa czasowa kraju: %(zone)s. Każdy uczeń zaczyna etap na starcie okna przydzielonego przez organizatora i widzi godziny w swojej strefie."
msgstr "Fuso horário do país: %(zone)s. Cada estudante começa a etapa no início da janela atribuída pelo organizador e vê os horários no seu próprio fuso."

#, python-format
msgid "Czas pracy: %(duration)s."
msgstr "Tempo de prova: %(duration)s."

msgid "Okna uczniów w etapie"
msgstr "Janelas dos estudantes na etapa"

msgid "Uczeń"
msgstr "Estudante"

msgid "Okno"
msgstr "Janela"

msgid "Start (strefa ucznia)"
msgstr "Início (fuso do estudante)"

msgid "Koniec (strefa ucznia)"
msgstr "Fim (fuso do estudante)"

msgid "Nie zgłoszono jeszcze żadnego ucznia."
msgstr "Nenhum estudante foi inscrito ainda."

msgid "Żaden etap tej edycji nie ma jeszcze okien czasowych."
msgstr "Nenhuma etapa desta edição tem janelas de horário ainda."

msgid "Strefy czasowe uczniów"
msgstr "Fusos horários dos estudantes"

msgid "Strefa zmienia tylko to, jak uczeń widzi godziny w swoim panelu. Nie zmienia jego okna."
msgstr "O fuso altera apenas como o estudante vê os horários no seu painel. Não altera a sua janela."

msgid "jak kraj drużyny"
msgstr "como o país da equipe"

msgid "Zapisz"
msgstr "Salvar"

msgid "Okna czasowe i strefy uczniów"
msgstr "Janelas de horário e fusos dos estudantes"

msgid "Wybierz strefę czasową z listy."
msgstr "Escolha um fuso horário da lista."

msgid "Strefa czasowa ucznia została zapisana."
msgstr "O fuso horário do estudante foi salvo."

#, python-format
msgid "Wysłano (%(zone)s)"
msgstr "Enviado (%(zone)s)"

#, python-format
msgid "Złożona (%(zone)s)"
msgstr "Apresentada (%(zone)s)"

#, python-format
msgid "Data (%(zone)s)"
msgstr "Data (%(zone)s)"

#, python-format
msgid "Terminy edycji. Wszystkie godziny: %(zone)s."
msgstr "Datas da edição. Todos os horários: %(zone)s."

#, python-format
msgid "Wszystkie godziny: %(zone)s."
msgstr "Todos os horários: %(zone)s."

#, python-format
msgid "Pokój otwiera się %(opens)s (%(zone)s). Wchodzi się wyłącznie tym przyciskiem – adresu pokoju nie da się podać przez telefon ani przesłać dalej."
msgstr "A sala abre às %(opens)s (%(zone)s). Só se entra por este botão – o endereço da sala não pode ser dado por telefone nem reencaminhado."
