#, python-format
msgid "Twoje okno czasowe: %(label)s"
msgstr "نافذتك الزمنية: %(label)s"

#, python-format
msgid "Twoje okno czasowe %(label)s: %(stage)s"
msgstr "نافذتك الزمنية %(label)s: %(stage)s"

msgid "Start"
msgstr "البداية"

msgid "Koniec"
msgstr "النهاية"

msgid "Strefa czasowa"
msgstr "المنطقة الزمنية"

msgid "Dodatkowy czas"
msgstr "وقت إضافي"

#, python-format
msgid "%(minutes)s min"
msgstr "%(minutes)s دقيقة"

msgid "Zadania zobaczysz dopiero na starcie swojego okna. Do końca ostatniego okna wszystkich krajów nie rozmawiaj o zadaniach – forum i wiadomości są wtedy moderowane."
msgstr "سترى المسائل فقط عند بدء نافذتك. لا تناقش المسائل حتى تنتهي النافذة الأخيرة لجميع الدول – يخضع المنتدى والرسائل للإشراف خلال تلك الفترة."

msgid "Okna czasowe drużyny"
msgstr "النوافذ الزمنية للفريق"

msgid "Panel opiekuna drużyny"
msgstr "لوحة قائد الفريق"

#, python-format
msgid "Okna czasowe: %(country)s"
msgstr "النوافذ الزمنية: %(country)s"

#, python-format
msgid "Strefa czasowa kraju: %(zone)s. Każdy uczeń zaczyna etap na starcie okna przydzielonego przez organizatora i widzi godziny w swojej strefie."
msgstr "المنطقة الزمنية للدولة: %(zone)s. يبدأ كل طالب المرحلة عند بدء النافذة التي يحددها المنظِّم ويرى الأوقات بمنطقته الزمنية."

#, python-format
msgid "Czas pracy: %(duration)s."
msgstr "وقت العمل: %(duration)s."

msgid "Okna uczniów w etapie"
msgstr "نوافذ الطلاب في المرحلة"

msgid "Uczeń"
msgstr "الطالب"

msgid "Okno"
msgstr "النافذة"

msgid "Start (strefa ucznia)"
msgstr "البداية (منطقة الطالب الزمنية)"

msgid "Koniec (strefa ucznia)"
msgstr "النهاية (منطقة الطالب الزمنية)"

msgid "Nie zgłoszono jeszcze żadnego ucznia."
msgstr "لم يُسجَّل أي طالب بعد."

msgid "Żaden etap tej edycji nie ma jeszcze okien czasowych."
msgstr "لا توجد نوافذ زمنية بعد لأي مرحلة من هذه الدورة."

msgid "Strefy czasowe uczniów"
msgstr "المناطق الزمنية للطلاب"

msgid "Strefa zmienia tylko to, jak uczeń widzi godziny w swoim panelu. Nie zmienia jego okna."
msgstr "تغيّر المنطقة الزمنية فقط طريقة عرض الأوقات في لوحة الطالب، ولا تغيّر نافذته."

msgid "jak kraj drużyny"
msgstr "مثل دولة الفريق"

msgid "Zapisz"
msgstr "حفظ"

msgid "Okna czasowe i strefy uczniów"
msgstr "النوافذ الزمنية والمناطق الزمنية للطلاب"

msgid "Wybierz strefę czasową z listy."
msgstr "اختر منطقة زمنية من القائمة."

msgid "Strefa czasowa ucznia została zapisana."
msgstr "تم حفظ المنطقة الزمنية للطالب."
