msgid "Wiadomość od organizatora"
msgstr "Сообщение от организатора"

msgid "Wiadomość od uczestnika"
msgstr "Сообщение от участника"

msgid "Ogłoszenie organizatora"
msgstr "Объявление организатора"

msgid "Zaświadczenie zaakceptowane"
msgstr "Справка принята"

msgid "Zaświadczenie odrzucone"
msgstr "Справка отклонена"

msgid "Odpowiedź na forum"
msgstr "Ответ на форуме"

msgid "Decyzja moderatora forum"
msgstr "Решение модератора форума"

msgid "Ogłoszone wyniki"
msgstr "Опубликованные результаты"

msgid "Decyzja w sprawie reklamacji"
msgstr "Решение по апелляции"

msgid "Nowa wiadomość od organizatora"
msgstr "Новое сообщение от организатора"

msgid "Nowa wiadomość w rozmowie z innym uczestnikiem"
msgstr "Новое сообщение в переписке с другим участником"

#, python-format
msgid "Nowe ogłoszenie organizatora: %(title)s"
msgstr "Новое объявление организатора: %(title)s"

msgid "Zaświadczenie o statusie ucznia zostało zaakceptowane"
msgstr "Справка о статусе учащегося принята"

msgid "Zaświadczenie o statusie ucznia zostało odrzucone – sprawdź powód"
msgstr "Справка о статусе учащегося отклонена — посмотрите причину"

msgid "Nowa odpowiedź w obserwowanym wątku na forum"
msgstr "Новый ответ в теме форума, которую вы отслеживаете"

msgid "Moderator forum podjął decyzję w sprawie Twojego wpisu"
msgstr "Модератор форума принял решение по вашему сообщению"

#, python-format
msgid "Ogłoszono wyniki: %(stage)s"
msgstr "Опубликованы результаты: %(stage)s"

msgid "Komisja rozpatrzyła Twoją reklamację"
msgstr "Комиссия рассмотрела вашу апелляцию"

msgid "Nowe powiadomienie"
msgstr "Новое уведомление"

msgid "Wszystkie powiadomienia oznaczono jako przeczytane."
msgstr "Все уведомления отмечены как прочитанные."

msgid "Powiadomienia"
msgstr "Уведомления"

msgid "Oznacz wszystkie jako przeczytane"
msgstr "Отметить все как прочитанные"

msgid "nowe"
msgstr "новое"

msgid "Nowsze"
msgstr "Новее"

msgid "Starsze"
msgstr "Старше"

msgid "Nie masz jeszcze powiadomień"
msgstr "У вас пока нет уведомлений"

msgid "Pojawią się tu nowe wiadomości, ogłoszenia organizatora, decyzje w sprawie zaświadczenia i reklamacji oraz ogłoszone wyniki."
msgstr "Здесь появятся новые сообщения, объявления организатора, решения по справке и апелляциям, а также опубликованные результаты."

msgid "Strony powiadomień"
msgstr "Страницы уведомлений"

#, python-format
msgid "Nowe wiadomości, ogłoszenia organizatora, decyzje i wyniki – w jednym miejscu. Powiadomienia starsze niż %(days)s dni usuwamy automatycznie."
msgstr "Новые сообщения, объявления организатора, решения и результаты — в одном месте. Уведомления старше %(days)s дней удаляются автоматически."
