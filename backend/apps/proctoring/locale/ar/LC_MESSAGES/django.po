msgid "Kategoria"
msgstr "الفئة"

msgid "Waga"
msgstr "درجة الخطورة"

msgid "Notatka"
msgstr "ملاحظة"

msgid "Czas incydentu zapisze się jako chwila otwarcia tego okna."
msgstr "سيُسجَّل وقت الحادثة على أنه لحظة فتح هذه النافذة."

msgid "Zapisz incydent"
msgstr "حفظ الحادثة"

msgid "Anuluj"
msgstr "إلغاء"

msgid "Etapy do nadzoru"
msgstr "المراحل الخاضعة للمراقبة"

msgid "Otwórz siatkę nadzoru"
msgstr "فتح شبكة المراقبة"

msgid "Nie masz etapów do nadzoru."
msgstr "ليست لديك مراحل للمراقبة."

msgid "Raport nadzoru"
msgstr "تقرير المراقبة"

msgid "Zgoda"
msgstr "الموافقة"

msgid "wycofana"
msgstr "مسحوبة"

msgid "zgoda opiekuna potwierdzona online"
msgstr "موافقة وليّ الأمر مؤكَّدة عبر الإنترنت"

msgid "brak"
msgstr "لا يوجد"

msgid "Sprawdzenie sprzętu"
msgstr "التحقق من الأجهزة"

msgid "Nadzór rozpoczęty"
msgstr "بدأت المراقبة"

msgid "Bez nadzoru od"
msgstr "دون مراقبة منذ"

msgid "Obecność"
msgstr "الحضور"

msgid "Inna forma nadzoru"
msgstr "شكل آخر من المراقبة"

msgid "Zdjęcie dokumentu"
msgstr "صورة الوثيقة"

msgid "otwórz (15 min)"
msgstr "فتح (15 دقيقة)"

msgid "Wstrzymanie usunięcia"
msgstr "تعليق الحذف"

msgid "Nośniki usunięte"
msgstr "تم حذف ملفات الوسائط"

msgid "Incydenty"
msgstr "الحوادث"

msgid "Czas"
msgstr "الوقت"

msgid "Zgłosił"
msgstr "المُبلِّغ"

msgid "Brak incydentów."
msgstr "لا توجد حوادث."

msgid "Wiadomości do ucznia"
msgstr "الرسائل إلى الطالب"

msgid "potwierdzona"
msgstr "مؤكَّدة"

msgid "Brak wiadomości."
msgstr "لا توجد رسائل."

msgid "Nagrania"
msgstr "التسجيلات"

msgid "odtwórz (15 min)"
msgstr "تشغيل (15 دقيقة)"

msgid "Brak nagrań."
msgstr "لا توجد تسجيلات."

msgid "Dziennik"
msgstr "السجل"

msgid "Dziennik jest pusty albo został już usunięty (retencja)."
msgstr "السجل فارغ أو حُذف بالفعل (انتهت مدة الاحتفاظ)."

msgid "Za dużo żądań. Spróbuj za chwilę."
msgstr "طلبات كثيرة جدًا. حاول مرة أخرى بعد قليل."

msgid "Sprawdzanie…"
msgstr "جارٍ التحقق…"

msgid "działa"
msgstr "يعمل"

msgid "nie działa"
msgstr "لا يعمل"

msgid "niewymagane"
msgstr "غير مطلوب"

msgid ""
"Ta przeglądarka nie obsługuje nadzoru wideo. Użyj aktualnej przeglądarki "
"Chrome, Edge, Firefox albo Safari."
msgstr ""
"هذا المتصفح لا يدعم المراقبة بالفيديو. استخدم إصدارًا حديثًا من Chrome أو "
