msgstr "incidents: %(count)s"

msgid "Wysłano."
msgstr "Sent."

msgid "Zapisano."
msgstr "Saved."

msgid "Dźwięk"
msgstr "Audio"

msgid "Raport"
msgstr "Report"

msgid "uczeń poza kadrem"
msgstr "student out of frame"

msgid "inna osoba w kadrze"
msgstr "another person in frame"

msgid "inne urządzenie"
msgstr "another device"

msgid "rozmowa lub komunikacja"
msgstr "talking or communication"

msgid "niedozwolone materiały"
msgstr "unauthorized materials"

