msgstr "play (15 min)"

msgid "Brak nagrań."
msgstr "No recordings."

msgid "Dziennik"
msgstr "Log"

msgid "Dziennik jest pusty albo został już usunięty (retencja)."
msgstr "The log is empty or has already been deleted (retention)."

msgid "Za dużo żądań. Spróbuj za chwilę."
msgstr "Too many requests. Please try again in a moment."

msgid "Sprawdzanie…"
msgstr "Checking…"

msgid "działa"
msgstr "working"

msgid "nie działa"
msgstr "not working"

msgid "niewymagane"
msgstr "not required"

msgid ""
"Ta przeglądarka nie obsługuje nadzoru wideo. Użyj aktualnej przeglądarki "
"Chrome, Edge, Firefox albo Safari."
msgstr ""
"This browser does not support video proctoring. Use an up-to-date version "
"of Chrome, Edge, Firefox or Safari."

msgid ""
"Brak dostępu do kamery. Zezwól na kamerę w ustawieniach przeglądarki i "
"spróbuj ponownie."
msgstr ""
"No access to the camera. Allow camera access in your browser settings and "
"try again."

msgid "Łączenie z serwerem nadzoru…"
msgstr "Connecting to the proctoring server…"

msgid "Nadzór działa. Zostaw tę kartę otwartą do końca etapu."
msgstr "Proctoring is active. Keep this tab open until the end of the stage."

msgid ""
"Połączenie nadzoru zostało przerwane. Nie zamykaj tej karty – trwa ponowne "
"łączenie."
msgstr ""
"The proctoring connection was interrupted. Don't close this tab – "
"reconnecting is in progress."

msgid "Połączenie nadzoru przywrócone."
msgstr "Proctoring connection restored."

msgid "Nie udało się połączyć z serwerem nadzoru."
msgstr "Could not connect to the proctoring server."

msgid "Udostępnianie ekranu zostało zatrzymane. Udostępnij ekran ponownie."
msgstr "Screen sharing has stopped. Share your screen again."

msgid "Wiadomość od osoby nadzorującej"
msgstr "Message from the proctor"

msgid "Osoba nadzorująca prosi: pokaż kamerą pokój dookoła siebie."
msgstr "The proctor asks: use your camera to show the room around you."

msgid "Osoba nadzorująca prosi: pokaż do kamery dokument tożsamości."
msgstr "The proctor asks: hold your ID document up to the camera."

msgid "Rozumiem"
msgstr "Got it"

msgid "Coś poszło nie tak. Spróbuj ponownie."
msgstr "Something went wrong. Please try again."

msgid "Spróbuj ponownie"
msgstr "Try again"

msgid "Zgoda na nadzór wycofana."
msgstr "Consent to proctoring withdrawn."

msgid "Zaznacz pole zgody, żeby przejść dalej."
msgstr "Tick the consent box to continue."

msgid "Prośba wysłana. Organizator odpowie w tej konsoli."
msgstr "Request sent. The organizer will reply in this console."

msgid "Połączono z pokojem nadzoru."
msgstr "Connected to the proctoring room."

msgid "Rozłączono z pokojem nadzoru. Odśwież stronę."
msgstr "Disconnected from the proctoring room. Refresh the page."

msgid "Nie udało się połączyć z pokojem nadzoru."
msgstr "Could not connect to the proctoring room."

#, python-format
msgid "Strona %(page)s z %(pages)s"
msgstr "Page %(page)s of %(pages)s"

msgid "Brak uczniów w tej grupie."
msgstr "No students in this group."

