msgstr "screen"

msgid "problem techniczny"
msgstr "technical problem"

msgid "inne"
msgstr "other"

msgid "informacja"
msgstr "info"

msgid "ostrzeżenie"
msgstr "warning"

msgid "poważny"
msgstr "serious"

msgid "Treść tego etapu jest w trakcie zawodów dostępna wyłącznie dla jego uczestników."
msgstr "During the competition, the content of this stage is available only to its participants."

msgid "Mój rodzic lub opiekun prawny zna tę informację o nadzorze zdalnym i zgadza się na niego."
msgstr "My parent or legal guardian knows this information about remote proctoring and agrees to it."

msgid "Zaznacz też oświadczenie o wiedzy i zgodzie rodzica lub opiekuna prawnego."
msgstr "Please also tick the statement about your parent or legal guardian's knowledge and consent."

msgid "Serwer nadzoru działa – spróbuj połączyć się jeszcze raz. Jeśli nie możesz użyć kamery, poproś o inną formę nadzoru."
msgstr "The proctoring server is working – try to connect again. If you cannot use a camera, request another form of proctoring."

msgid "serwer nadzoru nieskonfigurowany"
msgstr "proctoring server not configured"

msgid "serwer nadzoru niedostępny"
msgstr "proctoring server unavailable"

msgid "nieudane połączenia ucznia – serwer działał"
msgstr "student's connection attempts failed – the server was working"

msgid "Praca bez nadzoru – awaria serwera nadzoru została odnotowana."
msgstr "Working without proctoring – the proctoring server failure has been recorded."

msgid "Ustawienia etapu w chwili zgody"
msgstr "Stage settings at the time of consent"

#, python-format
msgid "późny start: %(minutes)s min"
msgstr "late start: %(minutes)s min"

msgid "Kamera nie działa albo nie masz do niej dostępu. Jeśli nie możesz jej użyć, poproś o inną formę nadzoru (na dole strony)."
msgstr "Your camera is not working or you have not allowed access to it. If you cannot use it, request another form of proctoring (at the bottom of the page)."

msgid "Tej osoby nie ma teraz w pokoju."
msgstr "This person is not in the room right now."

msgid "Twoja rozmowa jest nadzorowana zdalnie. Zgoda i sprzęt są gotowe – wejdź na rozmowę przyciskiem „Dołącz do rozmowy”."
msgstr "Your interview is remotely proctored. Your consent and equipment are ready – join with the “Join the interview” button."

msgid "Rozmowa"
msgstr "Interview"

msgid "Nadzór obejmuje Twoją rozmowę w pokoju na platformie – osobnego nadawania nie trzeba włączać. Wejdź na rozmowę z panelu przyciskiem „Dołącz do rozmowy”."
msgstr "Proctoring covers your interview in the platform room – you do not need to start a separate stream. Join the interview from your dashboard with the “Join the interview” button."

msgid "Wyjdź"
msgstr "Leave"

msgid "Obraz uczestników"
msgstr "Participants’ video"

msgid "Uczestnicy"
msgstr "Participants"

msgid "Czat"
msgstr "Chat"

msgid "Wyślij"
msgstr "Send"

msgid "Sterowanie"
msgstr "Controls"

msgid "Podnieś rękę"
msgstr "Raise hand"

msgid "Widok prelegenta"
msgstr "Speaker view"

#, python-format
msgid "Pokój rozmowy otworzy się %(when)s (czas polski) – wróć wtedy do panelu."
msgstr "The interview room opens at %(when)s (Polish time) – come back to the panel then."

msgid "Czas tej rozmowy minął – pokój jest już zamknięty."
msgstr "The time of this interview has passed – the room is closed."

#, python-format
msgid "Próba sprzętu – %(stage)s"
msgstr "Equipment test – %(stage)s"

#, python-format
msgid "Rozmowa – %(stage)s"
msgstr "Interview – %(stage)s"

msgid "Serwer wideo nie odpowiada. Spróbuj za chwilę."
msgstr "The video server is not responding. Please try again in a moment."

msgid "Ta rozmowa jest nadzorowana zdalnie. Najpierw wyraź zgodę i sprawdź sprzęt w konsoli nadzoru."
msgstr "This interview is remotely proctored. First give your consent and check your equipment in the proctoring console."

msgid "Twoja rozmowa jest nadzorowana zdalnie. Przed wejściem na rozmowę wyraź zgodę i sprawdź sprzęt w konsoli nadzoru."
msgstr "Your interview is remotely proctored. Before joining, give your consent and check your equipment in the proctoring console."

msgid "Przejdź do rozmowy"
msgstr "Go to the interview"

msgid "Rozmowa kwalifikacyjna"
msgstr "Qualifying interview"

msgid "Pokój rozmowy wymaga włączonego JavaScriptu."
msgstr "The interview room requires JavaScript to be enabled."

msgid "Pokój jest chwilowo niedostępny – brakuje komponentu wideo na serwerze. Daj znać organizatorowi."
msgstr "The room is temporarily unavailable – the video component is missing on the server. Please let the organiser know."
