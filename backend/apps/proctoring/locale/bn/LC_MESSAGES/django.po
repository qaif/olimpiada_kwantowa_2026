msgid "Powód"
msgstr "কারণ"

msgid "Nie mam kamery"
msgstr "আমার ক্যামেরা নেই"

msgid "Kamera nie działa"
msgstr "ক্যামেরা কাজ করছে না"

msgid "Moja przeglądarka nie obsługuje nadzoru"
msgstr "আমার ব্রাউজার নজরদারি সমর্থন করে না"

msgid "Potrzeby dostępności"
msgstr "প্রবেশযোগ্যতা-সংক্রান্ত প্রয়োজন"

msgid "Inny powód"
msgstr "অন্য কারণ"

msgid "Krótka uwaga (opcjonalnie)"
msgstr "সংক্ষিপ্ত মন্তব্য (ঐচ্ছিক)"

msgid ""
"Nie wpisuj informacji o zdrowiu – organizator skontaktuje się z Tobą, jeśli "
"będzie trzeba."
msgstr "স্বাস্থ্য-সংক্রান্ত তথ্য লিখবেন না – প্রয়োজন হলে আয়োজক আপনার সঙ্গে যোগাযোগ করবেন।"

msgid ""
"Ten etap jest nadzorowany zdalnie. Najpierw włącz nadzór w konsoli nadzoru."
msgstr "এই পর্বে দূরবর্তী নজরদারি চলে। প্রথমে নজরদারি কনসোলে নজরদারি চালু করুন।"

msgid ""
"Zapoznałem/-am się z informacją o nadzorze zdalnym tego etapu i wyrażam "
"zgodę na przekazywanie obrazu z mojej kamery (oraz – jeśli etap tego wymaga "
"– mojego ekranu i dźwięku) osobom nadzorującym na zasadach opisanych powyżej."
msgstr "আমি এই পর্বের দূরবর্তী নজরদারি সম্পর্কিত তথ্য পড়েছি এবং উপরে বর্ণিত শর্তে আমার ক্যামেরার ছবি (এবং – পর্বে প্রয়োজন হলে – আমার স্ক্রিন ও শব্দ) নজরদারিকারীদের কাছে পাঠানোর জন্য সম্মতি দিচ্ছি।"

msgid "Serwer nadzoru nie odpowiada. Spróbuj za chwilę."
msgstr "নজরদারি সার্ভার সাড়া দিচ্ছে না। একটু পরে আবার চেষ্টা করুন।"

#, python-format
msgid "uczniowie: %(name)s"
msgstr "শিক্ষার্থী: %(name)s"

msgid "uczniowie bez przydziału"
msgstr "বরাদ্দহীন শিক্ষার্থী"

msgid ""
"Najpierw potrzebna jest zgoda Twojego rodzica lub opiekuna prawnego, "
"potwierdzona online. Poproś o nią w panelu, w zakładce „Zgody”."
msgstr "প্রথমে আপনার মা-বাবা বা আইনগত অভিভাবকের সম্মতি প্রয়োজন, যা অনলাইনে নিশ্চিত করা হয়েছে। প্যানেলের “সম্মতি” ট্যাবে এর জন্য অনুরোধ করুন।"

msgid "Ten etap nie zbiera zdjęcia dokumentu."
msgstr "এই পর্বে নথির ছবি নেওয়া হয় না।"

msgid "Zdjęcie nie zostało zapisane. Spróbuj jeszcze raz."
msgstr "ছবিটি সংরক্ষিত হয়নি। আবার চেষ্টা করুন।"

msgid "Najpierw wyraź zgodę na nadzór."
msgstr "প্রথমে নজরদারিতে সম্মতি দিন।"

msgid "Najpierw sprawdź sprzęt."
msgstr "প্রথমে সরঞ্জাম পরীক্ষা করুন।"

msgid "Najpierw zrób zdjęcie dokumentu."
msgstr "প্রথমে নথির ছবি তুলুন।"

#, python-format
msgid "Nadzór będzie można włączyć od %(when)s."
msgstr "নজরদারি %(when)s থেকে চালু করা যাবে।"

msgid "Czas tego etapu minął."
msgstr "এই পর্বের সময় শেষ হয়ে গেছে।"

msgid ""
"Serwer nadzoru jeszcze nie widzi Twojej kamery. Poczekaj chwilę i spróbuj "
"ponownie."
msgstr "নজরদারি সার্ভার এখনো আপনার ক্যামেরা দেখতে পাচ্ছে না। একটু অপেক্ষা করে আবার চেষ্টা করুন।"

msgid "Ten etap wymaga działającego nadzoru. Skontaktuj się z organizatorem."
msgstr "এই পর্বে সক্রিয় নজরদারি প্রয়োজন। আয়োজকের সঙ্গে যোগাযোগ করুন।"

msgid "Wybierz powód z listy."
msgstr "তালিকা থেকে একটি কারণ বেছে নিন।"

msgid "Pokój nadzoru jest teraz zamknięty."
msgstr "নজরদারি কক্ষ এখন বন্ধ।"

msgid "Wpisz treść wiadomości."
msgstr "বার্তার বিষয়বস্তু লিখুন।"

msgid "Wybierz kategorię i wagę incydentu."
msgstr "ঘটনার বিভাগ ও গুরুত্ব বেছে নিন।"

msgid "Nadzór zdalny"
msgstr "দূরবর্তী নজরদারি"

msgid ""
"Ten etap jest nadzorowany zdalnie. Konsola nadzoru musi być otwarta w "
"osobnej karcie do końca etapu."
msgstr "এই পর্বে দূরবর্তী নজরদারি চলে। পর্ব শেষ না হওয়া পর্যন্ত নজরদারি কনসোল একটি আলাদা ট্যাবে খোলা রাখতে হবে।"

msgid ""
"Ten etap jest nadzorowany zdalnie. Zanim zobaczysz zadania, wyraź zgodę, "
"sprawdź sprzęt i włącz nadzór w konsoli."
msgstr "এই পর্বে দূরবর্তী নজরদারি চলে। সমস্যাগুলো দেখার আগে সম্মতি দিন, সরঞ্জাম পরীক্ষা করুন এবং কনসোলে নজরদারি চালু করুন।"

msgid "Nadzór działa."
msgstr "নজরদারি চালু আছে।"

msgid ""
"Nadzór nie działa – wróć do karty konsoli nadzoru albo otwórz ją ponownie."
msgstr "নজরদারি কাজ করছে না – নজরদারি কনসোলের ট্যাবে ফিরে যান অথবা সেটি আবার খুলুন।"

msgid "Stan nadzoru: sprawdź kartę konsoli nadzoru."
msgstr "নজরদারির অবস্থা: নজরদারি কনসোলের ট্যাবটি দেখুন।"

msgid "Konsola nadzoru"
msgstr "নজরদারি কনসোল"

msgid "Etap:"
msgstr "পর্ব:"

msgid "Nadzór możesz włączyć od:"
msgstr "নজরদারি চালু করা যাবে এই সময় থেকে:"

msgid "Nadzór zdalny wymaga włączonego JavaScriptu."
msgstr "দূরবর্তী নজরদারির জন্য JavaScript চালু থাকা প্রয়োজন।"

msgid ""
"Nadzór jest chwilowo niedostępny – brakuje komponentu wideo na serwerze. Daj "
"znać organizatorowi."
msgstr "নজরদারি সাময়িকভাবে অনুপলব্ধ – সার্ভারে ভিডিও উপাদান নেই। আয়োজককে জানান।"

msgid "Organizator zatwierdził inną formę nadzoru"
msgstr "আয়োজক নজরদারির অন্য একটি পদ্ধতি অনুমোদন করেছেন"

msgid "Przejdź do etapu"
msgstr "পর্বে যান"

msgid "1. Informacja o nadzorze i zgoda"
msgstr "1. নজরদারি সম্পর্কিত তথ্য ও সম্মতি"

msgid ""
"W czasie etapu obraz z Twojej kamery (mała rozdzielczość) widzą na żywo "
"osoby nadzorujące wskazane przez organizatora: koordynatorzy i członkowie "
"komisji, a w olimpiadzie międzynarodowej także opiekun Twojej drużyny "
"narodowej – wyłącznie uczniów swojej drużyny."
msgstr "পর্ব চলাকালীন আপনার ক্যামেরার ছবি (কম রেজোলিউশনে) আয়োজকের নির্ধারিত নজরদারিকারীরা সরাসরি দেখেন: সমন্বয়ক ও কমিটির সদস্যরা, এবং আন্তর্জাতিক অলিম্পিয়াডে আপনার জাতীয় দলের দলনেতাও – শুধু নিজের দলের শিক্ষার্থীদের।"

msgid ""
"Etap wymaga udostępnienia całego ekranu – osoby nadzorujące mogą go zobaczyć."
msgstr "এই পর্বে পুরো স্ক্রিন শেয়ার করতে হবে – নজরদারিকারীরা তা দেখতে পারেন।"

msgid "Etap wymaga włączonego mikrofonu – osoby nadzorujące mogą Cię słyszeć."
msgstr "এই পর্বে মাইক্রোফোন চালু রাখতে হবে – নজরদারিকারীরা আপনার কথা শুনতে পারেন।"

msgid ""
"Przed startem zrobisz kamerą zdjęcie dokumentu tożsamości (legitymacji "
"szkolnej). Zasłoń numer PESEL i adres – wystarczy imię, nazwisko i zdjęcie."
msgstr "শুরু করার আগে আপনি ক্যামেরা দিয়ে আপনার পরিচয়পত্রের (স্কুলের পরিচয়পত্র) ছবি তুলবেন। PESEL নম্বর (পোল্যান্ডের জাতীয় পরিচয় নম্বর) ও ঠিকানা ঢেকে রাখুন – শুধু নাম, পদবি ও ছবিই যথেষ্ট।"

msgid "Obraz z kamery jest nagrywany."
msgstr "ক্যামেরার ছবি রেকর্ড করা হচ্ছে।"

#, python-format
msgid ""
"Nagranie widzą wyłącznie koordynator i komisja odwoławcza (każde odtworzenie "
"jest zapisywane). Usuwamy je %(days)s dni po ogłoszeniu wyników i zamknięciu "
"okna reklamacji, chyba że trwa wyjaśnianie Twojej sprawy."
msgstr "রেকর্ডিং শুধু সমন্বয়ক ও আপিল কমিটি দেখতে পারেন (প্রতিবার চালানোর হিসাব রাখা হয়)। ফলাফল ঘোষণা ও অভিযোগ জানানোর সময়সীমা শেষ হওয়ার %(days)s দিন পরে আমরা এটি মুছে ফেলি, যদি না আপনার বিষয়টি নিয়ে তদন্ত চলতে থাকে।"

msgid "Obraz nie jest nagrywany – osoby nadzorujące widzą go tylko na żywo."
msgstr "ছবি রেকর্ড করা হয় না – নজরদারিকারীরা এটি শুধু সরাসরি দেখেন।"

msgid ""
"Nie stosujemy automatycznej analizy obrazu ani śledzenia tego, co robisz w "
"przeglądarce. Decyzje podejmują ludzie."
msgstr "আমরা ছবির স্বয়ংক্রিয় বিশ্লেষণ করি না এবং আপনি ব্রাউজারে কী করছেন তাও অনুসরণ করি না। সিদ্ধান্ত নেন মানুষ।"

#, python-format
msgid ""
"Zapisujemy czasy połączeń, wiadomości od osób nadzorujących i ich notatki o "
"incydentach. Dziennik połączeń i wiadomości usuwamy %(days)s dni po "
"ogłoszeniu wyników; notatki o incydentach zostają w dokumentacji zawodów "
"(odwołania)."
msgstr "আমরা সংযোগের সময়, নজরদারিকারীদের বার্তা ও ঘটনা সম্পর্কে তাঁদের নোট সংরক্ষণ করি। সংযোগ ও বার্তার লগ আমরা ফলাফল ঘোষণার %(days)s দিন পরে মুছে ফেলি; ঘটনার নোট প্রতিযোগিতার নথিতে থেকে যায় (আপিলের জন্য)।"

msgid ""
"Zgodę możesz wycofać w każdej chwili. Jeśli nie możesz albo nie chcesz "
"używać kamery, poproś organizatora o inną formę nadzoru (na dole strony)."
msgstr "আপনি যেকোনো সময় সম্মতি প্রত্যাহার করতে পারেন। আপনি যদি ক্যামেরা ব্যবহার করতে না পারেন বা না চান, তাহলে আয়োজকের কাছে নজরদারির অন্য পদ্ধতির অনুরোধ করুন (পৃষ্ঠার নিচে)।"

msgid ""
"Szczegóły przetwarzania danych: polityka prywatności organizatora (sekcja "
"„Nadzór zdalny”)."
msgstr "তথ্য প্রক্রিয়াকরণের বিস্তারিত: আয়োজকের গোপনীয়তা নীতি (“দূরবর্তী নজরদারি” অংশ)।"

#, python-format
msgid "Zgoda wyrażona %(when)s (wersja %(version)s)."
msgstr "সম্মতি দেওয়া হয়েছে %(when)s (সংস্করণ %(version)s)।"

msgid "Wycofaj zgodę"
msgstr "সম্মতি প্রত্যাহার করুন"

msgid ""
"Jesteś osobą niepełnoletnią: zanim wyrazisz zgodę, Twój rodzic lub opiekun "
"prawny musi potwierdzić online swoją zgodę na Twój udział."
msgstr "আপনি অপ্রাপ্তবয়স্ক: সম্মতি দেওয়ার আগে আপনার মা-বাবা বা আইনগত অভিভাবককে অনলাইনে আপনার অংশগ্রহণে তাঁর সম্মতি নিশ্চিত করতে হবে।"

msgid "Poproś opiekuna o zgodę"
msgstr "অভিভাবকের কাছে সম্মতি চান"

msgid "Zgoda Twojego opiekuna prawnego została potwierdzona online."
msgstr "আপনার আইনগত অভিভাবকের সম্মতি অনলাইনে নিশ্চিত হয়েছে।"

#, python-format
msgid "Wersja informacji: %(version)s."
msgstr "তথ্যের সংস্করণ: %(version)s।"

msgid "Wyrażam zgodę"
msgstr "আমি সম্মতি দিচ্ছি"

msgid "2. Sprawdzenie sprzętu"
msgstr "2. সরঞ্জাম পরীক্ষা"

msgid "Podgląd kamery"
msgstr "ক্যামেরার প্রিভিউ"

msgid "Przeglądarka"
msgstr "ব্রাউজার"

msgid "Kamera"
msgstr "ক্যামেরা"

msgid "Mikrofon"
msgstr "মাইক্রোফোন"

msgid "Udostępnianie ekranu"
msgstr "স্ক্রিন শেয়ার"

msgid "Sprawdź sprzęt"
msgstr "সরঞ্জাম পরীক্ষা করুন"

msgid "Sprzęt sprawdzony."
msgstr "সরঞ্জাম পরীক্ষা সম্পন্ন।"

msgid "3. Zdjęcie dokumentu"
msgstr "3. নথির ছবি"

msgid "opcjonalne"
msgstr "ঐচ্ছিক"

msgid ""
"Pokaż do kamery legitymację szkolną albo inny dokument ze zdjęciem i kliknij "
"„Zrób zdjęcie”."
msgstr "ক্যামেরার সামনে আপনার স্কুলের পরিচয়পত্র বা ছবিসহ অন্য কোনো নথি দেখান এবং “ছবি তুলুন”-এ ক্লিক করুন।"

msgid "Zrób zdjęcie"
msgstr "ছবি তুলুন"

msgid "Zdjęcie zapisane."
msgstr "ছবি সংরক্ষিত হয়েছে।"

msgid "4. Start nadzoru"
