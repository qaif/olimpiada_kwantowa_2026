msgid "Zgoda na nadzór wycofana."
msgstr "Consentimento para a supervisão retirado."

msgid "Zaznacz pole zgody, żeby przejść dalej."
msgstr "Marque a caixa de consentimento para continuar."

msgid "Prośba wysłana. Organizator odpowie w tej konsoli."
msgstr "Pedido enviado. O organizador responderá neste console."

msgid "Połączono z pokojem nadzoru."
msgstr "Conectado à sala de supervisão."

msgid "Rozłączono z pokojem nadzoru. Odśwież stronę."
msgstr "Desconectado da sala de supervisão. Atualize a página."

msgid "Nie udało się połączyć z pokojem nadzoru."
msgstr "Não foi possível conectar à sala de supervisão."

