msgstr "Server pengawasan berfungsi – coba sambungkan lagi. Jika Anda tidak dapat menggunakan kamera, ajukan bentuk pengawasan lain."

msgid "serwer nadzoru nieskonfigurowany"
msgstr "server pengawasan belum dikonfigurasi"

msgid "serwer nadzoru niedostępny"
msgstr "server pengawasan tidak tersedia"

msgid "nieudane połączenia ucznia – serwer działał"
