msgid "Nadzór rozpoczęty"
msgstr "Surveillance démarrée"

msgid "Bez nadzoru od"
msgstr "Sans surveillance depuis"

msgid "Obecność"
msgstr "Présence"

msgid "Inna forma nadzoru"
msgstr "Autre forme de surveillance"

msgid "Zdjęcie dokumentu"
msgstr "Photo de la pièce d’identité"

