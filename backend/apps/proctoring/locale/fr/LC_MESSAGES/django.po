msgstr "confirmé"

msgid "Brak wiadomości."
msgstr "Aucun message."

msgid "Nagrania"
msgstr "Enregistrements"

msgid "odtwórz (15 min)"
msgstr "lire (15 min)"

msgid "Brak nagrań."
msgstr "Aucun enregistrement."

msgid "Dziennik"
msgstr "Journal"

msgid "Dziennik jest pusty albo został już usunięty (retencja)."
msgstr "Le journal est vide ou a déjà été supprimé (durée de conservation)."

msgid "Za dużo żądań. Spróbuj za chwilę."
msgstr "Trop de requêtes. Réessayez dans un instant."

msgid "Sprawdzanie…"
msgstr "Vérification…"

msgid "działa"
msgstr "fonctionne"

msgid "nie działa"
msgstr "ne fonctionne pas"

msgid "niewymagane"
msgstr "non requis"

msgid ""
"Ta przeglądarka nie obsługuje nadzoru wideo. Użyj aktualnej przeglądarki "
"Chrome, Edge, Firefox albo Safari."
msgstr ""
"Ce navigateur ne prend pas en charge la surveillance vidéo. Utilisez une "
"version récente de Chrome, Edge, Firefox ou Safari."

msgid ""
"Brak dostępu do kamery. Zezwól na kamerę w ustawieniach przeglądarki i "
"spróbuj ponownie."
msgstr ""
"Pas d’accès à la caméra. Autorisez la caméra dans les paramètres du "
"navigateur et réessayez."

msgid "Łączenie z serwerem nadzoru…"
msgstr "Connexion au serveur de surveillance…"

msgid "Nadzór działa. Zostaw tę kartę otwartą do końca etapu."
msgstr ""
"La surveillance est active. Laissez cet onglet ouvert jusqu’à la fin de "
"l’étape."

msgid ""
"Połączenie nadzoru zostało przerwane. Nie zamykaj tej karty – trwa ponowne "
"łączenie."
msgstr ""
"La connexion de surveillance a été interrompue. Ne fermez pas cet onglet – "
"reconnexion en cours."

msgid "Połączenie nadzoru przywrócone."
msgstr "Connexion de surveillance rétablie."

msgid "Nie udało się połączyć z serwerem nadzoru."
msgstr "Impossible de se connecter au serveur de surveillance."

msgid "Udostępnianie ekranu zostało zatrzymane. Udostępnij ekran ponownie."
msgstr "Le partage d’écran a été arrêté. Partagez de nouveau votre écran."

msgid "Wiadomość od osoby nadzorującej"
msgstr "Message du surveillant"

msgid "Osoba nadzorująca prosi: pokaż kamerą pokój dookoła siebie."
msgstr ""
"Le surveillant vous demande : montrez avec la caméra la pièce autour de "
"vous."

msgid "Osoba nadzorująca prosi: pokaż do kamery dokument tożsamości."
msgstr ""
"Le surveillant vous demande : montrez votre pièce d’identité à la caméra."

msgid "Rozumiem"
msgstr "J’ai compris"

msgid "Coś poszło nie tak. Spróbuj ponownie."
msgstr "Une erreur s’est produite. Réessayez."

msgid "Spróbuj ponownie"
msgstr "Réessayer"

msgid "Zgoda na nadzór wycofana."
msgstr "Consentement à la surveillance retiré."

msgid "Zaznacz pole zgody, żeby przejść dalej."
msgstr "Cochez la case de consentement pour continuer."

msgid "Prośba wysłana. Organizator odpowie w tej konsoli."
msgstr "Demande envoyée. L’organisateur répondra dans cette console."

msgid "Połączono z pokojem nadzoru."
msgstr "Connecté à la salle de surveillance."

msgid "Rozłączono z pokojem nadzoru. Odśwież stronę."
msgstr "Déconnecté de la salle de surveillance. Actualisez la page."

msgid "Nie udało się połączyć z pokojem nadzoru."
msgstr "Impossible de se connecter à la salle de surveillance."

