msgstr "ouvrir (15 min)"

msgid "Wstrzymanie usunięcia"
msgstr "Suspension de la suppression"

msgid "Nośniki usunięte"
msgstr "Médias supprimés"

msgid "Incydenty"
msgstr "Incidents"

msgid "Czas"
msgstr "Heure"

msgid "Zgłosił"
msgstr "Signalé par"

msgid "Brak incydentów."
msgstr "Aucun incident."

msgid "Wiadomości do ucznia"
