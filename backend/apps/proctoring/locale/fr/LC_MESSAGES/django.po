msgid "Czas incydentu zapisze się jako chwila otwarcia tego okna."
msgstr ""
"L’heure de l’incident sera enregistrée comme le moment d’ouverture de cette "
"fenêtre."

msgid "Zapisz incydent"
msgstr "Enregistrer l’incident"

msgid "Anuluj"
msgstr "Annuler"

msgid "Etapy do nadzoru"
msgstr "Étapes à surveiller"

msgid "Otwórz siatkę nadzoru"
msgstr "Ouvrir la grille de surveillance"

msgid "Nie masz etapów do nadzoru."
msgstr "Vous n’avez aucune étape à surveiller."

msgid "Raport nadzoru"
msgstr "Rapport de surveillance"

