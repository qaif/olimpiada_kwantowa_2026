# Doręczalność poczty (MAIL-02) – katalog aplikacji apps.email_delivery.
# Angielski przejrzany ręcznie; pozostałe języki maszynowe (do przeglądu native speakerów, I18N-01 § 8).
msgid ""
msgstr ""
"Project-Id-Version: olimpiada\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#, python-format
msgid "Czy chodziło Ci o %s?"
msgstr "¿Quisiste decir %s?"

#, python-format
msgid "Użyj %s"
msgstr "Usar %s"

#, python-format
msgid "Sprawdź adres – czy chodziło Ci o %(suggestion)s? Wybierz „Popraw” albo potwierdź, że adres jest poprawny."
msgstr "Revisa la dirección: ¿quisiste decir %(suggestion)s? Elige «Corregir» o confirma que la dirección es correcta."

#, python-format
msgid "Domena %(domain)s nie istnieje albo nie przyjmuje poczty. Sprawdź adres."
msgstr "El dominio %(domain)s no existe o no acepta correo. Revisa la dirección."

#, python-format
msgid "Domena %(domain)s nie istnieje albo nie przyjmuje poczty. Czy chodziło Ci o %(suggestion)s?"
msgstr "El dominio %(domain)s no existe o no acepta correo. ¿Quisiste decir %(suggestion)s?"

#, python-format
msgid "Popraw na %(address)s"
msgstr "Corregir a %(address)s"

#, python-format
msgid "Tak, adres %(address)s jest poprawny"
msgstr "Sí, %(address)s es correcta"

# REG-UX-01 § 1.1: adres bez kropki w domenie (jan@gmailcom).
#, python-format
msgid "Adres e-mail jest niepełny – czy chodziło Ci o %(suggestion)s?"
msgstr "La dirección de correo está incompleta: ¿quisiste decir %(suggestion)s?"

#, python-format
msgid "Nie możemy dostarczyć poczty na adres %(email)s – serwer odbiorcy odpowiada, że taka skrzynka albo domena nie istnieje. Nie dostaniesz od nas listów, dopóki adres nie zostanie poprawiony."
msgstr "No podemos entregar correo en %(email)s: el servidor del destinatario indica que este buzón o dominio no existe. No recibirás mensajes nuestros hasta que se corrija la dirección."

msgid "Zmień adres e-mail"
msgstr "Cambiar la dirección de correo"

msgid "Mój adres jest poprawny"
msgstr "Mi dirección es correcta"

msgid "Dziękujemy. Wznowiliśmy wysyłkę na Twój adres – jeśli list znów nie dotrze, baner wróci."
msgstr "Gracias. Hemos reanudado los envíos a tu dirección; si un mensaje vuelve a fallar, este aviso volverá a aparecer."
