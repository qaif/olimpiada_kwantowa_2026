# Doręczalność poczty (MAIL-02) – katalog aplikacji apps.email_delivery.
# Angielski przejrzany ręcznie; pozostałe języki maszynowe (do przeglądu native speakerów, I18N-01 § 8).
msgid ""
msgstr ""
"Project-Id-Version: olimpiada\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#, python-format
msgid "Czy chodziło Ci o %s?"
msgstr "Did you mean %s?"

#, python-format
msgid "Użyj %s"
msgstr "Use %s"

#, python-format
msgid "Sprawdź adres – czy chodziło Ci o %(suggestion)s? Zaznacz poprawkę poniżej albo wyślij formularz jeszcze raz, żeby zostawić adres bez zmian."
msgstr "Check the address – did you mean %(suggestion)s? Tick the correction below or submit the form again to keep the address as it is."

#, python-format
msgid "Domena %(domain)s nie istnieje albo nie przyjmuje poczty. Sprawdź adres."
msgstr "The domain %(domain)s does not exist or does not accept email. Please check the address."

#, python-format
msgid "Domena %(domain)s nie istnieje albo nie przyjmuje poczty. Czy chodziło Ci o %(suggestion)s?"
msgstr "The domain %(domain)s does not exist or does not accept email. Did you mean %(suggestion)s?"

#, python-format
msgid "Użyj adresu <strong>%(address)s</strong>"
msgstr "Use <strong>%(address)s</strong>"

#, python-format
msgid "Nie możemy dostarczyć poczty na adres %(email)s – serwer odbiorcy odpowiada, że taka skrzynka albo domena nie istnieje. Nie dostaniesz od nas listów, dopóki adres nie zostanie poprawiony."
msgstr "We cannot deliver email to %(email)s – the recipient's server says that this mailbox or domain does not exist. You will not receive any messages from us until the address is corrected."

msgid "Zmień adres e-mail"
msgstr "Change email address"

msgid "Mój adres jest poprawny"
msgstr "My address is correct"

msgid "Dziękujemy. Wznowiliśmy wysyłkę na Twój adres – jeśli list znów nie dotrze, baner wróci."
msgstr "Thank you. We have resumed sending to your address – if a message fails again, this notice will come back."
