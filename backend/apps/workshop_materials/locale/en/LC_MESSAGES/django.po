#: templates/web/workshop_materials/detail.html
msgid "Ten format może zawierać makra. Program biurowy zapyta, czy je włączyć – włącz je tylko wtedy, gdy wiesz, do czego służą w tym pliku."
msgstr "This format may contain macros. Your office application will ask whether to enable them – enable them only if you know what they do in this file."

#: templates/web/workshop_materials/detail.html
msgid "Podgląd pliku"
msgstr "File preview"

#: templates/web/workshop_materials/detail.html
msgid "Plik jest pokazany jako zwykły tekst – jest zbyt złożony, żeby złożyć go jako Markdown."
msgstr "The file is shown as plain text – it is too complex to render as Markdown."

#: templates/web/workshop_materials/detail.html
#, python-format
msgid "Plik jest za duży na podgląd na stronie (podgląd do %(limit)s) – pobierz go."
msgstr "The file is too large to preview on the page (preview up to %(limit)s) – download it."

#: templates/web/workshop_materials/detail.html
msgid "Podgląd jest chwilowo niedostępny – pobierz plik."
msgstr "The preview is temporarily unavailable – download the file."

#: templates/web/workshop_materials/list.html
msgid "Zobacz"
msgstr "View"
