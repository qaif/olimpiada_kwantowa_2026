#: apps/calendar_feed/feed.py
#, python-format
msgid "Prowadzący: %(lecturer)s"
msgstr "Intervenant : %(lecturer)s"

#: apps/calendar_feed/feed.py
msgid "Warsztaty online. Link do spotkania podajemy zalogowanym uczestnikom w Wiadomościach."
msgstr "Atelier en ligne. Le lien de la réunion est communiqué aux participants connectés dans Messages."

#: apps/calendar_feed/feed.py
#, python-format
msgid "Szczegóły: %(url)s"
msgstr "Détails : %(url)s"

#: apps/calendar_feed/feed.py
#, python-format
msgid "%(stage)s: otwarcie"
msgstr "%(stage)s : ouverture"

#: apps/calendar_feed/feed.py
#, python-format
msgid "%(stage)s: termin oddania prac"
msgstr "%(stage)s : date limite de remise"

#: apps/calendar_feed/feed.py
#, python-format
msgid "%(stage)s: zamknięcie etapu"
msgstr "%(stage)s : clôture de l'étape"

#: apps/calendar_feed/feed.py
msgid "Rejestracja uczestników: start"
msgstr "Inscription des participants : ouverture"

#: apps/calendar_feed/feed.py
msgid "Rejestracja uczestników: koniec"
msgstr "Inscription des participants : clôture"

#: templates/calendar_feed/_subscribe.html
msgid "Kalendarz warsztatów i terminów"
msgstr "Calendrier des ateliers et des dates"

#: templates/calendar_feed/_subscribe.html
msgid "Dodaj warsztaty i terminy olimpiady do swojego kalendarza – wpisy same się zaktualizują, gdy zmieni się harmonogram."
msgstr "Ajoutez les ateliers et les dates de l'olympiade à votre agenda – les entrées se mettront à jour automatiquement si le programme change."

#: templates/calendar_feed/_subscribe.html
#: templates/cms/blocks/schedule.html
msgid "Dodaj do Google Calendar"
msgstr "Ajouter à Google Agenda"

#: templates/calendar_feed/_subscribe.html
msgid "Dodaj do Outlook / Apple"
msgstr "Ajouter à Outlook / Apple"

#: templates/calendar_feed/_subscribe.html
msgid "Pobierz .ics"
msgstr "Télécharger le fichier .ics"

#: templates/calendar_feed/_subscribe.html
msgid "Link do spotkania podajemy zalogowanym uczestnikom w Wiadomościach – w kalendarzu publicznym go nie ma."
msgstr "Le lien de la réunion est communiqué aux participants connectés dans Messages – il ne figure pas dans le calendrier public."
