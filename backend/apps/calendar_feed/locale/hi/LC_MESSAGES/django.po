#: apps/calendar_feed/feed.py
#, python-format
msgid "Prowadzący: %(lecturer)s"
msgstr "प्रशिक्षक: %(lecturer)s"

#: apps/calendar_feed/feed.py
msgid "Warsztaty online. Link do spotkania podajemy zalogowanym uczestnikom w Wiadomościach."
msgstr "ऑनलाइन कार्यशाला। मीटिंग का लिंक लॉग इन किए हुए प्रतिभागियों को संदेशों में दिया जाता है।"

#: apps/calendar_feed/feed.py
#, python-format
msgid "Szczegóły: %(url)s"
msgstr "विवरण: %(url)s"

#: apps/calendar_feed/feed.py
#, python-format
msgid "%(stage)s: otwarcie"
msgstr "%(stage)s: शुरुआत"

#: apps/calendar_feed/feed.py
#, python-format
msgid "%(stage)s: termin oddania prac"
msgstr "%(stage)s: जमा करने की अंतिम तिथि"

#: apps/calendar_feed/feed.py
#, python-format
msgid "%(stage)s: zamknięcie etapu"
msgstr "%(stage)s: चरण समाप्त"

#: apps/calendar_feed/feed.py
msgid "Rejestracja uczestników: start"
msgstr "प्रतिभागी पंजीकरण: शुरुआत"

#: apps/calendar_feed/feed.py
msgid "Rejestracja uczestników: koniec"
msgstr "प्रतिभागी पंजीकरण: समाप्ति"

#: templates/calendar_feed/_subscribe.html
msgid "Kalendarz warsztatów i terminów"
msgstr "कार्यशालाओं और तिथियों का कैलेंडर"

#: templates/calendar_feed/_subscribe.html
msgid "Dodaj warsztaty i terminy olimpiady do swojego kalendarza – wpisy same się zaktualizują, gdy zmieni się harmonogram."
msgstr "ओलंपियाड की कार्यशालाएँ और तिथियाँ अपने कैलेंडर में जोड़ें – कार्यक्रम बदलने पर प्रविष्टियाँ अपने आप अपडेट हो जाएँगी।"

#: templates/calendar_feed/_subscribe.html
#: templates/cms/blocks/schedule.html
msgid "Dodaj do Google Calendar"
msgstr "Google Calendar में जोड़ें"

#: templates/calendar_feed/_subscribe.html
msgid "Dodaj do Outlook / Apple"
msgstr "Outlook / Apple में जोड़ें"

#: templates/calendar_feed/_subscribe.html
msgid "Pobierz .ics"
msgstr ".ics डाउनलोड करें"

#: templates/calendar_feed/_subscribe.html
msgid "Link do spotkania podajemy zalogowanym uczestnikom w Wiadomościach – w kalendarzu publicznym go nie ma."
msgstr "मीटिंग का लिंक लॉग इन किए हुए प्रतिभागियों को संदेशों में दिया जाता है – सार्वजनिक कैलेंडर में यह नहीं है।"
