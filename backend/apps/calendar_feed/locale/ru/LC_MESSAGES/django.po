#: apps/calendar_feed/feed.py
#, python-format
msgid "Prowadzący: %(lecturer)s"
msgstr "Ведущий: %(lecturer)s"

#: apps/calendar_feed/feed.py
msgid "Warsztaty online. Link do spotkania podajemy zalogowanym uczestnikom w Wiadomościach."
msgstr "Онлайн-мастерская. Ссылку на встречу мы сообщаем вошедшим в систему участникам в разделе «Сообщения»."

#: apps/calendar_feed/feed.py
#, python-format
msgid "Szczegóły: %(url)s"
msgstr "Подробности: %(url)s"

#: apps/calendar_feed/feed.py
#, python-format
