#: templates/translation_review/reports.html:13
msgid "Zgłoszenia tłumaczeń"
msgstr "অনুবাদ রিপোর্ট"

#: templates/translation_review/reports.html:22
msgid "szukaj na liście"
msgstr "তালিকায় খুঁজুন"

#: templates/translation_review/reports.html:24
msgid "Uwaga"
msgstr "মন্তব্য"

#: templates/translation_review/reports.html:29
msgid "Zamknij zgłoszenie"
msgstr "রিপোর্ট বন্ধ করুন"

#: templates/translation_review/reports.html:33
msgid "Nie ma otwartych zgłoszeń."
msgstr "কোনো খোলা রিপোর্ট নেই।"

#: validation.py:110
msgid "Tłumaczenie nie może być puste."
msgstr "অনুবাদ খালি হতে পারে না।"

#: validation.py:121
#, python-format
msgid "Tłumaczenie jest za długie (najwyżej %(limit)d znaków)."
msgstr "অনুবাদটি খুব দীর্ঘ (সর্বোচ্চ %(limit)d অক্ষর)।"

#: validation.py:125
msgid "Tłumaczenie zawiera niedozwolony znak sterujący kierunkiem tekstu."
msgstr "অনুবাদে লেখার দিক নিয়ন্ত্রণের একটি নিষিদ্ধ অক্ষর আছে।"

#: validation.py:129
msgid "nowa linia"
msgstr "নতুন লাইন"

#: validation.py:129
msgid "tabulator"
msgstr "ট্যাব"

#: validation.py:130
#, python-format
msgid "Niedozwolony znak sterujący: %(char)s."
msgstr "নিষিদ্ধ নিয়ন্ত্রণ অক্ষর: %(char)s।"

#: validation.py:134 validation.py:150 validation.py:156
msgid "(brak)"
msgstr "(কিছু নেই)"

#: validation.py:136
#, python-format
msgid ""
"Znaczniki HTML muszą być dokładnie takie, jak w tekście źródłowym: %(tags)s"
msgstr "HTML ট্যাগ হুবহু উৎস লেখার মতো হতে হবে: %(tags)s"

#: validation.py:141
msgid ""
"Znak „<” poza znacznikiem z tekstu źródłowego może stać tylko przed spacją "
"albo cyfrą."
msgstr ""
"উৎস লেখার ট্যাগের বাইরে “<” অক্ষরটি কেবল ফাঁকা স্থান বা অঙ্কের আগে বসতে "
"পারে।"

#: validation.py:145
#, python-format
msgid ""
"Użyj cudzysłowów typograficznych (np. “…”, «…», „…”) zamiast znaku %(char)s."
msgstr ""
"%(char)s অক্ষরের বদলে টাইপোগ্রাফিক উদ্ধৃতিচিহ্ন (যেমন “…”, «…», „…”) "
"ব্যবহার করুন।"

#: validation.py:152 validation.py:158
#, python-format
msgid ""
"Tłumaczenie musi zawierać te same zmienne, co tekst źródłowy: "
"%(placeholders)s"
msgstr "অনুবাদে উৎস লেখার মতো একই চলক থাকতে হবে: %(placeholders)s"

#: validation.py:166
msgid ""
"Ten napis ma kilka zmiennych bez nazw – jego tłumaczenie można poprawić "
"tylko w repozytorium; zgłoś je ze stopki."
msgstr ""
"এই স্ট্রিংয়ে কয়েকটি নামহীন চলক আছে – এর অনুবাদ শুধু রিপোজিটরিতে ঠিক করা "
"যায়; ফুটার থেকে রিপোর্ট করুন।"

#: validation.py:173
msgid ""
"Znaki procentu i nawiasów klamrowych mają w tym napisie znaczenie techniczne "
"– zapisz je dokładnie tak, jak w tekście źródłowym."
msgstr ""
"এই স্ট্রিংয়ে শতাংশ চিহ্ন ও কোঁকড়া বন্ধনীর কারিগরি অর্থ আছে – এগুলো হুবহু "
"উৎস লেখার মতো লিখুন।"

#: views.py:78 views.py:225
msgid "Twoje konto nie ma roli tłumacza."
msgstr "আপনার অ্যাকাউন্টে অনুবাদকের ভূমিকা নেই।"

#: views.py:159
msgid "Propozycja została zapisana."
msgstr "প্রস্তাবটি সংরক্ষিত হয়েছে।"

#: views.py:171
msgid "Tłumaczenie zatwierdzone – działa w serwisie w ciągu kilku sekund."
msgstr "অনুবাদ অনুমোদিত – কয়েক সেকেন্ডের মধ্যে সাইটে দেখা যাবে।"

#: views.py:175
msgid "Propozycja została odrzucona."
msgstr "প্রস্তাবটি প্রত্যাখ্যাত হয়েছে।"

#: views.py:178
msgid "Tłumaczenie oznaczone jako przejrzane."
msgstr "অনুবাদটি পর্যালোচিত হিসেবে চিহ্নিত হয়েছে।"

#: views.py:181
msgid "Przywrócono tłumaczenie z katalogu."
msgstr "ক্যাটালগের অনুবাদ ফিরিয়ে আনা হয়েছে।"

#: views.py:204
msgid "Zgłoszenia przegląda recenzent tłumaczeń."
msgstr "রিপোর্টগুলো অনুবাদ পর্যালোচক দেখেন।"

#: views.py:215
msgid "Zgłoszenie zamknięte."
msgstr "রিপোর্ট বন্ধ করা হয়েছে।"

#: views.py:257
msgid "Dziękujemy – recenzent tłumaczeń zobaczy zgłoszenie."
msgstr "ধন্যবাদ – অনুবাদ পর্যালোচক আপনার রিপোর্ট দেখবেন।"

#: views.py:313
msgid "Rola tłumacza została odebrana."
msgstr "অনুবাদকের ভূমিকা প্রত্যাহার করা হয়েছে।"

#: views.py:330
msgid "Rola tłumacza została nadana."
msgstr "অনুবাদকের ভূমিকা দেওয়া হয়েছে।"
