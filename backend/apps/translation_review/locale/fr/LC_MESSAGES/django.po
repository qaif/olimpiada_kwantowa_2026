msgstr "absente"

#: templates/translation_review/list.html:53
msgid "propozycje"
msgstr "propositions"

#: templates/translation_review/list.html:57
msgid "Brak napisów spełniających filtr."
msgstr "Aucune chaîne ne correspond au filtre."

