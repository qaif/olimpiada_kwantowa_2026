msgstr "Texte sur la page"

#: forms.py:48
msgid "Skopiuj fragment źle przetłumaczonego tekstu – po nim znajdziemy napis."
msgstr ""
"Copiez un extrait du texte mal traduit – il nous servira à retrouver la "
"chaîne."

#: forms.py:51
msgid "Co jest nie tak / jak powinno brzmieć"
msgstr "Ce qui ne va pas / formulation correcte"

#: forms.py:62
msgid "Adres e-mail konta"
msgstr "Adresse e-mail du compte"

#: forms.py:64 templates/translation_review/coordinator_translators.html:33
#: templates/translation_review/coordinator_translators.html:42
msgid "Poziom"
msgstr "Niveau"

#: forms.py:69
msgid "tłumacz – proponuje i głosuje"
msgstr "traducteur – propose et vote"

#: forms.py:71
msgid "recenzent – także zatwierdza poprawki"
msgstr "relecteur – approuve aussi les corrections"

#: services.py:146 views.py:56
msgid "Nie masz uprawnień do tłumaczeń tego języka."
msgstr "Vous n’avez pas l’autorisation de traduire cette langue."

#: services.py:201
msgid "Nie możesz nadawać ról tłumaczy."
msgstr "Vous ne pouvez pas attribuer de rôle de traducteur."

#: services.py:203
msgid "Nieznany język."
msgstr "Langue inconnue."

#: services.py:205
msgid "Nieznany poziom uprawnień."
msgstr "Niveau d’autorisation inconnu."

#: services.py:208
msgid "Rolę recenzenta tłumaczeń nadaje wyłącznie superkoordynator."
msgstr ""
"Seul le super-coordinateur peut attribuer le rôle de relecteur des "
"traductions."

#: services.py:210
msgid "Ten język nie jest językiem interfejsu tego konkursu."
msgstr "Cette langue n’est pas une langue d’interface de ce concours."

#: services.py:215
msgid "Nie znaleziono aktywnego konta z tym adresem w tym konkursie."
msgstr "Aucun compte actif avec cette adresse n’a été trouvé dans ce concours."

#: services.py:244
msgid "Nie możesz odbierać ról tłumaczy."
msgstr "Vous ne pouvez pas retirer de rôle de traducteur."

#: services.py:249
msgid "Tę osobę może zmienić wyłącznie superkoordynator."
msgstr "Seul le super-coordinateur peut modifier cette personne."

#: services.py:434
msgid "Ta propozycja jest identyczna z obecnym tłumaczeniem."
msgstr "Cette proposition est identique à la traduction actuelle."

#: services.py:465
msgid "Na rozstrzygniętą propozycję nie można już głosować."
msgstr "On ne peut plus voter pour une proposition déjà tranchée."

#: services.py:467
msgid "Nie można głosować na własną propozycję."
msgstr "Vous ne pouvez pas voter pour votre propre proposition."

#: services.py:500 services.py:537
msgid "Ta propozycja została już rozstrzygnięta."
msgstr "Cette proposition a déjà été tranchée."

#: services.py:554
msgid "Ten napis nie ma jeszcze tłumaczenia – zaproponuj je."
msgstr "Cette chaîne n’a pas encore de traduction – proposez-en une."

#: services.py:557
msgid "To tłumaczenie jest już przejrzane."
msgstr "Cette traduction a déjà été relue."

#: services.py:614
msgid "Opisz, co jest nie tak z tłumaczeniem."
msgstr "Décrivez ce qui ne va pas dans la traduction."

#: services.py:616
msgid "Zgłoszenie jest za długie."
msgstr "Le signalement est trop long."

#: templates/translation_review/coordinator_translators.html:8
#: templates/translation_review/coordinator_translators.html:27
msgid "Tłumacze"
msgstr "Traducteurs"

#: templates/translation_review/coordinator_translators.html:8
msgid "panel koordynatora"
msgstr "panneau du coordinateur"

#: templates/translation_review/coordinator_translators.html:9
msgid "Tłumacze interfejsu"
msgstr "Traducteurs de l’interface"

#: templates/translation_review/coordinator_translators.html:11
msgid ""
"Osoby, które mogą przeglądać i poprawiać tłumaczenia napisów serwisu, np. "
"kierownicy delegacji. Zatwierdzona poprawka działa w całym serwisie."
msgstr ""
"Personnes pouvant relire et corriger les traductions des textes du site, p. "
"ex. les chefs de délégation. Une correction approuvée s’applique à tout le "
"site."

#: templates/translation_review/coordinator_translators.html:16
msgid "Nadaj rolę"
msgstr "Attribuer le rôle"

#: templates/translation_review/coordinator_translators.html:21
msgid ""
"Rolę recenzenta tłumaczeń nadaje superkoordynator. Konto musi należeć do "
"tego konkursu."
msgstr ""
"Le rôle de relecteur des traductions est attribué par le "
"super-coordinateur. Le compte doit appartenir à ce concours."

#: templates/translation_review/coordinator_translators.html:22
msgid "Nadaj"
msgstr "Attribuer"

#: templates/translation_review/coordinator_translators.html:31
#: templates/translation_review/coordinator_translators.html:40
