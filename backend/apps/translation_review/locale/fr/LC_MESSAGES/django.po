#: templates/translation_review/list.html:14
msgid ""
"Kliknij napis, żeby zobaczyć kontekst, zaproponować poprawkę albo zagłosować "
"na cudzą."
msgstr ""
"Cliquez sur une chaîne pour voir son contexte, proposer une correction ou "
"voter pour celle d’un autre."

#: templates/translation_review/list.html:21
msgid "Filtruj"
msgstr "Filtrer"

#: templates/translation_review/list.html:22
msgid "Wyczyść"
msgstr "Effacer"

#: templates/translation_review/list.html:25
