#: templatetags/translation_review.py:37
msgid "Zgłoś tłumaczenie"
msgstr "Signaler une traduction"

#: templates/translation_review/report.html:12
msgid ""
"Napisz, który napis jest źle przetłumaczony i jak powinien brzmieć. "
"Recenzent tłumaczeń Twojego języka poprawi go dla wszystkich."
msgstr ""
"Indiquez quel texte est mal traduit et comment il devrait se lire. Le "
"relecteur des traductions de votre langue le corrigera pour tout le monde."

#: templates/translation_review/report.html:16
#: templates/translation_review/reports.html:19
msgid "Strona"
msgstr "Page"

#: templates/translation_review/report.html:30
msgid "Wyślij zgłoszenie"
msgstr "Envoyer le signalement"

#: templates/translation_review/reports.html:13
msgid "Zgłoszenia tłumaczeń"
msgstr "Signalements de traduction"

#: templates/translation_review/reports.html:22
msgid "szukaj na liście"
msgstr "rechercher dans la liste"

#: templates/translation_review/reports.html:24
msgid "Uwaga"
msgstr "Commentaire"

#: templates/translation_review/reports.html:29
msgid "Zamknij zgłoszenie"
msgstr "Clore le signalement"

#: templates/translation_review/reports.html:33
msgid "Nie ma otwartych zgłoszeń."
msgstr "Aucun signalement ouvert."

#: validation.py:110
msgid "Tłumaczenie nie może być puste."
msgstr "La traduction ne peut pas être vide."

#: validation.py:121
#, python-format
msgid "Tłumaczenie jest za długie (najwyżej %(limit)d znaków)."
msgstr "La traduction est trop longue (%(limit)d caractères au maximum)."

#: validation.py:125
msgid "Tłumaczenie zawiera niedozwolony znak sterujący kierunkiem tekstu."
msgstr ""
"La traduction contient un caractère de contrôle de direction du texte "
"interdit."

#: validation.py:129
msgid "nowa linia"
msgstr "saut de ligne"

#: validation.py:129
msgid "tabulator"
msgstr "tabulation"

#: validation.py:130
#, python-format
msgid "Niedozwolony znak sterujący: %(char)s."
msgstr "Caractère de contrôle interdit : %(char)s."

#: validation.py:134 validation.py:150 validation.py:156
msgid "(brak)"
msgstr "(aucun)"

#: validation.py:136
#, python-format
msgid ""
"Znaczniki HTML muszą być dokładnie takie, jak w tekście źródłowym: %(tags)s"
msgstr ""
"Les balises HTML doivent être exactement celles du texte source : %(tags)s"

#: validation.py:141
msgid ""
"Znak „<” poza znacznikiem z tekstu źródłowego może stać tylko przed spacją "
"albo cyfrą."
msgstr ""
"En dehors d’une balise du texte source, le caractère « < » ne peut précéder "
"qu’une espace ou un chiffre."

#: validation.py:145
#, python-format
msgid ""
"Użyj cudzysłowów typograficznych (np. “…”, «…», „…”) zamiast znaku %(char)s."
msgstr ""
"Utilisez des guillemets typographiques (p. ex. “…”, «…», „…”) au lieu du "
"caractère %(char)s."

#: validation.py:152 validation.py:158
#, python-format
msgid ""
"Tłumaczenie musi zawierać te same zmienne, co tekst źródłowy: "
"%(placeholders)s"
msgstr ""
"La traduction doit contenir les mêmes variables que le texte source : "
"%(placeholders)s"

#: validation.py:166
msgid ""
"Ten napis ma kilka zmiennych bez nazw – jego tłumaczenie można poprawić "
"tylko w repozytorium; zgłoś je ze stopki."
msgstr ""
"Cette chaîne contient plusieurs variables sans nom – sa traduction ne peut "
"être corrigée que dans le dépôt ; signalez-la depuis le pied de page."

#: validation.py:173
msgid ""
"Znaki procentu i nawiasów klamrowych mają w tym napisie znaczenie techniczne "
"– zapisz je dokładnie tak, jak w tekście źródłowym."
msgstr ""
"Les signes de pourcentage et les accolades ont un sens technique dans cette "
"chaîne – écrivez-les exactement comme dans le texte source."

#: views.py:78 views.py:225
msgid "Twoje konto nie ma roli tłumacza."
msgstr "Votre compte n’a pas le rôle de traducteur."

#: views.py:159
msgid "Propozycja została zapisana."
msgstr "La proposition a été enregistrée."

#: views.py:171
msgid "Tłumaczenie zatwierdzone – działa w serwisie w ciągu kilku sekund."
msgstr ""
"Traduction approuvée – elle apparaîtra sur le site d’ici quelques secondes."

#: views.py:175
msgid "Propozycja została odrzucona."
msgstr "La proposition a été refusée."

#: views.py:178
msgid "Tłumaczenie oznaczone jako przejrzane."
msgstr "Traduction marquée comme relue."

#: views.py:181
msgid "Przywrócono tłumaczenie z katalogu."
msgstr "La traduction du catalogue a été rétablie."

#: views.py:204
msgid "Zgłoszenia przegląda recenzent tłumaczeń."
msgstr "Les signalements sont traités par le relecteur des traductions."

#: views.py:215
msgid "Zgłoszenie zamknięte."
msgstr "Signalement clos."

#: views.py:257
msgid "Dziękujemy – recenzent tłumaczeń zobaczy zgłoszenie."
msgstr "Merci – le relecteur des traductions verra votre signalement."

#: views.py:313
msgid "Rola tłumacza została odebrana."
msgstr "Le rôle de traducteur a été retiré."

#: views.py:330
msgid "Rola tłumacza została nadana."
msgstr "Le rôle de traducteur a été attribué."
