#: templates/translation_review/reports.html:22
msgid "szukaj na liście"
msgstr "在列表中搜索"

#: templates/translation_review/reports.html:24
msgid "Uwaga"
msgstr "备注"

#: templates/translation_review/reports.html:29
msgid "Zamknij zgłoszenie"
msgstr "关闭报告"

#: templates/translation_review/reports.html:33
msgid "Nie ma otwartych zgłoszeń."
msgstr "没有未处理的报告。"

#: validation.py:110
msgid "Tłumaczenie nie może być puste."
msgstr "译文不能为空。"

#: validation.py:121
#, python-format
msgid "Tłumaczenie jest za długie (najwyżej %(limit)d znaków)."
msgstr "译文过长（最多 %(limit)d 个字符）。"

#: validation.py:125
msgid "Tłumaczenie zawiera niedozwolony znak sterujący kierunkiem tekstu."
msgstr "译文包含不允许的文字方向控制字符。"

#: validation.py:129
msgid "nowa linia"
msgstr "换行符"

#: validation.py:129
msgid "tabulator"
msgstr "制表符"

#: validation.py:130
#, python-format
msgid "Niedozwolony znak sterujący: %(char)s."
msgstr "不允许的控制字符：%(char)s。"

#: validation.py:134 validation.py:150 validation.py:156
msgid "(brak)"
msgstr "（无）"

#: validation.py:136
#, python-format
msgid ""
"Znaczniki HTML muszą być dokładnie takie, jak w tekście źródłowym: %(tags)s"
msgstr "HTML 标签必须与源文本完全一致：%(tags)s"

#: validation.py:141
msgid ""
"Znak „<” poza znacznikiem z tekstu źródłowego może stać tylko przed spacją "
"albo cyfrą."
msgstr "在源文本标签之外，字符“<”只能出现在空格或数字之前。"

#: validation.py:145
#, python-format
msgid ""
"Użyj cudzysłowów typograficznych (np. “…”, «…», „…”) zamiast znaku %(char)s."
msgstr "请使用印刷体引号（如 “…”、«…»、„…”）代替字符 %(char)s。"

#: validation.py:152 validation.py:158
#, python-format
msgid ""
"Tłumaczenie musi zawierać te same zmienne, co tekst źródłowy: "
"%(placeholders)s"
msgstr "译文必须包含与源文本相同的变量：%(placeholders)s"

#: validation.py:166
msgid ""
"Ten napis ma kilka zmiennych bez nazw – jego tłumaczenie można poprawić "
"tylko w repozytorium; zgłoś je ze stopki."
msgstr "此文本包含多个未命名变量——其译文只能在代码库中修改；请通过页脚报告。"

#: validation.py:173
msgid ""
"Znaki procentu i nawiasów klamrowych mają w tym napisie znaczenie techniczne "
"– zapisz je dokładnie tak, jak w tekście źródłowym."
msgstr "百分号和花括号在此文本中具有技术含义——请严格按源文本书写。"

#: views.py:78 views.py:225
msgid "Twoje konto nie ma roli tłumacza."
msgstr "您的账户没有译者角色。"

#: views.py:159
msgid "Propozycja została zapisana."
msgstr "建议已保存。"

#: views.py:171
msgid "Tłumaczenie zatwierdzone – działa w serwisie w ciągu kilku sekund."
msgstr "译文已批准——几秒钟内将在网站上生效。"

#: views.py:175
msgid "Propozycja została odrzucona."
msgstr "建议已被拒绝。"

#: views.py:178
msgid "Tłumaczenie oznaczone jako przejrzane."
msgstr "译文已标记为已审核。"

#: views.py:181
msgid "Przywrócono tłumaczenie z katalogu."
msgstr "已恢复目录中的译文。"

#: views.py:204
msgid "Zgłoszenia przegląda recenzent tłumaczeń."
msgstr "报告由翻译审核人处理。"

#: views.py:215
msgid "Zgłoszenie zamknięte."
msgstr "报告已关闭。"

#: views.py:257
msgid "Dziękujemy – recenzent tłumaczeń zobaczy zgłoszenie."
msgstr "谢谢——翻译审核人将看到您的报告。"

#: views.py:313
msgid "Rola tłumacza została odebrana."
msgstr "译者角色已撤销。"

#: views.py:330
msgid "Rola tłumacza została nadana."
msgstr "已授予译者角色。"
