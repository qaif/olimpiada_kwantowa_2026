#: validation.py:121
#, python-format
msgid "Tłumaczenie jest za długie (najwyżej %(limit)d znaków)."
msgstr "अनुवाद बहुत लंबा है (अधिकतम %(limit)d अक्षर)।"

#: validation.py:125
msgid "Tłumaczenie zawiera niedozwolony znak sterujący kierunkiem tekstu."
msgstr "अनुवाद में पाठ-दिशा का एक निषिद्ध नियंत्रण वर्ण है।"

#: validation.py:129
msgid "nowa linia"
msgstr "नई पंक्ति"

#: validation.py:129
msgid "tabulator"
msgstr "टैब"

#: validation.py:130
#, python-format
msgid "Niedozwolony znak sterujący: %(char)s."
msgstr "निषिद्ध नियंत्रण वर्ण: %(char)s।"

#: validation.py:134 validation.py:150 validation.py:156
msgid "(brak)"
msgstr "(कोई नहीं)"

#: validation.py:136
#, python-format
msgid ""
"Znaczniki HTML muszą być dokładnie takie, jak w tekście źródłowym: %(tags)s"
msgstr "HTML टैग बिल्कुल स्रोत पाठ जैसे होने चाहिए: %(tags)s"

#: validation.py:141
msgid ""
"Znak „<” poza znacznikiem z tekstu źródłowego może stać tylko przed spacją "
"albo cyfrą."
msgstr ""
"स्रोत पाठ के टैग के बाहर वर्ण “<” केवल रिक्त स्थान या अंक से पहले आ सकता है।"

#: validation.py:145
#, python-format
msgid ""
"Użyj cudzysłowów typograficznych (np. “…”, «…», „…”) zamiast znaku %(char)s."
msgstr ""
"वर्ण %(char)s की जगह टाइपोग्राफ़िक उद्धरण चिह्न (जैसे “…”, «…», „…”) "
"इस्तेमाल करें।"

#: validation.py:152 validation.py:158
#, python-format
msgid ""
"Tłumaczenie musi zawierać te same zmienne, co tekst źródłowy: "
"%(placeholders)s"
msgstr "अनुवाद में स्रोत पाठ जैसे ही चर होने चाहिए: %(placeholders)s"

#: validation.py:166
msgid ""
"Ten napis ma kilka zmiennych bez nazw – jego tłumaczenie można poprawić "
"tylko w repozytorium; zgłoś je ze stopki."
msgstr ""
"इस स्ट्रिंग में कई बिना नाम वाले चर हैं – इसका अनुवाद केवल रिपॉज़िटरी में "
"सुधारा जा सकता है; फ़ुटर से इसकी रिपोर्ट करें।"

#: validation.py:173
msgid ""
"Znaki procentu i nawiasów klamrowych mają w tym napisie znaczenie techniczne "
"– zapisz je dokładnie tak, jak w tekście źródłowym."
msgstr ""
"इस स्ट्रिंग में प्रतिशत चिह्न और कर्ली ब्रैकेट का तकनीकी अर्थ है – उन्हें "
"बिल्कुल स्रोत पाठ की तरह लिखें।"

#: views.py:78 views.py:225
msgid "Twoje konto nie ma roli tłumacza."
msgstr "आपके खाते के पास अनुवादक की भूमिका नहीं है।"

#: views.py:159
msgid "Propozycja została zapisana."
msgstr "सुझाव सहेज लिया गया है।"

#: views.py:171
msgid "Tłumaczenie zatwierdzone – działa w serwisie w ciągu kilku sekund."
msgstr "अनुवाद स्वीकृत – कुछ ही सेकंड में साइट पर दिखेगा।"

#: views.py:175
msgid "Propozycja została odrzucona."
msgstr "सुझाव अस्वीकार कर दिया गया है।"

#: views.py:178
msgid "Tłumaczenie oznaczone jako przejrzane."
msgstr "अनुवाद को समीक्षित चिह्नित किया गया।"

#: views.py:181
msgid "Przywrócono tłumaczenie z katalogu."
msgstr "कैटलॉग का अनुवाद बहाल कर दिया गया।"

#: views.py:204
msgid "Zgłoszenia przegląda recenzent tłumaczeń."
msgstr "रिपोर्टें अनुवाद समीक्षक देखता है।"

#: views.py:215
msgid "Zgłoszenie zamknięte."
msgstr "रिपोर्ट बंद कर दी गई।"

#: views.py:257
msgid "Dziękujemy – recenzent tłumaczeń zobaczy zgłoszenie."
msgstr "धन्यवाद – अनुवाद समीक्षक आपकी रिपोर्ट देखेगा।"

#: views.py:313
msgid "Rola tłumacza została odebrana."
msgstr "अनुवादक की भूमिका वापस ले ली गई है।"

#: views.py:330
msgid "Rola tłumacza została nadana."
msgstr "अनुवादक की भूमिका दे दी गई है।"
