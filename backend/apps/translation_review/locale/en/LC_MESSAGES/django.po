msgstr "Text on the page"

#: forms.py:48
msgid "Skopiuj fragment źle przetłumaczonego tekstu – po nim znajdziemy napis."
msgstr ""
"Copy a fragment of the badly translated text – we will use it to find the "
"string."

#: forms.py:51
msgid "Co jest nie tak / jak powinno brzmieć"
msgstr "What is wrong / how it should read"

#: forms.py:62
msgid "Adres e-mail konta"
msgstr "Account e-mail address"

