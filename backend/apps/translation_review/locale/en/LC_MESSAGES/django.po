#: templates/translation_review/coordinator_translators.html:42
msgid "Poziom"
msgstr "Level"

#: forms.py:69
msgid "tłumacz – proponuje i głosuje"
msgstr "translator – suggests and votes"

#: forms.py:71
msgid "recenzent – także zatwierdza poprawki"
msgstr "reviewer – also approves corrections"

#: services.py:127 views.py:56
msgid "Nie masz uprawnień do tłumaczeń tego języka."
msgstr "You do not have permission to translate this language."

#: services.py:168
msgid "Nie możesz nadawać ról tłumaczy."
msgstr "You cannot grant translator roles."

#: services.py:170
msgid "Nieznany język."
msgstr "Unknown language."

#: services.py:172
msgid "Nieznany poziom uprawnień."
msgstr "Unknown permission level."

#: services.py:175
msgid "Rolę recenzenta tłumaczeń nadaje wyłącznie superkoordynator."
msgstr "Only the super coordinator can grant the translation reviewer role."

#: services.py:180
msgid "Nie znaleziono aktywnego konta z tym adresem w tym konkursie."
msgstr "No active account with this address was found in this competition."

#: services.py:183 services.py:208
msgid "Tę osobę może zmienić wyłącznie superkoordynator."
msgstr "Only the super coordinator can change this person."

#: services.py:205
msgid "Nie możesz odbierać ról tłumaczy."
msgstr "You cannot revoke translator roles."

#: services.py:340
msgid "Ta propozycja jest identyczna z obecnym tłumaczeniem."
msgstr "This suggestion is identical to the current translation."

#: services.py:367
msgid "Na rozstrzygniętą propozycję nie można już głosować."
msgstr "You can no longer vote on a decided suggestion."

#: services.py:369
msgid "Nie można głosować na własną propozycję."
msgstr "You cannot vote for your own suggestion."

#: services.py:390 services.py:423
msgid "Ta propozycja została już rozstrzygnięta."
msgstr "This suggestion has already been decided."

#: services.py:440
msgid "Ten napis nie ma jeszcze tłumaczenia – zaproponuj je."
msgstr "This string has no translation yet – suggest one."

#: services.py:442
msgid "To tłumaczenie jest już przejrzane."
msgstr "This translation has already been reviewed."

#: services.py:485
msgid "Opisz, co jest nie tak z tłumaczeniem."
msgstr "Describe what is wrong with the translation."

#: services.py:487
msgid "Zgłoszenie jest za długie."
msgstr "The report is too long."

#: templates/translation_review/coordinator_translators.html:8
#: templates/translation_review/coordinator_translators.html:27
msgid "Tłumacze"
msgstr "Translators"

#: templates/translation_review/coordinator_translators.html:8
msgid "panel koordynatora"
msgstr "coordinator panel"

#: templates/translation_review/coordinator_translators.html:9
msgid "Tłumacze interfejsu"
msgstr "Interface translators"

#: templates/translation_review/coordinator_translators.html:11
msgid ""
"Osoby, które mogą przeglądać i poprawiać tłumaczenia napisów serwisu, np. "
"kierownicy delegacji. Zatwierdzona poprawka działa w całym serwisie."
msgstr ""
"People who can review and correct translations of the site’s strings, e.g. "
"delegation leaders. An approved correction applies to the whole site."

#: templates/translation_review/coordinator_translators.html:16
msgid "Nadaj rolę"
msgstr "Grant role"

#: templates/translation_review/coordinator_translators.html:21
msgid ""
"Rolę recenzenta tłumaczeń nadaje superkoordynator. Konto musi należeć do "
"tego konkursu."
msgstr ""
"The translation reviewer role is granted by the super coordinator. The "
"account must belong to this competition."

#: templates/translation_review/coordinator_translators.html:22
msgid "Nadaj"
msgstr "Grant"

#: templates/translation_review/coordinator_translators.html:31
#: templates/translation_review/coordinator_translators.html:40
msgid "Konto"
msgstr "Account"

#: templates/translation_review/coordinator_translators.html:34
msgid "Czynności"
msgstr "Actions"

#: templates/translation_review/coordinator_translators.html:42
#: templates/translation_review/home.html:20
