msgstr "Approve"

#: templates/translation_review/detail.html:124
msgid "Odrzuć"
msgstr "Reject"

#: templates/translation_review/detail.html:131
msgid "Nikt jeszcze nie zaproponował poprawki tego napisu."
msgstr "Nobody has suggested a fix for this string yet."

#: templates/translation_review/home.html:7
#: templates/translation_review/home.html:11
msgid "Tłumaczenia interfejsu"
msgstr "Interface translations"

#: templates/translation_review/home.html:10
#: templates/translation_review/list.html:11
#: templates/translation_review/report.html:10
msgid "Tłumaczenia"
msgstr "Translations"

#: templates/translation_review/home.html:12
msgid ""
"Sprawdź tłumaczenia napisów serwisu w swoim języku i zaproponuj poprawki. "
"Tekst źródłowy jest po polsku; obok widzisz wersję angielską."
msgstr ""
"Check the translations of the site’s strings in your language and suggest "
"fixes. The source text is in Polish; the English version is shown next to "
"it."

#: templates/translation_review/home.html:21
#: templates/translation_review/home.html:26
msgid "Oczekujące propozycje"
msgstr "Pending suggestions"

#: templates/translation_review/home.html:25
msgid "Przeglądaj napisy"
msgstr "Browse strings"

#: templates/translation_review/home.html:28
#: templates/translation_review/reports.html:9
msgid "Zgłoszenia"
msgstr "Reports"

#: templates/translation_review/list.html:8
#: templates/translation_review/list.html:28
msgid "Napisy"
msgstr "Strings"

#: templates/translation_review/list.html:13
msgid ""
"Kliknij napis, żeby zobaczyć kontekst, zaproponować poprawkę albo zagłosować "
"na cudzą."
msgstr ""
"Click a string to see its context, suggest a fix or vote for someone else’s."

#: templates/translation_review/list.html:20
msgid "Filtruj"
msgstr "Filter"

#: templates/translation_review/list.html:21
msgid "Wyczyść"
msgstr "Clear"

#: templates/translation_review/list.html:24
msgid "Znalezione napisy"
msgstr "Strings found"

#: templates/translation_review/list.html:35
#: templates/translation_review/list.html:47
msgid "Stan"
msgstr "Status"

#: templates/translation_review/list.html:43
msgid "forma"
msgstr "form"

#: templates/translation_review/list.html:50
msgid "brak"
msgstr "missing"

#: templates/translation_review/list.html:51
msgid "propozycje"
msgstr "suggestions"

#: templates/translation_review/list.html:55
msgid "Brak napisów spełniających filtr."
msgstr "No strings match the filter."

#: templates/translation_review/list.html:63
msgid "Poprzednia"
msgstr "Previous"

#: templates/translation_review/list.html:65
#, python-format
msgid "Strona %(number)s z %(pages)s"
msgstr "Page %(number)s of %(pages)s"

#: templates/translation_review/list.html:67
msgid "Następna"
msgstr "Next"

#: templates/translation_review/report.html:7
#: templates/translation_review/report.html:11
#: templatetags/translation_review.py:37
msgid "Zgłoś tłumaczenie"
msgstr "Report a translation"

#: templates/translation_review/report.html:12
msgid ""
"Napisz, który napis jest źle przetłumaczony i jak powinien brzmieć. "
"Recenzent tłumaczeń Twojego języka poprawi go dla wszystkich."
msgstr ""
"Tell us which text is badly translated and how it should read. The "
"translation reviewer for your language will fix it for everyone."

#: templates/translation_review/report.html:16
#: templates/translation_review/reports.html:19
msgid "Strona"
msgstr "Page"

#: templates/translation_review/report.html:30
msgid "Wyślij zgłoszenie"
msgstr "Send report"

#: templates/translation_review/reports.html:13
msgid "Zgłoszenia tłumaczeń"
msgstr "Translation reports"

#: templates/translation_review/reports.html:22
msgid "szukaj na liście"
msgstr "search the list"

#: templates/translation_review/reports.html:24
msgid "Uwaga"
msgstr "Comment"

#: templates/translation_review/reports.html:29
msgid "Zamknij zgłoszenie"
msgstr "Close report"

#: templates/translation_review/reports.html:33
msgid "Nie ma otwartych zgłoszeń."
msgstr "There are no open reports."

#: validation.py:91
msgid "Tłumaczenie nie może być puste."
msgstr "The translation cannot be empty."

#: validation.py:101
#, python-format
msgid "Tłumaczenie jest za długie (najwyżej %(limit)d znaków)."
msgstr "The translation is too long (at most %(limit)d characters)."

#: validation.py:105
msgid "Tłumaczenie zawiera niedozwolony znak sterujący kierunkiem tekstu."
msgstr "The translation contains a forbidden text-direction control character."

#: validation.py:109
msgid "nowa linia"
msgstr "new line"

#: validation.py:109
msgid "tabulator"
msgstr "tab"

#: validation.py:110
#, python-format
msgid "Niedozwolony znak sterujący: %(char)s."
msgstr "Forbidden control character: %(char)s."

#: validation.py:114 validation.py:130
msgid "(brak)"
msgstr "(none)"

#: validation.py:116
#, python-format
msgid ""
"Znaczniki HTML muszą być dokładnie takie, jak w tekście źródłowym: %(tags)s"
msgstr "HTML tags must be exactly as in the source text: %(tags)s"

#: validation.py:122
#, python-format
msgid ""
"Znak „%(char)s” jest dozwolony wyłącznie jako część znacznika z tekstu "
"źródłowego."
msgstr ""
"The character “%(char)s” is allowed only as part of a tag from the source "
"text."

#: validation.py:126
#, python-format
msgid ""
"Użyj cudzysłowów typograficznych (np. “…”, «…», „…”) zamiast znaku %(char)s."
msgstr ""
"Use typographic quotation marks (e.g. “…”, «…», „…”) instead of the "
"character %(char)s."

#: validation.py:132
#, python-format
msgid ""
"Tłumaczenie musi zawierać te same zmienne, co tekst źródłowy: "
"%(placeholders)s"
msgstr ""
"The translation must contain the same variables as the source text: "
"%(placeholders)s"

#: validation.py:138
msgid ""
"Znaki procentu i nawiasów klamrowych mają w tym napisie znaczenie techniczne "
"– zapisz je dokładnie tak, jak w tekście źródłowym."
msgstr ""
"Percent signs and curly braces have a technical meaning in this string – "
"write them exactly as in the source text."

#: views.py:75 views.py:214
msgid "Twoje konto nie ma roli tłumacza."
msgstr "Your account does not have the translator role."

#: views.py:155
msgid "Propozycja została zapisana."
msgstr "The suggestion has been saved."

#: views.py:164
msgid "Tłumaczenie zatwierdzone – działa w serwisie w ciągu kilku sekund."
msgstr ""
"Translation approved – it will appear on the site within a few seconds."

#: views.py:167
msgid "Propozycja została odrzucona."
msgstr "The suggestion has been rejected."

#: views.py:170
msgid "Tłumaczenie oznaczone jako przejrzane."
msgstr "Translation marked as reviewed."

#: views.py:173
msgid "Przywrócono tłumaczenie z katalogu."
msgstr "The catalogue translation has been restored."

#: views.py:193
msgid "Zgłoszenia przegląda recenzent tłumaczeń."
msgstr "Reports are handled by the translation reviewer."

#: views.py:204
msgid "Zgłoszenie zamknięte."
msgstr "Report closed."

#: views.py:244
msgid "Dziękujemy – recenzent tłumaczeń zobaczy zgłoszenie."
msgstr "Thank you – the translation reviewer will see your report."

#: views.py:285
msgid "Rola tłumacza została odebrana."
msgstr "The translator role has been revoked."

#: views.py:302
msgid "Rola tłumacza została nadana."
msgstr "The translator role has been granted."
