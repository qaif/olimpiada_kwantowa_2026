msgstr "reviewer"

#: templates/translation_review/coordinator_translators.html:42
msgid "tłumacz"
msgstr "translator"

#: templates/translation_review/coordinator_translators.html:48
msgid "Odbierz"
msgstr "Revoke"

#: templates/translation_review/coordinator_translators.html:54
msgid "Nikt nie ma jeszcze roli tłumacza."
msgstr "Nobody has the translator role yet."

#: templates/translation_review/detail.html:10
