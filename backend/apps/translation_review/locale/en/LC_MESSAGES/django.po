msgstr "Current translation"

#: templates/translation_review/detail.html:29
msgid "zatwierdzone w serwisie, czeka na przeniesienie do repozytorium"
msgstr "approved on the site, waiting to be moved to the repository"

#: templates/translation_review/detail.html:33
#: templates/translation_review/list.html:49
msgid "maszynowe"
msgstr "machine"

#: templates/translation_review/detail.html:37
msgid "Tłumaczenie w katalogu"
msgstr "Translation in the catalogue"

#: templates/translation_review/detail.html:41
msgid "Forma mnoga"
msgstr "Plural form"

#: templates/translation_review/detail.html:45
msgid "Kontekst"
msgstr "Context"

#: templates/translation_review/detail.html:49
msgid "Uwagi dla tłumacza"
msgstr "Notes for the translator"

#: templates/translation_review/detail.html:52
msgid "Gdzie występuje"
msgstr "Where it appears"

#: templates/translation_review/detail.html:55
msgid ""
"Zmienne w nawiasach i znaczniki HTML muszą zostać dokładnie takie, jak w "
"tekście źródłowym. Zamiast cudzysłowów prostych używaj typograficznych."
msgstr ""
"Variables in brackets and HTML tags must stay exactly as in the source "
"text. Use typographic quotation marks instead of straight ones."

#: templates/translation_review/detail.html:61
msgid "Przywróć tłumaczenie z katalogu"
msgstr "Restore the catalogue translation"

#: templates/translation_review/detail.html:66
msgid "Obecne tłumaczenie jest poprawne"
msgstr "The current translation is correct"

#: templates/translation_review/detail.html:76
msgid "Zaproponuj poprawkę"
msgstr "Suggest a fix"

#: templates/translation_review/detail.html:88
msgid "Wyślij propozycję"
msgstr "Send suggestion"

#: templates/translation_review/detail.html:95
msgid "Propozycje"
msgstr "Suggestions"

#: templates/translation_review/detail.html:101
msgid "czeka na recenzenta"
msgstr "waiting for a reviewer"

#: templates/translation_review/detail.html:101
msgid "zatwierdzona"
msgstr "approved"

#: templates/translation_review/detail.html:101
