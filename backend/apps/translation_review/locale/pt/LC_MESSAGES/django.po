msgid "Zgłoś tłumaczenie"
msgstr "Comunicar uma tradução"

#: templates/translation_review/report.html:12
msgid ""
"Napisz, który napis jest źle przetłumaczony i jak powinien brzmieć. "
"Recenzent tłumaczeń Twojego języka poprawi go dla wszystkich."
msgstr ""
"Indique que texto está mal traduzido e como deveria ficar. O revisor de "
"traduções do seu idioma corrigi-lo-á para todos."

#: templates/translation_review/report.html:16
#: templates/translation_review/reports.html:19
msgid "Strona"
msgstr "Página"

#: templates/translation_review/report.html:30
msgid "Wyślij zgłoszenie"
msgstr "Enviar comunicação"

#: templates/translation_review/reports.html:13
msgid "Zgłoszenia tłumaczeń"
msgstr "Comunicações de tradução"

#: templates/translation_review/reports.html:22
msgid "szukaj na liście"
msgstr "pesquisar na lista"

#: templates/translation_review/reports.html:24
msgid "Uwaga"
msgstr "Comentário"

#: templates/translation_review/reports.html:29
msgid "Zamknij zgłoszenie"
msgstr "Fechar comunicação"

#: templates/translation_review/reports.html:33
msgid "Nie ma otwartych zgłoszeń."
msgstr "Não há comunicações abertas."

#: validation.py:91
msgid "Tłumaczenie nie może być puste."
msgstr "A tradução não pode estar vazia."

#: validation.py:101
#, python-format
msgid "Tłumaczenie jest za długie (najwyżej %(limit)d znaków)."
msgstr "A tradução é demasiado longa (no máximo %(limit)d caracteres)."

#: validation.py:105
msgid "Tłumaczenie zawiera niedozwolony znak sterujący kierunkiem tekstu."
msgstr ""
"A tradução contém um carácter de controlo de direção do texto não permitido."

#: validation.py:109
msgid "nowa linia"
msgstr "quebra de linha"

#: validation.py:109
msgid "tabulator"
msgstr "tabulação"

#: validation.py:110
#, python-format
msgid "Niedozwolony znak sterujący: %(char)s."
msgstr "Carácter de controlo não permitido: %(char)s."

#: validation.py:114 validation.py:130
msgid "(brak)"
msgstr "(nenhum)"

#: validation.py:116
#, python-format
msgid ""
"Znaczniki HTML muszą być dokładnie takie, jak w tekście źródłowym: %(tags)s"
msgstr ""
"As etiquetas HTML têm de ser exatamente como no texto de origem: %(tags)s"

#: validation.py:122
#, python-format
msgid ""
"Znak „%(char)s” jest dozwolony wyłącznie jako część znacznika z tekstu "
"źródłowego."
msgstr ""
"O carácter «%(char)s» só é permitido como parte de uma etiqueta do texto de "
"origem."

#: validation.py:126
#, python-format
msgid ""
"Użyj cudzysłowów typograficznych (np. “…”, «…», „…”) zamiast znaku %(char)s."
msgstr ""
"Use aspas tipográficas (p. ex. “…”, «…», „…”) em vez do carácter %(char)s."

#: validation.py:132
#, python-format
msgid ""
"Tłumaczenie musi zawierać te same zmienne, co tekst źródłowy: "
"%(placeholders)s"
msgstr ""
"A tradução tem de conter as mesmas variáveis que o texto de origem: "
"%(placeholders)s"

#: validation.py:138
msgid ""
"Znaki procentu i nawiasów klamrowych mają w tym napisie znaczenie techniczne "
"– zapisz je dokładnie tak, jak w tekście źródłowym."
msgstr ""
"Os sinais de percentagem e as chavetas têm significado técnico nesta cadeia "
"– escreva-os exatamente como no texto de origem."

#: views.py:75 views.py:214
msgid "Twoje konto nie ma roli tłumacza."
msgstr "A sua conta não tem a função de tradutor."

#: views.py:155
msgid "Propozycja została zapisana."
msgstr "A proposta foi guardada."

#: views.py:164
msgid "Tłumaczenie zatwierdzone – działa w serwisie w ciągu kilku sekund."
msgstr "Tradução aprovada – aparecerá no site dentro de alguns segundos."

#: views.py:167
msgid "Propozycja została odrzucona."
msgstr "A proposta foi rejeitada."

#: views.py:170
msgid "Tłumaczenie oznaczone jako przejrzane."
msgstr "Tradução marcada como revista."

#: views.py:173
msgid "Przywrócono tłumaczenie z katalogu."
msgstr "A tradução do catálogo foi reposta."

#: views.py:193
msgid "Zgłoszenia przegląda recenzent tłumaczeń."
msgstr "As comunicações são analisadas pelo revisor de traduções."

#: views.py:204
msgid "Zgłoszenie zamknięte."
msgstr "Comunicação fechada."

#: views.py:244
msgid "Dziękujemy – recenzent tłumaczeń zobaczy zgłoszenie."
msgstr "Obrigado – o revisor de traduções verá a sua comunicação."

#: views.py:285
msgid "Rola tłumacza została odebrana."
msgstr "A função de tradutor foi retirada."

#: views.py:302
msgid "Rola tłumacza została nadana."
msgstr "A função de tradutor foi atribuída."
