#: validation.py:91
msgid "Tłumaczenie nie może być puste."
msgstr "لا يمكن أن تكون الترجمة فارغة."

#: validation.py:101
#, python-format
msgid "Tłumaczenie jest za długie (najwyżej %(limit)d znaków)."
msgstr "الترجمة طويلة جدًا (الحد الأقصى %(limit)d حرفًا)."

#: validation.py:105
msgid "Tłumaczenie zawiera niedozwolony znak sterujący kierunkiem tekstu."
msgstr "تحتوي الترجمة على حرف تحكم غير مسموح به في اتجاه النص."

#: validation.py:109
msgid "nowa linia"
msgstr "سطر جديد"

#: validation.py:109
msgid "tabulator"
msgstr "مسافة جدولة"

#: validation.py:110
#, python-format
msgid "Niedozwolony znak sterujący: %(char)s."
msgstr "حرف تحكم غير مسموح به: %(char)s."

#: validation.py:114 validation.py:130
msgid "(brak)"
msgstr "(لا شيء)"

#: validation.py:116
#, python-format
msgid ""
"Znaczniki HTML muszą być dokładnie takie, jak w tekście źródłowym: %(tags)s"
msgstr "يجب أن تكون وسوم HTML مطابقة تمامًا لما في النص المصدر: %(tags)s"

#: validation.py:122
#, python-format
msgid ""
"Znak „%(char)s” jest dozwolony wyłącznie jako część znacznika z tekstu "
"źródłowego."
msgstr "يُسمح بالحرف «%(char)s» فقط كجزء من وسم موجود في النص المصدر."

#: validation.py:126
#, python-format
msgid ""
"Użyj cudzysłowów typograficznych (np. “…”, «…», „…”) zamiast znaku %(char)s."
msgstr ""
"استخدم علامات الاقتباس الطباعية (مثل “…” أو «…» أو „…”) بدل الحرف %(char)s."

#: validation.py:132
#, python-format
msgid ""
"Tłumaczenie musi zawierać te same zmienne, co tekst źródłowy: "
"%(placeholders)s"
msgstr ""
"يجب أن تحتوي الترجمة على المتغيرات نفسها الموجودة في النص المصدر: "
"%(placeholders)s"

#: validation.py:138
msgid ""
"Znaki procentu i nawiasów klamrowych mają w tym napisie znaczenie techniczne "
"– zapisz je dokładnie tak, jak w tekście źródłowym."
msgstr ""
"لعلامات النسبة المئوية والأقواس المعقوفة معنى تقني في هذا النص – اكتبها "
"تمامًا كما في النص المصدر."

