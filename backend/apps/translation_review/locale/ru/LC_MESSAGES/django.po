#: validation.py:91
msgid "Tłumaczenie nie może być puste."
msgstr "Перевод не может быть пустым."

#: validation.py:101
#, python-format
msgid "Tłumaczenie jest za długie (najwyżej %(limit)d znaków)."
msgstr "Перевод слишком длинный (не более %(limit)d символов)."

#: validation.py:105
msgid "Tłumaczenie zawiera niedozwolony znak sterujący kierunkiem tekstu."
msgstr "Перевод содержит запрещённый управляющий символ направления текста."

#: validation.py:109
msgid "nowa linia"
msgstr "перевод строки"

#: validation.py:109
msgid "tabulator"
msgstr "табуляция"

#: validation.py:110
#, python-format
msgid "Niedozwolony znak sterujący: %(char)s."
msgstr "Запрещённый управляющий символ: %(char)s."

#: validation.py:114 validation.py:130
msgid "(brak)"
msgstr "(нет)"

#: validation.py:116
#, python-format
msgid ""
"Znaczniki HTML muszą być dokładnie takie, jak w tekście źródłowym: %(tags)s"
msgstr "HTML-теги должны быть точно такими же, как в исходном тексте: %(tags)s"

#: validation.py:122
#, python-format
msgid ""
"Znak „%(char)s” jest dozwolony wyłącznie jako część znacznika z tekstu "
"źródłowego."
msgstr "Символ «%(char)s» допустим только как часть тега из исходного текста."

#: validation.py:126
#, python-format
msgid ""
"Użyj cudzysłowów typograficznych (np. “…”, «…», „…”) zamiast znaku %(char)s."
msgstr ""
"Используйте типографские кавычки (например, “…”, «…», „…”) вместо символа "
"%(char)s."

#: validation.py:132
#, python-format
msgid ""
"Tłumaczenie musi zawierać te same zmienne, co tekst źródłowy: "
"%(placeholders)s"
msgstr ""
"Перевод должен содержать те же переменные, что и исходный текст: "
"%(placeholders)s"

#: validation.py:138
msgid ""
"Znaki procentu i nawiasów klamrowych mają w tym napisie znaczenie techniczne "
"– zapisz je dokładnie tak, jak w tekście źródłowym."
msgstr ""
"Знаки процента и фигурные скобки имеют в этой строке техническое значение – "
"пишите их точно так же, как в исходном тексте."

#: views.py:75 views.py:214
msgid "Twoje konto nie ma roli tłumacza."
msgstr "У вашей учётной записи нет роли переводчика."

#: views.py:155
msgid "Propozycja została zapisana."
msgstr "Предложение сохранено."

#: views.py:164
msgid "Tłumaczenie zatwierdzone – działa w serwisie w ciągu kilku sekund."
msgstr "Перевод утверждён – он появится на сайте через несколько секунд."

#: views.py:167
msgid "Propozycja została odrzucona."
msgstr "Предложение отклонено."

#: views.py:170
msgid "Tłumaczenie oznaczone jako przejrzane."
msgstr "Перевод отмечен как проверенный."

#: views.py:173
msgid "Przywrócono tłumaczenie z katalogu."
msgstr "Перевод из каталога восстановлен."

#: views.py:193
msgid "Zgłoszenia przegląda recenzent tłumaczeń."
msgstr "Сообщения просматривает рецензент переводов."

#: views.py:204
msgid "Zgłoszenie zamknięte."
msgstr "Сообщение закрыто."

#: views.py:244
msgid "Dziękujemy – recenzent tłumaczeń zobaczy zgłoszenie."
msgstr "Спасибо – рецензент переводов увидит ваше сообщение."

#: views.py:285
msgid "Rola tłumacza została odebrana."
msgstr "Роль переводчика снята."

#: views.py:302
msgid "Rola tłumacza została nadana."
msgstr "Роль переводчика назначена."
