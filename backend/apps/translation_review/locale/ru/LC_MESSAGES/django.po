#: services.py:127 views.py:56
msgid "Nie masz uprawnień do tłumaczeń tego języka."
msgstr "У вас нет прав на перевод этого языка."

#: services.py:168
msgid "Nie możesz nadawać ról tłumaczy."
msgstr "Вы не можете назначать роль переводчика."

#: services.py:170
msgid "Nieznany język."
msgstr "Неизвестный язык."

#: services.py:172
msgid "Nieznany poziom uprawnień."
msgstr "Неизвестный уровень прав."

#: services.py:175
msgid "Rolę recenzenta tłumaczeń nadaje wyłącznie superkoordynator."
msgstr "Роль рецензента переводов назначает только суперкоординатор."

#: services.py:180
msgid "Nie znaleziono aktywnego konta z tym adresem w tym konkursie."
msgstr "Активная учётная запись с этим адресом в этом конкурсе не найдена."

#: services.py:183 services.py:208
msgid "Tę osobę może zmienić wyłącznie superkoordynator."
msgstr "Изменить эту запись может только суперкоординатор."

#: services.py:205
msgid "Nie możesz odbierać ról tłumaczy."
msgstr "Вы не можете снимать роль переводчика."

#: services.py:340
msgid "Ta propozycja jest identyczna z obecnym tłumaczeniem."
msgstr "Это предложение совпадает с текущим переводом."

#: services.py:367
msgid "Na rozstrzygniętą propozycję nie można już głosować."
msgstr "За рассмотренное предложение голосовать уже нельзя."

#: services.py:369
msgid "Nie można głosować na własną propozycję."
msgstr "Нельзя голосовать за собственное предложение."

#: services.py:390 services.py:423
msgid "Ta propozycja została już rozstrzygnięta."
msgstr "Это предложение уже рассмотрено."

#: services.py:440
msgid "Ten napis nie ma jeszcze tłumaczenia – zaproponuj je."
msgstr "У этой строки ещё нет перевода – предложите его."

#: services.py:442
msgid "To tłumaczenie jest już przejrzane."
msgstr "Этот перевод уже проверен."

#: services.py:485
msgid "Opisz, co jest nie tak z tłumaczeniem."
msgstr "Опишите, что не так с переводом."

#: services.py:487
msgid "Zgłoszenie jest za długie."
msgstr "Сообщение слишком длинное."

