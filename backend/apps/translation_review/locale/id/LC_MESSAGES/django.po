#: services.py:146 views.py:56
msgid "Nie masz uprawnień do tłumaczeń tego języka."
msgstr "Anda tidak berwenang menerjemahkan bahasa ini."

#: services.py:201
msgid "Nie możesz nadawać ról tłumaczy."
msgstr "Anda tidak dapat memberikan peran penerjemah."

#: services.py:203
msgid "Nieznany język."
msgstr "Bahasa tidak dikenal."

#: services.py:205
msgid "Nieznany poziom uprawnień."
msgstr "Tingkat izin tidak dikenal."

#: services.py:208
msgid "Rolę recenzenta tłumaczeń nadaje wyłącznie superkoordynator."
msgstr ""
"Hanya koordinator super yang dapat memberikan peran peninjau terjemahan."

#: services.py:210
msgid "Ten język nie jest językiem interfejsu tego konkursu."
msgstr "Bahasa ini bukan bahasa antarmuka kompetisi ini."

#: services.py:215
msgid "Nie znaleziono aktywnego konta z tym adresem w tym konkursie."
msgstr "Tidak ditemukan akun aktif dengan alamat ini dalam kompetisi ini."

#: services.py:244
msgid "Nie możesz odbierać ról tłumaczy."
msgstr "Anda tidak dapat mencabut peran penerjemah."

#: services.py:249
msgid "Tę osobę może zmienić wyłącznie superkoordynator."
msgstr "Hanya koordinator super yang dapat mengubah orang ini."

#: services.py:434
msgid "Ta propozycja jest identyczna z obecnym tłumaczeniem."
msgstr "Usulan ini sama dengan terjemahan saat ini."

#: services.py:465
msgid "Na rozstrzygniętą propozycję nie można już głosować."
msgstr "Usulan yang sudah diputuskan tidak dapat diberi suara lagi."

#: services.py:467
msgid "Nie można głosować na własną propozycję."
msgstr "Anda tidak dapat memberi suara pada usulan sendiri."

#: services.py:500 services.py:537
msgid "Ta propozycja została już rozstrzygnięta."
msgstr "Usulan ini sudah diputuskan."

#: services.py:554
msgid "Ten napis nie ma jeszcze tłumaczenia – zaproponuj je."
msgstr "Teks ini belum memiliki terjemahan – silakan usulkan."

#: services.py:557
msgid "To tłumaczenie jest już przejrzane."
msgstr "Terjemahan ini sudah ditinjau."

#: services.py:614
msgid "Opisz, co jest nie tak z tłumaczeniem."
msgstr "Jelaskan apa yang salah dengan terjemahan."

#: services.py:616
msgid "Zgłoszenie jest za długie."
msgstr "Laporan terlalu panjang."

