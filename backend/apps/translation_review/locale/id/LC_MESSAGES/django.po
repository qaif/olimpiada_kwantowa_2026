#: validation.py:110
msgid "Tłumaczenie nie może być puste."
msgstr "Terjemahan tidak boleh kosong."

#: validation.py:121
#, python-format
msgid "Tłumaczenie jest za długie (najwyżej %(limit)d znaków)."
msgstr "Terjemahan terlalu panjang (paling banyak %(limit)d karakter)."

#: validation.py:125
msgid "Tłumaczenie zawiera niedozwolony znak sterujący kierunkiem tekstu."
msgstr "Terjemahan berisi karakter kendali arah teks yang tidak diizinkan."

#: validation.py:129
msgid "nowa linia"
msgstr "baris baru"

#: validation.py:129
msgid "tabulator"
msgstr "tab"

#: validation.py:130
#, python-format
msgid "Niedozwolony znak sterujący: %(char)s."
msgstr "Karakter kendali tidak diizinkan: %(char)s."

#: validation.py:134 validation.py:150 validation.py:156
msgid "(brak)"
msgstr "(tidak ada)"

#: validation.py:136
#, python-format
msgid ""
"Znaczniki HTML muszą być dokładnie takie, jak w tekście źródłowym: %(tags)s"
msgstr "Tag HTML harus persis seperti di teks sumber: %(tags)s"

#: validation.py:141
msgid ""
"Znak „<” poza znacznikiem z tekstu źródłowego może stać tylko przed spacją "
"albo cyfrą."
msgstr ""
"Di luar tag dari teks sumber, karakter “<” hanya boleh berada sebelum spasi "
"atau angka."

#: validation.py:145
#, python-format
msgid ""
"Użyj cudzysłowów typograficznych (np. “…”, «…», „…”) zamiast znaku %(char)s."
msgstr ""
"Gunakan tanda kutip tipografis (mis. “…”, «…», „…”) sebagai ganti karakter "
"%(char)s."

#: validation.py:152 validation.py:158
#, python-format
msgid ""
"Tłumaczenie musi zawierać te same zmienne, co tekst źródłowy: "
"%(placeholders)s"
msgstr ""
"Terjemahan harus berisi variabel yang sama dengan teks sumber: "
"%(placeholders)s"

#: validation.py:166
msgid ""
"Ten napis ma kilka zmiennych bez nazw – jego tłumaczenie można poprawić "
"tylko w repozytorium; zgłoś je ze stopki."
msgstr ""
"Teks ini memiliki beberapa variabel tanpa nama – terjemahannya hanya dapat "
"diperbaiki di repositori; laporkan dari footer."

#: validation.py:173
msgid ""
"Znaki procentu i nawiasów klamrowych mają w tym napisie znaczenie techniczne "
"– zapisz je dokładnie tak, jak w tekście źródłowym."
msgstr ""
"Tanda persen dan kurung kurawal memiliki makna teknis dalam teks ini – "
"tulis persis seperti di teks sumber."

#: views.py:78 views.py:225
msgid "Twoje konto nie ma roli tłumacza."
msgstr "Akun Anda tidak memiliki peran penerjemah."

#: views.py:159
msgid "Propozycja została zapisana."
msgstr "Usulan telah disimpan."

#: views.py:171
msgid "Tłumaczenie zatwierdzone – działa w serwisie w ciągu kilku sekund."
msgstr "Terjemahan disetujui – akan tampil di situs dalam beberapa detik."

#: views.py:175
msgid "Propozycja została odrzucona."
msgstr "Usulan telah ditolak."

#: views.py:178
msgid "Tłumaczenie oznaczone jako przejrzane."
msgstr "Terjemahan ditandai sudah ditinjau."

#: views.py:181
msgid "Przywrócono tłumaczenie z katalogu."
msgstr "Terjemahan dari katalog telah dipulihkan."

#: views.py:204
msgid "Zgłoszenia przegląda recenzent tłumaczeń."
msgstr "Laporan ditangani oleh peninjau terjemahan."

#: views.py:215
msgid "Zgłoszenie zamknięte."
msgstr "Laporan ditutup."

#: views.py:257
msgid "Dziękujemy – recenzent tłumaczeń zobaczy zgłoszenie."
msgstr "Terima kasih – peninjau terjemahan akan melihat laporan Anda."

#: views.py:313
msgid "Rola tłumacza została odebrana."
msgstr "Peran penerjemah telah dicabut."

#: views.py:330
msgid "Rola tłumacza została nadana."
msgstr "Peran penerjemah telah diberikan."
