msgid "Zaświadczenie o udziale"
msgstr "प्रतिभागिता प्रमाणपत्र"

#, python-format
msgid "za wybitny wynik w zawodach %(competition)s"
msgstr "%(competition)s में उत्कृष्ट प्रदर्शन के लिए"

#, python-format
msgid "za wyróżniający się wynik w zawodach %(competition)s"
msgstr "%(competition)s में सराहनीय प्रदर्शन के लिए"

#, python-format
msgid "za udział w zawodach %(competition)s"
msgstr "%(competition)s में भाग लेने के लिए"

#, python-format
msgid "edycja %(edition)s"
msgstr "संस्करण %(edition)s"

msgid "Przewodniczący Komitetu Organizacyjnego"
msgstr "आयोजन समिति के अध्यक्ष"

#, python-format
msgid "Numer dokumentu: %(number)s"
msgstr "दस्तावेज़ संख्या: %(number)s"

#, python-format
msgid "Kod weryfikacyjny: %(code)s"
msgstr "सत्यापन कोड: %(code)s"

#, python-format
msgid "Data wystawienia: %(date)s"
msgstr "जारी करने की तिथि: %(date)s"

#, python-format
msgid "Weryfikacja: %(url)s"
msgstr "सत्यापन: %(url)s"

msgid "Medale"
msgstr "पदक"

msgid "Ranking krajów"
msgstr "देशों की रैंकिंग"

#, python-format
msgid "Ogłoszone %(announced)s. Złoto, srebro i brąz przyznaje się z rankingu etapu; ten sam wynik zawsze daje tę samą nagrodę."
msgstr "%(announced)s को घोषित। स्वर्ण, रजत और कांस्य पदक चरण की रैंकिंग के आधार पर दिए जाते हैं; समान अंक पर हमेशा समान पुरस्कार मिलता है।"

msgid "Pełna tabela wyników"
msgstr "पूरी परिणाम तालिका"

msgid "Wszystkie kraje"
msgstr "सभी देश"

msgid "Pokaż"
msgstr "दिखाएँ"

#, python-format
msgid "%(name)s – uczestnicy: %(contestants)s, złoto: %(gold)s, srebro: %(silver)s, brąz: %(bronze)s, wyróżnienia: %(hm)s."
msgstr "%(name)s – प्रतिभागी: %(contestants)s, स्वर्ण: %(gold)s, रजत: %(silver)s, कांस्य: %(bronze)s, सम्माननीय उल्लेख: %(hm)s।"

msgid "Lista obejmuje wyłącznie osoby, których kraj wolno pokazać przy wyniku."
msgstr "सूची में केवल वे प्रतिभागी हैं जिनका देश उनके परिणाम के साथ दिखाया जा सकता है।"

msgid "Tabela medali"
msgstr "पदक तालिका"

msgid "Nagroda"
msgstr "पुरस्कार"

msgid "decyzja komitetu"
msgstr "समिति का निर्णय"

msgid "Ranking nieoficjalny: olimpiada jest zawodami indywidualnymi. Tabela pokazuje wyłącznie sumy dla kraju – bez wyników poszczególnych uczestników."
msgstr "अनौपचारिक रैंकिंग: ओलंपियाड एक व्यक्तिगत प्रतियोगिता है। तालिका केवल देशों के कुल योग दिखाती है – व्यक्तिगत परिणाम नहीं।"

msgid "Kolejność według sumy punktów"
msgstr "कुल अंकों के अनुसार क्रम"

msgid "Kolejność według medali"
msgstr "पदकों के अनुसार क्रम"

msgid "Złoto"
msgstr "स्वर्ण"

msgid "Srebro"
msgstr "रजत"

msgid "Brąz"
msgstr "कांस्य"

msgid "Wyróżnienia"
msgstr "सम्माननीय उल्लेख"
