msgid "złoty medal"
msgstr "gold medal"

msgid "srebrny medal"
msgstr "silver medal"

msgid "brązowy medal"
msgstr "bronze medal"

msgid "wyróżnienie"
msgstr "honourable mention"

msgid "bez nagrody"
msgstr "no award"

msgid "Złoty medal"
msgstr "Gold Medal"

msgid "Srebrny medal"
msgstr "Silver Medal"

msgid "Brązowy medal"
msgstr "Bronze Medal"

msgid "Wyróżnienie"
msgstr "Honourable Mention"

msgid "Zaświadczenie o udziale"
msgstr "Certificate of Participation"

#, python-format
msgid "za wybitny wynik w zawodach %(competition)s"
msgstr "for outstanding performance at the %(competition)s"

#, python-format
msgid "za wyróżniający się wynik w zawodach %(competition)s"
msgstr "for a commendable performance at the %(competition)s"

#, python-format
msgid "za udział w zawodach %(competition)s"
msgstr "for participation in the %(competition)s"

#, python-format
msgid "edycja %(edition)s"
msgstr "edition %(edition)s"

msgid "Przewodniczący Komitetu Organizacyjnego"
msgstr "Chair of the Organising Committee"

#, python-format
msgid "Numer dokumentu: %(number)s"
msgstr "Document number: %(number)s"

#, python-format
msgid "Kod weryfikacyjny: %(code)s"
msgstr "Verification code: %(code)s"

#, python-format
msgid "Data wystawienia: %(date)s"
msgstr "Date of issue: %(date)s"

#, python-format
msgid "Weryfikacja: %(url)s"
msgstr "Verify: %(url)s"

msgid "Medale"
msgstr "Medals"

msgid "Ranking krajów"
msgstr "Country ranking"

#, python-format
msgid "Ogłoszone %(announced)s. Złoto, srebro i brąz przyznaje się z rankingu etapu; ten sam wynik zawsze daje tę samą nagrodę."
msgstr "Announced %(announced)s. Gold, silver and bronze are awarded from the round ranking; the same score always earns the same award."

msgid "Pełna tabela wyników"
msgstr "Full results table"

msgid "Wszystkie kraje"
msgstr "All countries"

msgid "Pokaż"
msgstr "Show"

#, python-format
msgid "%(name)s – uczestnicy: %(contestants)s, złoto: %(gold)s, srebro: %(silver)s, brąz: %(bronze)s, wyróżnienia: %(hm)s."
msgstr "%(name)s – contestants: %(contestants)s, gold: %(gold)s, silver: %(silver)s, bronze: %(bronze)s, honourable mentions: %(hm)s."

msgid "Lista obejmuje wyłącznie osoby, których kraj wolno pokazać przy wyniku."
msgstr "The list includes only contestants whose country may be shown next to their result."

msgid "Tabela medali"
msgstr "Medal table"

msgid "Nagroda"
msgstr "Award"

msgid "decyzja komitetu"
msgstr "committee decision"

msgid "Ranking nieoficjalny: olimpiada jest zawodami indywidualnymi. Tabela pokazuje wyłącznie sumy dla kraju – bez wyników poszczególnych uczestników."
msgstr "Unofficial ranking: the olympiad is an individual competition. The table shows only country totals – no individual results."

msgid "Kolejność według sumy punktów"
msgstr "Order by total score"

msgid "Kolejność według medali"
msgstr "Order by medals"

msgid "Złoto"
msgstr "Gold"

msgid "Srebro"
msgstr "Silver"

msgid "Brąz"
msgstr "Bronze"

msgid "Wyróżnienia"
msgstr "Honourable mentions"
