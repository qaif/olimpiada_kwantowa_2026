msgid "złoty medal"
msgstr "ميدالية ذهبية"

msgid "srebrny medal"
msgstr "ميدالية فضية"

msgid "brązowy medal"
msgstr "ميدالية برونزية"

msgid "wyróżnienie"
msgstr "تنويه شرفي"

msgid "bez nagrody"
msgstr "بدون جائزة"

msgid "Złoty medal"
msgstr "الميدالية الذهبية"

msgid "Srebrny medal"
msgstr "الميدالية الفضية"

msgid "Brązowy medal"
msgstr "الميدالية البرونزية"

msgid "Wyróżnienie"
msgstr "تنويه شرفي"

msgid "Zaświadczenie o udziale"
msgstr "شهادة مشاركة"

#, python-format
msgid "za wybitny wynik w zawodach %(competition)s"
msgstr "تقديرًا للأداء المتميز في %(competition)s"

#, python-format
msgid "za wyróżniający się wynik w zawodach %(competition)s"
msgstr "تقديرًا للأداء المشرّف في %(competition)s"

#, python-format
msgid "za udział w zawodach %(competition)s"
msgstr "للمشاركة في %(competition)s"

#, python-format
msgid "edycja %(edition)s"
msgstr "الدورة %(edition)s"

msgid "Przewodniczący Komitetu Organizacyjnego"
msgstr "رئيس اللجنة المنظمة"

#, python-format
msgid "Numer dokumentu: %(number)s"
msgstr "رقم الوثيقة: %(number)s"

#, python-format
msgid "Kod weryfikacyjny: %(code)s"
msgstr "رمز التحقق: %(code)s"

#, python-format
msgid "Data wystawienia: %(date)s"
msgstr "تاريخ الإصدار: %(date)s"

#, python-format
msgid "Weryfikacja: %(url)s"
msgstr "التحقق: %(url)s"

msgid "Medale"
msgstr "الميداليات"

msgid "Ranking krajów"
msgstr "ترتيب الدول"

#, python-format
msgid "Ogłoszone %(announced)s. Złoto, srebro i brąz przyznaje się z rankingu etapu; ten sam wynik zawsze daje tę samą nagrodę."
msgstr "أُعلنت في %(announced)s. تُمنح الميداليات الذهبية والفضية والبرونزية وفق ترتيب المرحلة، والنتيجة نفسها تنال دائمًا الجائزة نفسها."

msgid "Pełna tabela wyników"
msgstr "جدول النتائج الكامل"

msgid "Wszystkie kraje"
msgstr "جميع الدول"

msgid "Pokaż"
msgstr "عرض"

#, python-format
msgid "%(name)s – uczestnicy: %(contestants)s, złoto: %(gold)s, srebro: %(silver)s, brąz: %(bronze)s, wyróżnienia: %(hm)s."
msgstr "%(name)s – المشاركون: %(contestants)s، ذهبية: %(gold)s، فضية: %(silver)s، برونزية: %(bronze)s، تنويهات شرفية: %(hm)s."

msgid "Lista obejmuje wyłącznie osoby, których kraj wolno pokazać przy wyniku."
msgstr "تتضمن القائمة فقط المشاركين الذين يجوز إظهار دولتهم بجانب نتيجتهم."

msgid "Tabela medali"
msgstr "جدول الميداليات"

msgid "Nagroda"
msgstr "الجائزة"

msgid "decyzja komitetu"
msgstr "قرار اللجنة"

msgid "Ranking nieoficjalny: olimpiada jest zawodami indywidualnymi. Tabela pokazuje wyłącznie sumy dla kraju – bez wyników poszczególnych uczestników."
msgstr "ترتيب غير رسمي: الأولمبياد مسابقة فردية. يعرض الجدول مجاميع الدول فقط – دون النتائج الفردية."

msgid "Kolejność według sumy punktów"
msgstr "الترتيب حسب مجموع النقاط"

msgid "Kolejność według medali"
msgstr "الترتيب حسب الميداليات"

msgid "Złoto"
msgstr "ذهب"

msgid "Srebro"
msgstr "فضة"

msgid "Brąz"
msgstr "برونز"

msgid "Wyróżnienia"
msgstr "تنويهات شرفية"

msgid "Średnia"
msgstr "المتوسط"

#, python-format
msgid "Suma i średnia punktów są podane tylko dla krajów z co najmniej %(minimum)s wynikami – przy mniejszej drużynie byłyby wynikiem konkretnej osoby."
msgstr "يُعرض مجموع النقاط ومتوسطها فقط للدول التي لديها %(minimum)s نتائج على الأقل – ففي الفريق الأصغر قد يكشفان نتيجة شخص بعينه."

msgid "Ten dokument nie jest już aktualny: nagroda, którą poświadcza, została zmieniona albo jest w trakcie korekty. Aktualny dokument wydaje organizator."
msgstr "لم تعد هذه الوثيقة سارية: الجائزة التي تشهد بها قد تغيّرت أو قيد التصحيح. يُصدر المنظِّم الوثيقة السارية."
