msgid "złoty medal"
msgstr "золотая медаль"

msgid "srebrny medal"
msgstr "серебряная медаль"

msgid "brązowy medal"
msgstr "бронзовая медаль"

msgid "wyróżnienie"
msgstr "почётная грамота"

msgid "bez nagrody"
msgstr "без награды"

msgid "Złoty medal"
msgstr "Золотая медаль"

msgid "Srebrny medal"
msgstr "Серебряная медаль"

msgid "Brązowy medal"
msgstr "Бронзовая медаль"

msgid "Wyróżnienie"
msgstr "Почётная грамота"

msgid "Zaświadczenie o udziale"
msgstr "Свидетельство об участии"

#, python-format
msgid "za wybitny wynik w zawodach %(competition)s"
msgstr "за выдающийся результат в соревновании «%(competition)s»"

#, python-format
msgid "za wyróżniający się wynik w zawodach %(competition)s"
msgstr "за достойный результат в соревновании «%(competition)s»"

#, python-format
msgid "za udział w zawodach %(competition)s"
msgstr "за участие в соревновании «%(competition)s»"

#, python-format
msgid "edycja %(edition)s"
msgstr "сезон %(edition)s"

msgid "Przewodniczący Komitetu Organizacyjnego"
msgstr "Председатель организационного комитета"

#, python-format
msgid "Numer dokumentu: %(number)s"
msgstr "Номер документа: %(number)s"

#, python-format
msgid "Kod weryfikacyjny: %(code)s"
msgstr "Код проверки: %(code)s"

#, python-format
msgid "Data wystawienia: %(date)s"
msgstr "Дата выдачи: %(date)s"

#, python-format
msgid "Weryfikacja: %(url)s"
msgstr "Проверка: %(url)s"

msgid "Medale"
msgstr "Медали"

msgid "Ranking krajów"
msgstr "Рейтинг стран"

#, python-format
msgid "Ogłoszone %(announced)s. Złoto, srebro i brąz przyznaje się z rankingu etapu; ten sam wynik zawsze daje tę samą nagrodę."
msgstr "Объявлено %(announced)s. Золото, серебро и бронза присуждаются по рейтингу этапа; одинаковый результат всегда даёт одинаковую награду."

msgid "Pełna tabela wyników"
msgstr "Полная таблица результатов"

msgid "Wszystkie kraje"
msgstr "Все страны"

msgid "Pokaż"
msgstr "Показать"

#, python-format
msgid "%(name)s – uczestnicy: %(contestants)s, złoto: %(gold)s, srebro: %(silver)s, brąz: %(bronze)s, wyróżnienia: %(hm)s."
msgstr "%(name)s – участники: %(contestants)s, золото: %(gold)s, серебро: %(silver)s, бронза: %(bronze)s, почётные грамоты: %(hm)s."

msgid "Lista obejmuje wyłącznie osoby, których kraj wolno pokazać przy wyniku."
msgstr "В списке только участники, страну которых можно показывать рядом с результатом."

msgid "Tabela medali"
msgstr "Таблица медалей"

msgid "Nagroda"
msgstr "Награда"

msgid "decyzja komitetu"
msgstr "решение комитета"

msgid "Ranking nieoficjalny: olimpiada jest zawodami indywidualnymi. Tabela pokazuje wyłącznie sumy dla kraju – bez wyników poszczególnych uczestników."
msgstr "Неофициальный рейтинг: олимпиада — личное соревнование. Таблица показывает только итоги по странам, без индивидуальных результатов."

msgid "Kolejność według sumy punktów"
msgstr "Сортировать по сумме баллов"

msgid "Kolejność według medali"
msgstr "Сортировать по медалям"

msgid "Złoto"
msgstr "Золото"

msgid "Srebro"
msgstr "Серебро"

msgid "Brąz"
msgstr "Бронза"

msgid "Wyróżnienia"
msgstr "Почётные грамоты"

msgid "Średnia"
msgstr "Среднее"

#, python-format
msgid "Suma i średnia punktów są podane tylko dla krajów z co najmniej %(minimum)s wynikami – przy mniejszej drużynie byłyby wynikiem konkretnej osoby."
msgstr "Сумма и средний балл показываются только для стран, у которых не меньше %(minimum)s результатов, – в меньшей команде они раскрыли бы результат конкретного человека."

msgid "Ten dokument nie jest już aktualny: nagroda, którą poświadcza, została zmieniona albo jest w trakcie korekty. Aktualny dokument wydaje organizator."
msgstr "Этот документ больше не действителен: награда, которую он подтверждает, изменена или находится на исправлении. Действующий документ выдаёт организатор."
