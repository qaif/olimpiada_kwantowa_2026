msgstr "Medalla de bronce"

msgid "Wyróżnienie"
msgstr "Mención honorífica"

msgid "Zaświadczenie o udziale"
msgstr "Certificado de participación"

#, python-format
msgid "za wybitny wynik w zawodach %(competition)s"
msgstr "por su destacado desempeño en la competición %(competition)s"

#, python-format
msgid "za wyróżniający się wynik w zawodach %(competition)s"
msgstr "por su meritorio desempeño en la competición %(competition)s"

#, python-format
msgid "za udział w zawodach %(competition)s"
msgstr "por su participación en la competición %(competition)s"

#, python-format
msgid "edycja %(edition)s"
msgstr "edición %(edition)s"

msgid "Przewodniczący Komitetu Organizacyjnego"
msgstr "Presidencia del Comité Organizador"

#, python-format
msgid "Numer dokumentu: %(number)s"
msgstr "Número de documento: %(number)s"

#, python-format
msgid "Kod weryfikacyjny: %(code)s"
msgstr "Código de verificación: %(code)s"

#, python-format
msgid "Data wystawienia: %(date)s"
msgstr "Fecha de emisión: %(date)s"

#, python-format
msgid "Weryfikacja: %(url)s"
msgstr "Verificación: %(url)s"

msgid "Medale"
msgstr "Medallas"

msgid "Ranking krajów"
msgstr "Clasificación por países"

#, python-format
msgid "Ogłoszone %(announced)s. Złoto, srebro i brąz przyznaje się z rankingu etapu; ten sam wynik zawsze daje tę samą nagrodę."
msgstr "Publicado el %(announced)s. El oro, la plata y el bronce se otorgan según la clasificación de la fase; la misma puntuación siempre recibe el mismo premio."

msgid "Pełna tabela wyników"
msgstr "Tabla completa de resultados"

msgid "Wszystkie kraje"
msgstr "Todos los países"

msgid "Pokaż"
msgstr "Mostrar"

#, python-format
msgid "%(name)s – uczestnicy: %(contestants)s, złoto: %(gold)s, srebro: %(silver)s, brąz: %(bronze)s, wyróżnienia: %(hm)s."
msgstr "%(name)s – participantes: %(contestants)s, oro: %(gold)s, plata: %(silver)s, bronce: %(bronze)s, menciones honoríficas: %(hm)s."

msgid "Lista obejmuje wyłącznie osoby, których kraj wolno pokazać przy wyniku."
msgstr "La lista incluye solo a los participantes cuyo país puede mostrarse junto a su resultado."

msgid "Tabela medali"
msgstr "Medallero"

msgid "Nagroda"
msgstr "Premio"

msgid "decyzja komitetu"
msgstr "decisión del comité"

msgid "Ranking nieoficjalny: olimpiada jest zawodami indywidualnymi. Tabela pokazuje wyłącznie sumy dla kraju – bez wyników poszczególnych uczestników."
msgstr "Clasificación no oficial: la olimpiada es una competición individual. La tabla muestra solo los totales por país, sin resultados individuales."

msgid "Kolejność według sumy punktów"
msgstr "Ordenar por puntuación total"

msgid "Kolejność według medali"
msgstr "Ordenar por medallas"

msgid "Złoto"
msgstr "Oro"

msgid "Srebro"
msgstr "Plata"

msgid "Brąz"
msgstr "Bronce"

