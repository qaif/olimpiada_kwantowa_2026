msgstr "Medalha de prata"

msgid "Brązowy medal"
msgstr "Medalha de bronze"

msgid "Wyróżnienie"
msgstr "Menção honrosa"

msgid "Zaświadczenie o udziale"
msgstr "Certificado de participação"

#, python-format
msgid "za wybitny wynik w zawodach %(competition)s"
msgstr "pelo desempenho notável na competição %(competition)s"

#, python-format
msgid "za wyróżniający się wynik w zawodach %(competition)s"
msgstr "pelo desempenho meritório na competição %(competition)s"

#, python-format
msgid "za udział w zawodach %(competition)s"
msgstr "pela participação na competição %(competition)s"

#, python-format
msgid "edycja %(edition)s"
msgstr "edição %(edition)s"

msgid "Przewodniczący Komitetu Organizacyjnego"
msgstr "Presidência da Comissão Organizadora"

#, python-format
msgid "Numer dokumentu: %(number)s"
msgstr "Número do documento: %(number)s"

#, python-format
msgid "Kod weryfikacyjny: %(code)s"
msgstr "Código de verificação: %(code)s"

#, python-format
msgid "Data wystawienia: %(date)s"
msgstr "Data de emissão: %(date)s"

#, python-format
msgid "Weryfikacja: %(url)s"
msgstr "Verificação: %(url)s"

msgid "Medale"
msgstr "Medalhas"

msgid "Ranking krajów"
msgstr "Classificação por países"

#, python-format
msgid "Ogłoszone %(announced)s. Złoto, srebro i brąz przyznaje się z rankingu etapu; ten sam wynik zawsze daje tę samą nagrodę."
msgstr "Anunciado em %(announced)s. Ouro, prata e bronze são atribuídos com base na classificação da etapa; a mesma pontuação sempre recebe o mesmo prêmio."

msgid "Pełna tabela wyników"
msgstr "Tabela completa de resultados"

msgid "Wszystkie kraje"
msgstr "Todos os países"

msgid "Pokaż"
msgstr "Mostrar"

#, python-format
msgid "%(name)s – uczestnicy: %(contestants)s, złoto: %(gold)s, srebro: %(silver)s, brąz: %(bronze)s, wyróżnienia: %(hm)s."
msgstr "%(name)s – participantes: %(contestants)s, ouro: %(gold)s, prata: %(silver)s, bronze: %(bronze)s, menções honrosas: %(hm)s."

msgid "Lista obejmuje wyłącznie osoby, których kraj wolno pokazać przy wyniku."
msgstr "A lista inclui apenas os participantes cujo país pode ser mostrado junto ao resultado."

msgid "Tabela medali"
msgstr "Quadro de medalhas"

msgid "Nagroda"
msgstr "Prêmio"

msgid "decyzja komitetu"
msgstr "decisão do comitê"

msgid "Ranking nieoficjalny: olimpiada jest zawodami indywidualnymi. Tabela pokazuje wyłącznie sumy dla kraju – bez wyników poszczególnych uczestników."
msgstr "Classificação não oficial: a olimpíada é uma competição individual. A tabela mostra apenas os totais por país, sem resultados individuais."

msgid "Kolejność według sumy punktów"
msgstr "Ordenar pela pontuação total"

msgid "Kolejność według medali"
msgstr "Ordenar por medalhas"

msgid "Złoto"
msgstr "Ouro"

msgid "Srebro"
msgstr "Prata"

msgid "Brąz"
msgstr "Bronze"

msgid "Wyróżnienia"
