#, python-format
msgid "Zagregowane dane z profili absolwentów. Grupy mniejsze niż %(k)s osób nie są pokazywane osobno – nikogo nie da się z tych tabel rozpoznać."
msgstr "Data gabungan dari profil alumni. Kelompok yang lebih kecil dari %(k)s orang tidak ditampilkan terpisah – tidak ada yang dapat diidentifikasi dari tabel ini."

#, python-format
msgid "Absolwentów w sieci: %(total)s."
msgstr "Alumni dalam jaringan: %(total)s."

#, python-format
msgid "Mentorów: %(mentors)s."
msgstr "Mentor: %(mentors)s."

#, python-format
msgid "Mentorów: mniej niż %(k)s."
msgstr "Mentor: kurang dari %(k)s."

#, python-format
msgid "Sieć ma mniej niż %(k)s osób – rozkładów nie pokazujemy, bo każda liczba mówiłaby o konkretnych ludziach."
msgstr "Jaringan ini beranggotakan kurang dari %(k)s orang – kami tidak menampilkan sebaran, karena setiap angka akan menggambarkan orang tertentu."

msgid "Katalog absolwentów"
msgstr "Direktori alumni"

msgid "Absolwenci, którzy zgodzili się pokazać swój profil zalogowanym uczestnikom."
msgstr "Alumni yang bersedia menampilkan profilnya kepada peserta yang sudah masuk."

msgid "Szukaj (imię, uczelnia, kierunek)"
msgstr "Cari (nama depan, universitas, bidang studi)"

msgid "Zainteresowanie"
msgstr "Minat"

msgid "Tylko mentorzy z wolnym miejscem"
msgstr "Hanya mentor dengan tempat kosong"

msgid "Strony katalogu"
msgstr "Halaman direktori"

msgid "Nikogo tu jeszcze nie ma"
msgstr "Belum ada siapa pun di sini"

msgid "Sieć absolwentów"
msgstr "Jaringan alumni"

msgid "Organizator wyłączył sieć absolwentów. Twój profil nie jest nikomu pokazywany, nie dostajesz zaproszeń, a rozmowy mentorskie są tylko do odczytu. Dane profilu zostają do czasu wycofania zgody albo usunięcia ich przez organizatora."
msgstr "Penyelenggara telah menonaktifkan jaringan alumni. Profil Anda tidak ditampilkan kepada siapa pun, Anda tidak menerima undangan, dan percakapan mentoring hanya dapat dibaca. Data profil tetap tersimpan sampai Anda menarik persetujuan atau penyelenggara menghapusnya."

msgid "Wycofaj zgodę i usuń profil"
msgstr "Tarik persetujuan dan hapus profil"

msgid "Zgłoś problem z mentoringiem"
msgstr "Laporkan masalah mentoring"

msgid "Zgłoszenie trafi od razu do organizatora. Jeśli problem dotyczy konkretnej wiadomości, zgłoś ją także w Wiadomościach przyciskiem „Zgłoś”."
msgstr "Laporan langsung dikirim ke penyelenggara. Jika masalahnya menyangkut pesan tertentu, laporkan juga di Pesan dengan tombol “Laporkan”."

msgid "Wyślij zgłoszenie"
msgstr "Kirim laporan"

msgid "Byli uczestnicy, którzy pokazują, co robią dziś, pomagają obecnym uczestnikom jako mentorzy i dostają zaproszenia na warsztaty, webinary i do jury."
msgstr "Mantan peserta yang menunjukkan kegiatan mereka saat ini, membantu peserta saat ini sebagai mentor, dan menerima undangan ke lokakarya, webinar, dan peran juri."

msgid "Publiczna ściana"
msgstr "Dinding publik"

msgid "Zmieniła się treść zgody"
msgstr "Teks persetujuan telah berubah"

msgid "Twój profil jest niewidoczny, dopóki nie potwierdzisz nowej treści zgody. Możesz też wycofać zgodę niżej."
msgstr "Profil Anda tersembunyi sampai Anda mengonfirmasi teks persetujuan yang baru. Anda juga dapat menarik persetujuan di bawah."

msgid "Potwierdzam"
msgstr "Saya mengonfirmasi"

msgid "Twój profil"
msgstr "Profil Anda"

msgid "Organizator ukrył Twój profil – nie widać go w katalogu ani na ścianie. Napisz do organizatora, jeśli to pomyłka."
msgstr "Penyelenggara telah menyembunyikan profil Anda – profil tidak terlihat di direktori maupun di dinding. Hubungi penyelenggara jika ini suatu kesalahan."

msgid "Tak widzą Cię inni zalogowani uczestnicy:"
msgstr "Beginilah peserta lain yang sudah masuk melihat Anda:"

msgid "Zapisz profil"
msgstr "Simpan profil"

msgid "Wycofanie zgody"
msgstr "Penarikan persetujuan"

msgid "Po wycofaniu zgody Twój profil absolwenta zniknie od razu, a relacje, w których jesteś mentorem, zakończą się. Twoje wyniki i dyplomy zostają – to dokumentacja zawodów."
msgstr "Setelah Anda menarik persetujuan, profil alumni Anda akan segera hilang dan hubungan di mana Anda menjadi mentor akan berakhir. Hasil dan sertifikat Anda tetap ada – keduanya merupakan bagian dari arsip kompetisi."

msgid "Dołącz do sieci absolwentów"
msgstr "Bergabung dengan jaringan alumni"

msgid "Twoje osiągnięcia z ogłoszonych wyników:"
msgstr "Prestasi Anda dari hasil yang telah diumumkan:"

msgid "Dołączam"
msgstr "Bergabung"

msgid "Organizator nie włączył jeszcze mentoringu."
msgstr "Penyelenggara belum mengaktifkan mentoring."

msgid "Rola"
msgstr "Peran"

msgid "Druga osoba"
msgstr "Pihak lain"

msgid "jesteś mentorem"
msgstr "Anda adalah mentor"

msgid "Twój mentor"
msgstr "mentor Anda"

msgid "Notatka prośby czeka na akceptację organizatora."
msgstr "Catatan permintaan menunggu persetujuan penyelenggara."

msgid "Przyjmij"
msgstr "Terima"

msgid "Wycofaj prośbę"
msgstr "Tarik permintaan"

msgid "Rozmowa"
msgstr "Percakapan"

msgid "Zakończ"
msgstr "Akhiri"

msgid "Zgłoś problem"
msgstr "Laporkan masalah"

msgid "Nie masz jeszcze żadnej relacji mentorskiej. Mentora wybierzesz w katalogu absolwentów – przy osobach, które pomagają, stoi przycisk „Poproś o mentoring”."
msgstr "Anda belum memiliki hubungan mentoring. Anda dapat memilih mentor di direktori alumni – orang yang bersedia membantu memiliki tombol “Minta mentoring”."

msgid "Rozmowa mentorska toczy się w Wiadomościach. Jeśli uczestnik jest niepełnoletni, organizator czyta wiadomości – zależnie od zasad konkursu przed doręczeniem albo po nim."
msgstr "Percakapan mentoring berlangsung di Pesan. Jika peserta masih di bawah umur, penyelenggara membaca pesan – sebelum atau setelah dikirim, tergantung aturan kompetisi."

msgid "Prośba o mentoring"
msgstr "Permintaan mentoring"

msgid "Jeśli mentor przyjmie prośbę, rozmowa otworzy się w Wiadomościach. Organizator widzi relacje mentorskie i – zależnie od zasad konkursu – czyta wiadomości."
msgstr "Jika mentor menerima permintaan, percakapan akan dibuka di Pesan. Penyelenggara dapat melihat hubungan mentoring dan – tergantung aturan kompetisi – membaca pesan."

msgid "Wyślij prośbę"
msgstr "Kirim permintaan"

msgid "Wypis z zaproszeń"
msgstr "Berhenti berlangganan undangan"

msgid "Wypis z zaproszeń dla absolwentów"
msgstr "Berhenti berlangganan undangan alumni"

msgid "Ten odnośnik jest nieprawidłowy. Zaproszenia wyłączysz też w swoim profilu absolwenta."
msgstr "Tautan ini tidak valid. Anda juga dapat menonaktifkan undangan di profil alumni Anda."

msgid "Gotowe – nie będziesz już dostawać zaproszeń. Włączysz je z powrotem w profilu absolwenta."
msgstr "Selesai – Anda tidak akan menerima undangan lagi. Anda dapat mengaktifkannya kembali di profil alumni Anda."

msgid "Kliknij, żeby nie dostawać więcej zaproszeń od organizatora (warsztaty, webinary, jury)."
msgstr "Klik untuk berhenti menerima undangan dari penyelenggara (lokakarya, webinar, juri)."

msgid "Wypisz mnie"
msgstr "Berhentikan langganan saya"

msgid "Nasi absolwenci"
msgstr "Alumni kami"

msgid "Laureaci i finaliści poprzednich edycji – i to, co robią dziś."
msgstr "Pemenang dan finalis edisi sebelumnya – dan kegiatan mereka saat ini."

msgid "Strony"
msgstr "Halaman"

#, python-format
msgid "Podaj adres profilu %(service)s zaczynający się od https://."
msgstr "Masukkan alamat profil %(service)s yang diawali dengan https://."

#, python-format
msgid "To nie wygląda na adres profilu %(service)s."
msgstr "Ini tidak tampak seperti alamat profil %(service)s."

msgid "Adres wydarzenia musi zaczynać się od https://."
msgstr "Alamat acara harus diawali dengan https://."

msgid "Witaj w sieci absolwentów! Uzupełnij profil – każde pole jest opcjonalne."
msgstr "Selamat datang di jaringan alumni! Lengkapi profil Anda – semua kolom bersifat opsional."

msgid "Profil zapisany."
msgstr "Profil disimpan."

msgid "Zgoda wycofana – Twój profil absolwenta został usunięty."
msgstr "Persetujuan ditarik – profil alumni Anda telah dihapus."

msgid "Dziękujemy – Twój profil znów jest widoczny."
msgstr "Terima kasih – profil Anda terlihat kembali."

msgid "Prośba wysłana. Dostaniesz e-mail, gdy mentor odpowie."
msgstr "Permintaan terkirim. Anda akan menerima email saat mentor membalas."

msgid "Prośba przyjęta – rozmowa czeka w Wiadomościach."
msgstr "Permintaan diterima – percakapan menunggu di Pesan."

msgid "Prośba odrzucona."
msgstr "Permintaan ditolak."

msgid "Prośba wycofana."
msgstr "Permintaan ditarik."

msgid "Relacja mentorska zakończona."
msgstr "Hubungan mentoring berakhir."

msgid "Zgłoszenie wysłane do organizatora."
msgstr "Laporan dikirim ke penyelenggara."

msgid "Ustawienia zapisane."
msgstr "Pengaturan disimpan."

msgid "Profil ukryty."
msgstr "Profil disembunyikan."

msgid "Profil znów jest widoczny."
msgstr "Profil kembali terlihat."

msgid "Opis zaakceptowany – małoletni uczestnicy go zobaczą."
msgstr "Deskripsi disetujui – peserta di bawah umur akan melihatnya."

msgid "Decyzja zapisana."
msgstr "Keputusan disimpan."

msgid "Podaj powód zakończenia relacji."
msgstr "Berikan alasan pengakhiran hubungan."

msgid "Relacja zakończona. Obie strony dostały list."
msgstr "Hubungan diakhiri. Kedua pihak telah menerima email."

msgid "Zgłoszenie zamknięte."
msgstr "Laporan ditutup."

