msgstr "Berhenti berlangganan undangan: %(link)s"

msgid "Żaden absolwent nie spełnia tych filtrów."
msgstr "Tidak ada alumni yang sesuai dengan filter ini."

msgid "Rozmowa mentorska. Każdą wiadomość czyta i akceptuje organizator, zanim trafi do drugiej osoby."
msgstr "Percakapan mentoring. Penyelenggara membaca dan menyetujui setiap pesan sebelum sampai ke pihak lain."

msgid "Rozmowa mentorska – obowiązują zasady Wiadomości tego konkursu."
msgstr "Percakapan mentoring – berlaku aturan Pesan dari kompetisi ini."

msgid "Rozmowa mentorska. Organizator przegląda wiadomości tej rozmowy (moderacja następcza)."
msgstr "Percakapan mentoring. Penyelenggara meninjau pesan dalam percakapan ini (pascamoderasi)."

msgid "Mentoring zakończył się – ta rozmowa jest teraz tylko do odczytu."
msgstr "Mentoring telah berakhir – percakapan ini sekarang hanya dapat dibaca."

msgid "Organizator wstrzymał mentoring – ta rozmowa jest teraz tylko do odczytu."
msgstr "Penyelenggara telah menjeda mentoring – percakapan ini sekarang hanya dapat dibaca."

msgid "Nowa rozmowa mentorska. Pierwsze wiadomości czyta i akceptuje organizator, zanim trafią do drugiej osoby."
msgstr "Percakapan mentoring baru. Penyelenggara membaca dan menyetujui pesan-pesan pertama sebelum sampai ke pihak lain."

msgid "Mentoring jest w tym konkursie wyłączony."
msgstr "Mentoring dinonaktifkan dalam kompetisi ini."

msgid "Mentoring wymaga modułu Wiadomości, który organizator wyłączył."
msgstr "Mentoring memerlukan modul Pesan, yang telah dinonaktifkan oleh penyelenggara."

msgid "Ta osoba nie przyjmuje teraz próśb o mentoring."
msgstr "Orang ini sedang tidak menerima permintaan mentoring."

#, python-format
msgid "%(label)s nie może być puste."
msgstr "%(label)s tidak boleh kosong."

#, python-format
msgid "%(label)s jest za długie (limit %(limit)s znaków)."
msgstr "%(label)s terlalu panjang (batas: %(limit)s karakter)."

msgid "Nie możesz poprosić o mentoring samego siebie."
msgstr "Anda tidak dapat meminta mentoring kepada diri sendiri."

msgid "O mentora proszą uczestnicy bieżącej edycji."
msgstr "Mentor dapat diminta oleh peserta edisi saat ini."

msgid "Wybierz temat z listy."
msgstr "Pilih topik dari daftar."

msgid "Notatka"
msgstr "Catatan"

msgid "Masz już otwartą prośbę albo relację z tą osobą."
msgstr "Anda sudah memiliki permintaan terbuka atau hubungan mentoring dengan orang ini."

#, python-format
msgid "Możesz mieć naraz najwyżej %(limit)s otwarte prośby i relacje mentorskie."
msgstr "Anda dapat memiliki paling banyak %(limit)s permintaan dan hubungan mentoring terbuka sekaligus."

msgid "Ta osoba nie ma teraz wolnego miejsca na mentoring."
msgstr "Orang ini sedang tidak memiliki tempat mentoring yang kosong."

msgid "Wysłano już dziś dużo próśb o mentoring – spróbuj jutro."
msgstr "Hari ini Anda sudah mengirim banyak permintaan mentoring – coba lagi besok."

msgid "Do tej osoby wysłano już w tym tygodniu prośbę – spróbuj za kilka dni."
msgstr "Anda sudah mengirim permintaan kepada orang ini minggu ini – coba lagi dalam beberapa hari."

msgid "Nie ma takiej relacji mentorskiej."
msgstr "Hubungan mentoring tersebut tidak ditemukan."

msgid "Macie już rozmowę szyfrowaną, a ta relacja wymaga moderacji organizatora. Organizator dostał zgłoszenie i skontaktuje się z Wami."
msgstr "Anda sudah memiliki percakapan terenkripsi, sedangkan hubungan ini memerlukan moderasi penyelenggara. Penyelenggara telah diberi tahu dan akan menghubungi Anda."

msgid "Na tę prośbę już odpowiedziano."
msgstr "Permintaan ini sudah dijawab."

msgid "Najpierw dołącz do sieci absolwentów."
msgstr "Bergabunglah dengan jaringan alumni terlebih dahulu."

msgid "Twój profil nie przyjmuje teraz nowych relacji mentorskich."
msgstr "Profil Anda saat ini tidak menerima hubungan mentoring baru."

msgid "Ta osoba nie jest już uczestnikiem konkursu."
msgstr "Orang ini bukan lagi peserta kompetisi."

msgid "Masz już komplet mentee. Zwiększ liczbę miejsc w profilu albo zakończ inną relację."
msgstr "Jumlah mentee Anda sudah penuh. Tambah jumlah tempat di profil Anda atau akhiri hubungan lain."

msgid "Tę prośbę można już tylko zakończyć."
msgstr "Permintaan ini sekarang hanya dapat diakhiri."

msgid "Ta relacja jest już zakończona."
msgstr "Hubungan ini sudah berakhir."

