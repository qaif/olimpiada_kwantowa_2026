msgid "Sieć ma mniej niż %(k)s osób – rozkładów nie pokazujemy, bo każda liczba mówiłaby o konkretnych ludziach."
msgstr "The network has fewer than %(k)s people – we do not show distributions, because every number would describe specific people."

msgid "Katalog absolwentów"
msgstr "Alumni directory"

msgid "Absolwenci, którzy zgodzili się pokazać swój profil zalogowanym uczestnikom."
msgstr "Alumni who have agreed to show their profile to logged-in participants."

msgid "Szukaj (imię, uczelnia, kierunek)"
msgstr "Search (first name, university, field of study)"

msgid "Zainteresowanie"
msgstr "Interest"

msgid "Tylko mentorzy z wolnym miejscem"
msgstr "Only mentors with a free place"

msgid "Strony katalogu"
msgstr "Directory pages"

msgid "Nikogo tu jeszcze nie ma"
msgstr "Nobody here yet"

msgid "Zgłoś problem z mentoringiem"
msgstr "Report a problem with mentoring"

msgid "Zgłoszenie trafi od razu do organizatora. Jeśli problem dotyczy konkretnej wiadomości, zgłoś ją także w Wiadomościach przyciskiem „Zgłoś”."
msgstr "The report goes straight to the organiser. If the problem concerns a specific message, also report it in Messages with the “Report” button."

msgid "Wyślij zgłoszenie"
msgstr "Send report"

msgid "Sieć absolwentów"
msgstr "Alumni network"

msgid "Byli uczestnicy, którzy pokazują, co robią dziś, pomagają obecnym uczestnikom jako mentorzy i dostają zaproszenia na warsztaty, webinary i do jury."
msgstr "Former participants who show what they do today, help current participants as mentors and receive invitations to workshops, webinars and jury roles."

msgid "Publiczna ściana"
msgstr "Public wall"

msgid "Twój profil"
msgstr "Your profile"

msgid "Organizator ukrył Twój profil – nie widać go w katalogu ani na ścianie. Napisz do organizatora, jeśli to pomyłka."
msgstr "The organiser has hidden your profile – it is not visible in the directory or on the wall. Write to the organiser if this is a mistake."

msgid "Tak widzą Cię inni zalogowani uczestnicy:"
msgstr "This is how other logged-in participants see you:"

msgid "Zapisz profil"
msgstr "Save profile"

msgid "Wycofanie zgody"
msgstr "Withdrawing consent"

msgid "Po wycofaniu zgody Twój profil absolwenta zniknie od razu, a relacje, w których jesteś mentorem, zakończą się. Twoje wyniki i dyplomy zostają – to dokumentacja zawodów."
msgstr "After you withdraw consent, your alumni profile will disappear immediately and the relationships in which you are a mentor will end. Your results and certificates remain – they are part of the competition records."

msgid "Wycofaj zgodę i usuń profil"
msgstr "Withdraw consent and delete profile"

msgid "Dołącz do sieci absolwentów"
msgstr "Join the alumni network"

msgid "Twoje osiągnięcia z ogłoszonych wyników:"
msgstr "Your achievements from published results:"

msgid "Dołączam"
msgstr "Join"

msgid "Organizator nie włączył jeszcze mentoringu."
msgstr "The organiser has not enabled mentoring yet."

msgid "Rola"
msgstr "Role"

msgid "Druga osoba"
msgstr "Other person"

msgid "jesteś mentorem"
msgstr "you are the mentor"

msgid "Twój mentor"
msgstr "your mentor"

msgid "Przyjmij"
msgstr "Accept"

msgid "Odrzuć"
msgstr "Decline"

msgid "Wycofaj prośbę"
msgstr "Withdraw request"

msgid "Rozmowa"
msgstr "Conversation"

msgid "Zakończ"
msgstr "End"

msgid "Zgłoś problem"
msgstr "Report a problem"

msgid "Nie masz jeszcze żadnej relacji mentorskiej. Mentora wybierzesz w katalogu absolwentów – przy osobach, które pomagają, stoi przycisk „Poproś o mentoring”."
msgstr "You do not have any mentoring relationship yet. You can choose a mentor in the alumni directory – people who help have an “Ask for mentoring” button."

msgid "Rozmowa mentorska toczy się w Wiadomościach. Jeśli uczestnik jest niepełnoletni, organizator czyta wiadomości – zależnie od zasad konkursu przed doręczeniem albo po nim."
msgstr "The mentoring conversation takes place in Messages. If the participant is a minor, the organiser reads the messages – before or after delivery, depending on the competition's rules."

msgid "Prośba o mentoring"
msgstr "Mentoring request"

msgid "Jeśli mentor przyjmie prośbę, rozmowa otworzy się w Wiadomościach. Organizator widzi relacje mentorskie i – zależnie od zasad konkursu – czyta wiadomości."
msgstr "If the mentor accepts the request, a conversation will open in Messages. The organiser can see mentoring relationships and – depending on the competition's rules – reads the messages."

msgid "Wyślij prośbę"
msgstr "Send request"

msgid "Wypis z zaproszeń"
msgstr "Unsubscribe from invitations"

msgid "Wypis z zaproszeń dla absolwentów"
msgstr "Unsubscribe from alumni invitations"

msgid "Ten odnośnik jest nieprawidłowy. Zaproszenia wyłączysz też w swoim profilu absolwenta."
msgstr "This link is invalid. You can also turn off invitations in your alumni profile."

msgid "Gotowe – nie będziesz już dostawać zaproszeń. Włączysz je z powrotem w profilu absolwenta."
msgstr "Done – you will no longer receive invitations. You can turn them back on in your alumni profile."

msgid "Kliknij, żeby nie dostawać więcej zaproszeń od organizatora (warsztaty, webinary, jury)."
msgstr "Click to stop receiving invitations from the organiser (workshops, webinars, jury)."

msgid "Wypisz mnie"
msgstr "Unsubscribe me"

msgid "Nasi absolwenci"
msgstr "Our alumni"

msgid "Laureaci i finaliści poprzednich edycji – i to, co robią dziś."
msgstr "Laureates and finalists of previous editions – and what they do today."

msgid "Strony"
msgstr "Pages"

#, python-format
msgid "Podaj adres profilu %(service)s zaczynający się od https://."
msgstr "Enter the %(service)s profile address starting with https://."

#, python-format
msgid "To nie wygląda na adres profilu %(service)s."
msgstr "This does not look like a %(service)s profile address."

msgid "Adres wydarzenia musi zaczynać się od https://."
msgstr "The event address must start with https://."

msgid "Witaj w sieci absolwentów! Uzupełnij profil – każde pole jest opcjonalne."
msgstr "Welcome to the alumni network! Fill in your profile – every field is optional."

msgid "Profil zapisany."
msgstr "Profile saved."

msgid "Zgoda wycofana – Twój profil absolwenta został usunięty."
msgstr "Consent withdrawn – your alumni profile has been deleted."

msgid "Prośba wysłana. Dostaniesz e-mail, gdy mentor odpowie."
msgstr "Request sent. You will receive an email when the mentor replies."

msgid "Prośba przyjęta – rozmowa czeka w Wiadomościach."
msgstr "Request accepted – the conversation is waiting in Messages."

msgid "Prośba odrzucona."
msgstr "Request declined."

msgid "Prośba wycofana."
msgstr "Request withdrawn."

msgid "Relacja mentorska zakończona."
msgstr "Mentoring relationship ended."

msgid "Zgłoszenie wysłane do organizatora."
msgstr "Report sent to the organiser."

msgid "Ustawienia zapisane."
msgstr "Settings saved."

msgid "Profil ukryty."
msgstr "Profile hidden."

msgid "Profil znów jest widoczny."
msgstr "The profile is visible again."

msgid "Podaj powód zakończenia relacji."
msgstr "Give the reason for ending the relationship."

msgid "Relacja zakończona. Obie strony dostały list."
msgstr "Relationship ended. Both sides have received an email."

msgid "Zgłoszenie zamknięte."
msgstr "Report closed."

#, python-format
msgid "Zaproszenie wysłane. Liczba odbiorców: %(count)s."
msgstr "Invitation sent. Number of recipients: %(count)s."
