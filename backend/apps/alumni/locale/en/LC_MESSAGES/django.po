msgstr "Choose the type of invitation."

msgid "Tytuł jest wymagany (do 150 znaków)."
msgstr "A title is required (up to 150 characters)."

#, python-format
msgid "Treść jest wymagana (do %(limit)s znaków)."
msgstr "Content is required (up to %(limit)s characters)."

msgid "Dzień dobry,"
msgstr "Hello,"

#, python-format
msgid "organizator konkursu %(competition)s zaprasza absolwentów: %(kind)s."
msgstr "the organiser of %(competition)s invites alumni: %(kind)s."

#, python-format
msgid "Szczegóły i zapisy: %(url)s"
msgstr "Details and registration: %(url)s"

msgid "Dostajesz ten list, bo należysz do sieci absolwentów i nie wyłączyłeś zaproszeń."
msgstr "You are receiving this email because you belong to the alumni network and have not turned off invitations."

#, python-format
msgid "Wypisz się z zaproszeń: %(link)s"
msgstr "Unsubscribe from invitations: %(link)s"

msgid "Żaden absolwent nie spełnia tych filtrów."
msgstr "No alumni match these filters."

msgid "Rozmowa mentorska. Każdą wiadomość czyta i akceptuje organizator, zanim trafi do drugiej osoby."
msgstr "Mentoring conversation. The organiser reads and approves every message before it reaches the other person."

msgid "Rozmowa mentorska – obowiązują zasady Wiadomości tego konkursu."
msgstr "Mentoring conversation – the Messages rules of this competition apply."

msgid "Rozmowa mentorska. Organizator przegląda wiadomości tej rozmowy (moderacja następcza)."
msgstr "Mentoring conversation. The organiser reviews the messages of this conversation (post-moderation)."

msgid "Mentoring zakończył się – ta rozmowa jest teraz tylko do odczytu."
msgstr "The mentoring has ended – this conversation is now read-only."

msgid "Organizator wstrzymał mentoring – ta rozmowa jest teraz tylko do odczytu."
msgstr "The organiser has paused mentoring – this conversation is now read-only."

msgid "Mentoring jest w tym konkursie wyłączony."
msgstr "Mentoring is turned off in this competition."

msgid "Mentoring wymaga modułu Wiadomości, który organizator wyłączył."
msgstr "Mentoring requires the Messages module, which the organiser has turned off."

msgid "Ta osoba nie przyjmuje teraz próśb o mentoring."
msgstr "This person is not accepting mentoring requests at the moment."

#, python-format
msgid "%(label)s nie może być puste."
msgstr "%(label)s cannot be empty."

#, python-format
msgid "%(label)s jest za długie (limit %(limit)s znaków)."
msgstr "%(label)s is too long (limit: %(limit)s characters)."

msgid "Nie możesz poprosić o mentoring samego siebie."
msgstr "You cannot ask yourself for mentoring."

msgid "O mentora proszą uczestnicy bieżącej edycji."
msgstr "Mentors can be requested by participants of the current edition."

msgid "Wybierz temat z listy."
msgstr "Choose a topic from the list."

msgid "Notatka"
msgstr "Note"

msgid "Masz już otwartą prośbę albo relację z tą osobą."
msgstr "You already have an open request or mentoring relationship with this person."

#, python-format
msgid "Możesz mieć naraz najwyżej %(limit)s otwarte prośby i relacje mentorskie."
msgstr "You can have at most %(limit)s open mentoring requests and relationships at a time."

msgid "Ta osoba nie ma teraz wolnego miejsca na mentoring."
msgstr "This person has no free mentoring place at the moment."

msgid "Nie ma takiej relacji mentorskiej."
msgstr "No such mentoring relationship."

msgid "Na tę prośbę już odpowiedziano."
msgstr "This request has already been answered."

msgid "Najpierw dołącz do sieci absolwentów."
msgstr "Join the alumni network first."

msgid "Masz już komplet mentee. Zwiększ liczbę miejsc w profilu albo zakończ inną relację."
msgstr "You already have the full number of mentees. Increase the number of places in your profile or end another relationship."

msgid "Tę prośbę można już tylko zakończyć."
msgstr "This request can now only be ended."

msgid "Ta relacja jest już zakończona."
msgstr "This relationship has already ended."

msgid "Powód"
msgstr "Reason"

msgid "Nie ma takiego zgłoszenia."
msgstr "No such report."

