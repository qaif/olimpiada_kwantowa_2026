msgstr "Darse de baja de las invitaciones: %(link)s"

msgid "Żaden absolwent nie spełnia tych filtrów."
msgstr "Ningún exalumno coincide con estos filtros."

msgid "Rozmowa mentorska. Każdą wiadomość czyta i akceptuje organizator, zanim trafi do drugiej osoby."
msgstr "Conversación de mentoría. El organizador lee y aprueba cada mensaje antes de que llegue a la otra persona."

msgid "Rozmowa mentorska – obowiązują zasady Wiadomości tego konkursu."
msgstr "Conversación de mentoría: se aplican las reglas de Mensajes de esta competición."

msgid "Rozmowa mentorska. Organizator przegląda wiadomości tej rozmowy (moderacja następcza)."
msgstr "Conversación de mentoría. El organizador revisa los mensajes de esta conversación (moderación posterior)."

msgid "Mentoring zakończył się – ta rozmowa jest teraz tylko do odczytu."
msgstr "La mentoría ha terminado: esta conversación ahora es de solo lectura."

msgid "Organizator wstrzymał mentoring – ta rozmowa jest teraz tylko do odczytu."
msgstr "El organizador ha pausado la mentoría: esta conversación ahora es de solo lectura."

msgid "Nowa rozmowa mentorska. Pierwsze wiadomości czyta i akceptuje organizator, zanim trafią do drugiej osoby."
msgstr "Nueva conversación de mentoría. El organizador lee y aprueba los primeros mensajes antes de que lleguen a la otra persona."

msgid "Mentoring jest w tym konkursie wyłączony."
msgstr "La mentoría está desactivada en esta competición."

msgid "Mentoring wymaga modułu Wiadomości, który organizator wyłączył."
msgstr "La mentoría requiere el módulo Mensajes, que el organizador ha desactivado."

msgid "Ta osoba nie przyjmuje teraz próśb o mentoring."
msgstr "Esta persona no acepta solicitudes de mentoría en este momento."

#, python-format
msgid "%(label)s nie może być puste."
msgstr "%(label)s no puede estar vacío."

#, python-format
msgid "%(label)s jest za długie (limit %(limit)s znaków)."
msgstr "%(label)s es demasiado largo (límite: %(limit)s caracteres)."

msgid "Nie możesz poprosić o mentoring samego siebie."
msgstr "No puedes pedirte mentoría a ti mismo."

msgid "O mentora proszą uczestnicy bieżącej edycji."
msgstr "Pueden solicitar mentores los participantes de la edición actual."

msgid "Wybierz temat z listy."
msgstr "Elige un tema de la lista."

msgid "Notatka"
msgstr "Nota"

msgid "Masz już otwartą prośbę albo relację z tą osobą."
msgstr "Ya tienes una solicitud abierta o una relación de mentoría con esta persona."

#, python-format
msgid "Możesz mieć naraz najwyżej %(limit)s otwarte prośby i relacje mentorskie."
msgstr "Puedes tener como máximo %(limit)s solicitudes y relaciones de mentoría abiertas a la vez."

msgid "Ta osoba nie ma teraz wolnego miejsca na mentoring."
msgstr "Esta persona no tiene plazas de mentoría libres en este momento."

msgid "Wysłano już dziś dużo próśb o mentoring – spróbuj jutro."
msgstr "Hoy ya has enviado muchas solicitudes de mentoría; inténtalo mañana."

msgid "Do tej osoby wysłano już w tym tygodniu prośbę – spróbuj za kilka dni."
msgstr "Ya enviaste una solicitud a esta persona esta semana; inténtalo dentro de unos días."

msgid "Nie ma takiej relacji mentorskiej."
msgstr "No existe esa relación de mentoría."

msgid "Macie już rozmowę szyfrowaną, a ta relacja wymaga moderacji organizatora. Organizator dostał zgłoszenie i skontaktuje się z Wami."
msgstr "Ya tenéis una conversación cifrada y esta relación requiere la moderación del organizador. El organizador ha recibido un aviso y se pondrá en contacto con vosotros."

msgid "Na tę prośbę już odpowiedziano."
msgstr "Esta solicitud ya ha sido respondida."

msgid "Najpierw dołącz do sieci absolwentów."
msgstr "Primero únete a la red de exalumnos."

msgid "Twój profil nie przyjmuje teraz nowych relacji mentorskich."
msgstr "Tu perfil no acepta nuevas relaciones de mentoría en este momento."

msgid "Ta osoba nie jest już uczestnikiem konkursu."
msgstr "Esta persona ya no participa en el concurso."

msgid "Masz już komplet mentee. Zwiększ liczbę miejsc w profilu albo zakończ inną relację."
msgstr "Ya tienes el número máximo de mentorizados. Aumenta el número de plazas en tu perfil o finaliza otra relación."

msgid "Tę prośbę można już tylko zakończyć."
msgstr "Esta solicitud ahora solo se puede finalizar."

msgid "Ta relacja jest już zakończona."
msgstr "Esta relación ya ha finalizado."

