msgid "Sieć absolwentów"
msgstr "Réseau des anciens"

msgid "Byli uczestnicy, którzy pokazują, co robią dziś, pomagają obecnym uczestnikom jako mentorzy i dostają zaproszenia na warsztaty, webinary i do jury."
msgstr "D’anciens participants qui montrent ce qu’ils font aujourd’hui, aident les participants actuels en tant que mentors et reçoivent des invitations à des ateliers, des webinaires et des rôles de jury."

msgid "Publiczna ściana"
msgstr "Mur public"

msgid "Twój profil"
msgstr "Votre profil"

msgid "Organizator ukrył Twój profil – nie widać go w katalogu ani na ścianie. Napisz do organizatora, jeśli to pomyłka."
msgstr "L’organisateur a masqué votre profil – il n’est visible ni dans l’annuaire ni sur le mur. Écrivez à l’organisateur s’il s’agit d’une erreur."

msgid "Tak widzą Cię inni zalogowani uczestnicy:"
msgstr "Voici comment les autres participants connectés vous voient :"

msgid "Zapisz profil"
msgstr "Enregistrer le profil"

msgid "Wycofanie zgody"
msgstr "Retrait du consentement"

msgid "Po wycofaniu zgody Twój profil absolwenta zniknie od razu, a relacje, w których jesteś mentorem, zakończą się. Twoje wyniki i dyplomy zostają – to dokumentacja zawodów."
msgstr "Si vous retirez votre consentement, votre profil d’ancien disparaîtra immédiatement et les relations dans lesquelles vous êtes mentor prendront fin. Vos résultats et certificats sont conservés – ils font partie des archives du concours."

msgid "Wycofaj zgodę i usuń profil"
msgstr "Retirer mon consentement et supprimer mon profil"

msgid "Dołącz do sieci absolwentów"
msgstr "Rejoindre le réseau des anciens"

msgid "Twoje osiągnięcia z ogłoszonych wyników:"
msgstr "Vos résultats issus des classements publiés :"

msgid "Dołączam"
msgstr "Rejoindre"

msgid "Organizator nie włączył jeszcze mentoringu."
msgstr "L’organisateur n’a pas encore activé le mentorat."

msgid "Rola"
msgstr "Rôle"

msgid "Druga osoba"
msgstr "Autre personne"

msgid "jesteś mentorem"
msgstr "vous êtes le mentor"

msgid "Twój mentor"
msgstr "votre mentor"

msgid "Przyjmij"
msgstr "Accepter"

msgid "Odrzuć"
msgstr "Refuser"

msgid "Wycofaj prośbę"
msgstr "Retirer la demande"

msgid "Rozmowa"
msgstr "Conversation"

msgid "Zakończ"
msgstr "Terminer"

msgid "Zgłoś problem"
msgstr "Signaler un problème"

msgid "Nie masz jeszcze żadnej relacji mentorskiej. Mentora wybierzesz w katalogu absolwentów – przy osobach, które pomagają, stoi przycisk „Poproś o mentoring”."
msgstr "Vous n’avez encore aucune relation de mentorat. Vous pouvez choisir un mentor dans l’annuaire des anciens – les personnes qui proposent leur aide ont un bouton « Demander un mentorat »."

msgid "Rozmowa mentorska toczy się w Wiadomościach. Jeśli uczestnik jest niepełnoletni, organizator czyta wiadomości – zależnie od zasad konkursu przed doręczeniem albo po nim."
msgstr "La conversation de mentorat a lieu dans Messages. Si le participant est mineur, l’organisateur lit les messages – avant ou après leur remise, selon les règles du concours."

msgid "Prośba o mentoring"
msgstr "Demande de mentorat"

msgid "Jeśli mentor przyjmie prośbę, rozmowa otworzy się w Wiadomościach. Organizator widzi relacje mentorskie i – zależnie od zasad konkursu – czyta wiadomości."
msgstr "Si le mentor accepte la demande, une conversation s’ouvrira dans Messages. L’organisateur voit les relations de mentorat et – selon les règles du concours – lit les messages."

msgid "Wyślij prośbę"
msgstr "Envoyer la demande"

msgid "Wypis z zaproszeń"
msgstr "Se désabonner des invitations"

msgid "Wypis z zaproszeń dla absolwentów"
msgstr "Se désabonner des invitations destinées aux anciens"

msgid "Ten odnośnik jest nieprawidłowy. Zaproszenia wyłączysz też w swoim profilu absolwenta."
msgstr "Ce lien n’est pas valide. Vous pouvez aussi désactiver les invitations dans votre profil d’ancien."

msgid "Gotowe – nie będziesz już dostawać zaproszeń. Włączysz je z powrotem w profilu absolwenta."
msgstr "C’est fait – vous ne recevrez plus d’invitations. Vous pouvez les réactiver dans votre profil d’ancien."

msgid "Kliknij, żeby nie dostawać więcej zaproszeń od organizatora (warsztaty, webinary, jury)."
msgstr "Cliquez pour ne plus recevoir d’invitations de l’organisateur (ateliers, webinaires, jury)."

msgid "Wypisz mnie"
msgstr "Me désabonner"

msgid "Nasi absolwenci"
msgstr "Nos anciens"

msgid "Laureaci i finaliści poprzednich edycji – i to, co robią dziś."
msgstr "Lauréats et finalistes des éditions précédentes – et ce qu’ils font aujourd’hui."

msgid "Strony"
msgstr "Pages"

#, python-format
msgid "Podaj adres profilu %(service)s zaczynający się od https://."
msgstr "Saisissez l’adresse du profil %(service)s commençant par https://."

#, python-format
msgid "To nie wygląda na adres profilu %(service)s."
msgstr "Cela ne ressemble pas à une adresse de profil %(service)s."

msgid "Adres wydarzenia musi zaczynać się od https://."
msgstr "L’adresse de l’événement doit commencer par https://."

msgid "Witaj w sieci absolwentów! Uzupełnij profil – każde pole jest opcjonalne."
msgstr "Bienvenue dans le réseau des anciens ! Complétez votre profil – tous les champs sont facultatifs."

msgid "Profil zapisany."
msgstr "Profil enregistré."

msgid "Zgoda wycofana – Twój profil absolwenta został usunięty."
msgstr "Consentement retiré – votre profil d’ancien a été supprimé."

msgid "Prośba wysłana. Dostaniesz e-mail, gdy mentor odpowie."
msgstr "Demande envoyée. Vous recevrez un e-mail lorsque le mentor répondra."

msgid "Prośba przyjęta – rozmowa czeka w Wiadomościach."
msgstr "Demande acceptée – la conversation vous attend dans Messages."

msgid "Prośba odrzucona."
msgstr "Demande refusée."

msgid "Prośba wycofana."
msgstr "Demande retirée."

msgid "Relacja mentorska zakończona."
msgstr "Relation de mentorat terminée."

msgid "Zgłoszenie wysłane do organizatora."
msgstr "Signalement envoyé à l’organisateur."

msgid "Ustawienia zapisane."
msgstr "Paramètres enregistrés."

msgid "Profil ukryty."
msgstr "Profil masqué."

msgid "Profil znów jest widoczny."
msgstr "Le profil est de nouveau visible."

msgid "Podaj powód zakończenia relacji."
msgstr "Indiquez le motif de la fin de la relation."

msgid "Relacja zakończona. Obie strony dostały list."
msgstr "Relation terminée. Les deux parties ont reçu un e-mail."

msgid "Zgłoszenie zamknięte."
msgstr "Signalement clôturé."

#, python-format
msgid "Zaproszenie wysłane. Liczba odbiorców: %(count)s."
msgstr "Invitation envoyée. Nombre de destinataires : %(count)s."
