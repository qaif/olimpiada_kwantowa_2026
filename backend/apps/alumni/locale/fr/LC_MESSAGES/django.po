#, python-format
msgid "%(name)s prosi Cię o mentoring w sieci absolwentów."
msgstr "%(name)s vous demande un mentorat dans le réseau des anciens."

msgid "Notatkę prośby przeczytasz i odpowiesz na nią po zalogowaniu:"
msgstr "Vous pouvez lire la note de la demande et y répondre après vous être connecté :"

