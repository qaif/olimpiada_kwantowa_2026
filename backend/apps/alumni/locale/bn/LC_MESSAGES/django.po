msgstr "রিপোর্ট: সম্পর্কের সমস্যা / কথোপকথনে রিপোর্ট করা বার্তা (খোলা)।"

msgid "Gdzie są teraz – panel koordynatora"
msgstr "তাঁরা এখন কোথায় – সমন্বয়কারী প্যানেল"

#, python-format
msgid "Zagregowane dane z profili absolwentów. Grupy mniejsze niż %(k)s osób nie są pokazywane osobno – nikogo nie da się z tych tabel rozpoznać."
msgstr "প্রাক্তন অংশগ্রহণকারীদের প্রোফাইল থেকে সমষ্টিগত তথ্য। %(k)s জনের কম সদস্যের গোষ্ঠী আলাদাভাবে দেখানো হয় না – এই সারণিগুলো থেকে কাউকে শনাক্ত করা যায় না।"

#, python-format
msgid "Absolwentów w sieci: %(total)s."
msgstr "নেটওয়ার্কে প্রাক্তন অংশগ্রহণকারী: %(total)s।"

#, python-format
msgid "Mentorów: %(mentors)s."
msgstr "মেন্টর: %(mentors)s।"

#, python-format
msgid "Mentorów: mniej niż %(k)s."
msgstr "মেন্টর: %(k)s জনের কম।"

#, python-format
msgid "Sieć ma mniej niż %(k)s osób – rozkładów nie pokazujemy, bo każda liczba mówiłaby o konkretnych ludziach."
msgstr "নেটওয়ার্কে %(k)s জনের কম মানুষ আছেন – আমরা বণ্টন দেখাই না, কারণ প্রতিটি সংখ্যা নির্দিষ্ট মানুষদের সম্পর্কে তথ্য দেবে।"

msgid "Katalog absolwentów"
msgstr "প্রাক্তন অংশগ্রহণকারী ডিরেক্টরি"

msgid "Absolwenci, którzy zgodzili się pokazać swój profil zalogowanym uczestnikom."
msgstr "যেসব প্রাক্তন অংশগ্রহণকারী লগ-ইন করা অংশগ্রহণকারীদের নিজেদের প্রোফাইল দেখাতে সম্মত হয়েছেন।"

msgid "Szukaj (imię, uczelnia, kierunek)"
msgstr "খুঁজুন (প্রথম নাম, বিশ্ববিদ্যালয়, অধ্যয়নের বিষয়)"

msgid "Zainteresowanie"
msgstr "আগ্রহ"

msgid "Tylko mentorzy z wolnym miejscem"
msgstr "শুধু খালি জায়গা আছে এমন মেন্টর"

msgid "Strony katalogu"
msgstr "ডিরেক্টরির পৃষ্ঠা"

msgid "Nikogo tu jeszcze nie ma"
msgstr "এখানে এখনও কেউ নেই"

msgid "Sieć absolwentów"
msgstr "প্রাক্তন অংশগ্রহণকারী নেটওয়ার্ক"

msgid "Organizator wyłączył sieć absolwentów. Twój profil nie jest nikomu pokazywany, nie dostajesz zaproszeń, a rozmowy mentorskie są tylko do odczytu. Dane profilu zostają do czasu wycofania zgody albo usunięcia ich przez organizatora."
msgstr "আয়োজক প্রাক্তন অংশগ্রহণকারীদের নেটওয়ার্ক বন্ধ করেছেন। আপনার প্রোফাইল কাউকে দেখানো হয় না, আপনি আমন্ত্রণ পান না, এবং মেন্টরিং কথোপকথনগুলো কেবল পড়ার জন্য। আপনি সম্মতি প্রত্যাহার না করা বা আয়োজক মুছে না ফেলা পর্যন্ত প্রোফাইলের তথ্য থাকে।"

msgid "Wycofaj zgodę i usuń profil"
msgstr "সম্মতি প্রত্যাহার করুন ও প্রোফাইল মুছুন"

msgid "Zgłoś problem z mentoringiem"
msgstr "মেন্টরিং সংক্রান্ত সমস্যার রিপোর্ট করুন"

msgid "Zgłoszenie trafi od razu do organizatora. Jeśli problem dotyczy konkretnej wiadomości, zgłoś ją także w Wiadomościach przyciskiem „Zgłoś”."
msgstr "রিপোর্টটি সরাসরি আয়োজকের কাছে যাবে। সমস্যাটি কোনো নির্দিষ্ট বার্তা নিয়ে হলে, সেটি বার্তায় “রিপোর্ট করুন” বোতাম দিয়েও রিপোর্ট করুন।"

msgid "Wyślij zgłoszenie"
msgstr "রিপোর্ট পাঠান"

msgid "Byli uczestnicy, którzy pokazują, co robią dziś, pomagają obecnym uczestnikom jako mentorzy i dostają zaproszenia na warsztaty, webinary i do jury."
msgstr "প্রাক্তন অংশগ্রহণকারীরা, যাঁরা দেখান আজ তাঁরা কী করছেন, মেন্টর হিসেবে বর্তমান অংশগ্রহণকারীদের সাহায্য করেন এবং কর্মশালা, ওয়েবিনার ও জুরির আমন্ত্রণ পান।"

msgid "Publiczna ściana"
msgstr "সর্বজনীন দেয়াল"

msgid "Zmieniła się treść zgody"
msgstr "সম্মতির লেখা পরিবর্তিত হয়েছে"

msgid "Twój profil jest niewidoczny, dopóki nie potwierdzisz nowej treści zgody. Możesz też wycofać zgodę niżej."
msgstr "আপনি সম্মতির নতুন লেখা নিশ্চিত না করা পর্যন্ত আপনার প্রোফাইল লুকানো থাকবে। নিচে আপনি সম্মতি প্রত্যাহারও করতে পারেন।"

msgid "Potwierdzam"
msgstr "আমি নিশ্চিত করছি"

msgid "Twój profil"
msgstr "আপনার প্রোফাইল"

msgid "Organizator ukrył Twój profil – nie widać go w katalogu ani na ścianie. Napisz do organizatora, jeśli to pomyłka."
msgstr "আয়োজক আপনার প্রোফাইল লুকিয়ে রেখেছেন – এটি ডিরেক্টরি বা দেয়ালে দেখা যাচ্ছে না। এটি ভুল হলে আয়োজককে লিখুন।"

msgid "Tak widzą Cię inni zalogowani uczestnicy:"
msgstr "লগ-ইন করা অন্য অংশগ্রহণকারীরা আপনাকে এভাবে দেখেন:"

msgid "Zapisz profil"
msgstr "প্রোফাইল সংরক্ষণ করুন"

msgid "Wycofanie zgody"
msgstr "সম্মতি প্রত্যাহার"

msgid "Po wycofaniu zgody Twój profil absolwenta zniknie od razu, a relacje, w których jesteś mentorem, zakończą się. Twoje wyniki i dyplomy zostają – to dokumentacja zawodów."
msgstr "সম্মতি প্রত্যাহার করলে আপনার প্রাক্তন অংশগ্রহণকারী প্রোফাইল সঙ্গে সঙ্গে মুছে যাবে এবং যেসব সম্পর্কে আপনি মেন্টর, সেগুলো শেষ হয়ে যাবে। আপনার ফলাফল ও সনদ থেকে যাবে – সেগুলো প্রতিযোগিতার নথির অংশ।"

msgid "Dołącz do sieci absolwentów"
msgstr "প্রাক্তন অংশগ্রহণকারী নেটওয়ার্কে যোগ দিন"

msgid "Twoje osiągnięcia z ogłoszonych wyników:"
msgstr "প্রকাশিত ফলাফল থেকে আপনার অর্জন:"

msgid "Dołączam"
msgstr "যোগ দিন"

msgid "Organizator nie włączył jeszcze mentoringu."
msgstr "আয়োজক এখনও মেন্টরিং চালু করেননি।"

msgid "Rola"
msgstr "ভূমিকা"

msgid "Druga osoba"
msgstr "অন্য ব্যক্তি"

msgid "jesteś mentorem"
msgstr "আপনি মেন্টর"

msgid "Twój mentor"
msgstr "আপনার মেন্টর"

msgid "Notatka prośby czeka na akceptację organizatora."
msgstr "অনুরোধের নোট আয়োজকের অনুমোদনের অপেক্ষায় আছে।"

msgid "Przyjmij"
msgstr "গ্রহণ করুন"

msgid "Wycofaj prośbę"
msgstr "অনুরোধ প্রত্যাহার করুন"

msgid "Rozmowa"
msgstr "কথোপকথন"

msgid "Zakończ"
msgstr "শেষ করুন"

msgid "Zgłoś problem"
msgstr "সমস্যার রিপোর্ট করুন"

msgid "Nie masz jeszcze żadnej relacji mentorskiej. Mentora wybierzesz w katalogu absolwentów – przy osobach, które pomagają, stoi przycisk „Poproś o mentoring”."
msgstr "আপনার এখনও কোনো মেন্টরিং সম্পর্ক নেই। আপনি প্রাক্তন অংশগ্রহণকারী ডিরেক্টরিতে মেন্টর বেছে নিতে পারেন – যাঁরা সাহায্য করেন, তাঁদের পাশে “মেন্টরিংয়ের অনুরোধ করুন” বোতাম থাকে।"

msgid "Rozmowa mentorska toczy się w Wiadomościach. Jeśli uczestnik jest niepełnoletni, organizator czyta wiadomości – zależnie od zasad konkursu przed doręczeniem albo po nim."
msgstr "মেন্টরিং কথোপকথন বার্তায় হয়। অংশগ্রহণকারী অপ্রাপ্তবয়স্ক হলে আয়োজক বার্তাগুলো পড়েন – প্রতিযোগিতার নিয়ম অনুযায়ী পৌঁছানোর আগে বা পরে।"

msgid "Prośba o mentoring"
msgstr "মেন্টরিংয়ের অনুরোধ"

msgid "Jeśli mentor przyjmie prośbę, rozmowa otworzy się w Wiadomościach. Organizator widzi relacje mentorskie i – zależnie od zasad konkursu – czyta wiadomości."
msgstr "মেন্টর অনুরোধ গ্রহণ করলে বার্তায় একটি কথোপকথন খুলবে। আয়োজক মেন্টরিং সম্পর্কগুলো দেখতে পান এবং – প্রতিযোগিতার নিয়ম অনুযায়ী – বার্তাগুলো পড়েন।"

msgid "Wyślij prośbę"
msgstr "অনুরোধ পাঠান"

msgid "Wypis z zaproszeń"
msgstr "আমন্ত্রণ থেকে সদস্যতা ত্যাগ"

msgid "Wypis z zaproszeń dla absolwentów"
msgstr "প্রাক্তন অংশগ্রহণকারীদের আমন্ত্রণ থেকে সদস্যতা ত্যাগ"

msgid "Ten odnośnik jest nieprawidłowy. Zaproszenia wyłączysz też w swoim profilu absolwenta."
msgstr "এই লিংকটি অবৈধ। আপনি আপনার প্রাক্তন অংশগ্রহণকারী প্রোফাইলেও আমন্ত্রণ বন্ধ করতে পারেন।"

msgid "Gotowe – nie będziesz już dostawać zaproszeń. Włączysz je z powrotem w profilu absolwenta."
msgstr "হয়ে গেছে – আপনি আর আমন্ত্রণ পাবেন না। প্রাক্তন অংশগ্রহণকারী প্রোফাইলে আপনি সেগুলো আবার চালু করতে পারেন।"

msgid "Kliknij, żeby nie dostawać więcej zaproszeń od organizatora (warsztaty, webinary, jury)."
msgstr "আয়োজকের কাছ থেকে আর আমন্ত্রণ (কর্মশালা, ওয়েবিনার, জুরি) না পেতে ক্লিক করুন।"

msgid "Wypisz mnie"
msgstr "আমার সদস্যতা ত্যাগ করুন"

msgid "Nasi absolwenci"
msgstr "আমাদের প্রাক্তন অংশগ্রহণকারীরা"

msgid "Laureaci i finaliści poprzednich edycji – i to, co robią dziś."
msgstr "আগের সংস্করণগুলোর বিজয়ী ও ফাইনালিস্টরা – এবং আজ তাঁরা কী করছেন।"

msgid "Strony"
msgstr "পৃষ্ঠা"

#, python-format
msgid "Podaj adres profilu %(service)s zaczynający się od https://."
msgstr "https:// দিয়ে শুরু হওয়া %(service)s প্রোফাইলের ঠিকানা লিখুন।"

#, python-format
msgid "To nie wygląda na adres profilu %(service)s."
msgstr "এটি %(service)s প্রোফাইলের ঠিকানা বলে মনে হচ্ছে না।"

msgid "Adres wydarzenia musi zaczynać się od https://."
msgstr "অনুষ্ঠানের ঠিকানা অবশ্যই https:// দিয়ে শুরু হতে হবে।"

msgid "Witaj w sieci absolwentów! Uzupełnij profil – każde pole jest opcjonalne."
msgstr "প্রাক্তন অংশগ্রহণকারী নেটওয়ার্কে স্বাগতম! আপনার প্রোফাইল পূরণ করুন – প্রতিটি ঘর ঐচ্ছিক।"

msgid "Profil zapisany."
msgstr "প্রোফাইল সংরক্ষিত হয়েছে।"

msgid "Zgoda wycofana – Twój profil absolwenta został usunięty."
msgstr "সম্মতি প্রত্যাহার করা হয়েছে – আপনার প্রাক্তন অংশগ্রহণকারী প্রোফাইল মুছে ফেলা হয়েছে।"

msgid "Dziękujemy – Twój profil znów jest widoczny."
msgstr "ধন্যবাদ – আপনার প্রোফাইল আবার দৃশ্যমান।"

msgid "Prośba wysłana. Dostaniesz e-mail, gdy mentor odpowie."
msgstr "অনুরোধ পাঠানো হয়েছে। মেন্টর উত্তর দিলে আপনি ইমেল পাবেন।"

msgid "Prośba przyjęta – rozmowa czeka w Wiadomościach."
