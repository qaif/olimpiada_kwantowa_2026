msgid "Wyrażam zgodę opisaną wyżej."
msgstr "আমি উপরে বর্ণিত সম্মতি দিচ্ছি।"

msgid "Pokazuj moje pełne imię i nazwisko"
msgstr "আমার পুরো নাম দেখান"

msgid "Działa tylko wtedy, gdy masz w konkursie zgodę na publikację imienia i nazwiska."
msgstr "এটি তখনই কাজ করে, যখন আপনি এই প্রতিযোগিতায় আপনার পুরো নাম প্রকাশের সম্মতি দিয়েছেন।"

msgid "Uczelnia albo miejsce pracy"
msgstr "বিশ্ববিদ্যালয় বা কর্মস্থল"

msgid "Kierunek albo stanowisko"
msgstr "অধ্যয়নের বিষয় বা পদ"

msgid "Miasto"
msgstr "শহর"

msgid "Kraj"
msgstr "দেশ"

msgid "Kilka słów o sobie"
msgstr "নিজের সম্পর্কে কয়েকটি কথা"

msgid "Zainteresowania"
msgstr "আগ্রহ"

msgid "Chcę być mentorem"
msgstr "আমি মেন্টর হতে চাই"

msgid "W czym mogę pomóc"
msgstr "আমি কোন বিষয়ে সাহায্য করতে পারি"

msgid "Ilu uczestników naraz"
msgstr "একসঙ্গে কতজন অংশগ্রহণকারী"

msgid "Pokazuj mój profil w katalogu dla zalogowanych uczestników"
msgstr "লগ-ইন করা অংশগ্রহণকারীদের ডিরেক্টরিতে আমার প্রোফাইল দেখান"

msgid "Pokazuj mój profil na publicznej ścianie absolwentów"
msgstr "প্রাক্তন অংশগ্রহণকারীদের সর্বজনীন দেয়ালে আমার প্রোফাইল দেখান"

msgid "Na ścianie widać tylko podpis, osiągnięcia, uczelnię i kierunek."
msgstr "দেয়ালে শুধু আপনার নাম, অর্জন, বিশ্ববিদ্যালয় ও অধ্যয়নের বিষয় দেখা যায়।"

msgid "Chcę dostawać zaproszenia od organizatora (warsztaty, webinary, jury)"
msgstr "আমি আয়োজকের কাছ থেকে আমন্ত্রণ পেতে চাই (কর্মশালা, ওয়েবিনার, জুরি)"

msgid "Temat"
msgstr "বিষয়"

msgid "Krótko: w czym potrzebujesz pomocy?"
msgstr "সংক্ষেপে: আপনার কোন বিষয়ে সাহায্য দরকার?"

msgid "Notatkę przeczyta mentor i organizator. Nie wpisuj tu danych kontaktowych."
msgstr "নোটটি মেন্টর ও আয়োজক পড়বেন। এখানে যোগাযোগের তথ্য লিখবেন না।"

msgid "Co się stało?"
msgstr "কী হয়েছে?"

msgid "Notatka (powód zakończenia)"
msgstr "নোট (সমাপ্তির কারণ)"

msgid "Kto może dołączyć"
msgstr "কারা যোগ দিতে পারেন"

msgid "Mentoring włączony"
msgstr "মেন্টরিং চালু"

msgid "Publiczna ściana absolwentów"
msgstr "প্রাক্তন অংশগ্রহণকারীদের সর্বজনীন দেয়াল"

msgid "Rodzaj"
msgstr "ধরন"

msgid "Tytuł (temat listu)"
msgstr "শিরোনাম (ইমেলের বিষয়)"

msgid "Treść"
msgstr "বিষয়বস্তু"

msgid "Adres wydarzenia (https://…)"
msgstr "অনুষ্ঠানের ঠিকানা (https://…)"

msgid "Edycje"
msgstr "সংস্করণ"

msgid "Najniższe osiągnięcie"
msgstr "ন্যূনতম অর্জন"

msgid "dowolne"
msgstr "যেকোনো"

msgid "Zainteresowania (dowolne z)"
msgstr "আগ্রহ (যেকোনোটি)"

msgid "Tylko mentorzy"
msgstr "শুধু মেন্টর"

msgid "Wybierz rodzaj zaproszenia."
msgstr "আমন্ত্রণের ধরন বেছে নিন।"

msgid "Tytuł jest wymagany (do 150 znaków)."
msgstr "শিরোনাম আবশ্যক (সর্বোচ্চ ১৫০ অক্ষর)।"

#, python-format
msgid "Treść jest wymagana (do %(limit)s znaków)."
msgstr "বিষয়বস্তু আবশ্যক (সর্বোচ্চ %(limit)s অক্ষর)।"

msgid "Dzień dobry,"
msgstr "নমস্কার,"

#, python-format
msgid "organizator konkursu %(competition)s zaprasza absolwentów: %(kind)s."
msgstr "%(competition)s-এর আয়োজক প্রাক্তন অংশগ্রহণকারীদের আমন্ত্রণ জানাচ্ছেন: %(kind)s।"

#, python-format
msgid "Szczegóły i zapisy: %(url)s"
msgstr "বিস্তারিত ও নিবন্ধন: %(url)s"

msgid "Dostajesz ten list, bo należysz do sieci absolwentów i nie wyłączyłeś zaproszeń."
msgstr "আপনি এই ইমেলটি পাচ্ছেন, কারণ আপনি প্রাক্তন অংশগ্রহণকারী নেটওয়ার্কের সদস্য এবং আমন্ত্রণ বন্ধ করেননি।"

#, python-format
msgid "Wypisz się z zaproszeń: %(link)s"
msgstr "আমন্ত্রণ থেকে সদস্যতা ত্যাগ করুন: %(link)s"

msgid "Żaden absolwent nie spełnia tych filtrów."
msgstr "এই ফিল্টারগুলোর সঙ্গে কোনো প্রাক্তন অংশগ্রহণকারী মেলে না।"

msgid "Rozmowa mentorska. Każdą wiadomość czyta i akceptuje organizator, zanim trafi do drugiej osoby."
msgstr "মেন্টরিং কথোপকথন। প্রতিটি বার্তা অন্য ব্যক্তির কাছে পৌঁছানোর আগে আয়োজক তা পড়েন ও অনুমোদন করেন।"

msgid "Rozmowa mentorska – obowiązują zasady Wiadomości tego konkursu."
msgstr "মেন্টরিং কথোপকথন – এই প্রতিযোগিতার বার্তা-সংক্রান্ত নিয়ম প্রযোজ্য।"

msgid "Rozmowa mentorska. Organizator przegląda wiadomości tej rozmowy (moderacja następcza)."
msgstr "মেন্টরিং কথোপকথন। আয়োজক এই কথোপকথনের বার্তাগুলো পর্যালোচনা করেন (পরবর্তী মডারেশন)।"

msgid "Mentoring zakończył się – ta rozmowa jest teraz tylko do odczytu."
msgstr "মেন্টরিং শেষ হয়েছে – এই কথোপকথন এখন শুধু পড়া যাবে।"

msgid "Organizator wstrzymał mentoring – ta rozmowa jest teraz tylko do odczytu."
msgstr "আয়োজক মেন্টরিং স্থগিত করেছেন – এই কথোপকথন এখন শুধু পড়া যাবে।"

msgid "Nowa rozmowa mentorska. Pierwsze wiadomości czyta i akceptuje organizator, zanim trafią do drugiej osoby."
msgstr "নতুন মেন্টরিং কথোপকথন। প্রথম বার্তাগুলো অন্য ব্যক্তির কাছে পৌঁছানোর আগে আয়োজক পড়ে অনুমোদন করেন।"

msgid "Mentoring jest w tym konkursie wyłączony."
msgstr "এই প্রতিযোগিতায় মেন্টরিং বন্ধ আছে।"

msgid "Mentoring wymaga modułu Wiadomości, który organizator wyłączył."
msgstr "মেন্টরিংয়ের জন্য বার্তা মডিউল প্রয়োজন, যা আয়োজক বন্ধ করে দিয়েছেন।"

msgid "Ta osoba nie przyjmuje teraz próśb o mentoring."
msgstr "এই ব্যক্তি এখন মেন্টরিংয়ের অনুরোধ গ্রহণ করছেন না।"

#, python-format
msgid "%(label)s nie może być puste."
msgstr "%(label)s খালি রাখা যাবে না।"

#, python-format
msgid "%(label)s jest za długie (limit %(limit)s znaków)."
msgstr "%(label)s অনেক দীর্ঘ (সীমা: %(limit)s অক্ষর)।"

msgid "Nie możesz poprosić o mentoring samego siebie."
msgstr "আপনি নিজের কাছে মেন্টরিংয়ের অনুরোধ করতে পারবেন না।"

msgid "O mentora proszą uczestnicy bieżącej edycji."
msgstr "বর্তমান সংস্করণের অংশগ্রহণকারীরা মেন্টরের অনুরোধ করতে পারেন।"

msgid "Wybierz temat z listy."
msgstr "তালিকা থেকে একটি বিষয় বেছে নিন।"

msgid "Notatka"
msgstr "নোট"

msgid "Masz już otwartą prośbę albo relację z tą osobą."
msgstr "এই ব্যক্তির সঙ্গে আপনার ইতিমধ্যে একটি খোলা অনুরোধ বা মেন্টরিং সম্পর্ক আছে।"

#, python-format
msgid "Możesz mieć naraz najwyżej %(limit)s otwarte prośby i relacje mentorskie."
msgstr "একসঙ্গে আপনার সর্বোচ্চ %(limit)sটি খোলা মেন্টরিং অনুরোধ ও সম্পর্ক থাকতে পারে।"

msgid "Ta osoba nie ma teraz wolnego miejsca na mentoring."
msgstr "এই ব্যক্তির এখন মেন্টরিংয়ের জন্য কোনো খালি জায়গা নেই।"

msgid "Wysłano już dziś dużo próśb o mentoring – spróbuj jutro."
msgstr "আপনি আজ ইতিমধ্যে অনেক মেন্টরিং অনুরোধ পাঠিয়েছেন – আগামীকাল আবার চেষ্টা করুন।"

msgid "Do tej osoby wysłano już w tym tygodniu prośbę – spróbuj za kilka dni."
msgstr "আপনি এই সপ্তাহে ইতিমধ্যে এই ব্যক্তিকে অনুরোধ পাঠিয়েছেন – কয়েক দিন পরে আবার চেষ্টা করুন।"

msgid "Nie ma takiej relacji mentorskiej."
msgstr "এমন কোনো মেন্টরিং সম্পর্ক নেই।"

msgid "Macie już rozmowę szyfrowaną, a ta relacja wymaga moderacji organizatora. Organizator dostał zgłoszenie i skontaktuje się z Wami."
msgstr "আপনাদের ইতিমধ্যে একটি এনক্রিপ্ট করা কথোপকথন আছে, আর এই সম্পর্কের জন্য আয়োজকের মডারেশন প্রয়োজন। আয়োজক বিজ্ঞপ্তি পেয়েছেন এবং আপনাদের সঙ্গে যোগাযোগ করবেন।"

msgid "Na tę prośbę już odpowiedziano."
msgstr "এই অনুরোধের উত্তর ইতিমধ্যে দেওয়া হয়েছে।"

msgid "Najpierw dołącz do sieci absolwentów."
msgstr "আগে প্রাক্তন অংশগ্রহণকারী নেটওয়ার্কে যোগ দিন।"

msgid "Twój profil nie przyjmuje teraz nowych relacji mentorskich."
msgstr "আপনার প্রোফাইল এখন নতুন মেন্টরিং সম্পর্ক গ্রহণ করছে না।"

msgid "Ta osoba nie jest już uczestnikiem konkursu."
msgstr "এই ব্যক্তি আর প্রতিযোগিতার অংশগ্রহণকারী নন।"

msgid "Masz już komplet mentee. Zwiększ liczbę miejsc w profilu albo zakończ inną relację."
msgstr "আপনার মেন্টির সংখ্যা ইতিমধ্যে পূর্ণ। প্রোফাইলে জায়গার সংখ্যা বাড়ান অথবা অন্য একটি সম্পর্ক শেষ করুন।"

msgid "Tę prośbę można już tylko zakończyć."
msgstr "এই অনুরোধটি এখন শুধু শেষ করা যায়।"

msgid "Ta relacja jest już zakończona."
msgstr "এই সম্পর্ক ইতিমধ্যে শেষ হয়েছে।"

msgid "Powód"
msgstr "কারণ"

msgid "Nie ma takiej notatki do akceptacji."
msgstr "অনুমোদনের অপেক্ষায় এমন কোনো নোট নেই।"

msgid "Nie ma takiego zgłoszenia."
msgstr "এমন কোনো রিপোর্ট নেই।"

