msgid "Wyrażam zgodę opisaną wyżej."
msgstr "मैं ऊपर बताई गई सहमति देता/देती हूँ।"

msgid "Pokazuj moje pełne imię i nazwisko"
msgstr "मेरा पूरा नाम दिखाएँ"

msgid "Działa tylko wtedy, gdy masz w konkursie zgodę na publikację imienia i nazwiska."
msgstr "यह तभी काम करता है जब आपने इस प्रतियोगिता में अपना पूरा नाम प्रकाशित करने की सहमति दी हो।"

msgid "Uczelnia albo miejsce pracy"
msgstr "विश्वविद्यालय या कार्यस्थल"

msgid "Kierunek albo stanowisko"
msgstr "अध्ययन क्षेत्र या पद"

msgid "Miasto"
msgstr "शहर"

msgid "Kraj"
msgstr "देश"

msgid "Kilka słów o sobie"
msgstr "अपने बारे में कुछ शब्द"

msgid "Zainteresowania"
msgstr "रुचियाँ"

msgid "Chcę być mentorem"
msgstr "मैं मेंटर बनना चाहता/चाहती हूँ"

msgid "W czym mogę pomóc"
msgstr "मैं किसमें मदद कर सकता/सकती हूँ"

msgid "Ilu uczestników naraz"
msgstr "एक समय में कितने प्रतिभागी"

msgid "Pokazuj mój profil w katalogu dla zalogowanych uczestników"
msgstr "मेरी प्रोफ़ाइल लॉग-इन प्रतिभागियों की निर्देशिका में दिखाएँ"

msgid "Pokazuj mój profil na publicznej ścianie absolwentów"
msgstr "मेरी प्रोफ़ाइल पूर्व प्रतिभागियों की सार्वजनिक दीवार पर दिखाएँ"

msgid "Na ścianie widać tylko podpis, osiągnięcia, uczelnię i kierunek."
msgstr "दीवार पर केवल आपका नाम, उपलब्धियाँ, विश्वविद्यालय और अध्ययन क्षेत्र दिखते हैं।"

msgid "Chcę dostawać zaproszenia od organizatora (warsztaty, webinary, jury)"
msgstr "मैं आयोजक से आमंत्रण पाना चाहता/चाहती हूँ (कार्यशालाएँ, वेबिनार, जूरी)"

msgid "Temat"
msgstr "विषय"

msgid "Krótko: w czym potrzebujesz pomocy?"
msgstr "संक्षेप में: आपको किस चीज़ में मदद चाहिए?"

msgid "Notatkę przeczyta mentor i organizator. Nie wpisuj tu danych kontaktowych."
msgstr "इस नोट को मेंटर और आयोजक पढ़ेंगे। यहाँ संपर्क विवरण न लिखें।"

msgid "Co się stało?"
msgstr "क्या हुआ?"

msgid "Notatka (powód zakończenia)"
msgstr "नोट (समाप्ति का कारण)"

msgid "Kto może dołączyć"
msgstr "कौन जुड़ सकता है"

msgid "Mentoring włączony"
msgstr "मेंटरिंग सक्षम"

msgid "Publiczna ściana absolwentów"
msgstr "पूर्व प्रतिभागियों की सार्वजनिक दीवार"

msgid "Rodzaj"
msgstr "प्रकार"

msgid "Tytuł (temat listu)"
msgstr "शीर्षक (ईमेल का विषय)"

msgid "Treść"
msgstr "सामग्री"

msgid "Adres wydarzenia (https://…)"
msgstr "कार्यक्रम का पता (https://…)"

msgid "Edycje"
msgstr "संस्करण"

msgid "Najniższe osiągnięcie"
msgstr "न्यूनतम उपलब्धि"

msgid "dowolne"
msgstr "कोई भी"

msgid "Zainteresowania (dowolne z)"
msgstr "रुचियाँ (इनमें से कोई भी)"

msgid "Tylko mentorzy"
msgstr "केवल मेंटर"

msgid "Wybierz rodzaj zaproszenia."
msgstr "आमंत्रण का प्रकार चुनें।"

msgid "Tytuł jest wymagany (do 150 znaków)."
msgstr "शीर्षक आवश्यक है (अधिकतम 150 वर्ण)।"

#, python-format
msgid "Treść jest wymagana (do %(limit)s znaków)."
msgstr "सामग्री आवश्यक है (अधिकतम %(limit)s वर्ण)।"

msgid "Dzień dobry,"
msgstr "नमस्ते,"

#, python-format
msgid "organizator konkursu %(competition)s zaprasza absolwentów: %(kind)s."
msgstr "%(competition)s के आयोजक पूर्व प्रतिभागियों को आमंत्रित करते हैं: %(kind)s।"

#, python-format
msgid "Szczegóły i zapisy: %(url)s"
msgstr "विवरण और पंजीकरण: %(url)s"

msgid "Dostajesz ten list, bo należysz do sieci absolwentów i nie wyłączyłeś zaproszeń."
msgstr "आपको यह ईमेल इसलिए मिल रहा है क्योंकि आप पूर्व प्रतिभागी नेटवर्क के सदस्य हैं और आपने आमंत्रण बंद नहीं किए हैं।"

#, python-format
msgid "Wypisz się z zaproszeń: %(link)s"
msgstr "आमंत्रणों की सदस्यता समाप्त करें: %(link)s"

msgid "Żaden absolwent nie spełnia tych filtrów."
msgstr "इन फ़िल्टरों से कोई भी पूर्व प्रतिभागी मेल नहीं खाता।"

msgid "Rozmowa mentorska. Każdą wiadomość czyta i akceptuje organizator, zanim trafi do drugiej osoby."
msgstr "मेंटरिंग बातचीत। हर संदेश दूसरे व्यक्ति तक पहुँचने से पहले आयोजक उसे पढ़ता और स्वीकृत करता है।"

msgid "Rozmowa mentorska – obowiązują zasady Wiadomości tego konkursu."
msgstr "मेंटरिंग बातचीत – इस प्रतियोगिता के संदेश नियम लागू होते हैं।"

msgid "Rozmowa mentorska. Organizator przegląda wiadomości tej rozmowy (moderacja następcza)."
msgstr "मेंटरिंग बातचीत। आयोजक इस बातचीत के संदेशों की समीक्षा करता है (बाद में मॉडरेशन)।"

msgid "Mentoring zakończył się – ta rozmowa jest teraz tylko do odczytu."
msgstr "मेंटरिंग समाप्त हो गई है – यह बातचीत अब केवल पढ़ने के लिए है।"

msgid "Organizator wstrzymał mentoring – ta rozmowa jest teraz tylko do odczytu."
msgstr "आयोजक ने मेंटरिंग रोक दी है – यह बातचीत अब केवल पढ़ने के लिए है।"

msgid "Mentoring jest w tym konkursie wyłączony."
msgstr "इस प्रतियोगिता में मेंटरिंग बंद है।"

msgid "Mentoring wymaga modułu Wiadomości, który organizator wyłączył."
msgstr "मेंटरिंग के लिए संदेश मॉड्यूल आवश्यक है, जिसे आयोजक ने बंद कर दिया है।"

msgid "Ta osoba nie przyjmuje teraz próśb o mentoring."
msgstr "यह व्यक्ति अभी मेंटरिंग अनुरोध स्वीकार नहीं कर रहा है।"

#, python-format
msgid "%(label)s nie może być puste."
msgstr "%(label)s खाली नहीं हो सकता।"

#, python-format
msgid "%(label)s jest za długie (limit %(limit)s znaków)."
msgstr "%(label)s बहुत लंबा है (सीमा: %(limit)s वर्ण)।"

msgid "Nie możesz poprosić o mentoring samego siebie."
msgstr "आप स्वयं से मेंटरिंग का अनुरोध नहीं कर सकते।"

msgid "O mentora proszą uczestnicy bieżącej edycji."
msgstr "मेंटर का अनुरोध वर्तमान संस्करण के प्रतिभागी कर सकते हैं।"

msgid "Wybierz temat z listy."
msgstr "सूची से एक विषय चुनें।"

msgid "Notatka"
msgstr "नोट"

msgid "Masz już otwartą prośbę albo relację z tą osobą."
msgstr "इस व्यक्ति के साथ आपका पहले से एक खुला अनुरोध या मेंटरिंग संबंध है।"

#, python-format
msgid "Możesz mieć naraz najwyżej %(limit)s otwarte prośby i relacje mentorskie."
msgstr "आपके एक समय में अधिकतम %(limit)s खुले मेंटरिंग अनुरोध और संबंध हो सकते हैं।"

msgid "Ta osoba nie ma teraz wolnego miejsca na mentoring."
msgstr "इस व्यक्ति के पास अभी मेंटरिंग के लिए कोई खाली स्थान नहीं है।"

msgid "Nie ma takiej relacji mentorskiej."
msgstr "ऐसा कोई मेंटरिंग संबंध नहीं है।"

msgid "Na tę prośbę już odpowiedziano."
msgstr "इस अनुरोध का उत्तर पहले ही दिया जा चुका है।"

msgid "Najpierw dołącz do sieci absolwentów."
msgstr "पहले पूर्व प्रतिभागी नेटवर्क से जुड़ें।"

msgid "Masz już komplet mentee. Zwiększ liczbę miejsc w profilu albo zakończ inną relację."
msgstr "आपके मेंटी की संख्या पूरी हो चुकी है। अपनी प्रोफ़ाइल में स्थानों की संख्या बढ़ाएँ या कोई दूसरा संबंध समाप्त करें।"

msgid "Tę prośbę można już tylko zakończyć."
msgstr "यह अनुरोध अब केवल समाप्त किया जा सकता है।"

msgid "Ta relacja jest już zakończona."
msgstr "यह संबंध पहले ही समाप्त हो चुका है।"

msgid "Powód"
msgstr "कारण"

msgid "Nie ma takiego zgłoszenia."
msgstr "ऐसी कोई रिपोर्ट नहीं है।"

msgid "uczestnik"
msgstr "प्रतिभागी"

msgid "awans do kolejnego etapu"
msgstr "अगले चरण में पहुँचे"

msgid "finalista"
msgstr "फ़ाइनलिस्ट"

msgid "laureat"
msgstr "विजेता"

msgid "obliczenia kwantowe"
msgstr "क्वांटम कंप्यूटिंग"

msgid "fizyka kwantowa"
msgstr "क्वांटम भौतिकी"

msgid "fizyka"
msgstr "भौतिकी"

msgid "informatyka"
msgstr "कंप्यूटर विज्ञान"

msgid "matematyka"
msgstr "गणित"

msgid "inżynieria"
msgstr "इंजीनियरिंग"

msgid "chemia"
msgstr "रसायन विज्ञान"

msgid "badania naukowe"
msgstr "अनुसंधान"

msgid "praca w przemyśle"
msgstr "उद्योग"

msgid "edukacja i popularyzacja"
msgstr "शिक्षा और विज्ञान-प्रसार"

msgid "zgoda udzielona"
msgstr "सहमति दी गई"

msgid "zgoda wycofana"
msgstr "सहमति वापस ली गई"

msgid "prośba czeka na mentora"
msgstr "अनुरोध मेंटर की प्रतीक्षा में"

msgid "trwa"
msgstr "सक्रिय"

msgid "odrzucona przez mentora"
msgstr "मेंटर द्वारा अस्वीकृत"

msgid "wycofana przez uczestnika"
msgstr "प्रतिभागी द्वारा वापस लिया गया"

msgid "zakończona"
msgstr "समाप्त"

msgid "zakończył mentor"
msgstr "मेंटर द्वारा समाप्त"

msgid "zakończył uczestnik"
msgstr "प्रतिभागी द्वारा समाप्त"

msgid "zakończył organizator"
msgstr "आयोजक द्वारा समाप्त"

msgid "mentor wycofał zgodę"
msgstr "मेंटर ने सहमति वापस ली"

msgid "konto usunięte"
msgstr "खाता हटाया गया"

msgid "rozmowa według zasad Wiadomości"
msgstr "संदेश नियमों के अनुसार बातचीत"

msgid "każdą wiadomość akceptuje organizator"
msgstr "हर संदेश आयोजक स्वीकृत करता है"

msgid "warsztaty"
msgstr "कार्यशाला"

msgid "webinar"
msgstr "वेबिनार"

msgid "jury"
msgstr "जूरी"

msgid "inne"
msgstr "अन्य"

msgid "Absolwenci: prośba o mentoring"
msgstr "पूर्व प्रतिभागी: मेंटरिंग अनुरोध"

msgid "Absolwenci: mentor przyjął Twoją prośbę"
msgstr "पूर्व प्रतिभागी: एक मेंटर ने आपका अनुरोध स्वीकार कर लिया है"

msgid "Absolwenci: odpowiedź na prośbę o mentoring"
msgstr "पूर्व प्रतिभागी: आपके मेंटरिंग अनुरोध का उत्तर"

msgid "Absolwenci: relacja mentorska zakończona"
msgstr "पूर्व प्रतिभागी: मेंटरिंग संबंध समाप्त"

msgid "Absolwenci: zgłoszono problem z relacją mentorską"
msgstr "पूर्व प्रतिभागी: एक मेंटरिंग संबंध में समस्या की रिपोर्ट की गई"

#, python-format
msgid "%(name)s prosi Cię o mentoring w sieci absolwentów."
msgstr "%(name)s पूर्व प्रतिभागी नेटवर्क में आपसे मेंटरिंग का अनुरोध कर रहे हैं।"

msgid "Notatkę prośby przeczytasz i odpowiesz na nią po zalogowaniu:"
msgstr "लॉग इन करने के बाद आप अनुरोध का नोट पढ़ सकते हैं और उत्तर दे सकते हैं:"

#, python-format
msgid "%(name)s zgadza się zostać Twoim mentorem."
msgstr "%(name)s आपके मेंटर बनने के लिए सहमत हो गए हैं।"

msgid "Rozmowa czeka w Wiadomościach:"
msgstr "बातचीत संदेश में आपकी प्रतीक्षा कर रही है:"

#, python-format
msgid "%(name)s nie może teraz przyjąć Twojej prośby o mentoring."
msgstr "%(name)s अभी आपका मेंटरिंग अनुरोध स्वीकार नहीं कर सकते।"

msgid "Możesz poprosić inną osobę z katalogu absolwentów:"
msgstr "आप पूर्व प्रतिभागी निर्देशिका से किसी दूसरे व्यक्ति से अनुरोध कर सकते हैं:"

msgid "Relacja mentorska w sieci absolwentów została zakończona."
msgstr "पूर्व प्रतिभागी नेटवर्क में एक मेंटरिंग संबंध समाप्त हो गया है।"

msgid "Rozmowa zostaje w Wiadomościach do odczytu. Szczegóły:"
msgstr "बातचीत संदेश में केवल पढ़ने के लिए बनी रहती है। विवरण:"

msgid "Jedna ze stron relacji mentorskiej zgłosiła problem. Powód przeczytasz w panelu:"
msgstr "एक मेंटरिंग संबंध के एक पक्ष ने समस्या की रिपोर्ट की है। कारण आप पैनल में पढ़ सकते हैं:"

msgid "Do sieci absolwentów dołączają uczestnicy tego konkursu."
msgstr "पूर्व प्रतिभागी नेटवर्क इस प्रतियोगिता के प्रतिभागियों के लिए खुला है।"

msgid "Do sieci absolwentów dołączają osoby pełnoletnie. Wróć tu po swoich 18. urodzinach – Twoje osiągnięcia poczekają."
msgstr "पूर्व प्रतिभागी नेटवर्क वयस्कों के लिए खुला है। अपने 18वें जन्मदिन के बाद यहाँ लौटें – आपकी उपलब्धियाँ आपकी प्रतीक्षा करेंगी।"

#, python-format
msgid "Do sieci absolwentów dołączają osoby z osiągnięciem w zakończonej edycji na poziomie co najmniej: %(level)s."
msgstr "पूर्व प्रतिभागी नेटवर्क उन लोगों के लिए खुला है जिनकी किसी समाप्त संस्करण में कम से कम इस स्तर की उपलब्धि है: %(level)s।"

msgid "Chcę należeć do sieci absolwentów tego konkursu. Zgadzam się, żeby organizator przetwarzał moje imię i inicjał nazwiska (pełne imię i nazwisko – tylko jeśli tak wybiorę i mam zgodę na publikację nazwiska), moje osiągnięcia z ogłoszonych wyników oraz dane, które sam wpiszę do profilu, w celu: pokazania profilu zalogowanym uczestnikom konkursu (a na publicznej ścianie – tylko jeśli to zaznaczę), kontaktu mentorskiego przez Wiadomości, wysyłania mi zaproszeń na warsztaty, webinary i do jury (mogę się wypisać w każdym liście) oraz zagregowanych statystyk „gdzie są teraz”, w których nikt nie jest rozpoznawalny. Zgodę mogę wycofać w każdej chwili – profil zniknie od razu."
msgstr "मैं इस प्रतियोगिता के पूर्व प्रतिभागी नेटवर्क का सदस्य बनना चाहता/चाहती हूँ। मैं सहमत हूँ कि आयोजक मेरा पहला नाम और उपनाम का पहला अक्षर (पूरा नाम केवल तभी, जब मैं ऐसा चुनूँ और मैंने नाम प्रकाशित करने की सहमति दी हो), प्रकाशित परिणामों से मेरी उपलब्धियाँ और वह डेटा जो मैं स्वयं अपनी प्रोफ़ाइल में दर्ज करूँ, इन उद्देश्यों के लिए संसाधित करे: प्रतियोगिता के लॉग-इन प्रतिभागियों को मेरी प्रोफ़ाइल दिखाना (और सार्वजनिक दीवार पर केवल तभी, जब मैं यह विकल्प चुनूँ), संदेश के माध्यम से मेंटरिंग संपर्क संभव बनाना, मुझे कार्यशालाओं, वेबिनारों और जूरी के लिए आमंत्रण भेजना (मैं हर ईमेल से सदस्यता समाप्त कर सकता/सकती हूँ) और “वे अब कहाँ हैं” के समेकित आँकड़े तैयार करना, जिनमें किसी की पहचान नहीं की जा सकती। मैं किसी भी समय अपनी सहमति वापस ले सकता/सकती हूँ – मेरी प्रोफ़ाइल तुरंत हट जाएगी।"

