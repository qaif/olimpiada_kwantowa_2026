msgstr "Detalhes e inscrição: %(url)s"

msgid "Dostajesz ten list, bo należysz do sieci absolwentów i nie wyłączyłeś zaproszeń."
msgstr "Você está recebendo este e-mail porque faz parte da rede de ex-participantes e não desativou os convites."

#, python-format
msgid "Wypisz się z zaproszeń: %(link)s"
msgstr "Cancelar a inscrição nos convites: %(link)s"

msgid "Żaden absolwent nie spełnia tych filtrów."
msgstr "Nenhum ex-participante corresponde a estes filtros."

msgid "Rozmowa mentorska. Każdą wiadomość czyta i akceptuje organizator, zanim trafi do drugiej osoby."
msgstr "Conversa de mentoria. O organizador lê e aprova cada mensagem antes que ela chegue à outra pessoa."

msgid "Rozmowa mentorska – obowiązują zasady Wiadomości tego konkursu."
msgstr "Conversa de mentoria – aplicam-se as regras de Mensagens desta competição."

msgid "Rozmowa mentorska. Organizator przegląda wiadomości tej rozmowy (moderacja następcza)."
msgstr "Conversa de mentoria. O organizador revisa as mensagens desta conversa (pós-moderação)."

msgid "Mentoring zakończył się – ta rozmowa jest teraz tylko do odczytu."
msgstr "A mentoria terminou – esta conversa agora é somente leitura."

msgid "Organizator wstrzymał mentoring – ta rozmowa jest teraz tylko do odczytu."
msgstr "O organizador pausou a mentoria – esta conversa agora é somente leitura."

msgid "Nowa rozmowa mentorska. Pierwsze wiadomości czyta i akceptuje organizator, zanim trafią do drugiej osoby."
msgstr "Nova conversa de mentoria. O organizador lê e aprova as primeiras mensagens antes que cheguem à outra pessoa."

msgid "Mentoring jest w tym konkursie wyłączony."
msgstr "A mentoria está desativada nesta competição."

msgid "Mentoring wymaga modułu Wiadomości, który organizator wyłączył."
msgstr "A mentoria requer o módulo Mensagens, que o organizador desativou."

msgid "Ta osoba nie przyjmuje teraz próśb o mentoring."
msgstr "Esta pessoa não está aceitando pedidos de mentoria no momento."

#, python-format
msgid "%(label)s nie może być puste."
msgstr "%(label)s não pode ficar vazio."

#, python-format
msgid "%(label)s jest za długie (limit %(limit)s znaków)."
msgstr "%(label)s é longo demais (limite: %(limit)s caracteres)."

msgid "Nie możesz poprosić o mentoring samego siebie."
msgstr "Você não pode pedir mentoria a si mesmo."

msgid "O mentora proszą uczestnicy bieżącej edycji."
msgstr "Mentores podem ser solicitados por participantes da edição atual."

msgid "Wybierz temat z listy."
msgstr "Escolha um tema da lista."

msgid "Notatka"
msgstr "Nota"

msgid "Masz już otwartą prośbę albo relację z tą osobą."
msgstr "Você já tem um pedido aberto ou uma relação de mentoria com esta pessoa."

#, python-format
msgid "Możesz mieć naraz najwyżej %(limit)s otwarte prośby i relacje mentorskie."
msgstr "Você pode ter no máximo %(limit)s pedidos e relações de mentoria abertos ao mesmo tempo."

msgid "Ta osoba nie ma teraz wolnego miejsca na mentoring."
msgstr "Esta pessoa não tem vagas de mentoria livres no momento."

msgid "Wysłano już dziś dużo próśb o mentoring – spróbuj jutro."
msgstr "Você já enviou muitos pedidos de mentoria hoje – tente amanhã."

msgid "Do tej osoby wysłano już w tym tygodniu prośbę – spróbuj za kilka dni."
msgstr "Você já enviou um pedido a esta pessoa nesta semana – tente daqui a alguns dias."

msgid "Nie ma takiej relacji mentorskiej."
msgstr "Essa relação de mentoria não existe."

msgid "Macie już rozmowę szyfrowaną, a ta relacja wymaga moderacji organizatora. Organizator dostał zgłoszenie i skontaktuje się z Wami."
msgstr "Vocês já têm uma conversa criptografada, e esta relação exige moderação do organizador. O organizador foi notificado e entrará em contato."

msgid "Na tę prośbę już odpowiedziano."
msgstr "Este pedido já foi respondido."

msgid "Najpierw dołącz do sieci absolwentów."
msgstr "Primeiro entre na rede de ex-participantes."

msgid "Twój profil nie przyjmuje teraz nowych relacji mentorskich."
msgstr "Seu perfil não está aceitando novas relações de mentoria no momento."

msgid "Ta osoba nie jest już uczestnikiem konkursu."
msgstr "Esta pessoa não é mais participante do concurso."

msgid "Masz już komplet mentee. Zwiększ liczbę miejsc w profilu albo zakończ inną relację."
msgstr "Você já tem o número máximo de mentorados. Aumente o número de vagas no seu perfil ou encerre outra relação."

msgid "Tę prośbę można już tylko zakończyć."
msgstr "Este pedido agora só pode ser encerrado."

msgid "Ta relacja jest już zakończona."
msgstr "Esta relação já foi encerrada."

msgid "Powód"
msgstr "Motivo"

msgid "Nie ma takiej notatki do akceptacji."
msgstr "Não existe essa nota aguardando aprovação."

msgid "Nie ma takiego zgłoszenia."
msgstr "Essa denúncia não existe."

