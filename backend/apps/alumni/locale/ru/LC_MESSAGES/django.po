msgid "Wyrażam zgodę opisaną wyżej."
msgstr "Я даю согласие, описанное выше."

msgid "Pokazuj moje pełne imię i nazwisko"
msgstr "Показывать моё полное имя и фамилию"

msgid "Działa tylko wtedy, gdy masz w konkursie zgodę na publikację imienia i nazwiska."
msgstr "Работает, только если вы дали согласие на публикацию своего полного имени в этом конкурсе."

msgid "Uczelnia albo miejsce pracy"
msgstr "Вуз или место работы"

msgid "Kierunek albo stanowisko"
msgstr "Специальность или должность"

msgid "Miasto"
msgstr "Город"

msgid "Kraj"
msgstr "Страна"

msgid "Kilka słów o sobie"
msgstr "Несколько слов о себе"

msgid "Zainteresowania"
msgstr "Интересы"

msgid "Chcę być mentorem"
msgstr "Я хочу быть ментором"

msgid "W czym mogę pomóc"
msgstr "Чем я могу помочь"

msgid "Ilu uczestników naraz"
msgstr "Сколько участников одновременно"

msgid "Pokazuj mój profil w katalogu dla zalogowanych uczestników"
msgstr "Показывать мой профиль в каталоге для вошедших участников"

msgid "Pokazuj mój profil na publicznej ścianie absolwentów"
msgstr "Показывать мой профиль на публичной стене выпускников"

msgid "Na ścianie widać tylko podpis, osiągnięcia, uczelnię i kierunek."
msgstr "На стене видны только ваше имя, достижения, вуз и специальность."

msgid "Chcę dostawać zaproszenia od organizatora (warsztaty, webinary, jury)"
msgstr "Я хочу получать приглашения от организатора (мастер-классы, вебинары, жюри)"

msgid "Temat"
msgstr "Тема"

msgid "Krótko: w czym potrzebujesz pomocy?"
msgstr "Коротко: в чём вам нужна помощь?"

msgid "Notatkę przeczyta mentor i organizator. Nie wpisuj tu danych kontaktowych."
msgstr "Заметку прочитают ментор и организатор. Не указывайте здесь контактные данные."

msgid "Co się stało?"
msgstr "Что случилось?"

msgid "Notatka (powód zakończenia)"
msgstr "Заметка (причина завершения)"

msgid "Kto może dołączyć"
msgstr "Кто может присоединиться"

msgid "Mentoring włączony"
msgstr "Менторство включено"

msgid "Publiczna ściana absolwentów"
msgstr "Публичная стена выпускников"

msgid "Rodzaj"
msgstr "Тип"

msgid "Tytuł (temat listu)"
msgstr "Заголовок (тема письма)"

msgid "Treść"
msgstr "Содержание"

msgid "Adres wydarzenia (https://…)"
msgstr "Адрес мероприятия (https://…)"

msgid "Edycje"
msgstr "Выпуски"

msgid "Najniższe osiągnięcie"
msgstr "Минимальное достижение"

msgid "dowolne"
msgstr "любое"

msgid "Zainteresowania (dowolne z)"
msgstr "Интересы (любой из)"

msgid "Tylko mentorzy"
msgstr "Только менторы"

msgid "Wybierz rodzaj zaproszenia."
msgstr "Выберите тип приглашения."

msgid "Tytuł jest wymagany (do 150 znaków)."
msgstr "Заголовок обязателен (до 150 символов)."

#, python-format
msgid "Treść jest wymagana (do %(limit)s znaków)."
msgstr "Содержание обязательно (до %(limit)s символов)."

msgid "Dzień dobry,"
msgstr "Здравствуйте!"

#, python-format
msgid "organizator konkursu %(competition)s zaprasza absolwentów: %(kind)s."
msgstr "организатор конкурса %(competition)s приглашает выпускников: %(kind)s."

#, python-format
msgid "Szczegóły i zapisy: %(url)s"
msgstr "Подробности и регистрация: %(url)s"

msgid "Dostajesz ten list, bo należysz do sieci absolwentów i nie wyłączyłeś zaproszeń."
msgstr "Вы получили это письмо, потому что состоите в сети выпускников и не отключили приглашения."

#, python-format
msgid "Wypisz się z zaproszeń: %(link)s"
msgstr "Отписаться от приглашений: %(link)s"

msgid "Żaden absolwent nie spełnia tych filtrów."
msgstr "Ни один выпускник не соответствует этим фильтрам."

msgid "Rozmowa mentorska. Każdą wiadomość czyta i akceptuje organizator, zanim trafi do drugiej osoby."
msgstr "Менторская беседа. Организатор читает и одобряет каждое сообщение, прежде чем оно дойдёт до собеседника."

msgid "Rozmowa mentorska – obowiązują zasady Wiadomości tego konkursu."
msgstr "Менторская беседа – действуют правила раздела «Сообщения» этого конкурса."

msgid "Rozmowa mentorska. Organizator przegląda wiadomości tej rozmowy (moderacja następcza)."
msgstr "Менторская беседа. Организатор проверяет сообщения этой беседы (постмодерация)."

msgid "Mentoring zakończył się – ta rozmowa jest teraz tylko do odczytu."
msgstr "Менторство завершено – эта беседа теперь доступна только для чтения."

msgid "Organizator wstrzymał mentoring – ta rozmowa jest teraz tylko do odczytu."
msgstr "Организатор приостановил менторство – эта беседа теперь доступна только для чтения."

msgid "Mentoring jest w tym konkursie wyłączony."
msgstr "Менторство в этом конкурсе отключено."

msgid "Mentoring wymaga modułu Wiadomości, który organizator wyłączył."
msgstr "Для менторства нужен модуль «Сообщения», который организатор отключил."

msgid "Ta osoba nie przyjmuje teraz próśb o mentoring."
msgstr "Этот человек сейчас не принимает запросы на менторство."

#, python-format
msgid "%(label)s nie może być puste."
msgstr "%(label)s: поле не может быть пустым."

#, python-format
msgid "%(label)s jest za długie (limit %(limit)s znaków)."
msgstr "%(label)s: слишком длинный текст (лимит: %(limit)s символов)."

msgid "Nie możesz poprosić o mentoring samego siebie."
msgstr "Нельзя запросить менторство у самого себя."

msgid "O mentora proszą uczestnicy bieżącej edycji."
msgstr "Запросить ментора могут участники текущего выпуска."

msgid "Wybierz temat z listy."
msgstr "Выберите тему из списка."

msgid "Notatka"
msgstr "Заметка"

msgid "Masz już otwartą prośbę albo relację z tą osobą."
msgstr "У вас уже есть открытый запрос или менторская связь с этим человеком."

#, python-format
msgid "Możesz mieć naraz najwyżej %(limit)s otwarte prośby i relacje mentorskie."
msgstr "Одновременно у вас может быть не более %(limit)s открытых запросов и менторских связей."

msgid "Ta osoba nie ma teraz wolnego miejsca na mentoring."
msgstr "У этого человека сейчас нет свободного места для менторства."

msgid "Nie ma takiej relacji mentorskiej."
msgstr "Такой менторской связи нет."

msgid "Na tę prośbę już odpowiedziano."
msgstr "На этот запрос уже ответили."

msgid "Najpierw dołącz do sieci absolwentów."
msgstr "Сначала присоединитесь к сети выпускников."

msgid "Masz już komplet mentee. Zwiększ liczbę miejsc w profilu albo zakończ inną relację."
msgstr "У вас уже максимальное число подопечных. Увеличьте число мест в профиле или завершите другую связь."

msgid "Tę prośbę można już tylko zakończyć."
msgstr "Этот запрос теперь можно только завершить."

msgid "Ta relacja jest już zakończona."
msgstr "Эта связь уже завершена."

msgid "Powód"
msgstr "Причина"

msgid "Nie ma takiego zgłoszenia."
msgstr "Такого обращения нет."

