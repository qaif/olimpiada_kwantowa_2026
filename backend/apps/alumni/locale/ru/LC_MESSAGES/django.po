#, python-format
msgid "wolne miejsca: %(slots)s"
msgstr "свободных мест: %(slots)s"

msgid "brak wolnych miejsc"
msgstr "нет свободных мест"

msgid "Poproś o mentoring"
msgstr "Попросить о менторстве"

msgid "Absolwenci"
msgstr "Выпускники"

msgid "Mentoring"
msgstr "Менторство"

msgid "Zaproszenia"
msgstr "Приглашения"

msgid "Gdzie są teraz"
msgstr "Где они сейчас"

msgid "Absolwenci – panel koordynatora"
msgstr "Выпускники – панель координатора"

msgid "Sieć byłych uczestników, którzy wyrazili na to zgodę: profile, mentoring, zaproszenia i zagregowane statystyki."
msgstr "Сеть бывших участников, давших на это согласие: профили, менторство, приглашения и обобщённая статистика."

msgid "dane osobowe"
msgstr "персональные данные"

msgid "Podstawą jest zgoda absolwenta – wycofanie usuwa profil od razu. Osiągnięcia liczą się wyłącznie z ogłoszonych wyników i wystawionych dyplomów."
msgstr "Правовое основание – согласие выпускника; его отзыв сразу удаляет профиль. Достижения берутся только из опубликованных результатов и выданных сертификатов."

msgid "Ustawienia"
msgstr "Настройки"

msgid "Mentoring wymaga włączonych Wiadomości – bez nich mentorzy nie mogą przyjmować próśb."
msgstr "Для менторства нужно включить раздел «Сообщения» – без него менторы не могут принимать запросы."

msgid "„Kto może dołączyć” to najniższe osiągnięcie w zakończonej edycji. Dołączają wyłącznie osoby pełnoletnie. Mentoring małoletnich toczy się zawsze z udziałem organizatora: przy zasadzie „ta sama grupa wiekowa” każdą wiadomość akceptujesz przed doręczeniem, a przy „bez ograniczeń” przeglądasz je po doręczeniu (kolejka moderacji Wiadomości)."
msgstr "«Кто может присоединиться» – это минимальное достижение в завершённом выпуске. Присоединиться могут только совершеннолетние. Менторство несовершеннолетних всегда проходит с участием организатора: при правиле «та же возрастная группа» вы одобряете каждое сообщение до доставки, а при правиле «без ограничений» проверяете сообщения после доставки (очередь модерации раздела «Сообщения»)."

msgid "Zapisz ustawienia"
msgstr "Сохранить настройки"

msgid "Profile absolwentów"
msgstr "Профили выпускников"

#, python-format
msgid "Mogłoby jeszcze dołączyć (spełnia kryteria, nie dołączyło): %(count)s."
msgstr "Могли бы присоединиться (соответствуют критериям, но не присоединились): %(count)s."

