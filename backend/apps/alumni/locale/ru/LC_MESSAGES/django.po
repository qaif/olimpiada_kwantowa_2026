msgstr "завершена участником"

msgid "zakończył organizator"
msgstr "завершена организатором"

msgid "mentor wycofał zgodę"
msgstr "ментор отозвал согласие"

msgid "konto usunięte"
msgstr "аккаунт удалён"

msgid "rozmowa według zasad Wiadomości"
msgstr "беседа по правилам раздела «Сообщения»"

msgid "każdą wiadomość akceptuje organizator"
msgstr "организатор одобряет каждое сообщение"

