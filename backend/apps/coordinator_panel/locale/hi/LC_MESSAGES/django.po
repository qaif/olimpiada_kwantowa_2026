"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Wyślij komunikat"
msgstr "संदेश भेजें"

msgid "Obecność na warsztatach"
msgstr "कार्यशाला उपस्थिति"

msgid "Zaświadczenia z warsztatów"
msgstr "कार्यशाला प्रमाणपत्र"

msgid "Zdublowane konta"
msgstr "दोहरे खाते"

msgid "Eksport danych"
msgstr "डेटा निर्यात"

msgid "Zaplanowane wysyłki"
msgstr "निर्धारित संदेश"

msgid "Komunikaty czekające na termin wysyłki."
msgstr "भेजने के समय की प्रतीक्षा कर रहे संदेश।"

msgid "Nieudane wysyłki"
msgstr "विफल संदेश"

msgid "Komunikaty z ostatnich 30 dni, których nie udało się wysłać."
msgstr "पिछले 30 दिनों के संदेश जो भेजे नहीं जा सके।"

msgid "Nieprzeczytane rozmowy i kolejka moderacji."
msgstr "अपठित बातचीत और मॉडरेशन कतार।"

msgid "Zaświadczenia do weryfikacji"
msgstr "सत्यापन हेतु प्रमाणपत्र"

msgid "Zaświadczenia o statusie ucznia czekają na akceptację."
msgstr "छात्र स्थिति प्रमाणपत्र स्वीकृति की प्रतीक्षा में हैं।"

msgid "Ta sama osoba z kilkoma kontami uczestnika."
msgstr "एक ही व्यक्ति के कई प्रतिभागी खाते।"

msgid "Forum do moderacji"
msgstr "मॉडरेशन हेतु फ़ोरम"

msgid "Wątki, wpisy i zgłoszenia czekające na moderatora."
msgstr "मॉडरेटर की प्रतीक्षा में थ्रेड, पोस्ट और रिपोर्ट।"

msgid "Otwarcie etapu"
msgstr "चरण खुलता है"

msgid "Koniec oddawania prac"
msgstr "जमा करने की अंतिम तिथि"

msgid "Koniec recenzji"
msgstr "समीक्षा की अंतिम तिथि"

msgid "Otwarcie okna reklamacji"
msgstr "अपील अवधि शुरू"

msgid "Zamknięcie okna reklamacji"
msgstr "अपील अवधि समाप्त"

msgid "Wysyłka komunikatu"
msgstr "संदेश प्रेषण"

msgid "Warsztat"
msgstr "कार्यशाला"

msgid "Przypiąć można wyłącznie pozycję menu panelu."
msgstr "केवल पैनल मेनू की प्रविष्टियाँ पिन की जा सकती हैं।"

msgid "Przypięto. Pozycja stoi teraz nad sekcjami menu i na Starcie."
msgstr "पिन किया गया। यह प्रविष्टि अब मेनू अनुभागों के ऊपर और स्टार्ट पर दिखेगी।"

msgid "Odpięto pozycję."
msgstr "प्रविष्टि अनपिन की गई।"

#, python-format
msgid "Masz już %(limit)s przypiętych pozycji – odepnij którąś, żeby dodać nową."
msgstr "आपके पास पहले से %(limit)s पिन की गई प्रविष्टियाँ हैं – नई जोड़ने के लिए एक अनपिन करें।"

msgid "Okruszki"
msgstr "ब्रेडक्रंब"

msgid "Przypięte"
msgstr "पिन किए गए"

msgid "odepnij"
msgstr "अनपिन करें"

msgid "Komplet przypiętych pozycji – odepnij którąś na Starcie."
msgstr "सभी पिन स्थान भरे हैं – स्टार्ट पर एक अनपिन करें।"

msgid "Przypnij"
msgstr "पिन करें"

msgid "Polecenia"
msgstr "आदेश"

msgid "Ostatnio używane"
msgstr "हाल में उपयोग किए गए"

msgid "Szukaj w panelu"
msgstr "पैनल में खोजें"

msgid "Polecenia panelu koordynatora"
msgstr "समन्वयक पैनल आदेश"

msgid "Dokąd przejść? Ekran, sekcja albo fraza do wyszukania"
msgstr "कहाँ जाना है? स्क्रीन, अनुभाग या खोजने के लिए वाक्यांश"

msgid "Dokąd przejść? Ekran, sekcja albo fraza…"
msgstr "कहाँ जाना है? स्क्रीन, अनुभाग या वाक्यांश…"

msgid "Zamknij"
msgstr "बंद करें"

msgid "wybór"
msgstr "चुनें"

msgid "przejdź"
msgstr "जाएँ"

msgid "zamknij"
msgstr "बंद करें"

#, python-format
msgid "Ekrany etapu: %(stage)s"
msgstr "चरण स्क्रीन: %(stage)s"

msgid "Wszystko na bieżąco."
msgstr "सब कुछ अद्यतन है।"

msgid "Nic nie czeka na koordynatora – kolejki są puste."
msgstr "समन्वयक के लिए कुछ भी लंबित नहीं – कतारें खाली हैं।"

msgid "W najbliższych 30 dniach nie ma terminów etapów, warsztatów ani zaplanowanych wysyłek."
msgstr "अगले 30 दिनों में कोई चरण तिथि, कार्यशाला या निर्धारित संदेश नहीं है।"

msgid "Wydarzenia linii czasu"
msgstr "समयरेखा घटनाएँ"

msgid "Harmonogram warsztatów (CMS)"
msgstr "कार्यशाला कार्यक्रम (CMS)"

msgid "Konkurs w liczbach"
msgstr "प्रतियोगिता आँकड़ों में"

msgid "W tej edycji"
msgstr "इस संस्करण में"

msgid "Komitet (aktywni)"
msgstr "समिति (सक्रिय)"

msgid "Etapy otwarte"
msgstr "खुले चरण"

#, python-format
msgid "Czeka na decyzję: %(count)s"
msgstr "निर्णय की प्रतीक्षा: %(count)s"

#, python-format
msgid "Bez zaległości: %(count)s"
msgstr "कुछ लंबित नहीं: %(count)s"

#, python-format
msgid "Stan z %(time)s, liczby odświeżają się co 5 minut. Bez kont usuniętych."
msgstr "%(time)s की स्थिति; आँकड़े हर 5 मिनट में ताज़ा होते हैं। हटाए गए खाते शामिल नहीं।"

#, python-format
msgid "Odepnij: %(label)s"
msgstr "अनपिन करें: %(label)s"

#, python-format
msgid "Ekrany, po które sięgasz codziennie, przypnij przyciskiem „Przypnij” w nagłówku ekranu – staną tutaj i nad sekcjami menu (najwyżej %(limit)s)."
msgstr "रोज़ उपयोग की जाने वाली स्क्रीन को स्क्रीन शीर्षक में “पिन करें” बटन से पिन करें – वे यहाँ और मेनू अनुभागों के ऊपर दिखेंगी (अधिकतम %(limit)s)।"
