#: forms.py:19
msgid "Język 1 (domyślny dla uczniów)"
msgstr "Idioma 1 (padrão para os alunos)"

#: forms.py:20
msgid "Język 2 (opcjonalnie)"
msgstr "Idioma 2 (opcional)"

#: forms.py:33 forms.py:44
msgid "Tytuł zadania"
msgstr "Título do problema"

#: forms.py:35
msgid "Treść (Markdown, wzory w $…$)"
msgstr "Texto (Markdown, fórmulas entre $…$)"

#: forms.py:43
msgid "Przetłumaczony PDF"
msgstr "PDF traduzido"

#: services.py:380
msgid "Wybierz jeden albo dwa języki."
msgstr "Escolha um ou dois idiomas."

#: services.py:384
msgid "Nieznany język."
msgstr "Idioma desconhecido."

#: services.py:397
msgid "Nie można usunąć języka, w którym delegacja wysłała już tłumaczenie."
msgstr ""
"Não é possível remover um idioma no qual a delegação já enviou uma tradução."

#: services.py:444
msgid "Ten język nie jest językiem delegacji."
msgstr "Este idioma não é um idioma da delegação."

#: services.py:462 templates/problem_translations/leader/editor.html:145
msgid "Tłumaczenie jest zatwierdzone i zablokowane."
msgstr "A tradução está aprovada e bloqueada."

#: services.py:464
msgid ""
"Tłumaczenie czeka na decyzję komisji – cofnij wysłanie, żeby je poprawić."
msgstr ""
"A tradução aguarda a decisão da comissão – retire o envio para corrigi-la."

#: services.py:500
msgid ""
"Tłumaczenie zmieniło się w międzyczasie (inny opiekun albo inna karta). "
"Skopiuj swój tekst i odśwież stronę."
msgstr "A tradução foi alterada entretanto (outro líder de equipa ou outra aba). Copie seu texto e recarregue a página."

#: services.py:531 views_leader.py:386
msgid "Tekst jest za długi."
msgstr "O texto é muito longo."

#: services.py:538
msgid "Bieżące tłumaczenie to plik PDF – najpierw wybierz „Przejdź na tekst”."
msgstr "A tradução atual é um arquivo PDF – escolha primeiro “Mudar para texto”."

#: services.py:572
msgid ""
"Nie udało się sprawdzić pliku programem antywirusowym. Spróbuj ponownie za "
"chwilę."
msgstr ""
"Não foi possível verificar o arquivo com o antivírus. Tente novamente em "
"instantes."

#: services.py:578
msgid "Plik został odrzucony przez program antywirusowy."
msgstr "O arquivo foi rejeitado pelo antivírus."

#: services.py:598
msgid "Nie można odczytać pliku PDF (uszkodzony albo zaszyfrowany)."
msgstr "Não é possível ler o arquivo PDF (danificado ou criptografado)."

#: services.py:603
msgid "Plik ma za dużo stron."
msgstr "O arquivo tem páginas demais."

#: services.py:651
msgid "Tłumaczenie jest puste."
msgstr "A tradução está vazia."

#: services.py:656
#, python-format
msgid ""
"Wersja oficjalna zmieniła się, odkąd otworzono edytor (teraz wersja "
"%(version)s). Sprawdź zmiany poniżej i wyślij ponownie."
msgstr "A versão oficial mudou desde que o editor foi aberto (agora versão %(version)s). Verifique as alterações abaixo e envie novamente."

#: services.py:695
msgid "Tylko wysłane tłumaczenie można cofnąć."
msgstr "Só uma tradução enviada pode ser retirada."

#: services.py:715
msgid ""
"Zatwierdzone tłumaczenie można otworzyć ponownie tylko po zmianie wersji "
"oficjalnej."
msgstr ""
"Uma tradução aprovada só pode ser reaberta depois de uma alteração da versão "
"oficial."

