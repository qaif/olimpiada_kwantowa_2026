#: forms.py:19
msgid "Język 1 (domyślny dla uczniów)"
msgstr "Langue 1 (par défaut pour les élèves)"

#: forms.py:20
msgid "Język 2 (opcjonalnie)"
msgstr "Langue 2 (facultative)"

#: forms.py:33 forms.py:44
msgid "Tytuł zadania"
msgstr "Titre du problème"

#: forms.py:35
msgid "Treść (Markdown, wzory w $…$)"
msgstr "Texte (Markdown, formules entre $…$)"

#: forms.py:43
msgid "Przetłumaczony PDF"
msgstr "PDF traduit"

#: services.py:348
msgid "Wybierz jeden albo dwa języki."
msgstr "Choisissez une ou deux langues."

#: services.py:352
msgid "Nieznany język."
msgstr "Langue inconnue."

#: services.py:365
msgid "Nie można usunąć języka, w którym delegacja wysłała już tłumaczenie."
msgstr ""
"Impossible de supprimer une langue dans laquelle la délégation a déjà envoyé "
"une traduction."

#: services.py:412
msgid "Ten język nie jest językiem delegacji."
msgstr "Cette langue n’est pas une langue de la délégation."

#: services.py:430 templates/problem_translations/leader/editor.html:113
msgid "Tłumaczenie jest zatwierdzone i zablokowane."
msgstr "La traduction est approuvée et verrouillée."

#: services.py:432
msgid ""
"Tłumaczenie czeka na decyzję komisji – cofnij wysłanie, żeby je poprawić."
msgstr ""
"La traduction est en attente de la décision de la commission – retirez "
"l’envoi pour la corriger."

#: services.py:465 views_leader.py:306
msgid "Tekst jest za długi."
msgstr "Le texte est trop long."

#: services.py:489
msgid ""
"Nie udało się sprawdzić pliku programem antywirusowym. Spróbuj ponownie za "
"chwilę."
msgstr ""
"Impossible de vérifier le fichier avec l’antivirus. Réessayez dans un "
"instant."

#: services.py:495
msgid "Plik został odrzucony przez program antywirusowy."
msgstr "Le fichier a été rejeté par l’antivirus."

#: services.py:515
msgid "Nie można odczytać pliku PDF (uszkodzony albo zaszyfrowany)."
msgstr "Impossible de lire le fichier PDF (endommagé ou chiffré)."

#: services.py:520
msgid "Plik ma za dużo stron."
msgstr "Le fichier comporte trop de pages."

#: services.py:555
msgid "Tłumaczenie jest puste."
msgstr "La traduction est vide."

#: services.py:591
msgid "Tylko wysłane tłumaczenie można cofnąć."
msgstr "Seule une traduction envoyée peut être retirée."

#: services.py:610
msgid ""
"Zatwierdzone tłumaczenie można otworzyć ponownie tylko po zmianie wersji "
"oficjalnej."
msgstr ""
"Une traduction approuvée ne peut être rouverte qu’après une modification de "
"la version officielle."

#: templates/problem_translations/leader/_autosave.html:1
#, python-format
msgid "Szkic zapisany: %(at)s"
msgstr "Brouillon enregistré : %(at)s"

#: templates/problem_translations/leader/_autosave.html:2
