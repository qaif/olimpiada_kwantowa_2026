#: templates/problem_translations/leader/dashboard.html:10
#: templates/problem_translations/leader/dashboard.html:16
#: templates/problem_translations/leader/editor.html:20
msgid "Tłumaczenia zadań"
msgstr "Traductions des problèmes"

#: templates/problem_translations/leader/dashboard.html:15
#, python-format
msgid "Drużyna: %(country)s"
msgstr "Équipe : %(country)s"

#: templates/problem_translations/leader/dashboard.html:17
msgid ""
"Zadania są tajne do startu zawodów. Wersję oficjalną widzisz tylko w oknie "
"tłumaczeń ustalonym przez organizatora – każde otwarcie i pobranie jest "
"zapisywane, a pobrane pliki PDF mają znak wodny Twojej delegacji."
msgstr ""
"Les problèmes sont confidentiels jusqu’au début de la compétition. Vous ne "
"voyez la version officielle que pendant la période de traduction fixée par "
"l’organisateur – chaque ouverture et chaque téléchargement sont enregistrés, "
"et les fichiers PDF téléchargés portent le filigrane de votre délégation."

#: templates/problem_translations/leader/dashboard.html:22
msgid "Języki delegacji"
msgstr "Langues de la délégation"

#: templates/problem_translations/leader/dashboard.html:23
msgid ""
"Jeden albo dwa języki. Pierwszy jest domyślnym językiem uczniów – dla "
"pojedynczego ucznia możesz go zmienić niżej."
msgstr ""
"Une ou deux langues. La première est la langue par défaut des élèves – vous "
"pouvez la modifier pour un élève donné ci-dessous."

#: templates/problem_translations/leader/dashboard.html:27
msgid "Zapisz języki"
msgstr "Enregistrer les langues"

#: templates/problem_translations/leader/dashboard.html:37
msgid "Organizator nie ustalił jeszcze okna tłumaczeń tego etapu."
msgstr ""
"L’organisateur n’a pas encore fixé la période de traduction de cette étape."

#: templates/problem_translations/leader/dashboard.html:39
#, python-format
msgid "Okno tłumaczeń: %(opens)s – %(closes)s."
msgstr "Période de traduction : %(opens)s – %(closes)s."

#: templates/problem_translations/leader/dashboard.html:42
msgctxt "okno tłumaczeń"
msgid "otwarte"
msgstr "ouverte"

#: templates/problem_translations/leader/dashboard.html:43
msgid "jeszcze nie otwarte"
msgstr "pas encore ouverte"

#: templates/problem_translations/leader/dashboard.html:44
msgctxt "okno tłumaczeń"
msgid "zamknięte"
msgstr "fermée"

#: templates/problem_translations/leader/dashboard.html:45
msgid "Delegacje tego samego języka tworzą jedno wspólne tłumaczenie."
msgstr ""
"Les délégations d’une même langue rédigent une traduction commune unique."

#: templates/problem_translations/leader/dashboard.html:50
msgid "Zadeklaruj język delegacji, żeby zobaczyć zadania."
msgstr "Déclarez la langue de la délégation pour voir les problèmes."

#: templates/problem_translations/leader/dashboard.html:55
msgid "Zadania etapu i stan tłumaczeń"
msgstr "Problèmes de l’étape et état des traductions"

#: templates/problem_translations/leader/dashboard.html:58
msgid "Zadanie"
msgstr "Problème"

#: templates/problem_translations/leader/dashboard.html:69
msgid "Otwórz"
msgstr "Ouvrir"

#: templates/problem_translations/leader/dashboard.html:80
msgid "Bieżąca edycja nie ma jeszcze etapów."
msgstr "L’édition en cours n’a pas encore d’étapes."

#: templates/problem_translations/leader/dashboard.html:85
#: templates/problem_translations/leader/dashboard.html:93
msgid "Język uczniów"
msgstr "Langue des élèves"

#: templates/problem_translations/leader/dashboard.html:86
msgid ""
"Po starcie zawodów uczeń widzi zadanie w przypisanym języku (zatwierdzone "
"tłumaczenie) oraz zawsze w wersji oficjalnej."
msgstr ""
"Après le début de la compétition, l’élève voit le problème dans la langue qui"
" lui est attribuée (traduction approuvée) et toujours dans la version "
"officielle."

#: templates/problem_translations/leader/dashboard.html:89
msgid "Najpierw zadeklaruj języki delegacji."
msgstr "Déclarez d’abord les langues de la délégation."

#: templates/problem_translations/leader/dashboard.html:94
msgid "Uczeń"
msgstr "Élève"

#: templates/problem_translations/leader/dashboard.html:94
#: templates/problem_translations/leader/dashboard.html:102
msgid "Język"
msgstr "Langue"

#: templates/problem_translations/leader/dashboard.html:104
#, python-format
msgid "domyślny (%(language)s)"
msgstr "par défaut (%(language)s)"

#: templates/problem_translations/leader/dashboard.html:109
msgid "Zapisz"
msgstr "Enregistrer"

#: templates/problem_translations/leader/dashboard.html:114
msgid "Nie zgłoszono jeszcze żadnego ucznia."
msgstr "Aucun élève n’a encore été inscrit."

#: templates/problem_translations/leader/editor.html:15
#: templates/problem_translations/leader/editor.html:21
#, python-format
msgid "Zadanie %(number)s – %(language)s"
msgstr "Problème %(number)s – %(language)s"

#: templates/problem_translations/leader/editor.html:24
msgid "tłumaczenie wspólne delegacji tego języka"
msgstr "traduction commune des délégations de cette langue"

#: templates/problem_translations/leader/editor.html:25
#, python-format
msgid "Okno zamyka się %(closes)s."
msgstr "La période se termine le %(closes)s."

#: templates/problem_translations/leader/editor.html:28
msgid "Uwagi komisji:"
msgstr "Remarques de la commission :"

#: templates/problem_translations/leader/editor.html:32
#, python-format
msgid ""
"Wersja oficjalna zmieniła się (teraz wersja %(version)s). Zaktualizuj "
"tłumaczenie i wyślij je ponownie."
msgstr ""
"La version officielle a changé (désormais version %(version)s). Mettez à jour"
" la traduction et renvoyez-la."

#: templates/problem_translations/leader/editor.html:36
msgid "Zaktualizuj tłumaczenie"
msgstr "Mettre à jour la traduction"

#: templates/problem_translations/leader/editor.html:41
msgid "Co się zmieniło w wersji oficjalnej"
msgstr "Ce qui a changé dans la version officielle"

#: templates/problem_translations/leader/editor.html:51
#, python-format
msgid "Wersja oficjalna (v%(version)s)"
msgstr "Version officielle (v%(version)s)"

#: templates/problem_translations/leader/editor.html:54
msgid "PDF wersji oficjalnej (ze znakiem wodnym)"
msgstr "PDF de la version officielle (avec filigrane)"

#: templates/problem_translations/leader/editor.html:59
msgid "Tekst źródłowy (Markdown) do skopiowania"
msgstr "Texte source (Markdown) à copier"

#: templates/problem_translations/leader/editor.html:63
msgid "Organizator udostępnił wersję oficjalną tylko jako PDF."
msgstr "L’organisateur a fourni la version officielle uniquement en PDF."

#: templates/problem_translations/leader/editor.html:68
msgid "Tłumaczenie"
msgstr "Traduction"

#: templates/problem_translations/leader/editor.html:79
msgid ""
"Markdown: # nagłówek, **pogrubienie**, *kursywa*, listy „- ”, tabele z „|”. "
"Wzory LaTeX: $E=mc^2$ w tekście, $$…$$ w osobnym wierszu. Szkic zapisuje się "
"sam po chwili przerwy w pisaniu."
msgstr ""
"Markdown : # titre, **gras**, *italique*, listes « - », tableaux avec « | ». "
"Formules LaTeX : $E=mc^2$ dans le texte, $$…$$ sur une ligne à part. Le "
"brouillon s’enregistre automatiquement après une courte pause dans la saisie."

#: templates/problem_translations/leader/editor.html:81
msgid "Zapisz szkic"
msgstr "Enregistrer le brouillon"

#: templates/problem_translations/leader/editor.html:82
msgid "Wyślij do akceptacji"
msgstr "Envoyer pour validation"

#: templates/problem_translations/leader/editor.html:90
msgid "Zamiast tekstu: wgraj przetłumaczony PDF"
msgstr "À la place du texte : téléversez un PDF traduit"

#: templates/problem_translations/leader/editor.html:94
msgid "Wgraj PDF"
msgstr "Téléverser le PDF"

#: templates/problem_translations/leader/editor.html:97
msgid "Bieżące tłumaczenie to plik PDF."
msgstr "La traduction actuelle est un fichier PDF."

#: templates/problem_translations/leader/editor.html:98
msgid "Podgląd (ze znakiem wodnym)"
msgstr "Aperçu (avec filigrane)"

#: templates/problem_translations/leader/editor.html:101
msgid "Wyślij PDF do akceptacji"
msgstr "Envoyer le PDF pour validation"

#: templates/problem_translations/leader/editor.html:107
msgid ""
"Tłumaczenie czeka na decyzję komisji. Możesz cofnąć wysłanie, żeby wprowadzić"
" poprawki."
msgstr ""
"La traduction est en attente de la décision de la commission. Vous pouvez "
"retirer l’envoi pour apporter des corrections."

#: templates/problem_translations/leader/editor.html:110
msgid "Cofnij wysłanie"
msgstr "Retirer l’envoi"

#: templates/problem_translations/leader/editor.html:116
msgid "Podgląd PDF (ze znakiem wodnym)"
msgstr "Aperçu du PDF (avec filigrane)"

#: templates/problem_translations/leader/editor.html:124
msgid "Historia wersji"
msgstr "Historique des versions"

#: templates/problem_translations/leader/editor.html:127
#, python-format
msgid "wersja %(number)s, wysłana %(at)s"
msgstr "version %(number)s, envoyée le %(at)s"

#: templates/problem_translations/leader/editor.html:128
msgid "zatwierdzona"
msgstr "approuvée"

#: templates/problem_translations/leader/editor.html:129
msgid "zwrócona"
msgstr "renvoyée"

#: templates/problem_translations/leader/editor.html:130
msgid "wycofana"
msgstr "retirée"

#: templates/problem_translations/mail/approved_body.txt:3
#, python-format
msgid ""
"Komisja zatwierdziła tłumaczenie zadania %(number)s na język: %(language)s. "
"Po starcie zawodów uczniowie Twojej drużyny zobaczą tę wersję."
msgstr ""
"La commission a approuvé la traduction du problème %(number)s dans la langue "
": %(language)s. Après le début de la compétition, les élèves de votre équipe "
"verront cette version."

#: templates/problem_translations/mail/approved_body.txt:10
#: templates/problem_translations/mail/outdated_body.txt:11
#: templates/problem_translations/mail/returned_body.txt:13
msgid "Olimpiada Kwantowa"
msgstr "Olympiade quantique"

#: templates/problem_translations/mail/approved_body.txt:11
#: templates/problem_translations/mail/outdated_body.txt:12
#: templates/problem_translations/mail/returned_body.txt:14
msgid "Wiadomość wysłana automatycznie; prosimy na nią nie odpowiadać."
msgstr "Ce message a été envoyé automatiquement ; merci de ne pas y répondre."

#: templates/problem_translations/mail/approved_subject.txt:1
#, python-format
msgid "Tłumaczenie zadania %(number)s (%(language)s) zatwierdzone"
msgstr "Traduction du problème %(number)s (%(language)s) approuvée"

#: templates/problem_translations/mail/outdated_body.txt:4
#, python-format
msgid ""
"Organizator zmienił wersję oficjalną zadania %(number)s (teraz wersja "
"%(version)s). Tłumaczenia na języki: %(languages)s są oznaczone jako "
"nieaktualne – zaktualizuj je i wyślij ponownie do akceptacji."
msgstr ""
"L’organisateur a modifié la version officielle du problème %(number)s "
"(désormais version %(version)s). Les traductions dans les langues : "
"%(languages)s sont marquées comme obsolètes – mettez-les à jour et renvoyez-"
"les pour validation."

#: templates/problem_translations/mail/outdated_subject.txt:1
#, python-format
msgid "Zmiana wersji oficjalnej zadania %(number)s – zaktualizuj tłumaczenie"
msgstr ""
"Modification de la version officielle du problème %(number)s – mettez à jour "
"la traduction"

#: templates/problem_translations/mail/returned_body.txt:4
#, python-format
msgid ""
"Komisja zwróciła do poprawy tłumaczenie zadania %(number)s na język: "
"%(language)s."
msgstr ""
"La commission a renvoyé pour correction la traduction du problème %(number)s "
"dans la langue : %(language)s."

#: templates/problem_translations/mail/returned_body.txt:8
msgid ""
"Uwagi komisji i edytor tłumaczenia znajdziesz w panelu opiekuna drużyny:"
msgstr ""
"Vous trouverez les remarques de la commission et l’éditeur de traduction dans"
" l’espace chef d’équipe :"

#: templates/problem_translations/mail/returned_subject.txt:1
#, python-format
msgid "Tłumaczenie zadania %(number)s (%(language)s) zwrócone do poprawy"
msgstr ""
"Traduction du problème %(number)s (%(language)s) renvoyée pour correction"

