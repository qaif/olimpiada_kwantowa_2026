#: forms.py:19
msgid "Język 1 (domyślny dla uczniów)"
msgstr "Bahasa 1 (bawaan untuk siswa)"

#: forms.py:20
msgid "Język 2 (opcjonalnie)"
msgstr "Bahasa 2 (opsional)"

#: forms.py:33 forms.py:44
msgid "Tytuł zadania"
msgstr "Judul soal"

#: forms.py:35
msgid "Treść (Markdown, wzory w $…$)"
msgstr "Teks (Markdown, rumus dalam $…$)"

#: forms.py:43
msgid "Przetłumaczony PDF"
msgstr "PDF terjemahan"

#: services.py:380
msgid "Wybierz jeden albo dwa języki."
msgstr "Pilih satu atau dua bahasa."

#: services.py:384
msgid "Nieznany język."
msgstr "Bahasa tidak dikenal."

#: services.py:397
msgid "Nie można usunąć języka, w którym delegacja wysłała już tłumaczenie."
msgstr ""
"Bahasa yang sudah digunakan delegasi untuk mengirim terjemahan tidak dapat "
"dihapus."

#: services.py:444
msgid "Ten język nie jest językiem delegacji."
msgstr "Bahasa ini bukan bahasa delegasi."

#: services.py:462 templates/problem_translations/leader/editor.html:145
msgid "Tłumaczenie jest zatwierdzone i zablokowane."
msgstr "Terjemahan sudah disetujui dan dikunci."

#: services.py:464
msgid ""
"Tłumaczenie czeka na decyzję komisji – cofnij wysłanie, żeby je poprawić."
msgstr ""
"Terjemahan sedang menunggu keputusan komite – tarik kembali pengiriman untuk "
"memperbaikinya."

#: services.py:500
msgid ""
"Tłumaczenie zmieniło się w międzyczasie (inny opiekun albo inna karta). "
"Skopiuj swój tekst i odśwież stronę."
msgstr "Terjemahan telah berubah sementara itu (pemimpin tim lain atau tab lain). Salin teks Anda dan muat ulang halaman."

#: services.py:531 views_leader.py:386
msgid "Tekst jest za długi."
msgstr "Teks terlalu panjang."

#: services.py:538
msgid "Bieżące tłumaczenie to plik PDF – najpierw wybierz „Przejdź na tekst”."
msgstr "Terjemahan saat ini berupa file PDF – pilih dulu “Beralih ke teks”."

#: services.py:572
msgid ""
"Nie udało się sprawdzić pliku programem antywirusowym. Spróbuj ponownie za "
"chwilę."
msgstr "File tidak dapat diperiksa oleh antivirus. Coba lagi sebentar lagi."

#: services.py:578
msgid "Plik został odrzucony przez program antywirusowy."
msgstr "File ditolak oleh antivirus."

#: services.py:598
msgid "Nie można odczytać pliku PDF (uszkodzony albo zaszyfrowany)."
msgstr "File PDF tidak dapat dibaca (rusak atau terenkripsi)."

#: services.py:603
msgid "Plik ma za dużo stron."
msgstr "File memiliki terlalu banyak halaman."

#: services.py:651
msgid "Tłumaczenie jest puste."
msgstr "Terjemahan masih kosong."

#: services.py:656
#, python-format
msgid ""
"Wersja oficjalna zmieniła się, odkąd otworzono edytor (teraz wersja "
"%(version)s). Sprawdź zmiany poniżej i wyślij ponownie."
msgstr "Versi resmi telah berubah sejak editor dibuka (sekarang versi %(version)s). Periksa perubahan di bawah dan kirim ulang."

#: services.py:695
msgid "Tylko wysłane tłumaczenie można cofnąć."
msgstr "Hanya terjemahan yang sudah dikirim yang dapat ditarik kembali."

#: services.py:715
msgid ""
"Zatwierdzone tłumaczenie można otworzyć ponownie tylko po zmianie wersji "
"oficjalnej."
msgstr ""
"Terjemahan yang sudah disetujui hanya dapat dibuka kembali setelah versi "
"resmi berubah."

#: templates/problem_translations/leader/_autosave.html:6
#: templates/problem_translations/leader/editor.html:124
#, python-format
msgid "Szkic zapisany: %(at)s"
msgstr "Draf disimpan: %(at)s"

#: templates/problem_translations/leader/_autosave.html:9
#: templates/problem_translations/leader/editor.html:126
msgid "Podgląd"
msgstr "Pratinjau"

#: templates/problem_translations/leader/_status.html:1
msgid "nie rozpoczęte"
msgstr "belum dimulai"

#: templates/problem_translations/leader/_status.html:1
msgid "szkic"
msgstr "draf"

#: templates/problem_translations/leader/_status.html:1
msgid "czeka na akceptację"
msgstr "menunggu persetujuan"

#: templates/problem_translations/leader/_status.html:1
msgid "zwrócone do poprawy"
msgstr "dikembalikan untuk diperbaiki"

#: templates/problem_translations/leader/_status.html:1
msgid "zatwierdzone"
msgstr "disetujui"

#: templates/problem_translations/leader/_status.html:1
msgid "nieaktualne"
msgstr "usang"

#: templates/problem_translations/leader/dashboard.html:10
#: templates/problem_translations/leader/dashboard.html:16
#: templates/problem_translations/leader/editor.html:27
msgid "Tłumaczenia zadań"
msgstr "Terjemahan soal"

#: templates/problem_translations/leader/dashboard.html:15
#, python-format
msgid "Drużyna: %(country)s"
msgstr "Tim: %(country)s"

#: templates/problem_translations/leader/dashboard.html:17
msgid ""
"Zadania są tajne do startu zawodów. Wersję oficjalną widzisz tylko w oknie "
"tłumaczeń ustalonym przez organizatora – każde otwarcie i pobranie jest "
"zapisywane, a pobrane pliki PDF mają znak wodny Twojej delegacji."
msgstr ""
"Soal bersifat rahasia hingga kompetisi dimulai. Anda hanya dapat melihat "
"versi resmi selama periode penerjemahan yang ditetapkan penyelenggara – "
"setiap pembukaan dan unduhan dicatat, dan file PDF yang diunduh memuat tanda "
"air delegasi Anda."

#: templates/problem_translations/leader/dashboard.html:22
msgid "Języki delegacji"
msgstr "Bahasa delegasi"

#: templates/problem_translations/leader/dashboard.html:23
msgid ""
"Jeden albo dwa języki. Pierwszy jest domyślnym językiem uczniów – dla "
"pojedynczego ucznia możesz go zmienić niżej."
msgstr ""
"Satu atau dua bahasa. Bahasa pertama adalah bahasa bawaan siswa – Anda dapat "
"mengubahnya untuk siswa tertentu di bawah."

#: templates/problem_translations/leader/dashboard.html:27
msgid "Zapisz języki"
msgstr "Simpan bahasa"

#: templates/problem_translations/leader/dashboard.html:37
msgid "Organizator nie ustalił jeszcze okna tłumaczeń tego etapu."
msgstr "Penyelenggara belum menetapkan periode penerjemahan untuk tahap ini."

#: templates/problem_translations/leader/dashboard.html:39
#, python-format
msgid "Okno tłumaczeń: %(opens)s – %(closes)s."
msgstr "Periode penerjemahan: %(opens)s – %(closes)s."

#: templates/problem_translations/leader/dashboard.html:42
msgctxt "okno tłumaczeń"
msgid "otwarte"
msgstr "terbuka"

#: templates/problem_translations/leader/dashboard.html:43
msgid "jeszcze nie otwarte"
msgstr "belum dibuka"

#: templates/problem_translations/leader/dashboard.html:44
msgctxt "okno tłumaczeń"
msgid "zamknięte"
msgstr "ditutup"

#: templates/problem_translations/leader/dashboard.html:45
msgid "Delegacje tego samego języka tworzą jedno wspólne tłumaczenie."
msgstr "Delegasi dengan bahasa yang sama menyusun satu terjemahan bersama."

#: templates/problem_translations/leader/dashboard.html:50
msgid "Zadeklaruj język delegacji, żeby zobaczyć zadania."
msgstr "Nyatakan bahasa delegasi untuk melihat soal."

#: templates/problem_translations/leader/dashboard.html:55
msgid "Zadania etapu i stan tłumaczeń"
msgstr "Soal tahap dan status terjemahan"

#: templates/problem_translations/leader/dashboard.html:58
msgid "Zadanie"
msgstr "Soal"

#: templates/problem_translations/leader/dashboard.html:69
msgid "Otwórz"
msgstr "Buka"

#: templates/problem_translations/leader/dashboard.html:80
msgid "Bieżąca edycja nie ma jeszcze etapów."
msgstr "Edisi saat ini belum memiliki tahap."

#: templates/problem_translations/leader/dashboard.html:85
#: templates/problem_translations/leader/dashboard.html:93
msgid "Język uczniów"
msgstr "Bahasa siswa"

#: templates/problem_translations/leader/dashboard.html:86
msgid ""
"Po starcie zawodów uczeń widzi zadanie w przypisanym języku (zatwierdzone "
"tłumaczenie) oraz zawsze w wersji oficjalnej."
msgstr ""
"Setelah kompetisi dimulai, siswa melihat soal dalam bahasa yang ditetapkan "
"(terjemahan yang disetujui) dan selalu juga dalam versi resmi."

#: templates/problem_translations/leader/dashboard.html:89
msgid "Najpierw zadeklaruj języki delegacji."
msgstr "Nyatakan bahasa delegasi terlebih dahulu."

#: templates/problem_translations/leader/dashboard.html:94
msgid "Uczeń"
msgstr "Siswa"

#: templates/problem_translations/leader/dashboard.html:94
#: templates/problem_translations/leader/dashboard.html:102
msgid "Język"
msgstr "Bahasa"

#: templates/problem_translations/leader/dashboard.html:104
#, python-format
msgid "domyślny (%(language)s)"
msgstr "bawaan (%(language)s)"

#: templates/problem_translations/leader/dashboard.html:109
msgid "Zapisz"
msgstr "Simpan"

#: templates/problem_translations/leader/dashboard.html:114
msgid "Nie zgłoszono jeszcze żadnego ucznia."
msgstr "Belum ada siswa yang didaftarkan."

#: templates/problem_translations/leader/editor.html:22
#: templates/problem_translations/leader/editor.html:28
#, python-format
msgid "Zadanie %(number)s – %(language)s"
msgstr "Soal %(number)s – %(language)s"

#: templates/problem_translations/leader/editor.html:31
msgid "tłumaczenie wspólne delegacji tego języka"
msgstr "terjemahan bersama delegasi berbahasa ini"

#: templates/problem_translations/leader/editor.html:32
#, python-format
msgid "Okno zamyka się %(closes)s."
msgstr "Periode ditutup pada %(closes)s."

#: templates/problem_translations/leader/editor.html:35
msgid "Uwagi komisji:"
msgstr "Catatan komite:"

#: templates/problem_translations/leader/editor.html:39
#, python-format
msgid ""
"Wersja oficjalna zmieniła się (teraz wersja %(version)s). Zaktualizuj "
"tłumaczenie i wyślij je ponownie."
msgstr ""
"Versi resmi telah berubah (sekarang versi %(version)s). Perbarui terjemahan "
"dan kirim ulang."

#: templates/problem_translations/leader/editor.html:43
msgid "Zaktualizuj tłumaczenie"
msgstr "Perbarui terjemahan"

#: templates/problem_translations/leader/editor.html:48
msgid "Co się zmieniło w wersji oficjalnej"
msgstr "Apa yang berubah pada versi resmi"

#: templates/problem_translations/leader/editor.html:58
#, python-format
msgid "Wersja oficjalna (v%(version)s)"
msgstr "Versi resmi (v%(version)s)"

#: templates/problem_translations/leader/editor.html:61
msgid "PDF wersji oficjalnej – angielski, jak u uczniów (ze znakiem wodnym)"
msgstr "PDF versi resmi – bahasa Inggris, seperti yang diterima siswa (dengan tanda air)"

#: templates/problem_translations/leader/editor.html:61
msgid "PDF wersji oficjalnej (ze znakiem wodnym)"
msgstr "PDF versi resmi (dengan tanda air)"

#: templates/problem_translations/leader/editor.html:66
msgid "Tekst źródłowy (Markdown) do skopiowania"
msgstr "Teks sumber (Markdown) untuk disalin"

#: templates/problem_translations/leader/editor.html:70
msgid "Organizator udostępnił wersję oficjalną tylko jako PDF."
msgstr "Penyelenggara hanya menyediakan versi resmi dalam bentuk PDF."

#: templates/problem_translations/leader/editor.html:75
msgid "Tłumaczenie"
msgstr "Terjemahan"

#: templates/problem_translations/leader/editor.html:82
msgid "Bieżące tłumaczenie to plik PDF."
msgstr "Terjemahan saat ini berupa file PDF."

#: templates/problem_translations/leader/editor.html:83
msgid "Podgląd (ze znakiem wodnym)"
msgstr "Pratinjau (dengan tanda air)"

#: templates/problem_translations/leader/editor.html:89
msgid "Wyślij PDF do akceptacji"
msgstr "Kirim PDF untuk persetujuan"

#: templates/problem_translations/leader/editor.html:93
msgid "Przejdź na tekst"
msgstr "Beralih ke teks"

#: templates/problem_translations/leader/editor.html:97
msgid "Wgraj nowy PDF"
msgstr "Unggah PDF baru"

#: templates/problem_translations/leader/editor.html:101
#: templates/problem_translations/leader/editor.html:134
msgid "Wgraj PDF"
msgstr "Unggah PDF"

#: templates/problem_translations/leader/editor.html:116
msgid ""
"Markdown: # nagłówek, **pogrubienie**, *kursywa*, listy „- ”, tabele z „|”. "
"Wzory LaTeX: $E=mc^2$ w tekście, $$…$$ w osobnym wierszu. Szkic zapisuje się "
"sam po chwili przerwy w pisaniu."
msgstr ""
"Markdown: # judul, **tebal**, *miring*, daftar “- ”, tabel dengan “|”. Rumus "
"LaTeX: $E=mc^2$ di dalam teks, $$…$$ pada baris tersendiri. Draf tersimpan "
"otomatis setelah jeda singkat saat mengetik."

#: templates/problem_translations/leader/editor.html:118
msgid "Zapisz szkic"
msgstr "Simpan draf"

#: templates/problem_translations/leader/editor.html:119
msgid "Wyślij do akceptacji"
msgstr "Kirim untuk persetujuan"

#: templates/problem_translations/leader/editor.html:123
msgid ""
"Autozapis nie powiódł się – zmiany nie są zapisane. Skopiuj swój tekst i "
"odśwież stronę."
msgstr "Simpan otomatis gagal – perubahan tidak tersimpan. Salin teks Anda dan muat ulang halaman."

#: templates/problem_translations/leader/editor.html:130
msgid "Zamiast tekstu: wgraj przetłumaczony PDF"
msgstr "Sebagai ganti teks: unggah PDF terjemahan"

#: templates/problem_translations/leader/editor.html:139
msgid ""
"Tłumaczenie czeka na decyzję komisji. Możesz cofnąć wysłanie, żeby "
"wprowadzić poprawki."
msgstr ""
"Terjemahan sedang menunggu keputusan komite. Anda dapat menarik kembali "
"pengiriman untuk melakukan perbaikan."

#: templates/problem_translations/leader/editor.html:142
msgid "Cofnij wysłanie"
msgstr "Tarik kembali pengiriman"

#: templates/problem_translations/leader/editor.html:148
msgid "Podgląd PDF (ze znakiem wodnym)"
msgstr "Pratinjau PDF (dengan tanda air)"

#: templates/problem_translations/leader/editor.html:156
msgid "Historia wersji"
msgstr "Riwayat versi"

#: templates/problem_translations/leader/editor.html:159
#, python-format
msgid "wersja %(number)s, wysłana %(at)s"
msgstr "versi %(number)s, dikirim %(at)s"

#: templates/problem_translations/leader/editor.html:160
msgid "zatwierdzona"
msgstr "disetujui"

#: templates/problem_translations/leader/editor.html:161
msgid "zwrócona"
msgstr "dikembalikan"

#: templates/problem_translations/leader/editor.html:162
msgid "wycofana"
msgstr "ditarik kembali"

#: templates/problem_translations/mail/approved_body.txt:3
#, python-format
msgid ""
"Komisja zatwierdziła tłumaczenie zadania %(number)s na język: %(language)s. "
"Po starcie zawodów uczniowie Twojej drużyny zobaczą tę wersję."
msgstr ""
"Komite telah menyetujui terjemahan soal %(number)s ke dalam bahasa: "
"%(language)s. Setelah kompetisi dimulai, siswa tim Anda akan melihat versi "
"ini."

#: templates/problem_translations/mail/approved_body.txt:10
#: templates/problem_translations/mail/outdated_body.txt:11
#: templates/problem_translations/mail/returned_body.txt:13
msgid "Olimpiada Kwantowa"
msgstr "Olimpiade Kuantum"

#: templates/problem_translations/mail/approved_body.txt:11
#: templates/problem_translations/mail/outdated_body.txt:12
#: templates/problem_translations/mail/returned_body.txt:14
msgid "Wiadomość wysłana automatycznie; prosimy na nią nie odpowiadać."
msgstr "Pesan ini dikirim secara otomatis; mohon tidak membalasnya."

#: templates/problem_translations/mail/approved_subject.txt:1
#, python-format
msgid "Tłumaczenie zadania %(number)s (%(language)s) zatwierdzone"
msgstr "Terjemahan soal %(number)s (%(language)s) disetujui"

#: templates/problem_translations/mail/outdated_body.txt:4
#, python-format
msgid ""
"Organizator zmienił wersję oficjalną zadania %(number)s (teraz wersja "
"%(version)s). Tłumaczenia na języki: %(languages)s są oznaczone jako "
"nieaktualne – zaktualizuj je i wyślij ponownie do akceptacji."
msgstr ""
"Penyelenggara telah mengubah versi resmi soal %(number)s (sekarang versi "
"%(version)s). Terjemahan ke bahasa: %(languages)s ditandai sebagai usang – "
"perbarui dan kirim ulang untuk persetujuan."

#: templates/problem_translations/mail/outdated_subject.txt:1
#, python-format
msgid "Zmiana wersji oficjalnej zadania %(number)s – zaktualizuj tłumaczenie"
msgstr "Perubahan versi resmi soal %(number)s – perbarui terjemahan"

#: templates/problem_translations/mail/returned_body.txt:4
#, python-format
msgid ""
"Komisja zwróciła do poprawy tłumaczenie zadania %(number)s na język: "
"%(language)s."
msgstr ""
"Komite telah mengembalikan terjemahan soal %(number)s ke dalam bahasa: "
"%(language)s untuk diperbaiki."

#: templates/problem_translations/mail/returned_body.txt:8
msgid ""
"Uwagi komisji i edytor tłumaczenia znajdziesz w panelu opiekuna drużyny:"
msgstr ""
"Catatan komite dan editor terjemahan dapat Anda temukan di panel pemimpin "
"tim:"

#: templates/problem_translations/mail/returned_subject.txt:1
#, python-format
msgid "Tłumaczenie zadania %(number)s (%(language)s) zwrócone do poprawy"
msgstr ""
"Terjemahan soal %(number)s (%(language)s) dikembalikan untuk diperbaiki"

#: templates/problem_translations/student/problem.html:7
#, python-format
msgid "Zadanie %(number)s"
msgstr "Soal %(number)s"

#: templates/problem_translations/student/problem.html:12
msgid "Moje zadania"
msgstr "Soal saya"

#: templates/problem_translations/student/problem.html:14
#, python-format
msgid "Tłumaczenie: %(language)s."
msgstr "Terjemahan: %(language)s."

#: templates/problem_translations/student/problem.html:15
msgid "Wersja oficjalna (PDF)"
msgstr "Versi resmi (PDF)"

#: templates/problem_translations/student/problem.html:17
msgid ""
"Wersja oficjalna została zmieniona po zatwierdzeniu tego tłumaczenia – "
"sprawdź wersję oficjalną (PDF)."
msgstr "Versi resmi diubah setelah terjemahan ini disetujui – periksa versi resmi (PDF)."

#: templates/problem_translations/student/problem.html:20
#, python-format
msgid ""
"Tłumaczenie na język %(wanted)s nie jest dostępne – pokazujemy język "
"%(shown)s, drugi język Twojej drużyny."
msgstr "Terjemahan ke bahasa %(wanted)s tidak tersedia – ditampilkan bahasa %(shown)s, bahasa kedua tim Anda."

#: templates/problem_translations/student/problem.html:25
msgid "Treść zadania (PDF)"
msgstr "Isi soal (PDF)"

#: templatetags/problem_translations.py:40
#, python-format
msgid "Treść w języku: %(language)s"
msgstr "Teks dalam bahasa: %(language)s"

#: views_leader.py:136
msgid "Języki delegacji zostały zapisane."
msgstr "Bahasa delegasi telah disimpan."

#: views_leader.py:151
msgid "Język ucznia został zapisany."
msgstr "Bahasa siswa telah disimpan."

#: views_leader.py:271
msgid "Szkic zapisany."
msgstr "Draf disimpan."

#: views_leader.py:278
msgid ""
"Wersja oficjalna zmieniła się, odkąd otworzono edytor – sprawdź zmiany przed "
"wysłaniem."
msgstr "Versi resmi telah berubah sejak editor dibuka – periksa perubahan sebelum mengirim."

#: views_leader.py:298
msgid ""
"Okno tłumaczeń jest zamknięte – zmiany nie zostały zapisane. Skopiuj swój "
"tekst."
msgstr "Jendela terjemahan sudah ditutup – perubahan tidak tersimpan. Salin teks Anda."

#: views_leader.py:356
msgid "Wybierz plik PDF."
msgstr "Pilih file PDF."

#: views_leader.py:371
msgid "Plik PDF został zapisany jako tłumaczenie."
msgstr "File PDF telah disimpan sebagai terjemahan."

#: views_leader.py:381
msgid "Tłumaczenie wysłane do akceptacji."
msgstr "Terjemahan telah dikirim untuk persetujuan."

#: views_leader.py:408
msgid "Wysłanie cofnięte – tłumaczenie jest znowu szkicem."
msgstr "Pengiriman ditarik kembali – terjemahan kembali menjadi draf."

#: views_leader.py:415
msgid ""
"Tłumaczenie otwarte do aktualizacji. Uczniowie widzą dotąd zatwierdzoną "
"wersję."
msgstr ""
"Terjemahan dibuka untuk diperbarui. Sementara itu, siswa tetap melihat versi "
"yang telah disetujui sebelumnya."

#: views_leader.py:424
msgid "Tłumaczenie jest znowu tekstem – możesz pisać w edytorze."
msgstr "Terjemahan kembali berupa teks – Anda dapat menulis di editor."