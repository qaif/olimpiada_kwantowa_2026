#: forms.py:19
msgid "Język 1 (domyślny dla uczniów)"
msgstr "ভাষা 1 (শিক্ষার্থীদের জন্য ডিফল্ট)"

#: forms.py:20
msgid "Język 2 (opcjonalnie)"
msgstr "ভাষা 2 (ঐচ্ছিক)"

#: forms.py:33 forms.py:44
msgid "Tytuł zadania"
msgstr "সমস্যার শিরোনাম"

#: forms.py:35
msgid "Treść (Markdown, wzory w $…$)"
msgstr "পাঠ্য (Markdown, সূত্র $…$-এর মধ্যে)"

#: forms.py:43
msgid "Przetłumaczony PDF"
msgstr "অনূদিত PDF"

#: services.py:348
msgid "Wybierz jeden albo dwa języki."
msgstr "এক বা দুটি ভাষা বেছে নিন।"

#: services.py:352
msgid "Nieznany język."
msgstr "অজানা ভাষা।"

#: services.py:365
msgid "Nie można usunąć języka, w którym delegacja wysłała już tłumaczenie."
msgstr "যে ভাষায় প্রতিনিধিদল ইতিমধ্যে অনুবাদ পাঠিয়েছে, সেটি সরানো যাবে না।"

#: services.py:412
msgid "Ten język nie jest językiem delegacji."
msgstr "এই ভাষাটি প্রতিনিধিদলের ভাষা নয়।"

#: services.py:430 templates/problem_translations/leader/editor.html:113
msgid "Tłumaczenie jest zatwierdzone i zablokowane."
msgstr "অনুবাদটি অনুমোদিত এবং লক করা হয়েছে।"

#: services.py:432
msgid ""
"Tłumaczenie czeka na decyzję komisji – cofnij wysłanie, żeby je poprawić."
msgstr ""
"অনুবাদটি কমিটির সিদ্ধান্তের অপেক্ষায় আছে – সংশোধন করতে পাঠানো প্রত্যাহার "
"করুন।"

#: services.py:465 views_leader.py:306
msgid "Tekst jest za długi."
msgstr "পাঠ্যটি অনেক দীর্ঘ।"

#: services.py:489
msgid ""
"Nie udało się sprawdzić pliku programem antywirusowym. Spróbuj ponownie za "
"chwilę."
msgstr ""
"অ্যান্টিভাইরাস দিয়ে ফাইলটি পরীক্ষা করা যায়নি। কিছুক্ষণ পরে আবার চেষ্টা "
"করুন।"

#: services.py:495
msgid "Plik został odrzucony przez program antywirusowy."
msgstr "অ্যান্টিভাইরাস ফাইলটি প্রত্যাখ্যান করেছে।"

#: services.py:515
msgid "Nie można odczytać pliku PDF (uszkodzony albo zaszyfrowany)."
msgstr "PDF ফাইলটি পড়া যাচ্ছে না (ক্ষতিগ্রস্ত বা এনক্রিপ্ট করা)।"

#: services.py:520
msgid "Plik ma za dużo stron."
msgstr "ফাইলটিতে পৃষ্ঠার সংখ্যা অনেক বেশি।"

#: services.py:555
msgid "Tłumaczenie jest puste."
msgstr "অনুবাদটি খালি।"

#: services.py:591
msgid "Tylko wysłane tłumaczenie można cofnąć."
msgstr "শুধু পাঠানো অনুবাদই প্রত্যাহার করা যায়।"

#: services.py:610
msgid ""
"Zatwierdzone tłumaczenie można otworzyć ponownie tylko po zmianie wersji "
"oficjalnej."
msgstr "অনুমোদিত অনুবাদ কেবল অফিসিয়াল সংস্করণ পরিবর্তিত হলেই আবার খোলা যায়।"

#: templates/problem_translations/leader/_autosave.html:1
#, python-format
msgid "Szkic zapisany: %(at)s"
msgstr "খসড়া সংরক্ষিত: %(at)s"

#: templates/problem_translations/leader/_autosave.html:2
msgid "Podgląd"
msgstr "প্রিভিউ"

