#: templates/problem_translations/leader/dashboard.html:10
#: templates/problem_translations/leader/dashboard.html:16
#: templates/problem_translations/leader/editor.html:20
msgid "Tłumaczenia zadań"
msgstr "সমস্যার অনুবাদ"

#: templates/problem_translations/leader/dashboard.html:15
#, python-format
msgid "Drużyna: %(country)s"
msgstr "দল: %(country)s"

#: templates/problem_translations/leader/dashboard.html:17
msgid ""
"Zadania są tajne do startu zawodów. Wersję oficjalną widzisz tylko w oknie "
"tłumaczeń ustalonym przez organizatora – każde otwarcie i pobranie jest "
"zapisywane, a pobrane pliki PDF mają znak wodny Twojej delegacji."
msgstr ""
"প্রতিযোগিতা শুরু না হওয়া পর্যন্ত সমস্যাগুলো গোপন। আয়োজকের নির্ধারিত "
"অনুবাদের সময়সীমার মধ্যেই কেবল আপনি অফিসিয়াল সংস্করণ দেখতে পারবেন – প্রতিবার"
" খোলা ও ডাউনলোড নথিভুক্ত হয়, এবং ডাউনলোড করা PDF ফাইলে আপনার প্রতিনিধিদলের "
"ওয়াটারমার্ক থাকে।"

#: templates/problem_translations/leader/dashboard.html:22
msgid "Języki delegacji"
msgstr "প্রতিনিধিদলের ভাষা"

#: templates/problem_translations/leader/dashboard.html:23
msgid ""
"Jeden albo dwa języki. Pierwszy jest domyślnym językiem uczniów – dla "
"pojedynczego ucznia możesz go zmienić niżej."
msgstr ""
"এক বা দুটি ভাষা। প্রথমটি শিক্ষার্থীদের ডিফল্ট ভাষা – নির্দিষ্ট কোনো "
"শিক্ষার্থীর জন্য আপনি নিচে এটি বদলাতে পারেন।"

#: templates/problem_translations/leader/dashboard.html:27
msgid "Zapisz języki"
msgstr "ভাষা সংরক্ষণ করুন"

#: templates/problem_translations/leader/dashboard.html:37
msgid "Organizator nie ustalił jeszcze okna tłumaczeń tego etapu."
msgstr "আয়োজক এখনো এই পর্বের অনুবাদের সময়সীমা নির্ধারণ করেননি।"

#: templates/problem_translations/leader/dashboard.html:39
#, python-format
msgid "Okno tłumaczeń: %(opens)s – %(closes)s."
msgstr "অনুবাদের সময়সীমা: %(opens)s – %(closes)s।"

#: templates/problem_translations/leader/dashboard.html:42
msgctxt "okno tłumaczeń"
msgid "otwarte"
msgstr "খোলা"

#: templates/problem_translations/leader/dashboard.html:43
msgid "jeszcze nie otwarte"
msgstr "এখনো খোলা হয়নি"

#: templates/problem_translations/leader/dashboard.html:44
msgctxt "okno tłumaczeń"
msgid "zamknięte"
msgstr "বন্ধ"

#: templates/problem_translations/leader/dashboard.html:45
msgid "Delegacje tego samego języka tworzą jedno wspólne tłumaczenie."
msgstr "একই ভাষার প্রতিনিধিদলগুলো মিলে একটি যৌথ অনুবাদ তৈরি করে।"

#: templates/problem_translations/leader/dashboard.html:50
msgid "Zadeklaruj język delegacji, żeby zobaczyć zadania."
msgstr "সমস্যাগুলো দেখতে প্রতিনিধিদলের ভাষা ঘোষণা করুন।"

#: templates/problem_translations/leader/dashboard.html:55
msgid "Zadania etapu i stan tłumaczeń"
msgstr "পর্বের সমস্যা ও অনুবাদের অবস্থা"

#: templates/problem_translations/leader/dashboard.html:58
msgid "Zadanie"
msgstr "সমস্যা"

#: templates/problem_translations/leader/dashboard.html:69
msgid "Otwórz"
msgstr "খুলুন"

#: templates/problem_translations/leader/dashboard.html:80
msgid "Bieżąca edycja nie ma jeszcze etapów."
msgstr "বর্তমান সংস্করণে এখনো কোনো পর্ব নেই।"

#: templates/problem_translations/leader/dashboard.html:85
#: templates/problem_translations/leader/dashboard.html:93
msgid "Język uczniów"
msgstr "শিক্ষার্থীদের ভাষা"

#: templates/problem_translations/leader/dashboard.html:86
msgid ""
"Po starcie zawodów uczeń widzi zadanie w przypisanym języku (zatwierdzone "
"tłumaczenie) oraz zawsze w wersji oficjalnej."
msgstr ""
"প্রতিযোগিতা শুরু হওয়ার পর শিক্ষার্থী নির্ধারিত ভাষায় (অনুমোদিত অনুবাদ) এবং "
"সবসময় অফিসিয়াল সংস্করণেও সমস্যাটি দেখতে পায়।"

#: templates/problem_translations/leader/dashboard.html:89
msgid "Najpierw zadeklaruj języki delegacji."
msgstr "প্রথমে প্রতিনিধিদলের ভাষাগুলো ঘোষণা করুন।"

#: templates/problem_translations/leader/dashboard.html:94
msgid "Uczeń"
msgstr "শিক্ষার্থী"

#: templates/problem_translations/leader/dashboard.html:94
#: templates/problem_translations/leader/dashboard.html:102
msgid "Język"
msgstr "ভাষা"

#: templates/problem_translations/leader/dashboard.html:104
#, python-format
