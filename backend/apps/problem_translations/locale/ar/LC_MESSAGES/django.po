#: forms.py:19
msgid "Język 1 (domyślny dla uczniów)"
msgstr "اللغة 1 (الافتراضية للطلاب)"

#: forms.py:20
msgid "Język 2 (opcjonalnie)"
msgstr "اللغة 2 (اختيارية)"

#: forms.py:33 forms.py:44
msgid "Tytuł zadania"
msgstr "عنوان المسألة"

#: forms.py:35
msgid "Treść (Markdown, wzory w $…$)"
msgstr "النص (Markdown، والصيغ بين $…$)"

#: forms.py:43
