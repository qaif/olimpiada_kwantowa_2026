#: forms.py:19
msgid "Język 1 (domyślny dla uczniów)"
msgstr "Язык 1 (по умолчанию для учеников)"

#: forms.py:20
msgid "Język 2 (opcjonalnie)"
msgstr "Язык 2 (необязательно)"

#: forms.py:33 forms.py:44
msgid "Tytuł zadania"
msgstr "Название задачи"

#: forms.py:35
msgid "Treść (Markdown, wzory w $…$)"
msgstr "Текст (Markdown, формулы в $…$)"

#: forms.py:43
msgid "Przetłumaczony PDF"
msgstr "Переведённый PDF"

#: services.py:380
msgid "Wybierz jeden albo dwa języki."
msgstr "Выберите один или два языка."

#: services.py:384
msgid "Nieznany język."
msgstr "Неизвестный язык."

#: services.py:397
msgid "Nie można usunąć języka, w którym delegacja wysłała już tłumaczenie."
msgstr "Нельзя удалить язык, на котором делегация уже отправила перевод."

#: services.py:444
msgid "Ten język nie jest językiem delegacji."
msgstr "Этот язык не является языком делегации."

#: services.py:462 templates/problem_translations/leader/editor.html:145
msgid "Tłumaczenie jest zatwierdzone i zablokowane."
msgstr "Перевод одобрен и заблокирован."

#: services.py:464
msgid ""
"Tłumaczenie czeka na decyzję komisji – cofnij wysłanie, żeby je poprawić."
msgstr ""
"Перевод ожидает решения комиссии — отзовите отправку, чтобы исправить его."

#: services.py:500
msgid ""
"Tłumaczenie zmieniło się w międzyczasie (inny opiekun albo inna karta). "
"Skopiuj swój tekst i odśwież stronę."
msgstr "Перевод тем временем изменился (другой руководитель команды или другая вкладка). Скопируйте свой текст и обновите страницу."

#: services.py:531 views_leader.py:386
msgid "Tekst jest za długi."
msgstr "Текст слишком длинный."

#: services.py:538
msgid "Bieżące tłumaczenie to plik PDF – najpierw wybierz „Przejdź na tekst”."
msgstr "Текущий перевод — PDF-файл. Сначала выберите «Перейти к тексту»."

#: services.py:572
msgid ""
"Nie udało się sprawdzić pliku programem antywirusowym. Spróbuj ponownie za "
"chwilę."
msgstr "Не удалось проверить файл антивирусом. Повторите попытку чуть позже."

#: services.py:578
msgid "Plik został odrzucony przez program antywirusowy."
msgstr "Файл отклонён антивирусом."

#: services.py:598
msgid "Nie można odczytać pliku PDF (uszkodzony albo zaszyfrowany)."
msgstr "Не удаётся прочитать PDF-файл (он повреждён или зашифрован)."

#: services.py:603
msgid "Plik ma za dużo stron."
msgstr "В файле слишком много страниц."

#: services.py:651
msgid "Tłumaczenie jest puste."
msgstr "Перевод пуст."

#: services.py:656
#, python-format
msgid ""
"Wersja oficjalna zmieniła się, odkąd otworzono edytor (teraz wersja "
"%(version)s). Sprawdź zmiany poniżej i wyślij ponownie."
msgstr "Официальная версия изменилась с момента открытия редактора (теперь версия %(version)s). Проверьте изменения ниже и отправьте снова."

#: services.py:695
msgid "Tylko wysłane tłumaczenie można cofnąć."
msgstr "Отозвать можно только отправленный перевод."

#: services.py:715
msgid ""
"Zatwierdzone tłumaczenie można otworzyć ponownie tylko po zmianie wersji "
"oficjalnej."
msgstr ""
"Одобренный перевод можно открыть повторно только после изменения официальной "
"версии."

#: templates/problem_translations/leader/_autosave.html:6
#: templates/problem_translations/leader/editor.html:124
#, python-format
