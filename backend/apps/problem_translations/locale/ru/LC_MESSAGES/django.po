#: services.py:348
msgid "Wybierz jeden albo dwa języki."
msgstr "Выберите один или два языка."

#: services.py:352
msgid "Nieznany język."
msgstr "Неизвестный язык."

#: services.py:365
msgid "Nie można usunąć języka, w którym delegacja wysłała już tłumaczenie."
msgstr "Нельзя удалить язык, на котором делегация уже отправила перевод."

#: services.py:412
msgid "Ten język nie jest językiem delegacji."
msgstr "Этот язык не является языком делегации."

#: services.py:430 templates/problem_translations/leader/editor.html:113
msgid "Tłumaczenie jest zatwierdzone i zablokowane."
msgstr "Перевод одобрен и заблокирован."

#: services.py:432
msgid ""
"Tłumaczenie czeka na decyzję komisji – cofnij wysłanie, żeby je poprawić."
msgstr ""
"Перевод ожидает решения комиссии — отзовите отправку, чтобы исправить его."

#: services.py:465 views_leader.py:306
msgid "Tekst jest za długi."
msgstr "Текст слишком длинный."

#: services.py:489
msgid ""
"Nie udało się sprawdzić pliku programem antywirusowym. Spróbuj ponownie za "
"chwilę."
msgstr "Не удалось проверить файл антивирусом. Повторите попытку чуть позже."

#: services.py:495
msgid "Plik został odrzucony przez program antywirusowy."
msgstr "Файл отклонён антивирусом."

#: services.py:515
msgid "Nie można odczytać pliku PDF (uszkodzony albo zaszyfrowany)."
msgstr "Не удаётся прочитать PDF-файл (он повреждён или зашифрован)."

#: services.py:520
msgid "Plik ma za dużo stron."
msgstr "В файле слишком много страниц."

#: services.py:555
msgid "Tłumaczenie jest puste."
msgstr "Перевод пуст."

#: services.py:591
msgid "Tylko wysłane tłumaczenie można cofnąć."
msgstr "Отозвать можно только отправленный перевод."

#: services.py:610
msgid ""
"Zatwierdzone tłumaczenie można otworzyć ponownie tylko po zmianie wersji "
"oficjalnej."
msgstr ""
"Одобренный перевод можно открыть повторно только после изменения официальной "
"версии."

#: templates/problem_translations/leader/_autosave.html:1
#, python-format
msgid "Szkic zapisany: %(at)s"
msgstr "Черновик сохранён: %(at)s"

#: templates/problem_translations/leader/_autosave.html:2
