msgstr "版本 %(number)s，提交于 %(at)s"

#: templates/problem_translations/leader/editor.html:160
msgid "zatwierdzona"
msgstr "已批准"

#: templates/problem_translations/leader/editor.html:161
msgid "zwrócona"
msgstr "已退回"

#: templates/problem_translations/leader/editor.html:162
msgid "wycofana"
msgstr "已撤回"

#: templates/problem_translations/mail/approved_body.txt:3
#, python-format
msgid ""
"Komisja zatwierdziła tłumaczenie zadania %(number)s na język: %(language)s. "
"Po starcie zawodów uczniowie Twojej drużyny zobaczą tę wersję."
msgstr ""
"委员会已批准题目 %(number)s 的翻译（语言：%(language)s）。竞赛开始后，您代表"
"队的学生将看到此版本。"

#: templates/problem_translations/mail/approved_body.txt:10
#: templates/problem_translations/mail/outdated_body.txt:11
#: templates/problem_translations/mail/returned_body.txt:13
msgid "Olimpiada Kwantowa"
msgstr "量子奥林匹克"

#: templates/problem_translations/mail/approved_body.txt:11
#: templates/problem_translations/mail/outdated_body.txt:12
#: templates/problem_translations/mail/returned_body.txt:14
msgid "Wiadomość wysłana automatycznie; prosimy na nią nie odpowiadać."
msgstr "此邮件为系统自动发送，请勿回复。"

#: templates/problem_translations/mail/approved_subject.txt:1
#, python-format
msgid "Tłumaczenie zadania %(number)s (%(language)s) zatwierdzone"
msgstr "题目 %(number)s 的翻译（%(language)s）已批准"

#: templates/problem_translations/mail/outdated_body.txt:4
#, python-format
msgid ""
"Organizator zmienił wersję oficjalną zadania %(number)s (teraz wersja "
"%(version)s). Tłumaczenia na języki: %(languages)s są oznaczone jako "
"nieaktualne – zaktualizuj je i wyślij ponownie do akceptacji."
msgstr ""
"组织方已更改题目 %(number)s 的官方版本（当前为版本 %(version)s）。以下语言的"
"翻译已标记为过时：%(languages)s——请更新后重新提交审批。"

#: templates/problem_translations/mail/outdated_subject.txt:1
#, python-format
msgid "Zmiana wersji oficjalnej zadania %(number)s – zaktualizuj tłumaczenie"
msgstr "题目 %(number)s 的官方版本已更改——请更新翻译"

#: templates/problem_translations/mail/returned_body.txt:4
#, python-format
msgid ""
"Komisja zwróciła do poprawy tłumaczenie zadania %(number)s na język: "
"%(language)s."
msgstr "委员会已将题目 %(number)s 的翻译（语言：%(language)s）退回修改。"

#: templates/problem_translations/mail/returned_body.txt:8
msgid ""
"Uwagi komisji i edytor tłumaczenia znajdziesz w panelu opiekuna drużyny:"
msgstr "委员会意见和翻译编辑器可在领队面板中查看："

#: templates/problem_translations/mail/returned_subject.txt:1
#, python-format
msgid "Tłumaczenie zadania %(number)s (%(language)s) zwrócone do poprawy"
msgstr "题目 %(number)s 的翻译（%(language)s）已退回修改"

#: templates/problem_translations/student/problem.html:7
#, python-format
msgid "Zadanie %(number)s"
msgstr "题目 %(number)s"

#: templates/problem_translations/student/problem.html:12
msgid "Moje zadania"
msgstr "我的题目"

#: templates/problem_translations/student/problem.html:14
#, python-format
msgid "Tłumaczenie: %(language)s."
msgstr "翻译：%(language)s。"

#: templates/problem_translations/student/problem.html:15
msgid "Wersja oficjalna (PDF)"
msgstr "官方版本（PDF）"

#: templates/problem_translations/student/problem.html:17
msgid ""
"Wersja oficjalna została zmieniona po zatwierdzeniu tego tłumaczenia – "
"sprawdź wersję oficjalną (PDF)."
msgstr "此翻译获批后，正式版本已被修改——请查看正式版本（PDF）。"

#: templates/problem_translations/student/problem.html:20
#, python-format
msgid ""
"Tłumaczenie na język %(wanted)s nie jest dostępne – pokazujemy język "
"%(shown)s, drugi język Twojej drużyny."
msgstr "暂无%(wanted)s译文——现显示%(shown)s，即您代表队的另一种语言。"

#: templates/problem_translations/student/problem.html:25
msgid "Treść zadania (PDF)"
msgstr "题目（PDF）"

#: templatetags/problem_translations.py:40
#, python-format
msgid "Treść w języku: %(language)s"
msgstr "正文语言：%(language)s"

#: views_leader.py:136
msgid "Języki delegacji zostały zapisane."
msgstr "代表队语言已保存。"

#: views_leader.py:151
msgid "Język ucznia został zapisany."
msgstr "学生语言已保存。"

#: views_leader.py:271
msgid "Szkic zapisany."
msgstr "草稿已保存。"

#: views_leader.py:278
msgid ""
"Wersja oficjalna zmieniła się, odkąd otworzono edytor – sprawdź zmiany przed "
"wysłaniem."
msgstr "打开编辑器后正式版本已有变化——提交前请查看变化。"

#: views_leader.py:298
msgid ""
"Okno tłumaczeń jest zamknięte – zmiany nie zostały zapisane. Skopiuj swój "
"tekst."
msgstr "翻译窗口已关闭——更改未保存。请复制您的文本。"

#: views_leader.py:356
msgid "Wybierz plik PDF."
msgstr "请选择 PDF 文件。"

#: views_leader.py:371
msgid "Plik PDF został zapisany jako tłumaczenie."
msgstr "PDF 文件已保存为翻译。"

#: views_leader.py:381
msgid "Tłumaczenie wysłane do akceptacji."
msgstr "翻译已提交审批。"

#: views_leader.py:408
msgid "Wysłanie cofnięte – tłumaczenie jest znowu szkicem."
msgstr "已撤回提交——该翻译重新成为草稿。"

#: views_leader.py:415
msgid ""
"Tłumaczenie otwarte do aktualizacji. Uczniowie widzą dotąd zatwierdzoną "
"wersję."
msgstr "翻译已重新打开以便更新。在此期间，学生看到的仍是之前已批准的版本。"

#: views_leader.py:424
msgid "Tłumaczenie jest znowu tekstem – możesz pisać w edytorze."
msgstr "翻译已恢复为文本——您可以在编辑器中书写。"