msgstr "अनुवाद: %(language)s।"

#: templates/problem_translations/student/problem.html:15
msgid "Wersja oficjalna (PDF)"
msgstr "आधिकारिक संस्करण (PDF)"

#: templates/problem_translations/student/problem.html:17
msgid ""
"Wersja oficjalna została zmieniona po zatwierdzeniu tego tłumaczenia – "
"sprawdź wersję oficjalną (PDF)."
msgstr "इस अनुवाद के अनुमोदन के बाद आधिकारिक संस्करण बदल गया – आधिकारिक संस्करण (PDF) देखें।"

#: templates/problem_translations/student/problem.html:20
#, python-format
msgid ""
"Tłumaczenie na język %(wanted)s nie jest dostępne – pokazujemy język "
"%(shown)s, drugi język Twojej drużyny."
msgstr "%(wanted)s में अनुवाद उपलब्ध नहीं है – आपकी टीम की दूसरी भाषा %(shown)s दिखाई जा रही है।"

#: templates/problem_translations/student/problem.html:25
msgid "Treść zadania (PDF)"
msgstr "प्रश्न का पाठ (PDF)"

#: templatetags/problem_translations.py:40
#, python-format
msgid "Treść w języku: %(language)s"
msgstr "पाठ की भाषा: %(language)s"

#: views_leader.py:136
msgid "Języki delegacji zostały zapisane."
msgstr "प्रतिनिधिमंडल की भाषाएँ सहेज ली गई हैं।"

#: views_leader.py:151
msgid "Język ucznia został zapisany."
msgstr "विद्यार्थी की भाषा सहेज ली गई है।"

#: views_leader.py:271
msgid "Szkic zapisany."
msgstr "ड्राफ़्ट सहेजा गया।"

#: views_leader.py:278
msgid ""
"Wersja oficjalna zmieniła się, odkąd otworzono edytor – sprawdź zmiany przed "
"wysłaniem."
msgstr "संपादक खोलने के बाद आधिकारिक संस्करण बदल गया है – भेजने से पहले बदलाव देखें।"

#: views_leader.py:298
msgid ""
"Okno tłumaczeń jest zamknięte – zmiany nie zostały zapisane. Skopiuj swój "
"tekst."
msgstr "अनुवाद विंडो बंद है – बदलाव सहेजे नहीं गए। अपना पाठ कॉपी करें।"

#: views_leader.py:356
msgid "Wybierz plik PDF."
msgstr "PDF फ़ाइल चुनें।"

#: views_leader.py:371
msgid "Plik PDF został zapisany jako tłumaczenie."
msgstr "PDF फ़ाइल अनुवाद के रूप में सहेज ली गई है।"

#: views_leader.py:381
msgid "Tłumaczenie wysłane do akceptacji."
msgstr "अनुवाद स्वीकृति के लिए भेज दिया गया।"

#: views_leader.py:408
msgid "Wysłanie cofnięte – tłumaczenie jest znowu szkicem."
msgstr "भेजना वापस लिया गया – अनुवाद फिर से ड्राफ़्ट है।"

#: views_leader.py:415
msgid ""
"Tłumaczenie otwarte do aktualizacji. Uczniowie widzą dotąd zatwierdzoną "
"wersję."
msgstr ""
"अनुवाद अद्यतन के लिए खोल दिया गया है। तब तक विद्यार्थी पहले से स्वीकृत संस्करण ही देखते हैं।"

#: views_leader.py:424
msgid "Tłumaczenie jest znowu tekstem – możesz pisać w edytorze."
msgstr "अनुवाद फिर से पाठ है – आप संपादक में लिख सकते हैं।"