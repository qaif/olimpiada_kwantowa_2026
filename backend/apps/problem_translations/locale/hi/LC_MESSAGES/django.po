#: forms.py:19
msgid "Język 1 (domyślny dla uczniów)"
msgstr "भाषा 1 (विद्यार्थियों के लिए डिफ़ॉल्ट)"

#: forms.py:20
msgid "Język 2 (opcjonalnie)"
msgstr "भाषा 2 (वैकल्पिक)"

#: forms.py:33 forms.py:44
msgid "Tytuł zadania"
msgstr "प्रश्न का शीर्षक"

#: forms.py:35
msgid "Treść (Markdown, wzory w $…$)"
msgstr "पाठ (Markdown, सूत्र $…$ में)"

#: forms.py:43
msgid "Przetłumaczony PDF"
msgstr "अनूदित PDF"

#: services.py:380
msgid "Wybierz jeden albo dwa języki."
msgstr "एक या दो भाषाएँ चुनें।"

#: services.py:384
msgid "Nieznany język."
msgstr "अज्ञात भाषा।"

#: services.py:397
msgid "Nie można usunąć języka, w którym delegacja wysłała już tłumaczenie."
msgstr "जिस भाषा में प्रतिनिधिमंडल पहले ही अनुवाद भेज चुका है, उसे हटाया नहीं जा सकता।"

#: services.py:444
msgid "Ten język nie jest językiem delegacji."
msgstr "यह भाषा प्रतिनिधिमंडल की भाषा नहीं है।"

#: services.py:462 templates/problem_translations/leader/editor.html:145
msgid "Tłumaczenie jest zatwierdzone i zablokowane."
msgstr "अनुवाद स्वीकृत हो चुका है और लॉक है।"

#: services.py:464
msgid ""
"Tłumaczenie czeka na decyzję komisji – cofnij wysłanie, żeby je poprawić."
msgstr "अनुवाद समिति के निर्णय की प्रतीक्षा में है – इसे सुधारने के लिए भेजना वापस लें।"

#: services.py:500
msgid ""
"Tłumaczenie zmieniło się w międzyczasie (inny opiekun albo inna karta). "
"Skopiuj swój tekst i odśwież stronę."
msgstr "इस बीच अनुवाद बदल गया है (किसी अन्य टीम लीडर या किसी अन्य टैब से)। अपना पाठ कॉपी करें और पेज फिर से लोड करें।"

#: services.py:531 views_leader.py:386
msgid "Tekst jest za długi."
msgstr "पाठ बहुत लंबा है।"

#: services.py:538
msgid "Bieżące tłumaczenie to plik PDF – najpierw wybierz „Przejdź na tekst”."
msgstr "वर्तमान अनुवाद एक PDF फ़ाइल है – पहले “पाठ पर जाएँ” चुनें।"

#: services.py:572
msgid ""
"Nie udało się sprawdzić pliku programem antywirusowym. Spróbuj ponownie za "
"chwilę."
msgstr "फ़ाइल की एंटीवायरस से जाँच नहीं हो सकी। कृपया थोड़ी देर बाद फिर से प्रयास करें।"

#: services.py:578
msgid "Plik został odrzucony przez program antywirusowy."
msgstr "फ़ाइल को एंटीवायरस ने अस्वीकार कर दिया।"

#: services.py:598
msgid "Nie można odczytać pliku PDF (uszkodzony albo zaszyfrowany)."
msgstr "PDF फ़ाइल पढ़ी नहीं जा सकती (क्षतिग्रस्त या एन्क्रिप्टेड)।"

#: services.py:603
msgid "Plik ma za dużo stron."
msgstr "फ़ाइल में बहुत अधिक पृष्ठ हैं।"

#: services.py:651
msgid "Tłumaczenie jest puste."
msgstr "अनुवाद खाली है।"

#: services.py:656
#, python-format
msgid ""
"Wersja oficjalna zmieniła się, odkąd otworzono edytor (teraz wersja "
"%(version)s). Sprawdź zmiany poniżej i wyślij ponownie."
msgstr "संपादक खोलने के बाद आधिकारिक संस्करण बदल गया है (अब संस्करण %(version)s)। नीचे बदलाव देखें और फिर से भेजें।"

#: services.py:695
msgid "Tylko wysłane tłumaczenie można cofnąć."
msgstr "केवल भेजा गया अनुवाद ही वापस लिया जा सकता है।"

#: services.py:715
msgid ""
"Zatwierdzone tłumaczenie można otworzyć ponownie tylko po zmianie wersji "
"oficjalnej."
msgstr "स्वीकृत अनुवाद को केवल आधिकारिक संस्करण बदलने के बाद ही फिर से खोला जा सकता है।"

