msgstr "सहेजें"

#: templates/problem_translations/leader/dashboard.html:114
msgid "Nie zgłoszono jeszcze żadnego ucznia."
msgstr "अभी तक किसी विद्यार्थी का पंजीकरण नहीं हुआ है।"

#: templates/problem_translations/leader/editor.html:22
#: templates/problem_translations/leader/editor.html:28
