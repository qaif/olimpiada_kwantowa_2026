#: forms.py:19
msgid "Język 1 (domyślny dla uczniów)"
msgstr "Language 1 (default for students)"

#: forms.py:20
msgid "Język 2 (opcjonalnie)"
msgstr "Language 2 (optional)"

#: forms.py:33 forms.py:44
msgid "Tytuł zadania"
msgstr "Problem title"

#: forms.py:35
msgid "Treść (Markdown, wzory w $…$)"
msgstr "Text (Markdown, formulas in $…$)"

#: forms.py:43
msgid "Przetłumaczony PDF"
msgstr "Translated PDF"

#: services.py:380
msgid "Wybierz jeden albo dwa języki."
msgstr "Choose one or two languages."

#: services.py:384
msgid "Nieznany język."
msgstr "Unknown language."

#: services.py:397
msgid "Nie można usunąć języka, w którym delegacja wysłała już tłumaczenie."
msgstr ""
"You cannot remove a language in which the delegation has already submitted a "
"translation."

#: services.py:444
msgid "Ten język nie jest językiem delegacji."
msgstr "This language is not one of the delegation's languages."

#: services.py:462 templates/problem_translations/leader/editor.html:145
msgid "Tłumaczenie jest zatwierdzone i zablokowane."
msgstr "The translation is approved and locked."

#: services.py:464
msgid ""
"Tłumaczenie czeka na decyzję komisji – cofnij wysłanie, żeby je poprawić."
msgstr ""
"The translation is awaiting the committee's decision – withdraw the "
"submission to correct it."

#: services.py:500
msgid ""
"Tłumaczenie zmieniło się w międzyczasie (inny opiekun albo inna karta). "
"Skopiuj swój tekst i odśwież stronę."
msgstr "This translation has changed in the meantime (another team leader or another tab). Copy your text and reload the page."

#: services.py:531 views_leader.py:386
msgid "Tekst jest za długi."
msgstr "The text is too long."

#: services.py:538
msgid "Bieżące tłumaczenie to plik PDF – najpierw wybierz „Przejdź na tekst”."
msgstr "The current translation is a PDF file – choose “Switch to text” first."

#: services.py:572
msgid ""
"Nie udało się sprawdzić pliku programem antywirusowym. Spróbuj ponownie za "
"chwilę."
msgstr ""
"The file could not be checked by the antivirus scanner. Please try again in "
"a moment."

#: services.py:578
msgid "Plik został odrzucony przez program antywirusowy."
msgstr "The file was rejected by the antivirus scanner."

#: services.py:598
msgid "Nie można odczytać pliku PDF (uszkodzony albo zaszyfrowany)."
msgstr "The PDF file cannot be read (it is damaged or encrypted)."

#: services.py:603
msgid "Plik ma za dużo stron."
msgstr "The file has too many pages."

#: services.py:651
msgid "Tłumaczenie jest puste."
msgstr "The translation is empty."

#: services.py:656
#, python-format
msgid ""
"Wersja oficjalna zmieniła się, odkąd otworzono edytor (teraz wersja "
"%(version)s). Sprawdź zmiany poniżej i wyślij ponownie."
msgstr "The official version has changed since the editor was opened (now version %(version)s). Check the changes below and submit again."

#: services.py:695
msgid "Tylko wysłane tłumaczenie można cofnąć."
msgstr "Only a submitted translation can be withdrawn."

#: services.py:715
msgid ""
"Zatwierdzone tłumaczenie można otworzyć ponownie tylko po zmianie wersji "
"oficjalnej."
msgstr ""
"An approved translation can be reopened only after the official version has "
"changed."

#: templates/problem_translations/leader/_autosave.html:6
#: templates/problem_translations/leader/editor.html:124
#, python-format
msgid "Szkic zapisany: %(at)s"
msgstr "Draft saved: %(at)s"

#: templates/problem_translations/leader/_autosave.html:9
#: templates/problem_translations/leader/editor.html:126
