#: forms.py:19
msgid "Język 1 (domyślny dla uczniów)"
msgstr "Idioma 1 (predeterminado para los estudiantes)"

#: forms.py:20
msgid "Język 2 (opcjonalnie)"
msgstr "Idioma 2 (opcional)"

#: forms.py:33 forms.py:44
msgid "Tytuł zadania"
msgstr "Título del problema"

#: forms.py:35
msgid "Treść (Markdown, wzory w $…$)"
msgstr "Texto (Markdown, fórmulas entre $…$)"

#: forms.py:43
msgid "Przetłumaczony PDF"
msgstr "PDF traducido"

#: services.py:380
msgid "Wybierz jeden albo dwa języki."
msgstr "Elige uno o dos idiomas."

#: services.py:384
msgid "Nieznany język."
msgstr "Idioma desconocido."

#: services.py:397
msgid "Nie można usunąć języka, w którym delegacja wysłała już tłumaczenie."
msgstr ""
"No se puede eliminar un idioma en el que la delegación ya ha enviado una "
"traducción."

#: services.py:444
msgid "Ten język nie jest językiem delegacji."
msgstr "Este idioma no es un idioma de la delegación."

#: services.py:462 templates/problem_translations/leader/editor.html:145
msgid "Tłumaczenie jest zatwierdzone i zablokowane."
msgstr "La traducción está aprobada y bloqueada."

#: services.py:464
msgid ""
"Tłumaczenie czeka na decyzję komisji – cofnij wysłanie, żeby je poprawić."
msgstr ""
"La traducción está pendiente de la decisión de la comisión: retira el envío "
"para corregirla."

#: services.py:500
msgid ""
"Tłumaczenie zmieniło się w międzyczasie (inny opiekun albo inna karta). "
"Skopiuj swój tekst i odśwież stronę."
msgstr "La traducción ha cambiado mientras tanto (otro líder de equipo u otra pestaña). Copia tu texto y recarga la página."

#: services.py:531 views_leader.py:386
msgid "Tekst jest za długi."
msgstr "El texto es demasiado largo."

#: services.py:538
msgid "Bieżące tłumaczenie to plik PDF – najpierw wybierz „Przejdź na tekst”."
msgstr "La traducción actual es un archivo PDF: primero elige «Pasar a texto»."

#: services.py:572
msgid ""
"Nie udało się sprawdzić pliku programem antywirusowym. Spróbuj ponownie za "
"chwilę."
msgstr ""
"No se ha podido analizar el archivo con el antivirus. Inténtalo de nuevo en "
"un momento."

#: services.py:578
msgid "Plik został odrzucony przez program antywirusowy."
msgstr "El antivirus ha rechazado el archivo."

#: services.py:598
msgid "Nie można odczytać pliku PDF (uszkodzony albo zaszyfrowany)."
msgstr "No se puede leer el archivo PDF (está dañado o cifrado)."

#: services.py:603
msgid "Plik ma za dużo stron."
msgstr "El archivo tiene demasiadas páginas."

#: services.py:651
msgid "Tłumaczenie jest puste."
msgstr "La traducción está vacía."

#: services.py:656
#, python-format
msgid ""
"Wersja oficjalna zmieniła się, odkąd otworzono edytor (teraz wersja "
"%(version)s). Sprawdź zmiany poniżej i wyślij ponownie."
msgstr "La versión oficial ha cambiado desde que se abrió el editor (ahora versión %(version)s). Revisa los cambios abajo y envía de nuevo."

#: services.py:695
msgid "Tylko wysłane tłumaczenie można cofnąć."
msgstr "Solo se puede retirar una traducción enviada."

#: services.py:715
msgid ""
"Zatwierdzone tłumaczenie można otworzyć ponownie tylko po zmianie wersji "
"oficjalnej."
msgstr ""
"Una traducción aprobada solo se puede reabrir después de un cambio en la "
"versión oficial."

#: templates/problem_translations/leader/_autosave.html:6
#: templates/problem_translations/leader/editor.html:124
#, python-format
msgid "Szkic zapisany: %(at)s"
msgstr "Borrador guardado: %(at)s"

#: templates/problem_translations/leader/_autosave.html:9
#: templates/problem_translations/leader/editor.html:126
msgid "Podgląd"
msgstr "Vista previa"

#: templates/problem_translations/leader/_status.html:1
