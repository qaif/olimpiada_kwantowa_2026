msgstr "মেমরি সীমা (MB)"

msgid "widoczność wyników testów ukrytych"
msgstr "লুকানো পরীক্ষার ফলাফলের দৃশ্যমানতা"

msgid "zmieniono"
msgstr "পরিবর্তিত"

msgid "notatnik zadania"
msgstr "প্রশ্নের নোটবুক"

msgid "notatniki zadań"
msgstr "প্রশ্নের নোটবুকগুলো"

msgid "w kolejce"
msgstr "সারিতে"

msgid "sprawdzanie"
msgstr "যাচাই চলছে"

