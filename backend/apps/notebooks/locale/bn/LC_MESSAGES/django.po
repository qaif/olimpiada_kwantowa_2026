msgid "Tryb"
msgstr "মোড"

msgid "Język treści notatnika"
msgstr "নোটবুকের বিষয়বস্তুর ভাষা"

msgid ""
"Język notatnika startowego i komunikatów testów. Interfejs JupyterLab jest "
"angielski."
msgstr ""
"স্টার্টার নোটবুক ও পরীক্ষার বার্তার ভাষা। JupyterLab ইন্টারফেস ইংরেজিতে।"

msgid "Limit czasu wykonania (s)"
msgstr "চালানোর সময়সীমা (সে.)"

msgid "Limit pamięci (MB)"
msgstr "মেমরি সীমা (MB)"

msgid "Kto widzi wynik testów ukrytych"
msgstr "লুকানো পরীক্ষার ফল কে দেখে"

msgid ""
"„Od razu” daje uczestnikowi wyrocznię: może wysyłać kolejne wersje i "
"patrzeć, które testy ukryte przechodzą. Wybieraj to wyłącznie na etapach "
"treningowych."
msgstr ""
"“সঙ্গে সঙ্গে” অংশগ্রহণকারীকে একটি ওরাকল দেয়: সে নতুন সংস্করণ পাঠিয়ে দেখতে "
"পারে কোন লুকানো পরীক্ষা পাস করছে। শুধু অনুশীলন পর্বে বেছে নিন।"

msgid "Notatnik startowy (.ipynb)"
msgstr "স্টার্টার নোটবুক (.ipynb)"

msgid ""
"Puste = zostaje obecny (albo generowany szablon). Wyjścia komórek zostaną "
"wyczyszczone."
msgstr ""
"খালি = বর্তমানটি থাকবে (অথবা তৈরি করা টেমপ্লেট)। সেলের আউটপুট মুছে ফেলা হবে।"

msgid "Usuń wgrany notatnik startowy (użyj szablonu)"
msgstr "আপলোড করা স্টার্টার নোটবুক মুছুন (টেমপ্লেট ব্যবহার করুন)"

msgid "Notatnik wzorcowy (.ipynb)"
msgstr "রেফারেন্স নোটবুক (.ipynb)"

msgid ""
"Twoje rozwiązanie – służy wyłącznie do sprawdzenia testów. Uczestnicy go nie"
" widzą."
msgstr ""
"আপনার সমাধান – শুধু পরীক্ষা যাচাইয়ের জন্য। অংশগ্রহণকারীরা এটি দেখে না।"

msgid "Testy widoczne (JSON)"
msgstr "দৃশ্যমান পরীক্ষা (JSON)"

msgid ""
"Trafiają do notatnika uczestnika – uczestnik widzi je i uruchamia w "
"przeglądarce."
msgstr ""
"এগুলো অংশগ্রহণকারীর নোটবুকে যায় – সে এগুলো দেখে এবং ব্রাউজারে চালায়।"

msgid "Testy ukryte (JSON)"
msgstr "লুকানো পরীক্ষা (JSON)"

msgid ""
"Liczone wyłącznie na serwerze. Nigdy nie trafiają do przeglądarki "
"uczestnika."
msgstr "শুধু সার্ভারে গণনা হয়। কখনো অংশগ্রহণকারীর ব্রাউজারে পৌঁছায় না।"

msgid "To musi być plik .ipynb."
msgstr "এটি অবশ্যই .ipynb ফাইল হতে হবে।"

msgid "Notatnik jest za duży (najwyżej 1 MB)."
msgstr "নোটবুকটি খুব বড় (সর্বোচ্চ ১ MB)।"

msgid "To nie jest poprawny notatnik Jupytera (nbformat 4)."
msgstr "এটি বৈধ Jupyter নোটবুক নয় (nbformat 4)।"

msgid "Notatnik swobodny (ocenia komisja)"
msgstr "মুক্ত নোটবুক (কমিটি মূল্যায়ন করে)"

msgid "Sprawdzanie automatyczne (testy)"
msgstr "স্বয়ংক্রিয় যাচাই (পরীক্ষা)"

msgid "Tylko organizator i komisja"
msgstr "শুধু আয়োজক ও কমিটি"

msgid "Uczestnik po zamknięciu etapu"
msgstr "পর্ব বন্ধ হওয়ার পর অংশগ্রহণকারী"

msgid "Uczestnik od razu (zalecane tylko na etapach treningowych)"
msgstr "অংশগ্রহণকারী সঙ্গে সঙ্গে (শুধু অনুশীলন পর্বে প্রস্তাবিত)"

