msgstr "الخطوة"

msgid "Uczestnicy"
msgstr "المشاركون"

msgid "względem rejestracji"
msgstr "مقارنة بالتسجيلات"

msgid "brak takiego etapu w tej edycji"
msgstr "لا توجد مرحلة كهذه في هذه الدورة"

msgid "Zgoda opiekuna jest wymagana od niepełnoletnich według tej samej reguły wieku, co przy rejestracji."
msgstr "تُطلب موافقة ولي الأمر من القاصرين وفق قاعدة العمر نفسها المطبقة عند التسجيل."

msgid "Gdzie odpadają – najniższa aktywacja kont"
msgstr "أين يتسربون – أدنى تفعيل للحسابات"

msgid "Województwa"
msgstr "المحافظات"

msgid "Województwa – najniższa aktywacja"
msgstr "المحافظات – أدنى تفعيل"

msgid "Szkoły"
msgstr "المدارس"

msgid "Szkoły – najniższa aktywacja"
msgstr "المدارس – أدنى تفعيل"

#, python-format
msgid "Województwa i szkoły z co najmniej %(k)s rejestracjami, od najniższego odsetka aktywowanych kont."
msgstr "المحافظات والمدارس التي لديها %(k)s تسجيلات على الأقل، بدءًا من أدنى نسبة حسابات مفعّلة."

