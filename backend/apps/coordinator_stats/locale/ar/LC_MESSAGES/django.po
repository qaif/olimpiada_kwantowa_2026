msgstr "أول تسجيل دخول"

msgid "Zgody (w tym zgoda opiekuna niepełnoletniego)"
msgstr "الموافقات (بما فيها موافقة ولي أمر القاصر)"

msgid "Zapis do etapu edycji"
msgstr "التسجيل في مرحلة من الدورة"

msgid "w tym etap treningowy"
msgstr "منها مرحلة التدريب"

