msgid "Kiedy"
msgstr "متى"

msgid "Żaden list tego komunikatu nie wrócił."
msgstr "لم ترتد أي رسالة من هذا الإرسال."

#, python-format
msgid "Listy odrzucone przez Microsoft z powodu blokady adresu IP serwera (S3150): %(n)s."
msgstr "رسائل رفضتها Microsoft بسبب حظر عنوان IP للخادم (S3150): %(n)s."

#, python-format
msgid "Pokazano pierwsze %(n)s adresów – pełne liczby są w tabeli powyżej."
msgstr "تُعرض أول %(n)s عنوانًا – الأرقام الكاملة في الجدول أعلاه."

msgid "Lejek uczestnika"
msgstr "مسار المشاركين"

msgid "panel koordynatora"
msgstr "لوحة المنسق"

msgid "Liczby dotyczą uczestników wybranej edycji: zapisanych do jej etapu albo zarejestrowanych w czasie jej trwania. Konta usunięte nie są liczone."
msgstr "تخص الأرقام مشاركي الدورة المختارة: المسجلين في إحدى مراحلها أو الذين سجّلوا أثناءها. لا تُحتسب الحسابات المحذوفة."

msgid "Eksport CSV"
msgstr "تصدير CSV"

msgid "Ten konkurs nie ma jeszcze żadnej edycji."
msgstr "لا توجد لهذه المسابقة أي دورة بعد."

msgid "Filtry lejka"
msgstr "مرشحات المسار"

msgid "Edycja"
msgstr "الدورة"

msgid "Pokaż"
msgstr "عرض"

msgid "Wyczyść filtry"
msgstr "مسح المرشحات"

