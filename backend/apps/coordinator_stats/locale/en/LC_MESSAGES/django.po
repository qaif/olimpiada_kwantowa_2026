msgid "Początek okresu rejestracji jest późniejszy niż jego koniec."
msgstr "The start of the registration period is later than its end."

msgid "lejek ścisły – krok wymaga wszystkich poprzednich"
msgstr "strict funnel – a step requires all previous ones"

msgid "kroki niezależne"
msgstr "independent steps"

msgid "Rejestracja (profil uczestnika)"
msgstr "Registration (participant profile)"

msgid "Aktywacja konta (potwierdzony adres e-mail)"
msgstr "Account activation (confirmed e-mail address)"

msgid "Pierwsze logowanie"
msgstr "First login"

msgid "Zgody (w tym zgoda opiekuna niepełnoletniego)"
msgstr "Consents (including a minor’s guardian consent)"

msgid "Zapis do etapu edycji"
msgstr "Enrolment in a stage of the edition"

msgid "w tym etap treningowy"
msgstr "of which the training stage"

msgid "w tym Etap I"
msgstr "of which Stage I"

msgid "Pierwsza wysłana praca"
msgstr "First work submitted"

msgid "Zaświadczenie o statusie ucznia zaakceptowane"
