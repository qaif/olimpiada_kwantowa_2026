msgid "Sposób liczenia"
msgstr "Способ подсчёта"

msgid "Początek okresu rejestracji jest późniejszy niż jego koniec."
msgstr "Начало периода регистрации позже его конца."

msgid "lejek ścisły – krok wymaga wszystkich poprzednich"
msgstr "строгая воронка – шаг требует всех предыдущих"

msgid "kroki niezależne"
msgstr "независимые шаги"

msgid "Rejestracja (profil uczestnika)"
msgstr "Регистрация (профиль участника)"

msgid "Aktywacja konta (potwierdzony adres e-mail)"
msgstr "Активация аккаунта (подтверждённый e-mail)"

msgid "Pierwsze logowanie"
msgstr "Первый вход"

msgid "Zgody (w tym zgoda opiekuna niepełnoletniego)"
msgstr "Согласия (включая согласие опекуна несовершеннолетнего)"

msgid "Zapis do etapu edycji"
msgstr "Запись на этап сезона"

msgid "w tym etap treningowy"
msgstr "в том числе тренировочный этап"

msgid "w tym Etap I"
msgstr "в том числе этап I"

msgid "Pierwsza wysłana praca"
msgstr "Первая отправленная работа"

msgid "Zaświadczenie o statusie ucznia zaakceptowane"
msgstr "Справка о статусе ученика принята"

msgid "Obecność na co najmniej jednym warsztacie"
msgstr "Присутствие хотя бы на одном мастер-классе"

msgid "brak szkoły"
msgstr "без школы"

msgid "nazwa wpisana ręcznie"
msgstr "название введено вручную"

msgid "brak województwa"
msgstr "без воеводства"

