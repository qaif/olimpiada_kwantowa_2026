msgstr "dont S3150"

msgid "Tymczasowe i inne"
msgstr "Temporaires et autres"

msgid "Wysłane / odbite"
msgstr "Envoyés / rejetés"

msgid "Razem"
msgstr "Total"

msgid "Górny słupek – listy zakolejkowane, dolny – odbite; oba w tej samej skali. Odbicia przychodzą przez kilka dni po wysyłce (serwery ponawiają doręczenie), więc liczby mogą jeszcze rosnąć."
msgstr "Barre du haut – lettres mises en file, barre du bas – rejetées ; les deux à la même échelle. Les rejets arrivent pendant plusieurs jours après l’envoi (les serveurs réessaient la distribution), les chiffres peuvent donc encore augmenter."

msgid "Odbite adresy"
msgstr "Adresses rejetées"

msgid "Adres"
msgstr "Adresse"

msgid "Rodzaj"
msgstr "Type"

msgid "Kod"
msgstr "Code"

msgid "Powód (odpowiedź serwera odbiorcy)"
msgstr "Motif (réponse du serveur du destinataire)"

msgid "Kiedy"
msgstr "Quand"

msgid "Żaden list tego komunikatu nie wrócił."
msgstr "Aucune lettre de ce message n’a été rejetée."

#, python-format
msgid "Listy odrzucone przez Microsoft z powodu blokady adresu IP serwera (S3150): %(n)s."
msgstr "Lettres refusées par Microsoft en raison du blocage de l’adresse IP du serveur (S3150) : %(n)s."

#, python-format
msgid "Pokazano pierwsze %(n)s adresów – pełne liczby są w tabeli powyżej."
msgstr "Affichage des %(n)s premières adresses – les chiffres complets sont dans le tableau ci-dessus."

msgid "Lejek uczestnika"
msgstr "Entonnoir des participants"

msgid "panel koordynatora"
msgstr "panneau du coordinateur"

msgid "Ilu uczestników przechodzi kolejne kroki – od rejestracji, przez aktywację konta i zapis do etapu, do pierwszej pracy, zaświadczenia i warsztatów."
msgstr "Combien de participants franchissent chaque étape – de l’inscription, l’activation du compte et l’inscription à une épreuve jusqu’au premier travail, à l’attestation et aux ateliers."

msgid "Liczby dotyczą uczestników wybranej edycji: zapisanych do jej etapu albo zarejestrowanych w czasie jej trwania. Konta usunięte nie są liczone."
msgstr "Les chiffres concernent les participants de l’édition choisie : inscrits à l’une de ses épreuves ou enregistrés pendant sa durée. Les comptes supprimés ne sont pas comptés."

msgid "Eksport CSV"
msgstr "Export CSV"

msgid "Ten konkurs nie ma jeszcze żadnej edycji."
msgstr "Ce concours n’a encore aucune édition."

msgid "Filtry lejka"
msgstr "Filtres de l’entonnoir"

msgid "Edycja"
msgstr "Édition"

msgid "Pokaż"
msgstr "Afficher"

msgid "Wyczyść filtry"
msgstr "Effacer les filtres"

msgid "Kroki lejka"
msgstr "Étapes de l’entonnoir"

msgid "Krok"
msgstr "Étape"

msgid "Uczestnicy"
msgstr "Participants"

msgid "względem poprzedniego kroku"
msgstr "par rapport à l’étape précédente"

msgid "względem rejestracji"
msgstr "par rapport aux inscriptions"

msgid "brak takiego etapu w tej edycji"
msgstr "pas d’épreuve de ce type dans cette édition"

msgid "Lejek ścisły: krok liczy osoby, które przeszły także wszystkie poprzednie kroki. Wiersze „w tym” rozbijają zapis do etapu i liczą się względem kroku zgód."
msgstr "Entonnoir strict : une étape compte les personnes qui ont aussi franchi toutes les étapes précédentes. Les lignes « dont » détaillent l’inscription à une épreuve et sont rapportées à l’étape des consentements."

msgid "Kroki niezależne: każdy krok liczy wszystkich, którzy spełniają jego warunek – także bez poprzednich kroków (np. obecni na warsztacie bez zaakceptowanego zaświadczenia)."
msgstr "Étapes indépendantes : chaque étape compte toutes les personnes qui remplissent sa condition – même sans les étapes précédentes (p. ex. présentes à un atelier sans attestation acceptée)."

msgid "Zgoda opiekuna jest wymagana od niepełnoletnich według tej samej reguły wieku, co przy rejestracji."
msgstr "Le consentement du représentant légal est exigé des mineurs selon la même règle d’âge qu’à l’inscription."

msgid "Gdzie odpadają – najniższa aktywacja kont"
msgstr "Où ils décrochent – activation des comptes la plus faible"

msgid "Województwa"
msgstr "Voïvodies"

msgid "Województwa – najniższa aktywacja"
msgstr "Voïvodies – activation la plus faible"

msgid "Szkoły"
msgstr "Écoles"

msgid "Szkoły – najniższa aktywacja"
msgstr "Écoles – activation la plus faible"

#, python-format
msgid "Województwa i szkoły z co najmniej %(k)s rejestracjami, od najniższego odsetka aktywowanych kont."
msgstr "Voïvodies et écoles avec au moins %(k)s inscriptions, de la plus faible part de comptes activés."

