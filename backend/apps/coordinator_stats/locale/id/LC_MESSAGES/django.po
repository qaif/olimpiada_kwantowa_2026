msgid "Rejestracje"
msgstr "Pendaftaran"

msgid "Logowanie"
msgstr "Login"

msgid "Aktywacja"
msgstr "Aktivasi"

msgid "Brak grup powyżej progu."
msgstr "Tidak ada kelompok di atas ambang batas."

msgid "Raport wysyłki"
msgstr "Laporan pengiriman"

msgid "Raport wysyłki komunikatu"
msgstr "Laporan pengiriman pesan"

msgid "Wysłany"
msgstr "Dikirim"

msgid "Stan"
msgstr "Status"

