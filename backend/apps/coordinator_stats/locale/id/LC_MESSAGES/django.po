msgstr "Pendaftaran (profil peserta)"

msgid "Aktywacja konta (potwierdzony adres e-mail)"
msgstr "Aktivasi akun (alamat surel dikonfirmasi)"

msgid "Pierwsze logowanie"
msgstr "Login pertama"

