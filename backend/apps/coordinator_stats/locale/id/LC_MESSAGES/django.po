msgstr "terhadap pendaftaran"

msgid "brak takiego etapu w tej edycji"
msgstr "tidak ada tahap seperti itu di edisi ini"

msgid "Zgoda opiekuna jest wymagana od niepełnoletnich według tej samej reguły wieku, co przy rejestracji."
msgstr "Persetujuan wali diperlukan dari peserta di bawah umur menurut aturan usia yang sama seperti saat pendaftaran."

msgid "Gdzie odpadają – najniższa aktywacja kont"
msgstr "Di mana mereka berhenti – aktivasi akun terendah"

msgid "Województwa"
msgstr "Provinsi"

msgid "Województwa – najniższa aktywacja"
msgstr "Provinsi – aktivasi terendah"

msgid "Szkoły"
msgstr "Sekolah"

msgid "Szkoły – najniższa aktywacja"
msgstr "Sekolah – aktivasi terendah"

#, python-format
msgid "Województwa i szkoły z co najmniej %(k)s rejestracjami, od najniższego odsetka aktywowanych kont."
msgstr "Provinsi dan sekolah dengan sedikitnya %(k)s pendaftaran, dari persentase akun aktif terendah."

