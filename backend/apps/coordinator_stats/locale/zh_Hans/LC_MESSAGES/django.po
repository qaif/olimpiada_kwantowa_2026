msgstr "此消息没有发送数据——报告仅适用于2026年10月18日起发送的消息。"

msgid "Odbiorców"
msgstr "收件人"

msgid "Obsłużono"
msgstr "已处理"

msgid "To nie jest problem adresów odbiorców, tylko reputacji serwera poczty – zgłoś to operatorowi platformy (wniosek o zdjęcie blokady w Microsoft)."
msgstr "这不是收件人地址的问题，而是邮件服务器信誉的问题——请报告平台运营方（向微软申请解除封锁）。"

msgid "Zakolejkowano"
msgstr "已排队"

msgid "Pominięto (adres niedoręczalny)"
msgstr "已跳过（无法投递的地址）"

msgid "Odbite po wysyłce"
msgstr "发送后退回"

msgid "Grupy domen"
msgstr "域名组"

msgid "Domena"
msgstr "域名"

msgid "Pominięto"
msgstr "已跳过"

msgid "Adres nie istnieje"
msgstr "地址不存在"

