msgstr "hanya daftar yang lolos yang diumumkan"

msgid "W tej edycji żaden etap nie ma jeszcze ogłoszonych wyników."
msgstr "Belum ada tahap pada edisi ini yang hasilnya diumumkan."

msgid "Postęp w kolejnych edycjach"
msgstr "Perkembangan dari edisi ke edisi"

msgid "Średnia punktów w pierwszym etapie edycji z ogłoszoną pełną tabelą wyników."
msgstr "Rata-rata poin pada tahap pertama edisi yang tabel hasilnya diumumkan lengkap."

msgid "Średnia punktów w kolejnych edycjach"
msgstr "Rata-rata poin dari edisi ke edisi"

msgid "Moich uczniów"
msgstr "Siswa saya"

#, python-format
msgid "„—” oznacza brak ogłoszonych wyników albo grupę ukrytą, bo liczy mniej niż %(k)s osób."
msgstr "“—” berarti tidak ada hasil yang diumumkan atau kelompok disembunyikan karena beranggotakan kurang dari %(k)s orang."

msgid "Brak danych z poprzednich edycji."
msgstr "Tidak ada data dari edisi sebelumnya."

