#, python-format
msgid "mniej niż %(k)s uczestników – dane ukryte"
msgstr "kurang dari %(k)s peserta – data disembunyikan"

msgid "Raport szkoły"
msgstr "Laporan sekolah"

#, python-format
msgid "Edycja: %(edition)s · stan na %(date)s"
msgstr "Edisi: %(edition)s · per %(date)s"

