msgstr "inscriptions"

msgid "średnia"
msgstr "moyenne"

msgid "zakwalifikowani"
msgstr "qualifiés"

msgid "Statystyki szkół"
msgstr "Statistiques des établissements"

msgid "Te same wartości stoją w tabeli pod wykresem."
msgstr "Les mêmes valeurs figurent dans le tableau sous le graphique."

#, python-format
msgid "grupa ukryta – mniej niż %(k)s osób"
msgstr "groupe masqué – moins de %(k)s personnes"

msgid "panel koordynatora"
msgstr "espace coordinateur"

msgid "Udział szkół w edycji, porównanie z poprzednią edycją i – po ogłoszeniu wyników – średnie oraz liczba zakwalifikowanych."
msgstr "Participation des établissements à l’édition, comparaison avec l’édition précédente et – après publication des résultats – moyennes et nombre de qualifiés."

#, python-format
msgid "Średnie i liczby zakwalifikowanych grup mniejszych niż %(k)s wpisów są ukryte – także w eksporcie CSV i w raportach PDF."
msgstr "Les moyennes et le nombre de qualifiés des groupes de moins de %(k)s inscriptions sont masqués – y compris dans l’export CSV et les rapports PDF."

msgid "Eksport CSV"
msgstr "Export CSV"

msgid "Ten konkurs nie ma jeszcze żadnej edycji."
msgstr "Ce concours n’a encore aucune édition."

msgid "Kolejność"
msgstr "Ordre"

msgid "Pokaż"
msgstr "Afficher"

msgid "Szkoły z uczestnikami"
msgstr "Établissements avec participants"

#, python-format
msgid "Szkoły w edycji %(edition)s"
msgstr "Établissements de l’édition %(edition)s"

msgid "Szkoły bez uczestników w tej edycji"
msgstr "Établissements sans participant à cette édition"

msgid "Ranking szkół"
msgstr "Classement des établissements"

