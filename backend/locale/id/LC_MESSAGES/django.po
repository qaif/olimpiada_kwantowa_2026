#: apps/accounts/supervisor_consent.py:88
msgid "Prośba o zgodę na opiekuna szkolnego – Olimpiada Kwantowa"
msgstr "Permintaan persetujuan pembimbing sekolah – Olimpiade Kuantum"

#: apps/accounts/supervisor_consent.py:89
#, python-format
msgid "Prośba o zgodę na opiekuna szkolnego – %(competition)s"
msgstr "Permintaan persetujuan pembimbing sekolah – %(competition)s"

#: apps/accounts/supervisor_consent.py:97
msgid ""
"Link z prośbą o zgodę jest nieprawidłowy, wygasł albo jest już nieaktualny."
msgstr ""
"Tautan permintaan persetujuan tidak valid, sudah kedaluwarsa, atau tidak berlaku lagi."

#: apps/accounts/supervisor_consent.py:100
msgid ""
"Ta prośba jest adresowana do innego konta. Zaloguj się na konto, na które przyszedł list."
msgstr ""
"Permintaan ini ditujukan untuk akun lain. Masuklah ke akun yang menerima e-mail ini."

#: apps/accounts/twofactor.py:398
msgid "Najpierw zeskanuj kod QR – konfiguracja nie została rozpoczęta."
msgstr "Pindai kode QR terlebih dahulu – konfigurasi belum dimulai."

#: apps/accounts/twofactor.py:400
msgid "Drugi składnik jest już włączony na tym koncie."
msgstr "Verifikasi dua langkah sudah aktif di akun ini."

#: apps/accounts/twofactor.py:404
msgid ""
"Kod z aplikacji nie pasuje. Sprawdź, czy zegar w telefonie jest ustawiony automatycznie."
msgstr ""
"Kode dari aplikasi tidak cocok. Pastikan jam di ponsel Anda diatur secara otomatis."

#: apps/accounts/twofactor.py:608
msgid "Wymagane potwierdzenie drugiego składnika logowania."
msgstr "Diperlukan konfirmasi verifikasi dua langkah."

