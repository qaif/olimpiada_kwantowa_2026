msgstr "Anda tidak mengumpulkan jawaban untuk soal ini."

#: templates/web/participant/feedback.html:75
msgid "Recenzenci nie zostawili komentarza do tego zadania."
msgstr "Peninjau tidak meninggalkan komentar untuk soal ini."

