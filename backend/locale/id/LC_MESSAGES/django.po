#: apps/accounts/activation.py:80
msgid "Aktywuj konto – Olimpiada Kwantowa"
msgstr "Aktifkan akun Anda – Olimpiade Kuantum"

#: apps/accounts/activation.py:81
msgid "Potwierdź nowy adres e-mail – Olimpiada Kwantowa"
msgstr "Konfirmasi alamat e-mail baru Anda – Olimpiade Kuantum"

#: apps/accounts/activation.py:82
msgid "Adres e-mail konta został zmieniony – Olimpiada Kwantowa"
msgstr "Alamat e-mail akun telah diubah – Olimpiade Kuantum"

#: apps/accounts/activation.py:88
#, python-format
msgid "Aktywuj konto – %(competition)s"
msgstr "Aktifkan akun Anda – %(competition)s"

#: apps/accounts/activation.py:89
#, python-format
msgid "Potwierdź nowy adres e-mail – %(competition)s"
msgstr "Konfirmasi alamat e-mail baru Anda – %(competition)s"

#: apps/accounts/activation.py:90
#, python-format
msgid "Adres e-mail konta został zmieniony – %(competition)s"
msgstr "Alamat e-mail akun telah diubah – %(competition)s"

#: apps/accounts/activation.py:97
#, python-format
msgid ""
"Konto zostało założone. Sprawdź skrzynkę e-mail (także spam) i kliknij link aktywacyjny – bez tego logowanie nie zadziała. Link jest ważny %(hours)s godziny – po tym czasie konto zostanie usunięte i trzeba zarejestrować się ponownie."
msgstr ""
"Akun telah dibuat. Periksa kotak masuk e-mail Anda (termasuk folder spam) dan klik tautan aktivasi – tanpa itu Anda tidak dapat masuk. Tautan berlaku selama %(hours)s jam – setelah itu akun akan dihapus dan Anda harus mendaftar ulang."

#: apps/accounts/activation.py:115
msgid ""
"Jeśli konto z tym adresem istnieje i czeka na aktywację, link został wysłany ponownie. Sprawdź też folder ze spamem."
msgstr ""
"Jika ada akun dengan alamat ini yang menunggu aktivasi, tautan telah dikirim ulang. Periksa juga folder spam."

#: apps/accounts/activation.py:119
msgid "Link aktywacyjny jest nieprawidłowy albo wygasł."
msgstr "Tautan aktivasi tidak valid atau sudah kedaluwarsa."

#: apps/accounts/activation.py:272 apps/accounts/supervisor_consent.py:213
#: apps/accounts/supervisor_consent.py:256 apps/submissions/notifications.py:85
#: templates/registration/invite_student_body.txt:30
msgid "Olimpiada Kwantowa"
msgstr "Olimpiade Kuantum"

#: apps/accounts/activation.py:273 apps/submissions/notifications.py:86
#: templates/registration/invite_student_body.txt:31
#: templates/registration/password_reset_email.txt:26
#: templates/registration/supervisor_consent_body.txt:47
msgid "Wiadomość wysłana automatycznie; prosimy na nią nie odpowiadać."
msgstr "Pesan ini dikirim secara otomatis; mohon tidak membalasnya."

#: apps/accounts/activation.py:281
msgid ""
"Ktoś – prawdopodobnie Ty – założył konto w serwisie Olimpiady Kwantowej."
msgstr ""
"Seseorang – kemungkinan besar Anda – telah membuat akun di situs Olimpiade Kuantum."

#: apps/accounts/activation.py:283
msgid "Aby aktywować konto i móc się zalogować, otwórz poniższy adres:"
msgstr "Untuk mengaktifkan akun dan dapat masuk, buka alamat di bawah ini:"

#: apps/accounts/activation.py:288
#, python-format
msgid ""
"Link jest ważny %(hours)s godziny. Po tym czasie konto zostanie usunięte i rejestrację trzeba będzie powtórzyć."
msgstr ""
"Tautan berlaku selama %(hours)s jam. Setelah itu akun akan dihapus dan pendaftaran harus diulang."

#: apps/accounts/activation.py:294
msgid ""
"Jeśli to nie Ty zakładałeś konto – zignoruj tę wiadomość. Bez kliknięcia w link konto nie zostanie aktywowane i zniknie samo."
msgstr ""
"Jika bukan Anda yang membuat akun ini, abaikan pesan ini. Tanpa mengklik tautan, akun tidak akan diaktifkan dan akan terhapus dengan sendirinya."

#: apps/accounts/activation.py:307
#, python-format
msgid ""
"Poproszono o zmianę adresu e-mail konta w serwisie Olimpiady Kwantowej na %(email)s."
msgstr ""
"Ada permintaan untuk mengubah alamat e-mail akun Olimpiade Kuantum Anda menjadi %(email)s."

#: apps/accounts/activation.py:310
msgid "Aby potwierdzić nowy adres, otwórz poniższy adres:"
msgstr "Untuk mengonfirmasi alamat baru, buka tautan di bawah ini:"

#: apps/accounts/activation.py:314
msgid ""
"Do potwierdzenia obowiązuje dotychczasowy adres – logowanie działa bez zmian."
msgstr ""
"Sampai Anda mengonfirmasi, alamat saat ini tetap berlaku – Anda dapat masuk seperti biasa."

#: apps/accounts/activation.py:315
msgid "Link jest ważny 24 godziny."
msgstr "Tautan berlaku selama 24 jam."

#: apps/accounts/activation.py:317
msgid "Jeśli to nie Ty prosiłeś o zmianę – zignoruj tę wiadomość."
msgstr "Jika Anda tidak meminta perubahan ini, abaikan pesan ini."

#: apps/accounts/activation.py:333
#, python-format
msgid ""
"Adres e-mail konta w serwisie Olimpiady Kwantowej został zmieniony na %(email)s. Logowanie tym adresem przestaje działać."
msgstr ""
"Alamat e-mail akun Olimpiade Kuantum Anda telah diubah menjadi %(email)s. Anda tidak dapat lagi masuk dengan alamat sebelumnya."

#: apps/accounts/activation.py:338
msgid ""
"Jeśli to nie Ty dokonałeś zmiany, natychmiast skontaktuj się z organizatorem."
msgstr ""
"Jika bukan Anda yang melakukan perubahan ini, segera hubungi penyelenggara."

#: apps/accounts/activation.py:537
msgid "To konto jest już aktywne – możesz się zalogować."
msgstr "Akun ini sudah aktif – Anda dapat masuk."

#: apps/accounts/admin.py:34
msgid "Personal info"
msgstr "Info pribadi"

#: apps/accounts/admin.py:36
msgid "Permissions"
msgstr "Izin"

#: apps/accounts/admin.py:39
msgid "Important dates"
msgstr "Tanggal penting"

#: apps/accounts/bulk_registration.py:124
msgid "Link z zaproszeniem jest nieprawidłowy albo wygasł."
msgstr "Tautan undangan tidak valid atau sudah kedaluwarsa."

#: apps/accounts/bulk_registration.py:290
msgid ""
"adres ma już konto – jeśli to uczeń tego konkursu, dostanie prośbę o zgodę na dopisanie opiekuna"
msgstr ""
"alamat ini sudah memiliki akun – jika milik pelajar kompetisi ini, mereka akan diminta menyetujui penambahan pembimbing"

#: apps/accounts/guardian.py:62
msgid "Prośba o zgodę opiekuna – Olimpiada Kwantowa"
msgstr "Permintaan persetujuan wali – Olimpiade Kuantum"

#: apps/accounts/guardian.py:63
msgid "Zgoda opiekuna została potwierdzona – Olimpiada Kwantowa"
msgstr "Persetujuan wali telah dikonfirmasi – Olimpiade Kuantum"

#: apps/accounts/guardian.py:67
#, python-format
msgid "Prośba o zgodę opiekuna – %(competition)s"
msgstr "Permintaan persetujuan wali – %(competition)s"

#: apps/accounts/guardian.py:68
#, python-format
msgid "Zgoda opiekuna została potwierdzona – %(competition)s"
msgstr "Persetujuan wali telah dikonfirmasi – %(competition)s"

#: apps/accounts/guardian.py:70
msgid "Link do formularza zgody jest nieprawidłowy albo wygasł."
msgstr "Tautan ke formulir persetujuan tidak valid atau sudah kedaluwarsa."

#: apps/accounts/guardian.py:189
msgid ""
"Uczennica lub uczeń podał ten adres jako kontakt do rodzica albo opiekuna prawnego w zgłoszeniu do Olimpiady Kwantowej."
msgstr ""
"Seorang pelajar mencantumkan alamat ini sebagai kontak orang tua atau wali sah dalam pendaftarannya ke Olimpiade Kuantum."

#: apps/accounts/guardian.py:193
#, python-format
msgid "Zgłoszenie dotyczy: %(name)s (%(school)s)."
msgstr "Pendaftaran ini atas nama: %(name)s (%(school)s)."

#: apps/accounts/guardian.py:196
msgid ""
"Udział osoby niepełnoletniej wymaga zgody opiekuna. Treść zgody i formularz potwierdzenia znajdują się pod poniższym adresem:"
msgstr ""
"Keikutsertaan anak di bawah umur memerlukan persetujuan wali. Isi persetujuan dan formulir konfirmasi tersedia di alamat di bawah ini:"

#: apps/accounts/guardian.py:202
#, python-format
msgid "Link jest ważny %(days)s dni."
msgstr "Tautan berlaku selama %(days)s hari."

#: apps/accounts/guardian.py:205
msgid ""
"Jeśli nie jesteś opiekunem tej osoby albo nie wyrażasz zgody – zignoruj tę wiadomość. Bez potwierdzenia zgoda nie zostanie zapisana."
msgstr ""
"Jika Anda bukan wali orang ini atau tidak memberikan persetujuan, abaikan pesan ini. Tanpa konfirmasi, persetujuan tidak akan dicatat."

#: apps/accounts/guardian.py:219
#, python-format
msgid ""
"Zgoda rodzica lub opiekuna prawnego na Twój udział w Olimpiadzie Kwantowej została potwierdzona z adresu %(email)s."
msgstr ""
"Persetujuan orang tua atau wali sah atas keikutsertaan Anda dalam Olimpiade Kuantum telah dikonfirmasi dari alamat %(email)s."

#: apps/accounts/guardian.py:224
msgid "Stan zgód widzisz po zalogowaniu w panelu uczestnika."
msgstr "Anda dapat melihat status persetujuan setelah masuk ke panel peserta."

#: apps/accounts/guardian.py:245 apps/web/views/participant_extras.py:48
msgid "Podaj adres e-mail rodzica lub opiekuna prawnego."
msgstr "Masukkan alamat e-mail orang tua atau wali sah."

#: apps/accounts/guardian.py:251
msgid "Zgoda opiekuna nie jest wymagana dla osoby pełnoletniej."
msgstr "Persetujuan wali tidak diperlukan untuk peserta yang sudah dewasa."

#: apps/accounts/guardian.py:260
msgid "Adres opiekuna musi być inny niż Twój własny adres konta."
msgstr "Alamat wali harus berbeda dari alamat akun Anda sendiri."

#: apps/accounts/guardian.py:276
msgid "uczestnik/uczestniczka"
msgstr "peserta"

#: apps/accounts/profile.py:247
msgid "Podaj nowy adres e-mail."
msgstr "Masukkan alamat e-mail baru."

#: apps/accounts/profile.py:253
msgid "Konto z tym adresem e-mail już istnieje."
msgstr "Akun dengan alamat e-mail ini sudah ada."

#: apps/accounts/profile.py:268
msgid "To już jest adres tego konta."
msgstr "Ini sudah merupakan alamat akun ini."

#: apps/accounts/profile.py:288
msgid "Link potwierdzający jest nieprawidłowy albo wygasł."
msgstr "Tautan konfirmasi tidak valid atau sudah kedaluwarsa."

#: apps/accounts/profile.py:627
msgid ""
"Konta koordynatora nie można usunąć z panelu – skontaktuj się z administratorem serwisu."
msgstr ""
"Akun koordinator tidak dapat dihapus dari panel – hubungi administrator situs."

#: apps/accounts/profile.py:649
msgid "Nieprawidłowe hasło."
msgstr "Kata sandi salah."

#: apps/accounts/profile.py:653
msgid "Przepisz dokładnie adres e-mail swojego konta."
msgstr "Ketik ulang alamat e-mail akun Anda dengan tepat."

