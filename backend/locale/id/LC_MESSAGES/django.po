msgstr "Solusi dengan status %(status)s tidak dapat diajukan banding."

#: apps/appeals/services.py:178
msgid "Okno reklamacji jest zamknięte."
msgstr "Masa pengajuan banding sudah ditutup."

#: apps/chat/forms.py:65 templates/web/chat/_thread.html:134
msgid "Wiadomość"
msgstr "Pesan"

#: apps/chat/forms.py:96 templates/web/chat/_report.html:18
msgid "Dlaczego zgłaszasz tę wiadomość"
msgstr "Mengapa Anda melaporkan pesan ini"

#: apps/chat/forms.py:99
msgid "Zgłoszenie widzi wyłącznie organizator."
msgstr "Laporan hanya dapat dilihat oleh penyelenggara."

#: apps/chat/forms.py:167
msgid "Inni uczestnicy mogą mnie znaleźć i do mnie napisać"
msgstr "Peserta lain dapat menemukan dan mengirimi saya pesan"

#: apps/chat/forms.py:170
msgid ""
"W katalogu widać wyłącznie imię, pierwszą literę nazwiska i województwo – nigdy adres e-mail, szkołę ani kod uczestnika."
msgstr ""
"Direktori hanya menampilkan nama depan, huruf pertama nama belakang, dan provinsi Anda – tidak pernah alamat e-mail, sekolah, atau kode peserta."

#: apps/chat/forms.py:175
msgid "Wysyłaj mi e-mail, gdy dostanę nową wiadomość"
msgstr "Kirimi saya e-mail saat ada pesan baru"

#: apps/chat/forms.py:178
msgid ""
"List nie zawiera treści wiadomości – tylko informację, od kogo jest, i odnośnik."
msgstr "E-mail tidak berisi isi pesan – hanya informasi pengirim dan tautan."

#: apps/chat/notifications.py:49
msgid "Nowa wiadomość – Olimpiada Kwantowa"
msgstr "Pesan baru – Olimpiade Kuantum"

#: apps/chat/notifications.py:50
#, python-format
msgid "Nowa wiadomość – %(competition)s"
msgstr "Pesan baru – %(competition)s"

#: apps/chat/notifications.py:116 apps/web/views/chat.py:59
#: templates/cms/document_index_page.html:8
#: templates/web/chat/_messages.html:33 templates/web/support/detail.html:28
msgid "Organizator"
msgstr "Penyelenggara"

#: apps/chat/notifications.py:127
#, python-format
msgid "Masz nową wiadomość od %(sender)s na platformie %(competition)s."
msgstr "Anda memiliki pesan baru dari %(sender)s di platform %(competition)s."

#: apps/chat/notifications.py:130
#, python-format
msgid "Przeczytaj: %(link)s"
msgstr "Baca di sini: %(link)s"

#: apps/chat/notifications.py:132
msgid ""
"Treści wiadomości nie przesyłamy pocztą – przeczytasz ją po zalogowaniu."
msgstr ""
"Kami tidak pernah mengirim isi pesan melalui e-mail – Anda dapat membacanya setelah masuk."

#: apps/chat/notifications.py:133 apps/forum/notifications.py:507
#: apps/forum/notifications.py:805
#, python-format
msgid "Ustawienia powiadomień: %(link)s"
msgstr "Pengaturan notifikasi: %(link)s"

#: apps/chat/services.py:92
msgid "Nie można wysłać wiadomości do tej osoby."
msgstr "Pesan tidak dapat dikirim ke orang ini."

#: apps/chat/services.py:95
msgid ""
"Organizator wyłączył rozmowy między uczestnikami – ta rozmowa jest teraz tylko do odczytu."
msgstr ""
"Penyelenggara telah menonaktifkan percakapan antarpeserta – percakapan ini sekarang hanya dapat dibaca."

#: apps/chat/services.py:97
msgid "Zablokowałeś tę osobę. Odblokuj ją, jeśli chcesz napisać."
msgstr ""
"Anda telah memblokir orang ini. Buka blokirnya jika ingin mengirim pesan."

#: apps/chat/services.py:98
msgid ""
"Ta rozmowa jest szyfrowana – skonfiguruj szyfrowanie, żeby w niej pisać."
msgstr ""
"Percakapan ini terenkripsi – siapkan enkripsi untuk dapat menulis di sini."

#: apps/chat/services.py:101
msgid "Ta rozmowa została zamknięta zgodnie z zasadami konkursu."
msgstr "Percakapan ini telah ditutup sesuai peraturan kompetisi."

#: apps/chat/services.py:102
msgid "Osiągnięto dzienny limit nowych rozmów – spróbuj jutro."
msgstr "Batas harian percakapan baru telah tercapai – coba lagi besok."

#: apps/chat/services.py:307
msgid "Wiadomości są dostępne dla uczestników i organizatora tego konkursu."
msgstr "Pesan tersedia untuk peserta dan penyelenggara kompetisi ini."

#: apps/chat/services.py:439
#, python-format
msgid "%(label)s: niepoprawne dane."
msgstr "%(label)s: data tidak valid."

#: apps/chat/services.py:445
#, python-format
msgid "%(label)s: niepoprawny rozmiar."
msgstr "%(label)s: ukuran tidak valid."

#: apps/chat/services.py:468
msgid "Klucz publiczny nie jest kluczem P-256."
msgstr "Kunci publik bukan kunci P-256."

#: apps/chat/services.py:498 apps/chat/services.py:1056
msgid "Organizator nie włączył szyfrowanych rozmów."
msgstr "Penyelenggara belum mengaktifkan percakapan terenkripsi."

#: apps/chat/services.py:502
msgid ""
"Masz już klucz szyfrowania. Nowy utworzysz przyciskiem „Utwórz nowy klucz”."
msgstr ""
"Anda sudah memiliki kunci enkripsi. Buat kunci baru dengan tombol „Buat kunci baru”."

#: apps/chat/services.py:506
msgid "Klucz publiczny"
msgstr "Kunci publik"

#: apps/chat/services.py:508
msgid "Kopia klucza prywatnego"
msgstr "Salinan kunci privat"

#: apps/chat/services.py:509
msgid "Sól"
msgstr "Salt"

#: apps/chat/services.py:517
#, python-format
msgid "Za mało iteracji PBKDF2 (minimum %(minimum)s)."
msgstr "Iterasi PBKDF2 terlalu sedikit (minimal %(minimum)s)."

#: apps/chat/services.py:751
#, python-format
msgid ""
"Trwa etap „%(stage)s” – rozmowy szyfrowane są wstrzymane, bo organizator nie może ich moderować. Wrócą po zamknięciu etapu."
msgstr ""
"Tahap „%(stage)s” sedang berlangsung – percakapan terenkripsi ditangguhkan karena penyelenggara tidak dapat memoderasinya. Percakapan akan dibuka kembali setelah tahap ini ditutup."

#: apps/chat/services.py:754
msgid ""
"Organizator wyłączył szyfrowane rozmowy – ta rozmowa jest teraz tylko do odczytu."
msgstr ""
"Penyelenggara telah menonaktifkan percakapan terenkripsi – percakapan ini sekarang hanya dapat dibaca."

#: apps/chat/services.py:796
msgid "Wiadomość nie może być pusta."
msgstr "Pesan tidak boleh kosong."

#: apps/chat/services.py:799 apps/chat/services.py:884
#, python-format
msgid "Wiadomość jest za długa (limit %(limit)s znaków)."
