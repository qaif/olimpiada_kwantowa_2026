msgstr "No conversations."

#: templates/web/chat/_messages.html:36
msgid "czeka na akceptację"
msgstr "awaiting approval"

#: templates/web/chat/_messages.html:40
msgid "Wiadomość ukryta przez moderatora."
msgstr "Message hidden by a moderator."

#: templates/web/chat/_messages.html:46
msgid ""
"Wiadomość zaszyfrowana – odblokuj rozmowy szyfrowane, żeby ją przeczytać."
msgstr "Encrypted message – unlock encrypted conversations to read it."

#: templates/web/chat/_messages.html:53
#, python-format
msgid "Uzasadnienie organizatora: %(note)s"
msgstr "Organiser's reasoning: %(note)s"

#: templates/web/chat/_messages.html:56
msgid "Zgłosiłeś tę wiadomość organizatorowi."
msgstr "You reported this message to the organiser."

#: templates/web/chat/_messages.html:61
msgid "Nie ma jeszcze wiadomości – napisz pierwszą."
msgstr "No messages yet – write the first one."

#: templates/web/chat/_messages.html:61
