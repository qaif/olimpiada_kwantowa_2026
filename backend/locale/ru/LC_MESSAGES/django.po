msgstr "Выпуск %(edition)s. Зарегистрировано учеников: %(students)s из %(limit)s."

msgid "Dodaj ucznia"
msgstr "Добавить ученика"

msgid "Delegacja jest zamknięta – lista uczniów nie może się już zmienić. W razie potrzeby skontaktuj się z organizatorem."
msgstr "Делегация закрыта – список учеников больше нельзя изменить. При необходимости свяжитесь с организатором."

msgid "Drużyna ma komplet uczniów."
msgstr "Команда укомплектована."

msgid "Każdy zgłoszony uczeń dostaje e-mail z linkiem: sam ustawia hasło i składa zgody. Dane możesz poprawić, dopóki uczeń nie uruchomi konta; wypisać ucznia możesz do startu zawodów."
msgstr "Каждый зарегистрированный ученик получает письмо со ссылкой: он сам задаёт пароль и даёт согласия. Исправлять данные можно, пока ученик не активировал аккаунт; снять ученика можно до начала соревнования."

msgid "Uczniowie drużyny"
msgstr "Ученики команды"

msgid "Popraw dane"
msgstr "Исправить данные"

msgid "Wypisz"
msgstr "Снять"

msgid "Nie zgłoszono jeszcze żadnego ucznia."
msgstr "Пока не зарегистрировано ни одного ученика."

msgid "Opiekunowie drużyny"
msgstr "Руководители команды"

msgid "Wszyscy opiekunowie tego kraju prowadzą jedną drużynę i widzą tych samych uczniów."
msgstr "Все руководители команды этой страны ведут одну команду и видят одних и тех же учеников."

msgid "Wypisz ucznia"
msgstr "Снять ученика"

#, python-format
msgid "Uczeń %(name)s (%(email)s) zostanie wypisany z drużyny, a jego konto – usunięte."
msgstr "Ученик %(name)s (%(email)s) будет снят с команды, а его аккаунт – удалён."

msgid "Ten uczeń uruchomił już konto. Wypisz go tylko wtedy, gdy na pewno nie wystartuje."
msgstr "Этот ученик уже активировал аккаунт. Снимайте его, только если он точно не будет участвовать."

msgid "Popraw dane ucznia"
msgstr "Исправить данные ученика"

msgid "Zmiana adresu e-mail wysyła uczniowi nowy link – poprzedni przestaje działać."
msgstr "Смена адреса электронной почты отправляет ученику новую ссылку – прежняя перестаёт работать."

msgid "Uczeń dostanie e-mail z linkiem: ustawi hasło i sam złoży zgody. Do tego czasu konto jest nieaktywne."
msgstr "Ученик получит письмо со ссылкой: он задаст пароль и сам даст согласия. До этого аккаунт неактивен."

msgid "Zapisz"
msgstr "Сохранить"

msgid "Zgłoś ucznia"
msgstr "Зарегистрировать ученика"

#, python-format
msgid "Cześć %(name)s! Opiekun drużyny (%(country)s) zgłosił Cię do konkursu %(competition_name)s. Ustaw hasło i potwierdź oświadczenia – dopiero to uruchamia konto."
msgstr "Здравствуйте, %(name)s! Руководитель команды (%(country)s) зарегистрировал вас на %(competition_name)s. Задайте пароль и подтвердите заявления – только это активирует аккаунт."

msgid "Kraj:"
msgstr "Страна:"

msgid "Coś się nie zgadza? Napisz do opiekuna swojej drużyny – może poprawić dane, dopóki nie uruchomisz konta."
msgstr "Что-то не так? Напишите руководителю своей команды – он может исправить данные, пока вы не активировали аккаунт."

msgid "Kontakt z organizatorem:"
msgstr "Связь с организатором:"

# --- DEL-01: poprawki po przeglądzie ---

msgid "Uczeń został wypisany z drużyny. Jego konto zostaje – o dalszym udziale zdecyduje organizator."
msgstr "Ученик снят с команды. Его аккаунт сохраняется – о дальнейшем участии решит организатор."

#, python-format
msgid "Cześć %(name)s! Opiekun drużyny narodowej (%(country)s) wypisał Cię z drużyny w konkursie %(competition)s."
msgstr "Здравствуйте, %(name)s! Руководитель национальной команды (%(country)s) снял вас с команды на %(competition)s."

msgid "Twoje konto nie zostało usunięte. Organizator skontaktuje się z Tobą w sprawie dalszego udziału. Jeśli to pomyłka, napisz do opiekuna drużyny albo do organizatora."
msgstr "Ваш аккаунт не удалён. Организатор свяжется с вами по поводу дальнейшего участия. Если это ошибка, напишите руководителю команды или организатору."

#, python-format
msgid "Wypisanie z drużyny narodowej – %(competition)s"
msgstr "Снятие с национальной команды – %(competition)s"

msgid "Nie prowadzisz drużyny w bieżącej edycji"
msgstr "Вы не руководите командой в текущем выпуске"

msgid "Twoje konto nie jest przypisane do żadnej delegacji w bieżącej edycji. Jeśli masz prowadzić drużynę, poproś organizatora o zaproszenie."
msgstr "Ваш аккаунт не привязан ни к одной делегации в текущем выпуске. Если вы должны руководить командой, попросите организатора о приглашении."

#, python-format
msgid "Uczeń %(name)s (%(email)s) zostanie wypisany z drużyny. Jego konto zostaje – o dalszym udziale zdecyduje organizator, a uczeń dostanie o tym wiadomość."
msgstr "Ученик %(name)s (%(email)s) будет снят с команды. Его аккаунт сохранится – о дальнейшем участии решит организатор, а ученик получит уведомление."

msgid "Wróć do drużyny"
msgstr "Вернуться к команде"

#: apps/cms/context_processors.py
msgid "Dokumenty"
msgstr "Документы"

#: apps/cms/context_processors.py
msgid "Komitety"
msgstr "Комитеты"

#: apps/cms/context_processors.py
msgid "Harmonogram"
msgstr "Расписание"

#: apps/cms/context_processors.py
msgid "Kontakt"
msgstr "Контакты"

#: apps/cms/context_processors.py
msgid "Dla szkół/nauczycieli"
msgstr "Для школ/учителей"

#: apps/cms/context_processors.py
msgid "Rejestracja nauczyciela"
msgstr "Регистрация учителя"

