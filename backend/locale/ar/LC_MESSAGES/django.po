#: templates/web/invite/accept.html:19
msgid "Uruchom swoje konto"
msgstr "فعّل حسابك"

#: templates/web/invite/accept.html:20
#, python-format
msgid ""
"Cześć %(name)s! Nauczyciel ze szkoły %(school)s zgłosił Cię do Olimpiady "
"Kwantowej. Ustaw hasło i potwierdź oświadczenia – dopiero to uruchamia konto."
msgstr ""
"مرحبًا %(name)s! سجّلك معلّم من مدرسة %(school)s في الأولمبياد الكمّي. عيّن كلمة "
"مرور وأكّد الإقرارات – فبذلك وحده يُفعَّل الحساب."

#: templates/web/invite/accept.html:28
msgid "Twoje dane ze zgłoszenia"
msgstr "بياناتك من طلب التسجيل"

#: templates/web/invite/accept.html:30
msgid "Adres e-mail (login):"
msgstr "عنوان البريد الإلكتروني (اسم المستخدم):"

#: templates/web/invite/accept.html:31
