msgstr "موعد استحقاق الدفع"

#: templates/web/participant/_fees_card.html:22
msgid "Oznaczenie do przelewu"
msgstr "مرجع التحويل"

#: templates/web/participant/_fees_card.html:28
msgid "Pobierz rachunek"
msgstr "تنزيل الفاتورة"

