#: templates/web/guardian/invalid.html:12 templates/web/invite/invalid.html:12
#: templates/web/supervisor/consent_invalid.html:14
msgid "Ten link nie działa"
msgstr "هذا الرابط لا يعمل"

#: templates/web/guardian/invalid.html:15
msgid ""
"Poproś uczestnika o wysłanie prośby jeszcze raz – nowy link przyjdzie na ten "
"sam adres."
msgstr ""
"اطلب من المشارك إرسال الطلب مرة أخرى – سيصل رابط جديد إلى العنوان نفسه."

#: templates/web/invite/accept.html:14
msgid "Zaproszenie do Olimpiady Kwantowej"
msgstr "دعوة إلى أولمبياد الكم"

#: templates/web/invite/accept.html:18 templates/web/invite/done.html:14
#: templates/web/invite/invalid.html:11
