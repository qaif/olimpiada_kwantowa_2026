#: apps/accounts/activation.py:80
msgid "Aktywuj konto – Olimpiada Kwantowa"
msgstr "تفعيل الحساب – أولمبياد الكم"

#: apps/accounts/activation.py:81
msgid "Potwierdź nowy adres e-mail – Olimpiada Kwantowa"
msgstr "تأكيد عنوان البريد الإلكتروني الجديد – أولمبياد الكم"

#: apps/accounts/activation.py:82
msgid "Adres e-mail konta został zmieniony – Olimpiada Kwantowa"
msgstr "تم تغيير عنوان البريد الإلكتروني للحساب – أولمبياد الكم"

#: apps/accounts/activation.py:88
#, python-format
msgid "Aktywuj konto – %(competition)s"
msgstr "تفعيل الحساب – %(competition)s"

#: apps/accounts/activation.py:89
#, python-format
msgid "Potwierdź nowy adres e-mail – %(competition)s"
msgstr "تأكيد عنوان البريد الإلكتروني الجديد – %(competition)s"

#: apps/accounts/activation.py:90
#, python-format
msgid "Adres e-mail konta został zmieniony – %(competition)s"
msgstr "تم تغيير عنوان البريد الإلكتروني للحساب – %(competition)s"

#: apps/accounts/activation.py:97
#, python-format
msgid ""
"Konto zostało założone. Sprawdź skrzynkę e-mail (także spam) i kliknij link "
"aktywacyjny – bez tego logowanie nie zadziała. Link jest ważny %(hours)s "
"godziny – po tym czasie konto zostanie usunięte i trzeba zarejestrować się "
"ponownie."
msgstr ""
"تم إنشاء الحساب. تحقّق من صندوق بريدك الإلكتروني (بما في ذلك مجلد الرسائل غير "
"المرغوب فيها) وانقر على رابط التفعيل – فلن يعمل تسجيل الدخول من دونه. الرابط "
"صالح لمدة %(hours)s ساعة، وبعدها سيُحذف الحساب وسيتعيّن عليك التسجيل من جديد."

#: apps/accounts/activation.py:115
msgid ""
"Jeśli konto z tym adresem istnieje i czeka na aktywację, link został wysłany "
"ponownie. Sprawdź też folder ze spamem."
msgstr ""
"إذا كان هناك حساب بهذا العنوان بانتظار التفعيل، فقد أُعيد إرسال الرابط. تحقّق "
"أيضًا من مجلد الرسائل غير المرغوب فيها."

#: apps/accounts/activation.py:119
msgid "Link aktywacyjny jest nieprawidłowy albo wygasł."
msgstr "رابط التفعيل غير صالح أو منتهي الصلاحية."

#: apps/accounts/activation.py:272 apps/accounts/supervisor_consent.py:213
#: apps/accounts/supervisor_consent.py:256 apps/submissions/notifications.py:85
#: apps/tenancy/branding.py:104
msgid "Olimpiada Kwantowa"
msgstr "أولمبياد الكم"

#: apps/accounts/activation.py:273 apps/submissions/notifications.py:86
#: templates/registration/invite_student_body.txt:31
#: templates/registration/password_reset_email.txt:26
#: templates/registration/supervisor_consent_body.txt:47
msgid "Wiadomość wysłana automatycznie; prosimy na nią nie odpowiadać."
msgstr "أُرسلت هذه الرسالة تلقائيًا؛ يُرجى عدم الرد عليها."

#: apps/accounts/activation.py:281
#, python-format
msgid ""
"Ktoś – prawdopodobnie Ty – założył konto w serwisie %(competition_genitive)s."
msgstr ""
"قام شخص ما – ربما أنت – بإنشاء حساب على موقع %(competition_genitive)s."

#: apps/accounts/activation.py:284
msgid "Aby aktywować konto i móc się zalogować, otwórz poniższy adres:"
msgstr "لتفعيل الحساب والتمكّن من تسجيل الدخول، افتح العنوان التالي:"

#: apps/accounts/activation.py:289
#, python-format
msgid ""
"Link jest ważny %(hours)s godziny. Po tym czasie konto zostanie usunięte i "
"rejestrację trzeba będzie powtórzyć."
msgstr ""
"الرابط صالح لمدة %(hours)s ساعة. بعد ذلك سيُحذف الحساب وسيتعيّن تكرار التسجيل."

#: apps/accounts/activation.py:295
msgid ""
"Jeśli to nie Ty zakładałeś konto – zignoruj tę wiadomość. Bez kliknięcia w "
"link konto nie zostanie aktywowane i zniknie samo."
msgstr ""
"إذا لم تكن أنت من أنشأ الحساب، فتجاهل هذه الرسالة. لن يُفعَّل الحساب من دون "
"النقر على الرابط، وسيُحذف تلقائيًا."

#: apps/accounts/activation.py:308
#, python-format
msgid ""
"Poproszono o zmianę adresu e-mail konta w serwisie %(competition_genitive)s na %(email)s."
msgstr ""
"طُلب تغيير البريد الإلكتروني للحساب على موقع %(competition_genitive)s إلى %(email)s."

#: apps/accounts/activation.py:311
msgid "Aby potwierdzić nowy adres, otwórz poniższy adres:"
msgstr "لتأكيد العنوان الجديد، افتح الرابط التالي:"

#: apps/accounts/activation.py:315
msgid ""
"Do potwierdzenia obowiązuje dotychczasowy adres – logowanie działa bez zmian."
msgstr "يظل العنوان الحالي ساريًا حتى التأكيد – ويعمل تسجيل الدخول كالمعتاد."

#: apps/accounts/activation.py:316
msgid "Link jest ważny 24 godziny."
msgstr "الرابط صالح لمدة 24 ساعة."

#: apps/accounts/activation.py:318
msgid "Jeśli to nie Ty prosiłeś o zmianę – zignoruj tę wiadomość."
msgstr "إذا لم تطلب هذا التغيير، فتجاهل هذه الرسالة."

#: apps/accounts/activation.py:334
#, python-format
msgid ""
"Adres e-mail konta w serwisie %(competition_genitive)s został zmieniony na %(email)s. Logowanie tym adresem przestaje działać."
msgstr ""
"تم تغيير البريد الإلكتروني للحساب على موقع %(competition_genitive)s إلى %(email)s. لم يعد تسجيل الدخول بهذا العنوان ممكنًا."

#: apps/accounts/activation.py:339
msgid ""
"Jeśli to nie Ty dokonałeś zmiany, natychmiast skontaktuj się z organizatorem."
msgstr "إذا لم تكن أنت من أجرى هذا التغيير، فتواصل مع المنظِّم فورًا."

#: apps/accounts/activation.py:538
msgid "To konto jest już aktywne – możesz się zalogować."
msgstr "هذا الحساب مفعَّل بالفعل – يمكنك تسجيل الدخول."

#: apps/accounts/admin.py:34
msgid "Personal info"
msgstr "المعلومات الشخصية"

#: apps/accounts/admin.py:36
msgid "Permissions"
msgstr "الصلاحيات"

#: apps/accounts/admin.py:39
msgid "Important dates"
msgstr "تواريخ مهمة"

#: apps/accounts/bulk_registration.py:125
msgid "Link z zaproszeniem jest nieprawidłowy albo wygasł."
msgstr "رابط الدعوة غير صالح أو منتهي الصلاحية."

#: apps/accounts/bulk_registration.py:291
msgid ""
"adres ma już konto – jeśli to uczeń tego konkursu, dostanie prośbę o zgodę "
"na dopisanie opiekuna"
msgstr ""
"لهذا العنوان حساب بالفعل – إذا كان لطالب في هذه المسابقة، فسيتلقى طلبًا "
"بالموافقة على إضافة المشرف"

#: apps/accounts/guardian.py:62
msgid "Prośba o zgodę opiekuna – Olimpiada Kwantowa"
msgstr "طلب موافقة وليّ الأمر – أولمبياد الكم"

#: apps/accounts/guardian.py:63
msgid "Zgoda opiekuna została potwierdzona – Olimpiada Kwantowa"
msgstr "تم تأكيد موافقة وليّ الأمر – أولمبياد الكم"

#: apps/accounts/guardian.py:67
#, python-format
msgid "Prośba o zgodę opiekuna – %(competition)s"
msgstr "طلب موافقة وليّ الأمر – %(competition)s"

#: apps/accounts/guardian.py:68
#, python-format
msgid "Zgoda opiekuna została potwierdzona – %(competition)s"
msgstr "تم تأكيد موافقة وليّ الأمر – %(competition)s"

#: apps/accounts/guardian.py:70
msgid "Link do formularza zgody jest nieprawidłowy albo wygasł."
msgstr "رابط نموذج الموافقة غير صالح أو منتهي الصلاحية."

#: apps/accounts/guardian.py:189
#, python-format
msgid ""
"Uczennica lub uczeń podał ten adres jako kontakt do rodzica albo opiekuna prawnego w zgłoszeniu do %(competition_genitive)s."
msgstr ""
"أدخل أحد الطلاب هذا العنوان بوصفه جهة اتصال لولي الأمر أو الوصي القانوني في طلب المشاركة في %(competition_genitive)s."

#: apps/accounts/guardian.py:194
#, python-format
msgid "Zgłoszenie dotyczy: %(name)s (%(school)s)."
msgstr "يخصّ الطلب: %(name)s (%(school)s)."

#: apps/accounts/guardian.py:197
msgid ""
"Udział osoby niepełnoletniej wymaga zgody opiekuna. Treść zgody i formularz "
"potwierdzenia znajdują się pod poniższym adresem:"
msgstr ""
"تتطلب مشاركة القاصر موافقة وليّ الأمر. تجد نص الموافقة ونموذج التأكيد على "
"العنوان التالي:"

#: apps/accounts/guardian.py:203
#, python-format
msgid "Link jest ważny %(days)s dni."
msgstr "الرابط صالح لمدة %(days)s يوم."

#: apps/accounts/guardian.py:206
msgid ""
"Jeśli nie jesteś opiekunem tej osoby albo nie wyrażasz zgody – zignoruj tę "
"wiadomość. Bez potwierdzenia zgoda nie zostanie zapisana."
msgstr ""
"إذا لم تكن وليّ أمر هذا الشخص أو لا توافق على مشاركته، فتجاهل هذه الرسالة. لن "
"تُسجَّل الموافقة من دون تأكيد."

#: apps/accounts/guardian.py:220
#, python-format
msgid ""
"Zgoda rodzica lub opiekuna prawnego na Twój udział w %(competition_locative)s została potwierdzona z adresu %(email)s."
msgstr ""
"تم تأكيد موافقة ولي الأمر أو الوصي القانوني على مشاركتك في %(competition_locative)s من العنوان %(email)s."

#: apps/accounts/guardian.py:225
msgid "Stan zgód widzisz po zalogowaniu w panelu uczestnika."
msgstr "يمكنك الاطلاع على حالة الموافقات بعد تسجيل الدخول إلى لوحة المشارك."

#: apps/accounts/guardian.py:246 apps/web/views/participant_extras.py:48
msgid "Podaj adres e-mail rodzica lub opiekuna prawnego."
msgstr "أدخل عنوان البريد الإلكتروني لأحد الوالدين أو لوليّ الأمر."

#: apps/accounts/guardian.py:252
msgid "Zgoda opiekuna nie jest wymagana dla osoby pełnoletniej."
msgstr "لا يلزم الحصول على موافقة وليّ الأمر للشخص البالغ."

#: apps/accounts/guardian.py:261
msgid "Adres opiekuna musi być inny niż Twój własny adres konta."
msgstr "يجب أن يختلف عنوان وليّ الأمر عن عنوان حسابك."

#: apps/accounts/guardian.py:277
msgid "uczestnik/uczestniczka"
msgstr "المشارك/المشاركة"

#: apps/accounts/profile.py:255
msgid "Podaj nowy adres e-mail."
msgstr "أدخل عنوان البريد الإلكتروني الجديد."

#: apps/accounts/profile.py:261
msgid "Konto z tym adresem e-mail już istnieje."
msgstr "يوجد حساب بهذا العنوان بالفعل."

#: apps/accounts/profile.py:276
msgid "To już jest adres tego konta."
msgstr "هذا هو عنوان هذا الحساب بالفعل."

#: apps/accounts/profile.py:296
msgid "Link potwierdzający jest nieprawidłowy albo wygasł."
msgstr "رابط التأكيد غير صالح أو منتهي الصلاحية."

#: apps/accounts/profile.py:635
msgid ""
"Konta koordynatora nie można usunąć z panelu – skontaktuj się z "
"administratorem serwisu."
msgstr "لا يمكن حذف حساب المنسّق من لوحة التحكم – تواصل مع مسؤول الموقع."

#: apps/accounts/profile.py:657
msgid "Nieprawidłowe hasło."
msgstr "كلمة المرور غير صحيحة."

#: apps/accounts/profile.py:661
msgid "Przepisz dokładnie adres e-mail swojego konta."
msgstr "أعد كتابة عنوان البريد الإلكتروني لحسابك بدقة."

#: apps/accounts/regions.py:214 apps/web/forms.py:901 apps/web/forms.py:937
#: apps/web/forms.py:1055 apps/web/forms.py:1378 apps/web/views/invite.py:75
msgid "Województwo"
msgstr "المقاطعة"

#: apps/accounts/regions.py:219 apps/web/forms.py:557
msgid "Kraj"
msgstr "الدولة"

#: apps/accounts/regions.py:219
#: templates/web/supervisor/_import_preview.html:54
msgid "Region"
msgstr "المنطقة"

#: apps/accounts/services.py:172
msgid "Nieznane województwo – wybierz jedno z listy."
msgstr "مقاطعة غير معروفة – اختر واحدة من القائمة."

#: apps/accounts/services.py:178
msgid "Województwo jest wymagane."
msgstr "المقاطعة مطلوبة."

#: apps/accounts/services.py:224
msgid "Wybierz pozycję z listy – to pole jest wymagane."
msgstr "اختر عنصرًا من القائمة – هذا الحقل مطلوب."

#: apps/accounts/services.py:232
msgid "Nieznana pozycja – wybierz jedną z listy."
msgstr "عنصر غير معروف – اختر واحدًا من القائمة."

#: apps/accounts/supervisor_consent.py:88
msgid "Prośba o zgodę na opiekuna szkolnego – Olimpiada Kwantowa"
msgstr "طلب الموافقة على المشرف المدرسي – أولمبياد الكم"

#: apps/accounts/supervisor_consent.py:89
#, python-format
msgid "Prośba o zgodę na opiekuna szkolnego – %(competition)s"
msgstr "طلب الموافقة على المشرف المدرسي – %(competition)s"

#: apps/accounts/supervisor_consent.py:97
msgid ""
"Link z prośbą o zgodę jest nieprawidłowy, wygasł albo jest już nieaktualny."
msgstr "رابط طلب الموافقة غير صالح أو منتهي الصلاحية أو لم يعد ساريًا."

#: apps/accounts/supervisor_consent.py:100
msgid ""
"Ta prośba jest adresowana do innego konta. Zaloguj się na konto, na które "
"przyszedł list."
msgstr ""
"هذا الطلب موجَّه إلى حساب آخر. سجّل الدخول إلى الحساب الذي وصلت إليه الرسالة."

#: apps/accounts/twofactor.py:398
msgid "Najpierw zeskanuj kod QR – konfiguracja nie została rozpoczęta."
msgstr "امسح رمز QR أولًا – لم يبدأ الإعداد بعد."

#: apps/accounts/twofactor.py:400
msgid "Drugi składnik jest już włączony na tym koncie."
msgstr "العامل الثاني للتحقق مفعَّل بالفعل على هذا الحساب."

#: apps/accounts/twofactor.py:404
msgid ""
"Kod z aplikacji nie pasuje. Sprawdź, czy zegar w telefonie jest ustawiony "
"automatycznie."
msgstr "الرمز من التطبيق غير مطابق. تأكّد من ضبط ساعة الهاتف تلقائيًا."

#: apps/accounts/twofactor.py:608
msgid "Wymagane potwierdzenie drugiego składnika logowania."
msgstr "يلزم تأكيد العامل الثاني لتسجيل الدخول."

#: apps/appeals/models.py:41
msgid "złożona"
msgstr "مقدَّم"

#: apps/appeals/models.py:42 templates/web/chat/_messages.html:37
msgid "odrzucona"
msgstr "مرفوض"

#: apps/appeals/models.py:43
