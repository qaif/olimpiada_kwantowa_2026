#: apps/accounts/activation.py:80
msgid "Aktywuj konto – Olimpiada Kwantowa"
msgstr "Activez votre compte – Olympiade quantique"

#: apps/accounts/activation.py:81
msgid "Potwierdź nowy adres e-mail – Olimpiada Kwantowa"
msgstr "Confirmez votre nouvelle adresse e-mail – Olympiade quantique"

#: apps/accounts/activation.py:82
msgid "Adres e-mail konta został zmieniony – Olimpiada Kwantowa"
msgstr "Adresse e-mail du compte modifiée – Olympiade quantique"

#: apps/accounts/activation.py:88
#, python-format
msgid "Aktywuj konto – %(competition)s"
msgstr "Activez votre compte – %(competition)s"

#: apps/accounts/activation.py:89
#, python-format
msgid "Potwierdź nowy adres e-mail – %(competition)s"
msgstr "Confirmez votre nouvelle adresse e-mail – %(competition)s"

#: apps/accounts/activation.py:90
#, python-format
msgid "Adres e-mail konta został zmieniony – %(competition)s"
msgstr "Adresse e-mail du compte modifiée – %(competition)s"

#: apps/accounts/activation.py:97
#, python-format
msgid ""
"Konto zostało założone. Sprawdź skrzynkę e-mail (także spam) i kliknij link "
"aktywacyjny – bez tego logowanie nie zadziała. Link jest ważny %(hours)s "
"godziny – po tym czasie konto zostanie usunięte i trzeba zarejestrować się "
"ponownie."
msgstr ""
"Le compte a été créé. Consultez votre boîte de réception (y compris les "
"spams) et cliquez sur le lien d’activation – sans cela, la connexion ne "
"fonctionnera pas. Le lien est valable %(hours)s heures – passé ce délai, le "
"compte sera supprimé et il faudra vous réinscrire."

#: apps/accounts/activation.py:115
msgid ""
"Jeśli konto z tym adresem istnieje i czeka na aktywację, link został wysłany "
"ponownie. Sprawdź też folder ze spamem."
msgstr ""
"Si un compte associé à cette adresse existe et attend d’être activé, le lien "
"a été renvoyé. Vérifiez aussi votre dossier de spams."

#: apps/accounts/activation.py:119
msgid "Link aktywacyjny jest nieprawidłowy albo wygasł."
msgstr "Le lien d’activation est invalide ou a expiré."

#: apps/accounts/activation.py:272 apps/accounts/supervisor_consent.py:213
#: apps/accounts/supervisor_consent.py:256 apps/submissions/notifications.py:85
#: apps/tenancy/branding.py:104
msgid "Olimpiada Kwantowa"
msgstr "Olympiade quantique"

#: apps/accounts/activation.py:273 apps/submissions/notifications.py:86
#: templates/registration/invite_student_body.txt:31
#: templates/registration/password_reset_email.txt:26
#: templates/registration/supervisor_consent_body.txt:47
msgid "Wiadomość wysłana automatycznie; prosimy na nią nie odpowiadać."
msgstr "Ce message a été envoyé automatiquement ; merci de ne pas y répondre."

#: apps/accounts/activation.py:281
#, python-format
msgid ""
"Ktoś – prawdopodobnie Ty – założył konto w serwisie %(competition_genitive)s."
msgstr ""
"Quelqu'un – probablement vous – a créé un compte sur le site de l'%(competition_genitive)s."

#: apps/accounts/activation.py:284
msgid "Aby aktywować konto i móc się zalogować, otwórz poniższy adres:"
msgstr ""
"Pour activer le compte et pouvoir vous connecter, ouvrez l’adresse ci-"
"dessous :"

#: apps/accounts/activation.py:289
#, python-format
msgid ""
"Link jest ważny %(hours)s godziny. Po tym czasie konto zostanie usunięte i "
"rejestrację trzeba będzie powtórzyć."
msgstr ""
"Le lien est valable %(hours)s heures. Passé ce délai, le compte sera "
"supprimé et il faudra recommencer l’inscription."

#: apps/accounts/activation.py:295
msgid ""
"Jeśli to nie Ty zakładałeś konto – zignoruj tę wiadomość. Bez kliknięcia w "
"link konto nie zostanie aktywowane i zniknie samo."
msgstr ""
"Si vous n’avez pas créé ce compte, ignorez simplement ce message. Sans clic "
"sur le lien, le compte ne sera pas activé et disparaîtra de lui-même."

#: apps/accounts/activation.py:308
#, python-format
msgid ""
"Poproszono o zmianę adresu e-mail konta w serwisie %(competition_genitive)s na %(email)s."
msgstr ""
"Un changement de l'adresse e-mail du compte sur le site de l'%(competition_genitive)s vers %(email)s a été demandé."

#: apps/accounts/activation.py:311
msgid "Aby potwierdzić nowy adres, otwórz poniższy adres:"
msgstr "Pour confirmer la nouvelle adresse, ouvrez le lien ci-dessous :"

#: apps/accounts/activation.py:315
msgid ""
"Do potwierdzenia obowiązuje dotychczasowy adres – logowanie działa bez zmian."
msgstr ""
"Jusqu’à la confirmation, l’adresse actuelle reste valable – la connexion "
"fonctionne comme avant."

#: apps/accounts/activation.py:316
msgid "Link jest ważny 24 godziny."
msgstr "Le lien est valable 24 heures."

#: apps/accounts/activation.py:318
msgid "Jeśli to nie Ty prosiłeś o zmianę – zignoruj tę wiadomość."
msgstr ""
"Si vous n’avez pas demandé cette modification, ignorez simplement ce message."

#: apps/accounts/activation.py:334
#, python-format
msgid ""
"Adres e-mail konta w serwisie %(competition_genitive)s został zmieniony na %(email)s. Logowanie tym adresem przestaje działać."
msgstr ""
"L'adresse e-mail du compte sur le site de l'%(competition_genitive)s a été changée en %(email)s. La connexion avec cette adresse ne fonctionne plus."

#: apps/accounts/activation.py:339
msgid ""
"Jeśli to nie Ty dokonałeś zmiany, natychmiast skontaktuj się z organizatorem."
msgstr ""
"Si vous n’êtes pas à l’origine de cette modification, contactez "
"immédiatement l’organisateur."

#: apps/accounts/activation.py:538
msgid "To konto jest już aktywne – możesz się zalogować."
msgstr "Ce compte est déjà actif – vous pouvez vous connecter."

#: apps/accounts/admin.py:34
msgid "Personal info"
msgstr "Informations personnelles"

#: apps/accounts/admin.py:36
msgid "Permissions"
msgstr "Autorisations"

#: apps/accounts/admin.py:39
msgid "Important dates"
msgstr "Dates importantes"

#: apps/accounts/bulk_registration.py:125
msgid "Link z zaproszeniem jest nieprawidłowy albo wygasł."
msgstr "Le lien d’invitation est invalide ou a expiré."

#: apps/accounts/bulk_registration.py:291
msgid ""
"adres ma już konto – jeśli to uczeń tego konkursu, dostanie prośbę o zgodę "
"na dopisanie opiekuna"
msgstr ""
"cette adresse a déjà un compte – s’il s’agit d’un élève de ce concours, il "
"lui sera demandé de consentir à l’ajout d’un encadrant"

#: apps/accounts/guardian.py:62
msgid "Prośba o zgodę opiekuna – Olimpiada Kwantowa"
msgstr "Demande de consentement du représentant légal – Olympiade quantique"

#: apps/accounts/guardian.py:63
msgid "Zgoda opiekuna została potwierdzona – Olimpiada Kwantowa"
msgstr "Consentement du représentant légal confirmé – Olympiade quantique"

#: apps/accounts/guardian.py:67
#, python-format
msgid "Prośba o zgodę opiekuna – %(competition)s"
msgstr "Demande de consentement du représentant légal – %(competition)s"

#: apps/accounts/guardian.py:68
#, python-format
msgid "Zgoda opiekuna została potwierdzona – %(competition)s"
msgstr "Consentement du représentant légal confirmé – %(competition)s"

#: apps/accounts/guardian.py:70
msgid "Link do formularza zgody jest nieprawidłowy albo wygasł."
msgstr "Le lien vers le formulaire de consentement est invalide ou a expiré."

#: apps/accounts/guardian.py:189
#, python-format
msgid ""
"Uczennica lub uczeń podał ten adres jako kontakt do rodzica albo opiekuna prawnego w zgłoszeniu do %(competition_genitive)s."
msgstr ""
"Un élève a indiqué cette adresse comme contact d'un parent ou représentant légal dans son inscription à l'%(competition_genitive)s."

#: apps/accounts/guardian.py:194
#, python-format
msgid "Zgłoszenie dotyczy: %(name)s (%(school)s)."
msgstr "L’inscription concerne : %(name)s (%(school)s)."

#: apps/accounts/guardian.py:197
msgid ""
"Udział osoby niepełnoletniej wymaga zgody opiekuna. Treść zgody i formularz "
"potwierdzenia znajdują się pod poniższym adresem:"
msgstr ""
"La participation d’un mineur nécessite le consentement de son représentant "
"légal. Le texte du consentement et le formulaire de confirmation se trouvent "
"à l’adresse ci-dessous :"

#: apps/accounts/guardian.py:203
#, python-format
msgid "Link jest ważny %(days)s dni."
msgstr "Le lien est valable %(days)s jours."

#: apps/accounts/guardian.py:206
msgid ""
"Jeśli nie jesteś opiekunem tej osoby albo nie wyrażasz zgody – zignoruj tę "
"wiadomość. Bez potwierdzenia zgoda nie zostanie zapisana."
msgstr ""
"Si vous n’êtes pas le représentant légal de cette personne ou si vous ne "
"donnez pas votre consentement, ignorez simplement ce message. Sans "
"confirmation, aucun consentement ne sera enregistré."

#: apps/accounts/guardian.py:220
#, python-format
msgid ""
"Zgoda rodzica lub opiekuna prawnego na Twój udział w %(competition_locative)s została potwierdzona z adresu %(email)s."
msgstr ""
"Le consentement d'un parent ou représentant légal à votre participation à l'%(competition_locative)s a été confirmé depuis l'adresse %(email)s."

#: apps/accounts/guardian.py:225
msgid "Stan zgód widzisz po zalogowaniu w panelu uczestnika."
msgstr ""
"Vous pouvez consulter l’état de vos consentements dans l’espace participant, "
"après connexion."

#: apps/accounts/guardian.py:246 apps/web/views/participant_extras.py:48
msgid "Podaj adres e-mail rodzica lub opiekuna prawnego."
msgstr "Saisissez l’adresse e-mail d’un parent ou représentant légal."

#: apps/accounts/guardian.py:252
msgid "Zgoda opiekuna nie jest wymagana dla osoby pełnoletniej."
msgstr ""
"Le consentement du représentant légal n’est pas requis pour une personne "
"majeure."

#: apps/accounts/guardian.py:261
msgid "Adres opiekuna musi być inny niż Twój własny adres konta."
msgstr ""
"L’adresse du représentant légal doit être différente de l’adresse de votre "
"compte."

#: apps/accounts/guardian.py:277
msgid "uczestnik/uczestniczka"
msgstr "participant·e"

#: apps/accounts/profile.py:255
msgid "Podaj nowy adres e-mail."
msgstr "Saisissez la nouvelle adresse e-mail."

#: apps/accounts/profile.py:261
msgid "Konto z tym adresem e-mail już istnieje."
msgstr "Un compte avec cette adresse e-mail existe déjà."

#: apps/accounts/profile.py:276
msgid "To już jest adres tego konta."
msgstr "C’est déjà l’adresse de ce compte."

#: apps/accounts/profile.py:296
msgid "Link potwierdzający jest nieprawidłowy albo wygasł."
msgstr "Le lien de confirmation est invalide ou a expiré."

#: apps/accounts/profile.py:635
msgid ""
"Konta koordynatora nie można usunąć z panelu – skontaktuj się z "
"administratorem serwisu."
msgstr ""
"Un compte coordinateur ne peut pas être supprimé depuis le panneau – "
"contactez l’administrateur du site."

#: apps/accounts/profile.py:657
msgid "Nieprawidłowe hasło."
msgstr "Mot de passe incorrect."

#: apps/accounts/profile.py:661
msgid "Przepisz dokładnie adres e-mail swojego konta."
msgstr "Recopiez exactement l’adresse e-mail de votre compte."

#: apps/accounts/regions.py:214 apps/web/forms.py:901 apps/web/forms.py:937
#: apps/web/forms.py:1055 apps/web/forms.py:1378 apps/web/views/invite.py:75
msgid "Województwo"
msgstr "Voïvodie"

#: apps/accounts/regions.py:219 apps/web/forms.py:557
msgid "Kraj"
msgstr "Pays"

#: apps/accounts/regions.py:219
#: templates/web/supervisor/_import_preview.html:54
msgid "Region"
msgstr "Région"

#: apps/accounts/services.py:172
msgid "Nieznane województwo – wybierz jedno z listy."
msgstr "Voïvodie inconnue – choisissez-en une dans la liste."

#: apps/accounts/services.py:178
msgid "Województwo jest wymagane."
msgstr "La voïvodie est obligatoire."

#: apps/accounts/services.py:224
msgid "Wybierz pozycję z listy – to pole jest wymagane."
msgstr "Choisissez un élément dans la liste – ce champ est obligatoire."

#: apps/accounts/services.py:232
msgid "Nieznana pozycja – wybierz jedną z listy."
msgstr "Élément inconnu – choisissez-en un dans la liste."

#: apps/accounts/supervisor_consent.py:88
msgid "Prośba o zgodę na opiekuna szkolnego – Olimpiada Kwantowa"
msgstr ""
"Demande de consentement pour un encadrant scolaire – Olympiade quantique"

#: apps/accounts/supervisor_consent.py:89
#, python-format
msgid "Prośba o zgodę na opiekuna szkolnego – %(competition)s"
msgstr "Demande de consentement pour un encadrant scolaire – %(competition)s"

#: apps/accounts/supervisor_consent.py:97
msgid ""
"Link z prośbą o zgodę jest nieprawidłowy, wygasł albo jest już nieaktualny."
msgstr ""
"Le lien de demande de consentement est invalide, a expiré ou n’est plus "
"d’actualité."

#: apps/accounts/supervisor_consent.py:100
msgid ""
"Ta prośba jest adresowana do innego konta. Zaloguj się na konto, na które "
"przyszedł list."
msgstr ""
"Cette demande est adressée à un autre compte. Connectez-vous au compte "
"auquel l’e-mail a été envoyé."

#: apps/accounts/twofactor.py:398
msgid "Najpierw zeskanuj kod QR – konfiguracja nie została rozpoczęta."
msgstr "Scannez d’abord le code QR – la configuration n’a pas été lancée."

#: apps/accounts/twofactor.py:400
msgid "Drugi składnik jest już włączony na tym koncie."
msgstr "La double authentification est déjà activée sur ce compte."

#: apps/accounts/twofactor.py:404
msgid ""
"Kod z aplikacji nie pasuje. Sprawdź, czy zegar w telefonie jest ustawiony "
"automatycznie."
msgstr ""
"Le code de l’application ne correspond pas. Vérifiez que l’horloge de votre "
"téléphone est réglée automatiquement."

#: apps/accounts/twofactor.py:608
msgid "Wymagane potwierdzenie drugiego składnika logowania."
msgstr "Confirmation du second facteur d’authentification requise."

#: apps/appeals/models.py:41
msgid "złożona"
msgstr "déposée"

#: apps/appeals/models.py:42 templates/web/chat/_messages.html:37
msgid "odrzucona"
msgstr "rejetée"

#: apps/appeals/models.py:43
msgid "uwzględniona"
msgstr "acceptée"

#: apps/appeals/models.py:44
msgid "częściowo uwzględniona"
msgstr "partiellement acceptée"

#: apps/appeals/services.py:89
#, python-format
msgid "%(label)s nie może przekraczać %(limit)s znaków."
msgstr "%(label)s ne peut pas dépasser %(limit)s caractères."

#: apps/appeals/services.py:158
msgid "Nie ma takiego rozwiązania."
msgstr "Cette solution n’existe pas."

#: apps/appeals/services.py:160 apps/web/forms.py:1244
msgid "Uzasadnienie reklamacji"
msgstr "Motif de la réclamation"

#: apps/appeals/services.py:163
#, python-format
msgid "Uzasadnienie reklamacji musi mieć co najmniej %(limit)s znaków."
msgstr ""
"Le motif de la réclamation doit comporter au moins %(limit)s caractères."

#: apps/appeals/services.py:168
msgid "Reklamacja na to rozwiązanie została już złożona."
msgstr "Une réclamation a déjà été déposée pour cette solution."

#: apps/appeals/services.py:171
#, python-format
msgid "Rozwiązanie w stanie %(status)s nie podlega reklamacji."
msgstr ""
"Une solution à l’état %(status)s ne peut pas faire l’objet d’une réclamation."

#: apps/appeals/services.py:178
msgid "Okno reklamacji jest zamknięte."
msgstr "La période de réclamation est close."

#: apps/chat/forms.py:65 templates/web/chat/_thread.html:134
msgid "Wiadomość"
msgstr "Message"

#: apps/chat/forms.py:96 templates/web/chat/_report.html:18
msgid "Dlaczego zgłaszasz tę wiadomość"
msgstr "Pourquoi signalez-vous ce message ?"

#: apps/chat/forms.py:99
msgid "Zgłoszenie widzi wyłącznie organizator."
msgstr "Seul l’organisateur voit le signalement."

#: apps/chat/forms.py:167
msgid "Inni uczestnicy mogą mnie znaleźć i do mnie napisać"
msgstr "Les autres participants peuvent me trouver et m’écrire"

#: apps/chat/forms.py:170
msgid ""
"W katalogu widać wyłącznie imię, pierwszą literę nazwiska i województwo – "
"nigdy adres e-mail, szkołę ani kod uczestnika."
msgstr ""
"L’annuaire affiche uniquement votre prénom, l’initiale de votre nom et votre "
"voïvodie – jamais votre adresse e-mail, votre établissement ni votre code "
"participant."

#: apps/chat/forms.py:175
msgid "Wysyłaj mi e-mail, gdy dostanę nową wiadomość"
msgstr "M’envoyer un e-mail quand je reçois un nouveau message"

#: apps/chat/forms.py:178
msgid ""
"List nie zawiera treści wiadomości – tylko informację, od kogo jest, i "
"odnośnik."
msgstr ""
"L’e-mail ne contient pas le message – seulement l’expéditeur et un lien."

#: apps/chat/notifications.py:49
msgid "Nowa wiadomość – Olimpiada Kwantowa"
msgstr "Nouveau message – Olympiade quantique"

#: apps/chat/notifications.py:50
#, python-format
msgid "Nowa wiadomość – %(competition)s"
msgstr "Nouveau message – %(competition)s"

#: apps/chat/notifications.py:116 apps/web/views/chat.py:59
#: templates/cms/document_index_page.html:8
#: templates/web/chat/_messages.html:33 templates/web/support/detail.html:28
msgid "Organizator"
msgstr "Organisateur"

#: apps/chat/notifications.py:127
#, python-format
msgid "Masz nową wiadomość od %(sender)s na platformie %(competition)s."
msgstr ""
"Vous avez un nouveau message de %(sender)s sur la plateforme %(competition)s."

#: apps/chat/notifications.py:130
#, python-format
msgid "Przeczytaj: %(link)s"
msgstr "Lire : %(link)s"

#: apps/chat/notifications.py:132
msgid ""
"Treści wiadomości nie przesyłamy pocztą – przeczytasz ją po zalogowaniu."
msgstr ""
"Nous n’envoyons jamais le contenu du message par e-mail – vous le lirez "
"après vous être connecté."

#: apps/chat/notifications.py:133 apps/forum/notifications.py:507
#: apps/forum/notifications.py:805
#, python-format
msgid "Ustawienia powiadomień: %(link)s"
msgstr "Paramètres des notifications : %(link)s"

#: apps/chat/services.py:92
msgid "Nie można wysłać wiadomości do tej osoby."
msgstr "Impossible d’envoyer un message à cette personne."

#: apps/chat/services.py:95
msgid ""
"Organizator wyłączył rozmowy między uczestnikami – ta rozmowa jest teraz "
"tylko do odczytu."
msgstr ""
"L’organisateur a désactivé les conversations entre participants – cette "
"conversation est désormais en lecture seule."

#: apps/chat/services.py:97
msgid "Zablokowałeś tę osobę. Odblokuj ją, jeśli chcesz napisać."
msgstr ""
"Vous avez bloqué cette personne. Débloquez-la si vous souhaitez lui écrire."

#: apps/chat/services.py:98
msgid ""
"Ta rozmowa jest szyfrowana – skonfiguruj szyfrowanie, żeby w niej pisać."
msgstr ""
"Cette conversation est chiffrée – configurez le chiffrement pour pouvoir y "
"écrire."

#: apps/chat/services.py:101
msgid "Ta rozmowa została zamknięta zgodnie z zasadami konkursu."
msgstr "Cette conversation a été fermée conformément au règlement du concours."

#: apps/chat/services.py:102
msgid "Osiągnięto dzienny limit nowych rozmów – spróbuj jutro."
msgstr ""
"Limite quotidienne de nouvelles conversations atteinte – réessayez demain."

#: apps/chat/services.py:307
msgid "Wiadomości są dostępne dla uczestników i organizatora tego konkursu."
msgstr ""
"La messagerie est réservée aux participants et à l’organisateur de ce "
"concours."

#: apps/chat/services.py:439
#, python-format
msgid "%(label)s: niepoprawne dane."
msgstr "%(label)s : données invalides."

#: apps/chat/services.py:445
#, python-format
msgid "%(label)s: niepoprawny rozmiar."
msgstr "%(label)s : taille invalide."

#: apps/chat/services.py:468
msgid "Klucz publiczny nie jest kluczem P-256."
msgstr "La clé publique n’est pas une clé P-256."

#: apps/chat/services.py:498 apps/chat/services.py:1056
msgid "Organizator nie włączył szyfrowanych rozmów."
msgstr "L’organisateur n’a pas activé les conversations chiffrées."

#: apps/chat/services.py:502
msgid ""
"Masz już klucz szyfrowania. Nowy utworzysz przyciskiem „Utwórz nowy klucz”."
msgstr ""
"Vous avez déjà une clé de chiffrement. Pour en créer une nouvelle, utilisez "
"le bouton « Créer une nouvelle clé »."

#: apps/chat/services.py:506
msgid "Klucz publiczny"
msgstr "Clé publique"

#: apps/chat/services.py:508
msgid "Kopia klucza prywatnego"
msgstr "Copie de la clé privée"

#: apps/chat/services.py:509
msgid "Sól"
msgstr "Sel"

#: apps/chat/services.py:517
#, python-format
msgid "Za mało iteracji PBKDF2 (minimum %(minimum)s)."
msgstr "Nombre d’itérations PBKDF2 insuffisant (minimum %(minimum)s)."

#: apps/chat/services.py:751
#, python-format
