msgstr "टेस्ट सेटिंग्स पर वापस जाएँ"

#: templates/web/quiz/preview.html:35 templates/web/quiz/start.html:48
msgid "Instrukcja organizatora"
msgstr "आयोजक के निर्देश"

#: templates/web/quiz/preview.html:76
msgid "Brak pytań"
msgstr "कोई प्रश्न नहीं"

#: templates/web/quiz/result.html:12 templates/web/quiz/start.html:106
msgid "podsumowanie"
msgstr "सारांश"

#: templates/web/quiz/result.html:20
msgid "Strona testu"
msgstr "टेस्ट पृष्ठ"

#: templates/web/quiz/result.html:27
msgid "Twoje podejście"
msgstr "आपका प्रयास"

#: templates/web/quiz/result.html:31 templates/web/quiz/start.html:86
msgid "Rozpoczęte"
msgstr "शुरू हुआ"

#: templates/web/quiz/result.html:33 templates/web/quiz/start.html:87
