# Kontekst obrazu djcms = korzeń repozytorium (djcms/Dockerfile). Wszystko poza trzema katalogami
# jest wykluczone – w szczególności .env, backend/ (kod aplikacji głównej), secrets/, .git.
*
!djcms/
!backend/static/
!backend/djcms_contract/
djcms/.venv
djcms/media
djcms/staticfiles
djcms/.pytest_cache
djcms/.ruff_cache
djcms/.mypy_cache
**/__pycache__
**/*.pyc
